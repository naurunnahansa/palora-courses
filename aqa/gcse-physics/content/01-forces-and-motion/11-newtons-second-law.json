                  {
                    "type": "text",
                    "text": "$= 200{,}000 + 300{,}000 = 500{,}000$"
                  },
                  {
                    "type": "text",
                    "text": " N (calculation)"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
