{
  "id": "quiz-algebraic-fractions",
  "title": "Quiz: Algebraic Fractions",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\frac{x^2 - 9}{x + 3}$.",
      "options": [
        {"id": "a", "text": "$x + 3$"},
        {"id": "b", "text": "$x - 3$"},
        {"id": "c", "text": "$x^2 - 3$"},
        {"id": "d", "text": "$\\frac{x - 9}{3}$"}
      ],
      "correctAnswer": "b",
      "explanation": "Factorise the numerator as a difference of two squares: $\\frac{(x + 3)(x - 3)}{x + 3} = x - 3$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\frac{x}{3} \\times \\frac{9}{x^2}$.",
      "options": [
        {"id": "a", "text": "$\\frac{3}{x}$"},
        {"id": "b", "text": "$\\frac{x}{3}$"},
        {"id": "c", "text": "$3x$"},
        {"id": "d", "text": "$\\frac{9}{3x}$"}
      ],
      "correctAnswer": "a",
      "explanation": "Multiply numerators and denominators: $\\frac{9x}{3x^2} = \\frac{3}{x}$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\frac{1}{x} + \\frac{2}{x + 1}$.",
      "options": [
        {"id": "a", "text": "$\\frac{3}{2x + 1}$"},
        {"id": "b", "text": "$\\frac{3x + 1}{x(x + 1)}$"},
        {"id": "c", "text": "$\\frac{3}{x(x + 1)}$"},
        {"id": "d", "text": "$\\frac{2x + 1}{x(x + 1)}$"}
      ],
      "correctAnswer": "b",
      "explanation": "Common denominator is $x(x + 1)$: $\\frac{x + 1}{x(x + 1)} + \\frac{2x}{x(x + 1)} = \\frac{x + 1 + 2x}{x(x + 1)} = \\frac{3x + 1}{x(x + 1)}$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\frac{x^2}{4} \\div \\frac{x}{8}$.",
      "options": [
        {"id": "a", "text": "$\\frac{x}{2}$"},
        {"id": "b", "text": "$2x$"},
        {"id": "c", "text": "$\\frac{x^2}{2}$"},
        {"id": "d", "text": "$\\frac{2}{x}$"}
      ],
      "correctAnswer": "b",
      "explanation": "Dividing by a fraction means multiplying by its reciprocal: $\\frac{x^2}{4} \\times \\frac{8}{x} = \\frac{8x^2}{4x} = 2x$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $\\frac{5}{x - 1} = \\frac{3}{x + 1}$.",
      "options": [
        {"id": "a", "text": "$x = 4$"},
        {"id": "b", "text": "$x = -4$"},
        {"id": "c", "text": "$x = 2$"},
        {"id": "d", "text": "$x = -2$"}
      ],
      "correctAnswer": "b",
      "explanation": "Cross-multiply: $5(x + 1) = 3(x - 1)$, so $5x + 5 = 3x - 3$, giving $2x = -8$ and $x = -4$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\frac{x^2 + 5x + 6}{x^2 - 9}$.",
      "options": [
        {"id": "a", "text": "$\\frac{x + 2}{x - 3}$"},
        {"id": "b", "text": "$\\frac{x + 3}{x - 3}$"},
        {"id": "c", "text": "$\\frac{x + 2}{x + 3}$"},
        {"id": "d", "text": "$\\frac{5x + 6}{-9}$"}
      ],
      "correctAnswer": "a",
      "explanation": "Factorise: $\\frac{(x + 2)(x + 3)}{(x + 3)(x - 3)}$. Cancel $(x + 3)$: $\\frac{x + 2}{x - 3}$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Write $\\frac{3}{x - 2} - \\frac{2}{x + 1}$ as a single fraction.",
      "options": [
        {"id": "a", "text": "$\\frac{1}{(x - 2)(x + 1)}$"},
        {"id": "b", "text": "$\\frac{x + 7}{(x - 2)(x + 1)}$"},
        {"id": "c", "text": "$\\frac{x - 7}{(x - 2)(x + 1)}$"},
        {"id": "d", "text": "$\\frac{5}{(x - 2)(x + 1)}$"}
      ],
      "correctAnswer": "b",
      "explanation": "$\\frac{3(x + 1) - 2(x - 2)}{(x - 2)(x + 1)} = \\frac{3x + 3 - 2x + 4}{(x - 2)(x + 1)} = \\frac{x + 7}{(x - 2)(x + 1)}$."
    }
  ]
}
