  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $x^2 + 5x + 6 = 0$.",
      "options": [
        { "id": "a", "text": "$x = 2$ or $x = 3$" },
        { "id": "b", "text": "$x = -2$ or $x = -3$" },
        { "id": "c", "text": "$x = -1$ or $x = -6$" },
        { "id": "d", "text": "$x = 1$ or $x = 6$" }
      ],
      "correctAnswer": "b",
      "explanation": "Factorise: $(x + 2)(x + 3) = 0$. So $x + 2 = 0$ gives $x = -2$, and $x + 3 = 0$ gives $x = -3$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $x^2 - 9 = 0$.",
      "options": [
        { "id": "a", "text": "$x = 9$ only" },
        { "id": "b", "text": "$x = 3$ only" },
        { "id": "c", "text": "$x = 3$ or $x = -3$" },
        { "id": "d", "text": "$x = 81$ or $x = -81$" }
      ],
      "correctAnswer": "c",
      "explanation": "Factorise as a difference of two squares: $(x + 3)(x - 3) = 0$. So $x = -3$ or $x = 3$."
    }
