  "title": "Check: Gradient",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The line passing through $(-2, 7)$ and $(4, -5)$ has a gradient of:",
      "options": [
        { "id": "a", "text": "$-2$" },
        { "id": "b", "text": "$2$" },
        { "id": "c", "text": "$-\\frac{1}{2}$" },
        { "id": "d", "text": "$\\frac{1}{2}$" }
      ],
      "correctAnswer": "a",
      "explanation": "Gradient $= \\frac{-5 - 7}{4 - (-2)} = \\frac{-12}{6} = -2$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Two lines have gradients $m_1 = 3$ and $m_2 = \\frac{1}{3}$. Which line is steeper?",
      "options": [
        { "id": "a", "text": "The line with gradient $m_2$" },
        { "id": "b", "text": "They are equally steep" },
        { "id": "c", "text": "The line with gradient $m_1$" },
        { "id": "d", "text": "Cannot be determined" }
      ],
      "correctAnswer": "c",
      "explanation": "The steepness of a line is determined by the absolute value of its gradient. Since $|3| > |\\frac{1}{3}|$, the line with gradient $m_1 = 3$ is steeper."
    }
  ]
}
