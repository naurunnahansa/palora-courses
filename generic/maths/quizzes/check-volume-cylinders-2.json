  "title": "Check: Volume of Cylinders",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cylinder has a volume of $200\\pi\\text{ cm}^3$ and a radius of $5\\text{ cm}$. What is its height?",
      "options": [
        {
          "id": "a",
          "text": "$4\\text{ cm}$"
        },
        {
          "id": "b",
          "text": "$8\\text{ cm}$"
        },
        {
          "id": "c",
          "text": "$10\\text{ cm}$"
        },
        {
          "id": "d",
          "text": "$40\\text{ cm}$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$V = \\pi r^2 h$, so $200\\pi = \\pi \\times 25 \\times h$. Dividing by $25\\pi$: $h = 8\\text{ cm}$."
    }
  ]
