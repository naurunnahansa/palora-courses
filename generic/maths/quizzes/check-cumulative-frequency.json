  "title": "Check: Cumulative Frequency",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A grouped frequency table has frequencies $5, 8, 12, 10, 5$. What are the cumulative frequencies?",
      "options": [
        {
          "id": "a",
          "text": "$5, 8, 12, 10, 5$"
        },
        {
          "id": "b",
          "text": "$5, 13, 25, 30, 40$"
        },
        {
          "id": "c",
          "text": "$5, 13, 25, 35, 40$"
        },
        {
          "id": "d",
          "text": "$40, 35, 25, 13, 5$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Cumulative frequency is a running total: $5$, $5+8=13$, $13+12=25$, $25+10=35$, $35+5=40$."
    }
  ]
