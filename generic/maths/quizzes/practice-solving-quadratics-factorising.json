{
  "id": "practice-solving-quadratics-factorising",
  "title": "Practice: Solving Quadratics by Factorising",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Solve: x^2 - 5x - 14 = 0",
      "options": [
        { "id": "a", "text": "x = 7 or x = -2" },
        { "id": "b", "text": "x = -7 or x = 2" },
        { "id": "c", "text": "x = 7 or x = 2" },
        { "id": "d", "text": "x = -7 or x = -2" }
      ],
      "correctAnswer": "a",
      "explanation": "x^2 - 5x - 14 = (x - 7)(x + 2) = 0. So x = 7 or x = -2."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Solve: x^2 + 6x = 0",
      "options": [
        { "id": "a", "text": "x = 6" },
        { "id": "b", "text": "x = 0 or x = 6" },
        { "id": "c", "text": "x = 0 or x = -6" },
        { "id": "d", "text": "x = -6" }
      ],
      "correctAnswer": "c",
      "explanation": "x^2 + 6x = x(x + 6) = 0. So x = 0 or x = -6. Do not divide by x, or you lose the solution x = 0."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "The product of two consecutive positive integers is 72. What are the integers?",
      "options": [
        { "id": "a", "text": "6 and 12" },
        { "id": "b", "text": "8 and 9" },
        { "id": "c", "text": "7 and 8" },
        { "id": "d", "text": "9 and 10" }
      ],
      "correctAnswer": "b",
      "explanation": "Let n and n+1 be the integers. n(n+1) = 72. n^2 + n - 72 = 0. (n+9)(n-8) = 0. n = 8 (taking positive). So the integers are 8 and 9."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Solve: 2x^2 - 7x + 3 = 0",
      "options": [
        { "id": "a", "text": "x = 3 or x = 1/2" },
        { "id": "b", "text": "x = -3 or x = -1/2" },
        { "id": "c", "text": "x = 3 or x = -1/2" },
        { "id": "d", "text": "x = -3 or x = 1/2" }
      ],
      "correctAnswer": "a",
      "explanation": "2x^2 - 7x + 3 = (2x - 1)(x - 3) = 0. So 2x - 1 = 0 giving x = 1/2, or x - 3 = 0 giving x = 3."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Solve: (x + 1)(x - 3) = 5",
      "options": [
        { "id": "a", "text": "x = -1 or x = 3" },
        { "id": "b", "text": "x = 4 or x = -2" },
        { "id": "c", "text": "x = -4 or x = 2" },
        { "id": "d", "text": "x = 5 or x = -1" }
      ],
      "correctAnswer": "b",
      "explanation": "Expand: x^2 - 2x - 3 = 5. Rearrange: x^2 - 2x - 8 = 0. Factorise: (x - 4)(x + 2) = 0. x = 4 or x = -2. Common error: setting each bracket to 5."
    }
  ]
}
