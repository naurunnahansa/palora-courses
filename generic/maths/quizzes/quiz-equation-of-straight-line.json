{
  "id": "quiz-equation-of-straight-line",
  "title": "Quiz: Equation of a Straight Line",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the gradient and $y$-intercept of the line $y = -2x + 7$?",
      "options": [
        {"id": "a", "text": "Gradient $= 7$, $y$-intercept $= -2$"},
        {"id": "b", "text": "Gradient $= -2$, $y$-intercept $= 7$"},
        {"id": "c", "text": "Gradient $= 2$, $y$-intercept $= -7$"},
        {"id": "d", "text": "Gradient $= -2$, $y$-intercept $= -7$"}
      ],
      "correctAnswer": "b",
      "explanation": "In $y = mx + c$, $m$ is the gradient and $c$ is the $y$-intercept. Here $m = -2$ and $c = 7$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Rearrange $2x + 3y = 12$ into $y = mx + c$ form.",
      "options": [
        {"id": "a", "text": "$y = 2x + 4$"},
        {"id": "b", "text": "$y = -\\frac{2}{3}x + 4$"},
        {"id": "c", "text": "$y = \\frac{2}{3}x + 4$"},
        {"id": "d", "text": "$y = -2x + 12$"}
      ],
      "correctAnswer": "b",
      "explanation": "$3y = -2x + 12$, so $y = -\\frac{2}{3}x + 4$. The gradient is $-\\frac{2}{3}$ and the $y$-intercept is 4."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which two lines are parallel?",
      "options": [
        {"id": "a", "text": "$y = 3x + 1$ and $y = -3x + 1$"},
        {"id": "b", "text": "$y = 2x + 5$ and $y = 2x - 3$"},
        {"id": "c", "text": "$y = 4x + 2$ and $y = 2x + 4$"},
        {"id": "d", "text": "$y = x + 1$ and $y = -x + 1$"}
      ],
      "correctAnswer": "b",
      "explanation": "Parallel lines have the same gradient. Both $y = 2x + 5$ and $y = 2x - 3$ have gradient 2, so they are parallel."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A line has gradient 4 and passes through the point $(0, -1)$. What is its equation?",
      "options": [
        {"id": "a", "text": "$y = 4x - 1$"},
        {"id": "b", "text": "$y = -x + 4$"},
        {"id": "c", "text": "$y = 4x + 1$"},
        {"id": "d", "text": "$y = x - 4$"}
      ],
      "correctAnswer": "a",
      "explanation": "The point $(0, -1)$ is on the $y$-axis, so $c = -1$. With $m = 4$: $y = 4x - 1$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which line passes through the origin?",
      "options": [
        {"id": "a", "text": "$y = 3x + 1$"},
        {"id": "b", "text": "$y = x - 2$"},
        {"id": "c", "text": "$y = -5x$"},
        {"id": "d", "text": "$y = 2$"}
      ],
      "correctAnswer": "c",
      "explanation": "A line passes through the origin when $c = 0$. Only $y = -5x$ (equivalently $y = -5x + 0$) has $c = 0$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the equation of the line with gradient $\\frac{1}{2}$ and $y$-intercept $3$?",
      "options": [
        {"id": "a", "text": "$y = 3x + \\frac{1}{2}$"},
        {"id": "b", "text": "$y = \\frac{1}{2}x + 3$"},
        {"id": "c", "text": "$y = 2x + 3$"},
        {"id": "d", "text": "$y = \\frac{3}{2}x$"}
      ],
      "correctAnswer": "b",
      "explanation": "Substitute $m = \\frac{1}{2}$ and $c = 3$ into $y = mx + c$: $y = \\frac{1}{2}x + 3$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Two lines are $y = 5x + 2$ and $y = 5x - 4$. What is true about these lines?",
      "options": [
        {"id": "a", "text": "They intersect at one point"},
        {"id": "b", "text": "They are the same line"},
        {"id": "c", "text": "They are parallel and never meet"},
        {"id": "d", "text": "They are perpendicular"}
      ],
      "correctAnswer": "c",
      "explanation": "Both lines have the same gradient ($m = 5$) but different $y$-intercepts, so they are parallel and will never intersect."
    }
  ]
}
