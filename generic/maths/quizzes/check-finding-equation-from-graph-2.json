{
  "id": "check-finding-equation-from-graph-2",
  "title": "Check: Finding Equation from a Graph",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A line passes through $(-1, 5)$ and $(3, -3)$. What is the equation of this line?",
      "options": [
        { "id": "a", "text": "$y = -2x + 3$" },
        { "id": "b", "text": "$y = 2x + 3$" },
        { "id": "c", "text": "$y = -2x - 3$" },
        { "id": "d", "text": "$y = -\\frac{1}{2}x + 3$" }
      ],
      "correctAnswer": "a",
      "explanation": "Gradient $= \\frac{-3 - 5}{3 - (-1)} = \\frac{-8}{4} = -2$. Using point $(3, -3)$: $-3 = -2(3) + c$, so $c = -3 + 6 = 3$. The equation is $y = -2x + 3$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A graph shows a straight line crossing the $y$-axis at $-4$ and the $x$-axis at $2$. What is the gradient?",
      "options": [
        { "id": "a", "text": "$-2$" },
        { "id": "b", "text": "$2$" },
        { "id": "c", "text": "$-\\frac{1}{2}$" },
        { "id": "d", "text": "$\\frac{1}{2}$" }
      ],
      "correctAnswer": "b",
      "explanation": "The line passes through $(0, -4)$ and $(2, 0)$. The gradient is $\\frac{0 - (-4)}{2 - 0} = \\frac{4}{2} = 2$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A straight line has a $y$-intercept of $1$ and passes through $(6, 4)$. What is its equation?",
      "options": [
        { "id": "a", "text": "$y = 2x + 1$" },
        { "id": "b", "text": "$y = \\frac{1}{2}x + 1$" },
        { "id": "c", "text": "$y = \\frac{1}{2}x - 1$" },
        { "id": "d", "text": "$y = 4x + 1$" }
      ],
      "correctAnswer": "b",
      "explanation": "Gradient $= \\frac{4 - 1}{6 - 0} = \\frac{3}{6} = \\frac{1}{2}$. With $c = 1$, the equation is $y = \\frac{1}{2}x + 1$."
    }
  ]
}
