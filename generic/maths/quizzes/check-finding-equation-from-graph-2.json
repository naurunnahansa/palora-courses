{
  "id": "check-finding-equation-from-graph-2",
  "title": "Check: Finding Equation from a Graph",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A line passes through $(-1, 5)$ and $(3, -3)$. What is the equation of this line?",
      "options": [
        {
          "id": "a",
          "text": "$y = -\\frac{1}{2}x + 3$"
        },
        {
          "id": "b",
          "text": "$y = -2x - 3$"
        },
        {
          "id": "c",
          "text": "$y = -2x + 3$"
        },
        {
          "id": "d",
          "text": "$y = 2x + 3$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Gradient $= \\frac{-3 - 5}{3 - (-1)} = \\frac{-8}{4} = -2$. Using point $(3, -3)$: $-3 = -2(3) + c$, so $c = -3 + 6 = 3$. The equation is $y = -2x + 3$."
    }
  ]
}
