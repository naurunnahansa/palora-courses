{
  "id": "check-functions-notation-2-b",
  "title": "Check: Functions and Notation (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $f(x) = 2x + 5$, what is $f^{-1}(x)$?",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{1}{2x + 5}$"
        },
        {
          "id": "b",
          "text": "$\\frac{x - 5}{2}$"
        },
        {
          "id": "c",
          "text": "$2x - 5$"
        },
        {
          "id": "d",
          "text": "$\\frac{x + 5}{2}$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "To find the inverse, set $y = 2x + 5$. Swap $x$ and $y$: $x = 2y + 5$. Solve for $y$: $y = \\frac{x - 5}{2}$. So $f^{-1}(x) = \\frac{x - 5}{2}$."
    }
  ]
}
