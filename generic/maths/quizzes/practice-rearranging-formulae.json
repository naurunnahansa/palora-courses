      "stem": "Make x the subject of: y = (x - 3) / 5",
      "options": [
        { "id": "a", "text": "x = y/5 + 3" },
        { "id": "b", "text": "x = 5y + 3" },
        { "id": "c", "text": "x = 5(y + 3)" },
        { "id": "d", "text": "x = 5y - 3" }
      ],
      "correctAnswer": "b",
