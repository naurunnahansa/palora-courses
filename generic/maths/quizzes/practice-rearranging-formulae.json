  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Make t the subject of: v = u + at",
      "options": [
        { "id": "a", "text": "t = v - u - a" },
        { "id": "b", "text": "t = (v - u) / a" },
        { "id": "c", "text": "t = v / (u + a)" },
        { "id": "d", "text": "t = a / (v - u)" }
      ],
      "correctAnswer": "b",
      "explanation": "v = u + at. Subtract u: v - u = at. Divide by a: t = (v - u) / a."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Make b the subject of: A = (1/2)(a + b)h",
      "options": [
        { "id": "a", "text": "b = 2A/h - a" },
        { "id": "b", "text": "b = A/(2h) - a" },
        { "id": "c", "text": "b = (2A - a)/h" },
        { "id": "d", "text": "b = 2Ah - a" }
      ],
      "correctAnswer": "a",
      "explanation": "A = (1/2)(a + b)h. Multiply by 2: 2A = (a + b)h. Divide by h: 2A/h = a + b. Subtract a: b = 2A/h - a."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Make C the subject of: F = (9C)/5 + 32",
      "options": [
        { "id": "a", "text": "C = 5F/9 - 32" },
        { "id": "b", "text": "C = (F - 32) / 9 x 5" },
        { "id": "c", "text": "C = 5(F - 32) / 9" },
        { "id": "d", "text": "C = 9(F - 32) / 5" }
      ],
      "correctAnswer": "c",
      "explanation": "F = 9C/5 + 32. Subtract 32: F - 32 = 9C/5. Multiply by 5: 5(F - 32) = 9C. Divide by 9: C = 5(F - 32)/9."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Make l the subject of: P = 2(l + w)",
      "options": [
        { "id": "a", "text": "l = P/2 - w" },
        { "id": "b", "text": "l = (P - w)/2" },
        { "id": "c", "text": "l = P - 2w" },
        { "id": "d", "text": "l = 2P - w" }
      ],
      "correctAnswer": "a",
      "explanation": "P = 2(l + w). Divide by 2: P/2 = l + w. Subtract w: l = P/2 - w."
    },
    {
