{
  "id": "quiz-surface-area-cones-spheres",
  "title": "Quiz: Surface Area: Cones and Spheres",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The formula for the curved surface area of a cone is:",
      "options": [
        {"id": "a", "text": "$\\pi r^2$"},
        {"id": "b", "text": "$\\pi r l$"},
        {"id": "c", "text": "$2\\pi r h$"},
        {"id": "d", "text": "$\\frac{1}{3}\\pi r^2 h$"}
      ],
      "correctAnswer": "b",
      "explanation": "The curved surface area of a cone is $\\pi r l$, where $r$ is the base radius and $l$ is the slant height."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cone has a base radius of $5$ cm and a slant height of $13$ cm. What is its total surface area in terms of $\\pi$?",
      "options": [
        {"id": "a", "text": "$65\\pi$ cm$^2$"},
        {"id": "b", "text": "$90\\pi$ cm$^2$"},
        {"id": "c", "text": "$130\\pi$ cm$^2$"},
        {"id": "d", "text": "$45\\pi$ cm$^2$"}
      ],
      "correctAnswer": "b",
      "explanation": "Total $= \\pi rl + \\pi r^2 = \\pi(5)(13) + \\pi(25) = 65\\pi + 25\\pi = 90\\pi$ cm$^2$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The surface area of a sphere with radius $r$ is:",
      "options": [
        {"id": "a", "text": "$2\\pi r^2$"},
        {"id": "b", "text": "$\\pi r^2$"},
        {"id": "c", "text": "$4\\pi r^2$"},
        {"id": "d", "text": "$\\frac{4}{3}\\pi r^3$"}
      ],
      "correctAnswer": "c",
      "explanation": "The surface area of a sphere is $4\\pi r^2$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A sphere has a radius of $7$ cm. What is its surface area in terms of $\\pi$?",
      "options": [
        {"id": "a", "text": "$49\\pi$ cm$^2$"},
        {"id": "b", "text": "$196\\pi$ cm$^2$"},
        {"id": "c", "text": "$28\\pi$ cm$^2$"},
        {"id": "d", "text": "$98\\pi$ cm$^2$"}
      ],
      "correctAnswer": "b",
      "explanation": "Surface area $= 4\\pi r^2 = 4\\pi(49) = 196\\pi$ cm$^2$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cone has base radius $6$ cm and vertical height $8$ cm. What is the slant height?",
      "options": [
        {"id": "a", "text": "$10$ cm"},
        {"id": "b", "text": "$14$ cm"},
        {"id": "c", "text": "$\\sqrt{28}$ cm"},
        {"id": "d", "text": "$7$ cm"}
      ],
      "correctAnswer": "a",
      "explanation": "Using Pythagoras: $l = \\sqrt{r^2 + h^2} = \\sqrt{36 + 64} = \\sqrt{100} = 10$ cm."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A hemisphere has a radius of $4$ cm. What is its total surface area (curved surface plus flat base) in terms of $\\pi$?",
      "options": [
        {"id": "a", "text": "$32\\pi$ cm$^2$"},
        {"id": "b", "text": "$48\\pi$ cm$^2$"},
        {"id": "c", "text": "$64\\pi$ cm$^2$"},
        {"id": "d", "text": "$16\\pi$ cm$^2$"}
      ],
      "correctAnswer": "b",
      "explanation": "Curved surface $= 2\\pi r^2 = 32\\pi$ cm$^2$. Flat base $= \\pi r^2 = 16\\pi$ cm$^2$. Total $= 48\\pi$ cm$^2$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A sphere has a surface area of $100\\pi$ cm$^2$. What is its radius?",
      "options": [
        {"id": "a", "text": "$5$ cm"},
        {"id": "b", "text": "$10$ cm"},
        {"id": "c", "text": "$25$ cm"},
        {"id": "d", "text": "$\\sqrt{10}$ cm"}
      ],
      "correctAnswer": "a",
      "explanation": "$4\\pi r^2 = 100\\pi$, so $r^2 = 25$ and $r = 5$ cm."
    }
  ]
}
