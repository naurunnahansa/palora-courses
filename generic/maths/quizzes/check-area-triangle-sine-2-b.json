  "title": "Check: Area of a Triangle Using Sine (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A triangle has an area of $30\\text{ cm}^2$, one side of $10\\text{ cm}$, and an adjacent side of $12\\text{ cm}$. What is the included angle?",
      "options": [
        {
          "id": "a",
          "text": "$45°$"
        },
        {
          "id": "b",
          "text": "$30°$"
        },
        {
          "id": "c",
          "text": "$90°$"
        },
        {
          "id": "d",
          "text": "$60°$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$30 = \\frac{1}{2} \\times 10 \\times 12 \\times \\sin C$, so $\\sin C = \\frac{30}{60} = 0.5$, giving $C = 30°$."
    }
  ]
