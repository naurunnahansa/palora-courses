      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A parallelogram has an area of $56\\text{ cm}^2$ and a base of $8\\text{ cm}$. What is its perpendicular height?",
      "options": [
        { "id": "a", "text": "$6\\text{ cm}$" },
        { "id": "b", "text": "$7\\text{ cm}$" },
        { "id": "c", "text": "$14\\text{ cm}$" },
        { "id": "d", "text": "$48\\text{ cm}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$A = bh$, so $56 = 8 \\times h$, giving $h = 7\\text{ cm}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A trapezium has an area of $45\\text{ cm}^2$, a height of $5\\text{ cm}$, and one parallel side of $7\\text{ cm}$. What is the other parallel side?",
      "options": [
        { "id": "a", "text": "$9\\text{ cm}$" },
        { "id": "b", "text": "$11\\text{ cm}$" },
        { "id": "c", "text": "$18\\text{ cm}$" },
        { "id": "d", "text": "$4\\text{ cm}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$A = \\frac{1}{2}(a+b)h$, so $45 = \\frac{1}{2}(7+b) \\times 5$. This gives $45 = \\frac{5(7+b)}{2}$, so $90 = 5(7+b)$, $18 = 7+b$, hence $b = 11\\text{ cm}$."
    }
  ]
