  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Calculate $\\frac{2}{3} + \\frac{1}{4}$.",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{3}{7}$"
        },
        {
          "id": "b",
          "text": "$\\frac{8}{12}$"
        },
        {
          "id": "c",
          "text": "$\\frac{5}{12}$"
        },
        {
          "id": "d",
          "text": "$\\frac{11}{12}$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Find a common denominator (LCM of 3 and 4 is 12): $\\frac{2}{3} = \\frac{8}{12}$ and $\\frac{1}{4} = \\frac{3}{12}$. So $\\frac{8}{12} + \\frac{3}{12} = \\frac{11}{12}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Calculate $\\frac{3}{5} \\times \\frac{2}{7}$.",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{21}{10}$"
        },
        {
          "id": "b",
          "text": "$\\frac{5}{12}$"
        },
        {
          "id": "c",
          "text": "$\\frac{6}{12}$"
        },
        {
          "id": "d",
          "text": "$\\frac{6}{35}$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "To multiply fractions, multiply numerators and denominators: $\\frac{3 \\times 2}{5 \\times 7} = \\frac{6}{35}$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Calculate $\\frac{3}{4} \\div \\frac{1}{2}$.",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{3}{8}$"
        },
        {
          "id": "b",
          "text": "$\\frac{3}{2}$"
        },
        {
          "id": "c",
          "text": "$\\frac{6}{4}$"
        },
        {
          "id": "d",
          "text": "$\\frac{1}{2}$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "To divide by a fraction, multiply by its reciprocal (flip it): $\\frac{3}{4} \\div \\frac{1}{2} = \\frac{3}{4} \\times \\frac{2}{1} = \\frac{6}{4} = \\frac{3}{2}$."
    },
    {
