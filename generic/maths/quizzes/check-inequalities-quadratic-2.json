{
  "id": "check-inequalities-quadratic-2",
  "title": "Check: Quadratic Inequalities",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $x^2 + 2x - 8 \\leq 0$.",
      "options": [
        { "id": "a", "text": "$x \\leq -4$ or $x \\geq 2$" },
        { "id": "b", "text": "$-4 \\leq x \\leq 2$" },
        { "id": "c", "text": "$-2 \\leq x \\leq 4$" },
        { "id": "d", "text": "$x \\leq -2$ or $x \\geq 4$" }
      ],
      "correctAnswer": "b",
      "explanation": "Factorise: $(x+4)(x-2) \\leq 0$. Roots are $x = -4$ and $x = 2$. The quadratic is $\\leq 0$ between (and including) the roots: $-4 \\leq x \\leq 2$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $x^2 \\geq 9$.",
      "options": [
        { "id": "a", "text": "$x \\geq 3$" },
        { "id": "b", "text": "$-3 \\leq x \\leq 3$" },
        { "id": "c", "text": "$x \\leq -3$ or $x \\geq 3$" },
        { "id": "d", "text": "$x \\geq -3$" }
      ],
      "correctAnswer": "c",
      "explanation": "Rearrange: $x^2 - 9 \\geq 0$, so $(x-3)(x+3) \\geq 0$. The quadratic is $\\geq 0$ outside the roots: $x \\leq -3$ or $x \\geq 3$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $2x^2 - 5x - 3 > 0$.",
      "options": [
        { "id": "a", "text": "$-\\frac{1}{2} < x < 3$" },
        { "id": "b", "text": "$x < -\\frac{1}{2}$ or $x > 3$" },
        { "id": "c", "text": "$x < -3$ or $x > \\frac{1}{2}$" },
        { "id": "d", "text": "$-3 < x < \\frac{1}{2}$" }
      ],
      "correctAnswer": "b",
      "explanation": "Factorise: $(2x + 1)(x - 3) > 0$. Roots are $x = -\\frac{1}{2}$ and $x = 3$. Since the quadratic opens upward, it is positive outside the roots: $x < -\\frac{1}{2}$ or $x > 3$."
    }
  ]
}
