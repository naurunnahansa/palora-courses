{
  "id": "quiz-bearings",
  "title": "Quiz: Bearings",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Bearings are always measured:",
      "options": [
        {
          "id": "a",
          "text": "Anticlockwise from north"
        },
        {
          "id": "b",
          "text": "Anticlockwise from east"
        },
        {
          "id": "c",
          "text": "Clockwise from north"
        },
        {
          "id": "d",
          "text": "Clockwise from south"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Bearings are always measured clockwise from north and given as three-figure values."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The bearing of due east is:",
      "options": [
        {
          "id": "a",
          "text": "$090°$"
        },
        {
          "id": "b",
          "text": "$270°$"
        },
        {
          "id": "c",
          "text": "$180°$"
        },
        {
          "id": "d",
          "text": "$000°$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Due east is $90°$ clockwise from north, written as $090°$ in three-figure bearing format."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The bearing of $B$ from $A$ is $065°$. What is the bearing of $A$ from $B$?",
      "options": [
        {
          "id": "a",
          "text": "$295°$"
        },
        {
          "id": "b",
          "text": "$245°$"
        },
        {
          "id": "c",
          "text": "$115°$"
        },
        {
          "id": "d",
          "text": "$235°$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "The reverse bearing is $065° + 180° = 245°$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The bearing of $Q$ from $P$ is $310°$. What is the bearing of $P$ from $Q$?",
      "options": [
        {
          "id": "a",
          "text": "$490°$"
        },
        {
          "id": "b",
          "text": "$140°$"
        },
        {
          "id": "c",
          "text": "$130°$"
        },
        {
          "id": "d",
          "text": "$050°$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "The reverse bearing is $310° - 180° = 130°$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A ship sails on a bearing of $135°$. In which general direction is it heading?",
      "options": [
        {
          "id": "a",
          "text": "South-east"
        },
        {
          "id": "b",
          "text": "North-west"
        },
        {
          "id": "c",
          "text": "South-west"
        },
        {
          "id": "d",
          "text": "North-east"
        }
      ],
      "correctAnswer": "a",
      "explanation": "$135°$ is halfway between south ($180°$) and east ($090°$), so the direction is south-east."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Town $A$ is due north of town $C$. Town $B$ is on a bearing of $070°$ from $A$. What is the angle $BAC$ in the triangle?",
      "options": [
        {
          "id": "a",
          "text": "$70°$"
        },
        {
          "id": "b",
          "text": "$110°$"
        },
        {
          "id": "c",
          "text": "$290°$"
        },
        {
          "id": "d",
          "text": "$20°$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Since $A$ is due north of $C$, the line $AC$ points south from $A$. The bearing of $B$ from $A$ is $070°$ from north, so angle $BAC$ (measured between the north line and $AB$) is $70°$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A plane flies from $P$ on a bearing of $040°$ for $200$ km, then turns to a bearing of $130°$ for $150$ km to reach $Q$. The angle of the turn at the intermediate point is:",
      "options": [
        {
          "id": "a",
          "text": "$90°$"
        },
        {
          "id": "b",
          "text": "$170°$"
        },
        {
          "id": "c",
          "text": "$130°$"
        },
        {
          "id": "d",
          "text": "$50°$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "The reverse of bearing $040°$ is $220°$. The interior angle at the turning point $= 220° - 130° = 90°$."
    }
  ]
}
