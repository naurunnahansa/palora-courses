{
  "id": "quiz-arc-length-sector-area",
  "title": "Quiz: Arc Length and Sector Area",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A sector has a radius of $10$ cm and an angle of $90°$. What is the arc length in terms of $\\pi$?",
      "options": [
        {"id": "a", "text": "$5\\pi$ cm"},
        {"id": "b", "text": "$10\\pi$ cm"},
        {"id": "c", "text": "$20\\pi$ cm"},
        {"id": "d", "text": "$25\\pi$ cm"}
      ],
      "correctAnswer": "a",
      "explanation": "Arc length $= \\frac{\\theta}{360} \\times 2\\pi r = \\frac{90}{360} \\times 2\\pi(10) = \\frac{1}{4} \\times 20\\pi = 5\\pi$ cm."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A sector has a radius of $8$ cm and an angle of $45°$. What is its area in terms of $\\pi$?",
      "options": [
        {"id": "a", "text": "$4\\pi$ cm$^2$"},
        {"id": "b", "text": "$8\\pi$ cm$^2$"},
        {"id": "c", "text": "$16\\pi$ cm$^2$"},
        {"id": "d", "text": "$32\\pi$ cm$^2$"}
      ],
      "correctAnswer": "b",
      "explanation": "Sector area $= \\frac{\\theta}{360} \\times \\pi r^2 = \\frac{45}{360} \\times \\pi(64) = \\frac{1}{8} \\times 64\\pi = 8\\pi$ cm$^2$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What fraction of the full circle is a sector with angle $120°$?",
      "options": [
        {"id": "a", "text": "$\\frac{1}{2}$"},
        {"id": "b", "text": "$\\frac{1}{3}$"},
        {"id": "c", "text": "$\\frac{1}{4}$"},
        {"id": "d", "text": "$\\frac{2}{3}$"}
      ],
      "correctAnswer": "b",
      "explanation": "The fraction is $\\frac{120}{360} = \\frac{1}{3}$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A sector has an arc length of $6\\pi$ cm and a radius of $9$ cm. What is the sector angle?",
      "options": [
        {"id": "a", "text": "$60°$"},
        {"id": "b", "text": "$90°$"},
        {"id": "c", "text": "$120°$"},
        {"id": "d", "text": "$180°$"}
      ],
      "correctAnswer": "c",
      "explanation": "$6\\pi = \\frac{\\theta}{360} \\times 2\\pi(9) = \\frac{\\theta}{360} \\times 18\\pi$. So $\\frac{\\theta}{360} = \\frac{6}{18} = \\frac{1}{3}$, giving $\\theta = 120°$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A sector has a radius of $6$ cm and angle $60°$. What is the perimeter of the sector in terms of $\\pi$?",
      "options": [
        {"id": "a", "text": "$(2\\pi + 12)$ cm"},
        {"id": "b", "text": "$2\\pi$ cm"},
        {"id": "c", "text": "$12\\pi$ cm"},
        {"id": "d", "text": "$(6\\pi + 12)$ cm"}
      ],
      "correctAnswer": "a",
      "explanation": "Arc length $= \\frac{60}{360} \\times 2\\pi(6) = 2\\pi$ cm. Perimeter $=$ arc $+$ two radii $= 2\\pi + 6 + 6 = (2\\pi + 12)$ cm."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A sector has an area of $12\\pi$ cm$^2$ and a radius of $6$ cm. What is the angle of the sector?",
      "options": [
        {"id": "a", "text": "$60°$"},
        {"id": "b", "text": "$90°$"},
        {"id": "c", "text": "$120°$"},
        {"id": "d", "text": "$150°$"}
      ],
      "correctAnswer": "c",
      "explanation": "$12\\pi = \\frac{\\theta}{360} \\times \\pi(36)$. So $\\frac{\\theta}{360} = \\frac{12}{36} = \\frac{1}{3}$, giving $\\theta = 120°$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Two sectors have the same angle but radii of $4$ cm and $8$ cm. The ratio of their areas is:",
      "options": [
        {"id": "a", "text": "$1:2$"},
        {"id": "b", "text": "$1:4$"},
        {"id": "c", "text": "$2:4$"},
        {"id": "d", "text": "$1:8$"}
      ],
      "correctAnswer": "b",
      "explanation": "Area depends on $r^2$. Ratio $= 4^2 : 8^2 = 16 : 64 = 1 : 4$."
    }
  ]
}
