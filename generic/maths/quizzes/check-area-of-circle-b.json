{
  "id": "check-area-of-circle-b",
  "title": "Check: Area of a Circle (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A circle has a diameter of $10\\text{ cm}$. What is its area in terms of $\\pi$?",
      "options": [
        {
          "id": "a",
          "text": "$100\\pi\\text{ cm}^2$"
        },
        {
          "id": "b",
          "text": "$50\\pi\\text{ cm}^2$"
        },
        {
          "id": "c",
          "text": "$25\\pi\\text{ cm}^2$"
        },
        {
          "id": "d",
          "text": "$10\\pi\\text{ cm}^2$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "The radius is $\\frac{10}{2} = 5\\text{ cm}$. Area $= \\pi r^2 = \\pi \\times 5^2 = 25\\pi\\text{ cm}^2$."
    }
  ]
}