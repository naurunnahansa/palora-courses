{
  "id": "check-trigonometric-ratios-2-b",
  "title": "Check: Trigonometric Ratios (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which sides of a right-angled triangle do you need to use $\\sin\\theta$ if you know the hypotenuse and want to find the opposite side?",
      "options": [
        {
          "id": "a",
          "text": "Use $\\cos\\theta$ instead"
        },
        {
          "id": "b",
          "text": "Opposite $= \\text{hypotenuse} \\times \\sin\\theta$"
        },
        {
          "id": "c",
          "text": "Opposite $= \\frac{\\text{hypotenuse}}{\\sin\\theta}$"
        },
        {
          "id": "d",
          "text": "Opposite $= \\text{hypotenuse} \\times \\cos\\theta$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Since $\\sin\\theta = \\frac{\\text{opposite}}{\\text{hypotenuse}}$, rearranging gives opposite $= \\text{hypotenuse} \\times \\sin\\theta$."
    }
  ]
}