{
  "id": "check-proportion",
  "title": "Check: Proportion",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $5$ books cost $£30$, how much would $8$ books cost at the same rate?",
      "options": [
        { "id": "a", "text": "$£38$" },
        { "id": "b", "text": "$£40$" },
        { "id": "c", "text": "$£48$" },
        { "id": "d", "text": "$£56$" }
      ],
      "correctAnswer": "c",
      "explanation": "Cost per book $= £30 \\div 5 = £6$. Cost of $8$ books $= 8 \\times £6 = £48$. This is direct proportion."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "$y$ is directly proportional to $x$. When $x = 4$, $y = 20$. What is $y$ when $x = 7$?",
      "options": [
        { "id": "a", "text": "$23$" },
        { "id": "b", "text": "$28$" },
        { "id": "c", "text": "$35$" },
        { "id": "d", "text": "$140$" }
      ],
      "correctAnswer": "c",
      "explanation": "$y = kx$ where $k = \\frac{20}{4} = 5$. When $x = 7$: $y = 5 \\times 7 = 35$."
    }
  ]
}
