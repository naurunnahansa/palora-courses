{
  "id": "quiz-mean",
  "title": "Quiz: Mean",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The mean of the numbers $4, 7, 10, 3, 6$ is:",
      "options": [
        {
          "id": "a",
          "text": "6"
        },
        {
          "id": "b",
          "text": "7"
        },
        {
          "id": "c",
          "text": "30"
        },
        {
          "id": "d",
          "text": "5"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Mean $= \\frac{4 + 7 + 10 + 3 + 6}{5} = \\frac{30}{5} = 6$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The mean of 8 values is 12. What is the sum of all 8 values?",
      "options": [
        {
          "id": "a",
          "text": "48"
        },
        {
          "id": "b",
          "text": "1.5"
        },
        {
          "id": "c",
          "text": "20"
        },
        {
          "id": "d",
          "text": "96"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Sum $= \\text{mean} \\times n = 12 \\times 8 = 96$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Five students have a mean test score of 72. A sixth student scores 90. What is the new mean?",
      "options": [
        {
          "id": "a",
          "text": "81"
        },
        {
          "id": "b",
          "text": "74"
        },
        {
          "id": "c",
          "text": "75"
        },
        {
          "id": "d",
          "text": "78"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Total of 5 students $= 5 \\times 72 = 360$. New total $= 360 + 90 = 450$. New mean $= \\frac{450}{6} = 75$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which of these is a disadvantage of using the mean?",
      "options": [
        {
          "id": "a",
          "text": "It uses all the data values"
        },
        {
          "id": "b",
          "text": "It is affected by extreme values (outliers)"
        },
        {
          "id": "c",
          "text": "It is easy to calculate"
        },
        {
          "id": "d",
          "text": "It can be used with any numerical data"
        }
      ],
      "correctAnswer": "b",
      "explanation": "The mean is affected by outliers because it uses every data value. A single extreme value can pull the mean significantly higher or lower."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The numbers $3, 5, 7, x, 10$ have a mean of 7. What is $x$?",
      "options": [
        {
          "id": "a",
          "text": "8"
        },
        {
          "id": "b",
          "text": "10"
        },
        {
          "id": "c",
          "text": "7"
        },
        {
          "id": "d",
          "text": "9"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Sum $= 7 \\times 5 = 35$. So $3 + 5 + 7 + x + 10 = 35$, giving $25 + x = 35$, and $x = 10$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Why can the mean NOT be used for qualitative data?",
      "options": [
        {
          "id": "a",
          "text": "Because you cannot add and divide non-numerical values"
        },
        {
          "id": "b",
          "text": "It can be used for qualitative data"
        },
        {
          "id": "c",
          "text": "Because qualitative data is always too large"
        },
        {
          "id": "d",
          "text": "Because qualitative data has no frequency"
        }
      ],
      "correctAnswer": "a",
      "explanation": "The mean requires adding values and dividing by the count. This is not possible with non-numerical (qualitative) data like colours or names."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If every value in a dataset is increased by 5, the mean will:",
      "options": [
        {
          "id": "a",
          "text": "Decrease by 5"
        },
        {
          "id": "b",
          "text": "Increase by 5"
        },
        {
          "id": "c",
          "text": "Be multiplied by 5"
        },
        {
          "id": "d",
          "text": "Stay the same"
        }
      ],
      "correctAnswer": "b",
      "explanation": "If every value increases by 5, the sum increases by $5n$, and the mean increases by $\\frac{5n}{n} = 5$."
    }
  ]
}
