{
  "id": "check-set-notation",
  "title": "Check: Set Notation",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What does the notation $A \\cap B$ represent?",
      "options": [
        { "id": "a", "text": "Elements in $A$ or $B$ (or both)" },
        { "id": "b", "text": "Elements in $A$ and $B$ (the intersection)" },
        { "id": "c", "text": "Elements not in $A$" },
        { "id": "d", "text": "The universal set" }
      ],
      "correctAnswer": "b",
      "explanation": "$A \\cap B$ is the intersection of sets $A$ and $B$, meaning the elements that belong to both $A$ and $B$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What does $A'$ (or $A^c$) represent?",
      "options": [
        { "id": "a", "text": "The elements in set $A$" },
        { "id": "b", "text": "The universal set" },
        { "id": "c", "text": "The complement of $A$ — elements NOT in $A$" },
        { "id": "d", "text": "The empty set" }
      ],
      "correctAnswer": "c",
      "explanation": "$A'$ represents the complement of $A$, which is the set of all elements in the universal set $\\xi$ that are not in $A$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $\\xi = \\{1,2,3,4,5,6,7,8\\}$, $A = \\{2,4,6,8\\}$, and $B = \\{1,2,3,4\\}$, what is $A \\cup B$?",
      "options": [
        { "id": "a", "text": "$\\{2, 4\\}$" },
        { "id": "b", "text": "$\\{1,2,3,4,6,8\\}$" },
        { "id": "c", "text": "$\\{1,3,5,7\\}$" },
        { "id": "d", "text": "$\\{6, 8\\}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$A \\cup B$ is the union — all elements in $A$ or $B$ (or both): $\\{1,2,3,4,6,8\\}$."
    }
  ]
}