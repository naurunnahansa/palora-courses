  "title": "Check: Simultaneous Equations (One Linear, One Quadratic)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve: $y = x + 1$ and $x^2 + y^2 = 25$.",
      "options": [
        { "id": "a", "text": "$(3, 4)$ and $(-4, -3)$" },
        { "id": "b", "text": "$(4, 5)$ and $(-3, -2)$" },
        { "id": "c", "text": "$(3, 4)$ and $(4, 5)$" },
        { "id": "d", "text": "$(-4, -3)$ and $(5, 0)$" }
      ],
      "correctAnswer": "a",
      "explanation": "Substitute $y = x + 1$: $x^2 + (x+1)^2 = 25$. Expand: $x^2 + x^2 + 2x + 1 = 25$. Simplify: $2x^2 + 2x - 24 = 0$, so $x^2 + x - 12 = 0$. Factorise: $(x+4)(x-3) = 0$. So $x = 3, y = 4$ or $x = -4, y = -3$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "How many solutions can a system of one linear and one quadratic equation have?",
      "options": [
        { "id": "a", "text": "Always exactly two" },
        { "id": "b", "text": "Zero, one, or two" },
        { "id": "c", "text": "One or two" },
        { "id": "d", "text": "Always exactly one" }
      ],
      "correctAnswer": "b",
      "explanation": "A line can intersect a parabola or circle at $0$, $1$, or $2$ points. The discriminant of the resulting quadratic tells you which case applies."
    },
    {
