{
  "id": "check-tree-diagrams-dependent-2",
  "title": "Check: Tree Diagrams (Dependent Events)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A box contains $4$ red and $6$ green sweets. Two sweets are taken without replacement. What is $P(\\text{both red})$?",
      "options": [
        { "id": "a", "text": "$\\frac{16}{100}$" },
        { "id": "b", "text": "$\\frac{12}{90}$" },
        { "id": "c", "text": "$\\frac{4}{10} \\times \\frac{4}{10}$" },
        { "id": "d", "text": "$\\frac{8}{10}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$P(\\text{1st red}) = \\frac{4}{10}$. After removing a red, $P(\\text{2nd red}) = \\frac{3}{9}$. $P(\\text{both red}) = \\frac{4}{10} \\times \\frac{3}{9} = \\frac{12}{90} = \\frac{2}{15}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "From the same box ($4$ red, $6$ green, without replacement), what is the probability of picking one of each colour?",
      "options": [
        { "id": "a", "text": "$\\frac{24}{90}$" },
        { "id": "b", "text": "$\\frac{48}{90}$" },
        { "id": "c", "text": "$\\frac{24}{100}$" },
        { "id": "d", "text": "$\\frac{12}{90}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$P(\\text{red then green}) = \\frac{4}{10} \\times \\frac{6}{9} = \\frac{24}{90}$. $P(\\text{green then red}) = \\frac{6}{10} \\times \\frac{4}{9} = \\frac{24}{90}$. Total $= \\frac{24}{90} + \\frac{24}{90} = \\frac{48}{90} = \\frac{8}{15}$."
    }
  ]
}