        {
          "id": "c",
          "text": "$1\\frac{3}{4}$ cups"
        },
        {
          "id": "d",
          "text": "$2\\frac{1}{4}$ cups"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$\\frac{3}{4} \\times 2\\frac{1}{2} = \\frac{3}{4} \\times \\frac{5}{2} = \\frac{15}{8} = 1\\frac{7}{8}$ cups."
