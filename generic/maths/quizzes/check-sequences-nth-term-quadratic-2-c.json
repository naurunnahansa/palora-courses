  "title": "Check: Sequences: nth Term (Quadratic) (C)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Find the $n$th term of $0, 3, 8, 15, 24, ...$.",
      "options": [
        {
          "id": "a",
          "text": "$n^2 + 1$"
        },
        {
          "id": "b",
          "text": "$n^2 + n - 2$"
        },
        {
          "id": "c",
          "text": "$n^2 - 1$"
        },
        {
          "id": "d",
          "text": "$n^2 - n$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Test $n = 1$: $1 - 1 = 0$. $n = 2$: $4 - 1 = 3$. $n = 3$: $9 - 1 = 8$. $n = 4$: $16 - 1 = 15$. $n = 5$: $25 - 1 = 24$. All match, so the $n$th term is $n^2 - 1$."
    }
  ]
