{
  "id": "quiz-rearranging-formulae",
  "title": "Quiz: Rearranging Formulae",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $x$ the subject of $y = 3x + 5$.",
      "options": [
        {"id": "a", "text": "$x = \\frac{y + 5}{3}$"},
        {"id": "b", "text": "$x = \\frac{y - 5}{3}$"},
        {"id": "c", "text": "$x = 3y - 5$"},
        {"id": "d", "text": "$x = \\frac{3}{y - 5}$"}
      ],
      "correctAnswer": "b",
      "explanation": "Subtract 5: $y - 5 = 3x$. Divide by 3: $x = \\frac{y - 5}{3}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $r$ the subject of $A = \\pi r^2$.",
      "options": [
        {"id": "a", "text": "$r = \\frac{A}{\\pi}$"},
        {"id": "b", "text": "$r = \\sqrt{\\frac{A}{\\pi}}$"},
        {"id": "c", "text": "$r = \\frac{\\sqrt{A}}{\\pi}$"},
        {"id": "d", "text": "$r = \\frac{A}{2\\pi}$"}
      ],
      "correctAnswer": "b",
      "explanation": "Divide by $\\pi$: $\\frac{A}{\\pi} = r^2$. Take the square root: $r = \\sqrt{\\frac{A}{\\pi}}$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $t$ the subject of $v = u + at$.",
      "options": [
        {"id": "a", "text": "$t = v - u - a$"},
        {"id": "b", "text": "$t = \\frac{v - u}{a}$"},
        {"id": "c", "text": "$t = \\frac{v + u}{a}$"},
        {"id": "d", "text": "$t = a(v - u)$"}
      ],
      "correctAnswer": "b",
      "explanation": "Subtract $u$: $v - u = at$. Divide by $a$: $t = \\frac{v - u}{a}$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $b$ the subject of $P = 2a + 2b$.",
      "options": [
        {"id": "a", "text": "$b = P - 2a$"},
        {"id": "b", "text": "$b = \\frac{P - 2a}{2}$"},
        {"id": "c", "text": "$b = \\frac{P}{2} - a$"},
        {"id": "d", "text": "Both (b) and (c)"}
      ],
      "correctAnswer": "d",
      "explanation": "Subtract $2a$: $P - 2a = 2b$. Divide by 2: $b = \\frac{P - 2a}{2}$. This is equivalent to $b = \\frac{P}{2} - a$. Both forms are correct."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $x$ the subject of $y = \\frac{x + 3}{4}$.",
      "options": [
        {"id": "a", "text": "$x = 4y + 3$"},
        {"id": "b", "text": "$x = 4y - 3$"},
        {"id": "c", "text": "$x = \\frac{y - 3}{4}$"},
        {"id": "d", "text": "$x = 4(y - 3)$"}
      ],
      "correctAnswer": "b",
      "explanation": "Multiply by 4: $4y = x + 3$. Subtract 3: $x = 4y - 3$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The formula for the circumference of a circle is $C = 2\\pi r$. Make $r$ the subject.",
      "options": [
        {"id": "a", "text": "$r = C - 2\\pi$"},
        {"id": "b", "text": "$r = \\frac{2\\pi}{C}$"},
        {"id": "c", "text": "$r = \\frac{C}{2\\pi}$"},
        {"id": "d", "text": "$r = 2\\pi C$"}
      ],
      "correctAnswer": "c",
      "explanation": "Divide both sides by $2\\pi$: $r = \\frac{C}{2\\pi}$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $h$ the subject of $V = \\frac{1}{3}\\pi r^2 h$.",
      "options": [
        {"id": "a", "text": "$h = \\frac{V}{3\\pi r^2}$"},
        {"id": "b", "text": "$h = \\frac{3V}{\\pi r^2}$"},
        {"id": "c", "text": "$h = \\frac{V\\pi r^2}{3}$"},
        {"id": "d", "text": "$h = 3V - \\pi r^2$"}
      ],
      "correctAnswer": "b",
      "explanation": "Multiply both sides by 3: $3V = \\pi r^2 h$. Divide by $\\pi r^2$: $h = \\frac{3V}{\\pi r^2}$."
    }
  ]
}
