{
  "id": "quiz-negative-numbers",
  "title": "Quiz: Negative Numbers",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which of the following is the correct order from smallest to largest?",
      "options": [
        {"id": "a", "text": "$-2, -7, 0, 3, 5$"},
        {"id": "b", "text": "$-7, -2, 0, 3, 5$"},
        {"id": "c", "text": "$0, -2, -7, 3, 5$"},
        {"id": "d", "text": "$5, 3, 0, -2, -7$"}
      ],
      "correctAnswer": "b",
      "explanation": "On a number line, numbers increase from left to right. $-7$ is furthest left (smallest), then $-2$, then $0$, then $3$, then $5$ (largest)."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $-3 - (-7)$?",
      "options": [
        {"id": "a", "text": "$-10$"},
        {"id": "b", "text": "$-4$"},
        {"id": "c", "text": "$4$"},
        {"id": "d", "text": "$10$"}
      ],
      "correctAnswer": "c",
      "explanation": "Subtracting a negative becomes adding a positive: $-3 - (-7) = -3 + 7 = 4$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $(-5) \\times (-6)$?",
      "options": [
        {"id": "a", "text": "$-30$"},
        {"id": "b", "text": "$30$"},
        {"id": "c", "text": "$-11$"},
        {"id": "d", "text": "$11$"}
      ],
      "correctAnswer": "b",
      "explanation": "When multiplying two numbers with the same sign (both negative), the result is positive. $(-5) \\times (-6) = 30$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $(-2)^3$?",
      "options": [
        {"id": "a", "text": "$8$"},
        {"id": "b", "text": "$-8$"},
        {"id": "c", "text": "$6$"},
        {"id": "d", "text": "$-6$"}
      ],
      "correctAnswer": "b",
      "explanation": "$(-2)^3 = (-2) \\times (-2) \\times (-2) = 4 \\times (-2) = -8$. An odd power of a negative number gives a negative result."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The temperature is $-3°C$ and it falls by $7°C$. What is the new temperature?",
      "options": [
        {"id": "a", "text": "$4°C$"},
        {"id": "b", "text": "$-4°C$"},
        {"id": "c", "text": "$10°C$"},
        {"id": "d", "text": "$-10°C$"}
      ],
      "correctAnswer": "d",
      "explanation": "Starting at $-3°C$ and falling by $7°C$ means subtracting: $-3 - 7 = -10°C$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $\\frac{-15 + 3}{-2 - 4}$?",
      "options": [
        {"id": "a", "text": "$-2$"},
        {"id": "b", "text": "$2$"},
        {"id": "c", "text": "$-3$"},
        {"id": "d", "text": "$3$"}
      ],
      "correctAnswer": "b",
      "explanation": "The numerator is $-15 + 3 = -12$. The denominator is $-2 - 4 = -6$. So $\\frac{-12}{-6} = 2$ (same signs give a positive result)."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the difference between $(-3)^2$ and $-3^2$?",
      "options": [
        {"id": "a", "text": "They are both equal to $9$"},
        {"id": "b", "text": "They are both equal to $-9$"},
        {"id": "c", "text": "$(-3)^2 = 9$ and $-3^2 = -9$"},
        {"id": "d", "text": "$(-3)^2 = -9$ and $-3^2 = 9$"}
      ],
      "correctAnswer": "c",
      "explanation": "$(-3)^2$ means $(-3) \\times (-3) = 9$ (squaring the negative number). But $-3^2$ means $-(3^2) = -9$ (the negative sign is not squared)."
    }
  ]
}
