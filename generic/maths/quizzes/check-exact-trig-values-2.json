  "title": "Check: Exact Trigonometric Values",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the exact value of $\\sin 45°$?",
      "options": [
        { "id": "a", "text": "$\\frac{1}{2}$" },
        { "id": "b", "text": "$\\frac{\\sqrt{2}}{2}$" },
        { "id": "c", "text": "$1$" },
        { "id": "d", "text": "$\\frac{\\sqrt{3}}{2}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$\\sin 45° = \\frac{\\sqrt{2}}{2} = \\frac{1}{\\sqrt{2}}$. This comes from the isosceles right-angled triangle with legs of length 1 and hypotenuse $\\sqrt{2}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Calculate the exact value of $\\sin 30° \\times \\tan 60°$.",
      "options": [
        { "id": "a", "text": "$\\frac{1}{2}$" },
        { "id": "b", "text": "$\\frac{\\sqrt{3}}{2}$" },
        { "id": "c", "text": "$\\frac{3}{2}$" },
        { "id": "d", "text": "$\\sqrt{3}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$\\sin 30° \\times \\tan 60° = \\frac{1}{2} \\times \\sqrt{3} = \\frac{\\sqrt{3}}{2}$."
    }
  ]
