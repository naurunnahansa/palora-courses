{
  "id": "check-equation-of-straight-line-2",
  "title": "Check: Equation of a Straight Line",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A line has equation $3x + 2y = 12$. What is the gradient of this line?",
      "options": [
        { "id": "a", "text": "$3$" },
        { "id": "b", "text": "$-\\frac{3}{2}$" },
        { "id": "c", "text": "$\\frac{3}{2}$" },
        { "id": "d", "text": "$-3$" }
      ],
      "correctAnswer": "b",
      "explanation": "Rearranging to $y = mx + c$: $2y = -3x + 12$, so $y = -\\frac{3}{2}x + 6$. The gradient is $-\\frac{3}{2}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Write the equation of the line with gradient $\\frac{1}{2}$ that passes through $(4, 5)$.",
      "options": [
        { "id": "a", "text": "$y = \\frac{1}{2}x + 5$" },
        { "id": "b", "text": "$y = \\frac{1}{2}x + 3$" },
        { "id": "c", "text": "$y = 2x + 5$" },
        { "id": "d", "text": "$y = \\frac{1}{2}x - 3$" }
      ],
      "correctAnswer": "b",
      "explanation": "Using $y - y_1 = m(x - x_1)$: $y - 5 = \\frac{1}{2}(x - 4)$, so $y = \\frac{1}{2}x - 2 + 5 = \\frac{1}{2}x + 3$."
    }
  ]
}
