{
  "id": "check-surds-2",
  "title": "Check: Surds",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Rationalise the denominator of $\\frac{6}{\\sqrt{3}}$.",
      "options": [
        { "id": "a", "text": "$\\frac{6\\sqrt{3}}{3}$" },
        { "id": "b", "text": "$2\\sqrt{3}$" },
        { "id": "c", "text": "$\\frac{\\sqrt{3}}{6}$" },
        { "id": "d", "text": "$6\\sqrt{3}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$\\frac{6}{\\sqrt{3}} = \\frac{6}{\\sqrt{3}} \\times \\frac{\\sqrt{3}}{\\sqrt{3}} = \\frac{6\\sqrt{3}}{3} = 2\\sqrt{3}$. Options (a) and (b) are equivalent but $2\\sqrt{3}$ is the simplified form."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Expand and simplify $(3 + \\sqrt{5})(3 - \\sqrt{5})$.",
      "options": [
        { "id": "a", "text": "$4$" },
        { "id": "b", "text": "$9 - 5$" },
        { "id": "c", "text": "$14$" },
        { "id": "d", "text": "$9 + 2\\sqrt{5}$" }
      ],
      "correctAnswer": "a",
      "explanation": "Using the difference of two squares: $(3 + \\sqrt{5})(3 - \\sqrt{5}) = 3^2 - (\\sqrt{5})^2 = 9 - 5 = 4$. Note option (b) shows the working but $4$ is the simplified answer."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Rationalise the denominator of $\\frac{1}{2 + \\sqrt{3}}$.",
      "options": [
        { "id": "a", "text": "$2 + \\sqrt{3}$" },
        { "id": "b", "text": "$2 - \\sqrt{3}$" },
        { "id": "c", "text": "$\\frac{2 + \\sqrt{3}}{7}$" },
        { "id": "d", "text": "$\\frac{2 - \\sqrt{3}}{7}$" }
      ],
      "correctAnswer": "b",
      "explanation": "Multiply by the conjugate: $\\frac{1}{2 + \\sqrt{3}} \\times \\frac{2 - \\sqrt{3}}{2 - \\sqrt{3}} = \\frac{2 - \\sqrt{3}}{4 - 3} = \\frac{2 - \\sqrt{3}}{1} = 2 - \\sqrt{3}$."
    }
  ]
}
