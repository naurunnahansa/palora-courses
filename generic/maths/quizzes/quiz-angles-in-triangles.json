    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Two angles in a triangle are $(2x + 10)°$ and $(3x - 5)°$. The third angle is $50°$. What is $x$?",
      "options": [
        {
          "id": "a",
          "text": "$30$"
        },
        {
          "id": "b",
          "text": "$25$"
        },
        {
          "id": "c",
          "text": "$20$"
        },
        {
          "id": "d",
          "text": "$35$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$(2x + 10) + (3x - 5) + 50 = 180$, so $5x + 55 = 180$, giving $5x = 125$ and $x = 25$."
    }
  ]
