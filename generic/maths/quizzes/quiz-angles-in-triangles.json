{
  "id": "quiz-angles-in-triangles",
  "title": "Quiz: Angles in Triangles",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A triangle has angles of $70°$ and $55°$. What is the third angle?",
      "options": [
        {
          "id": "a",
          "text": "$55°$"
        },
        {
          "id": "b",
          "text": "$75°$"
        },
        {
          "id": "c",
          "text": "$45°$"
        },
        {
          "id": "d",
          "text": "$65°$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Angles in a triangle sum to $180°$: $180° - 70° - 55° = 55°$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "An isosceles triangle has a base angle of $65°$. What is the angle at the apex?",
      "options": [
        {
          "id": "a",
          "text": "$65°$"
        },
        {
          "id": "b",
          "text": "$115°$"
        },
        {
          "id": "c",
          "text": "$50°$"
        },
        {
          "id": "d",
          "text": "$55°$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Both base angles are $65°$, so the apex angle is $180° - 65° - 65° = 50°$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The angles of a triangle are $x$, $2x$, and $3x$. What is the largest angle?",
      "options": [
        {
          "id": "a",
          "text": "$30°$"
        },
        {
          "id": "b",
          "text": "$90°$"
        },
        {
          "id": "c",
          "text": "$60°$"
        },
        {
          "id": "d",
          "text": "$120°$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$x + 2x + 3x = 6x = 180°$, so $x = 30°$. The largest angle is $3x = 90°$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "An exterior angle of a triangle is $124°$. One of the non-adjacent interior angles is $56°$. What is the other non-adjacent interior angle?",
      "options": [
        {
          "id": "a",
          "text": "$124°$"
        },
        {
          "id": "b",
          "text": "$68°$"
        },
        {
          "id": "c",
          "text": "$56°$"
        },
        {
          "id": "d",
          "text": "$78°$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "An exterior angle equals the sum of the two non-adjacent interior angles: $124° - 56° = 68°$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A right-angled triangle has one angle of $38°$. What is the other non-right angle?",
      "options": [
        {
          "id": "a",
          "text": "$52°$"
        },
        {
          "id": "b",
          "text": "$42°$"
        },
        {
          "id": "c",
          "text": "$48°$"
        },
        {
          "id": "d",
          "text": "$62°$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "The three angles sum to $180°$: $180° - 90° - 38° = 52°$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Each angle of an equilateral triangle measures:",
