      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A house was bought for $£200,\\!000$ and sold for $£230,\\!000$. What is the percentage profit?",
      "options": [
        {
          "id": "a",
          "text": "$13\\%$"
        },
        {
          "id": "b",
          "text": "$30\\%$"
        },
        {
          "id": "c",
          "text": "$87\\%$"
        },
        {
          "id": "d",
          "text": "$15\\%$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Profit $= £230,\\!000 - £200,\\!000 = £30,\\!000$. Percentage profit $= \\frac{30,\\!000}{200,\\!000} \\times 100 = 15\\%$."
    }
  ]
