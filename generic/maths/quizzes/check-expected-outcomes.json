      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A bag contains $4$ red and $6$ blue counters. A counter is picked at random and replaced. This is done $80$ times. How many times would you expect to pick red?",
      "options": [
        { "id": "a", "text": "$4$" },
        { "id": "b", "text": "$32$" },
        { "id": "c", "text": "$40$" },
        { "id": "d", "text": "$48$" }
      ],
      "correctAnswer": "b",
      "explanation": "$P(\\text{red}) = \\frac{4}{10} = 0.4$. Expected number $= 80 \\times 0.4 = 32$."
    }
