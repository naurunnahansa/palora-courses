{
  "id": "quiz-volume-spheres",
  "title": "Quiz: Volume of Spheres",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The formula for the volume of a sphere is:",
      "options": [
        {
          "id": "a",
          "text": "$4\\pi r^2$"
        },
        {
          "id": "b",
          "text": "$\\frac{4}{3}\\pi r^3$"
        },
        {
          "id": "c",
          "text": "$\\pi r^3$"
        },
        {
          "id": "d",
          "text": "$\\frac{2}{3}\\pi r^3$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "The volume of a sphere is $\\frac{4}{3}\\pi r^3$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A sphere has radius $3$ cm. What is its volume in terms of $\\pi$?",
      "options": [
        {
          "id": "a",
          "text": "$108\\pi$ cm$^3$"
        },
        {
          "id": "b",
          "text": "$27\\pi$ cm$^3$"
        },
        {
          "id": "c",
          "text": "$12\\pi$ cm$^3$"
        },
        {
          "id": "d",
          "text": "$36\\pi$ cm$^3$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Volume $= \\frac{4}{3}\\pi(3)^3 = \\frac{4}{3}\\pi(27) = 36\\pi$ cm$^3$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A sphere has a diameter of $10$ cm. What is its volume to $1$ decimal place? (Use $\\pi = 3.14$)",
      "options": [
        {
          "id": "a",
          "text": "$523.3$ cm$^3$"
        },
        {
          "id": "b",
          "text": "$4186.7$ cm$^3$"
        },
        {
          "id": "c",
          "text": "$314.0$ cm$^3$"
        },
        {
          "id": "d",
          "text": "$1046.7$ cm$^3$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Radius $= 5$ cm. Volume $= \\frac{4}{3} \\times 3.14 \\times 125 = \\frac{1570}{3} = 523.3$ cm$^3$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A hemisphere has radius $6$ cm. What is its volume in terms of $\\pi$?",
      "options": [
        {
          "id": "a",
          "text": "$288\\pi$ cm$^3$"
        },
        {
          "id": "b",
          "text": "$144\\pi$ cm$^3$"
        },
        {
          "id": "c",
          "text": "$36\\pi$ cm$^3$"
        },
        {
          "id": "d",
          "text": "$72\\pi$ cm$^3$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Hemisphere volume $= \\frac{1}{2} \\times \\frac{4}{3}\\pi r^3 = \\frac{2}{3}\\pi(216) = 144\\pi$ cm$^3$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A sphere has a volume of $\\frac{256}{3}\\pi$ cm$^3$. What is its radius?",
      "options": [
        {
          "id": "a",
          "text": "$8$ cm"
        },
        {
          "id": "b",
          "text": "$16$ cm"
        },
        {
          "id": "c",
          "text": "$6$ cm"
        },
        {
          "id": "d",
          "text": "$4$ cm"
        }
      ],
      "correctAnswer": "d",
      "explanation": "$\\frac{4}{3}\\pi r^3 = \\frac{256}{3}\\pi$. So $4r^3 = 256$, giving $r^3 = 64$ and $r = 4$ cm."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If the radius of a sphere is doubled, its volume is multiplied by:",
      "options": [
        {
          "id": "a",
          "text": "$8$"
        },
        {
          "id": "b",
          "text": "$2$"
        },
        {
          "id": "c",
          "text": "$16$"
        },
        {
          "id": "d",
          "text": "$4$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Volume $\\propto r^3$. Doubling $r$ gives $(2r)^3 = 8r^3$, so the volume is multiplied by $8$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A ball has a volume of $904.3$ cm$^3$. What is its radius to the nearest whole number? (Use $\\pi = 3.14$)",
      "options": [
        {
          "id": "a",
          "text": "$7$ cm"
        },
        {
          "id": "b",
          "text": "$8$ cm"
        },
        {
          "id": "c",
          "text": "$6$ cm"
        },
        {
          "id": "d",
          "text": "$5$ cm"
        }
      ],
      "correctAnswer": "c",
      "explanation": "$r^3 = \\frac{3 \\times 904.3}{4 \\times 3.14} = \\frac{2712.9}{12.56} = 215.9$. $r = \\sqrt[3]{215.9} \\approx 6$ cm."
    }
  ]
}
