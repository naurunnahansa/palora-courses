{
  "id": "check-parallel-perpendicular-lines-b",
  "title": "Check: Parallel and Perpendicular Lines (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A line has gradient $4$. What is the gradient of a line perpendicular to it?",
      "options": [
        {
          "id": "a",
          "text": "$-4$"
        },
        {
          "id": "b",
          "text": "$\\frac{1}{4}$"
        },
        {
          "id": "c",
          "text": "$-\\frac{1}{4}$"
        },
        {
          "id": "d",
          "text": "$4$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Perpendicular lines have gradients that are negative reciprocals: $m_1 \\times m_2 = -1$. So $m_2 = -\\frac{1}{4}$."
    }
  ]
}