  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the $y$-intercept of the line $y = 5x - 3$?",
      "options": [
        {
          "id": "a",
          "text": "3"
        },
        {
          "id": "b",
          "text": "$-5$"
        },
        {
          "id": "c",
          "text": "5"
        },
        {
          "id": "d",
          "text": "$-3$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "In $y = mx + c$, the $y$-intercept is $c$. Here $c = -3$, so the line crosses the $y$-axis at $(0, -3)$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Find the $y$-intercept of the line $3x + 2y = 12$.",
      "options": [
        {
          "id": "a",
          "text": "3"
        },
        {
          "id": "b",
          "text": "12"
        },
        {
          "id": "c",
          "text": "4"
        },
        {
          "id": "d",
          "text": "6"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Substitute $x = 0$: $3(0) + 2y = 12$, so $2y = 12$ and $y = 6$. The $y$-intercept is 6."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
