  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $x^2 - x - 12 = 0$.",
      "options": [
        { "id": "a", "text": "$x = 3$ or $x = -4$" },
        { "id": "b", "text": "$x = -3$ or $x = 4$" },
        { "id": "c", "text": "$x = 6$ or $x = -2$" },
        { "id": "d", "text": "$x = -6$ or $x = 2$" }
      ],
      "correctAnswer": "b",
      "explanation": "Factorise: $(x - 4)(x + 3) = 0$. So $x = 4$ or $x = -3$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $2x^2 + 7x + 3 = 0$.",
      "options": [
        { "id": "a", "text": "$x = -3$ or $x = -\\frac{1}{2}$" },
        { "id": "b", "text": "$x = 3$ or $x = \\frac{1}{2}$" },
        { "id": "c", "text": "$x = -3$ or $x = \\frac{1}{2}$" },
        { "id": "d", "text": "$x = 3$ or $x = -\\frac{1}{2}$" }
      ],
      "correctAnswer": "a",
      "explanation": "Factorise: $(2x + 1)(x + 3) = 0$. So $2x + 1 = 0$ gives $x = -\\frac{1}{2}$, and $x + 3 = 0$ gives $x = -3$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $x^2 = 5x$.",
      "options": [
        { "id": "a", "text": "$x = 5$ only" },
        { "id": "b", "text": "$x = 0$ or $x = 5$" },
        { "id": "c", "text": "$x = 0$ or $x = -5$" },
        { "id": "d", "text": "$x = \\sqrt{5}$" }
      ],
      "correctAnswer": "b",
      "explanation": "Rearrange to $x^2 - 5x = 0$. Factorise: $x(x - 5) = 0$. So $x = 0$ or $x = 5$. Do not divide both sides by $x$ as you would lose the $x = 0$ solution."
    }
  ]
}
