  "title": "Check: Factorising Harder Quadratics",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Factorise $2x^2 + 5x + 3$.",
      "options": [
        { "id": "a", "text": "$(2x + 1)(x + 3)$" },
        { "id": "b", "text": "$(2x + 3)(x + 1)$" },
        { "id": "c", "text": "$(2x - 1)(x - 3)$" },
        { "id": "d", "text": "$(x + 1)(x + 3)$" }
      ],
      "correctAnswer": "b",
      "explanation": "For $2x^2 + 5x + 3$, we need factors of $2 \\times 3 = 6$ that add to $5$: these are $2$ and $3$. Splitting: $2x^2 + 2x + 3x + 3 = 2x(x+1) + 3(x+1) = (2x+3)(x+1)$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Factorise $3x^2 - 11x - 4$.",
      "options": [
        { "id": "a", "text": "$(3x - 1)(x + 4)$" },
        { "id": "b", "text": "$(3x + 4)(x - 1)$" },
        { "id": "c", "text": "$(3x + 1)(x - 4)$" },
        { "id": "d", "text": "$(3x - 4)(x + 1)$" }
      ],
      "correctAnswer": "c",
      "explanation": "We need factors of $3 \\times (-4) = -12$ that add to $-11$: these are $+1$ and $-12$. Splitting: $3x^2 + x - 12x - 4 = x(3x+1) - 4(3x+1) = (3x+1)(x-4)$."
    }
  ]
}
