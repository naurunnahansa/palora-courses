{
  "id": "quiz-trigonometric-ratios",
  "title": "Quiz: Trigonometric Ratios",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, $\\sin \\theta$ is defined as:",
      "options": [
        {"id": "a", "text": "$\\frac{\\text{adjacent}}{\\text{hypotenuse}}$"},
        {"id": "b", "text": "$\\frac{\\text{opposite}}{\\text{hypotenuse}}$"},
        {"id": "c", "text": "$\\frac{\\text{opposite}}{\\text{adjacent}}$"},
        {"id": "d", "text": "$\\frac{\\text{hypotenuse}}{\\text{opposite}}$"}
      ],
      "correctAnswer": "b",
      "explanation": "$\\sin \\theta = \\frac{\\text{opposite}}{\\text{hypotenuse}}$ (the 'SOH' in SOHCAHTOA)."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "$\\cos \\theta$ is defined as:",
      "options": [
        {"id": "a", "text": "$\\frac{\\text{adjacent}}{\\text{hypotenuse}}$"},
        {"id": "b", "text": "$\\frac{\\text{opposite}}{\\text{hypotenuse}}$"},
        {"id": "c", "text": "$\\frac{\\text{opposite}}{\\text{adjacent}}$"},
        {"id": "d", "text": "$\\frac{\\text{hypotenuse}}{\\text{adjacent}}$"}
      ],
      "correctAnswer": "a",
      "explanation": "$\\cos \\theta = \\frac{\\text{adjacent}}{\\text{hypotenuse}}$ (the 'CAH' in SOHCAHTOA)."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "$\\tan \\theta$ is defined as:",
      "options": [
        {"id": "a", "text": "$\\frac{\\text{adjacent}}{\\text{opposite}}$"},
        {"id": "b", "text": "$\\frac{\\text{hypotenuse}}{\\text{opposite}}$"},
        {"id": "c", "text": "$\\frac{\\text{opposite}}{\\text{adjacent}}$"},
        {"id": "d", "text": "$\\frac{\\text{adjacent}}{\\text{hypotenuse}}$"}
      ],
      "correctAnswer": "c",
      "explanation": "$\\tan \\theta = \\frac{\\text{opposite}}{\\text{adjacent}}$ (the 'TOA' in SOHCAHTOA)."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the side opposite the angle $\\theta$ is $4$ cm and the hypotenuse is $5$ cm. What is $\\sin \\theta$?",
      "options": [
        {"id": "a", "text": "$\\frac{3}{5}$"},
        {"id": "b", "text": "$\\frac{4}{5}$"},
        {"id": "c", "text": "$\\frac{4}{3}$"},
        {"id": "d", "text": "$\\frac{5}{4}$"}
      ],
      "correctAnswer": "b",
      "explanation": "$\\sin \\theta = \\frac{\\text{opposite}}{\\text{hypotenuse}} = \\frac{4}{5}$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The mnemonic SOHCAHTOA helps you remember:",
      "options": [
        {"id": "a", "text": "The three types of triangles"},
        {"id": "b", "text": "The angle sum properties"},
        {"id": "c", "text": "The definitions of $\\sin$, $\\cos$, and $\\tan$"},
        {"id": "d", "text": "Pythagoras' Theorem"}
      ],
      "correctAnswer": "c",
      "explanation": "SOHCAHTOA stands for: Sin = Opposite/Hypotenuse, Cos = Adjacent/Hypotenuse, Tan = Opposite/Adjacent."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle with angle $\\theta$, the adjacent side is $12$ cm and the opposite side is $5$ cm. What is $\\tan \\theta$?",
      "options": [
        {"id": "a", "text": "$\\frac{5}{13}$"},
        {"id": "b", "text": "$\\frac{12}{13}$"},
        {"id": "c", "text": "$\\frac{5}{12}$"},
        {"id": "d", "text": "$\\frac{12}{5}$"}
      ],
      "correctAnswer": "c",
      "explanation": "$\\tan \\theta = \\frac{\\text{opposite}}{\\text{adjacent}} = \\frac{5}{12}$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which trigonometric ratio would you use if you know the opposite side and need to find the hypotenuse?",
      "options": [
        {"id": "a", "text": "$\\tan$"},
        {"id": "b", "text": "$\\cos$"},
        {"id": "c", "text": "$\\sin$"},
        {"id": "d", "text": "Pythagoras"}
      ],
      "correctAnswer": "c",
      "explanation": "$\\sin \\theta = \\frac{\\text{opposite}}{\\text{hypotenuse}}$ involves both the opposite side and the hypotenuse."
    }
  ]
}
