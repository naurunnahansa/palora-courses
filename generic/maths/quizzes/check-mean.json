  "title": "Check: Mean",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The data set is $3, 7, 5, 9, 6$. What is the mean?",
      "options": [
        { "id": "a", "text": "$5$" },
        { "id": "b", "text": "$6$" },
        { "id": "c", "text": "$7$" },
        { "id": "d", "text": "$30$" }
      ],
      "correctAnswer": "b",
      "explanation": "Mean $= \\frac{3 + 7 + 5 + 9 + 6}{5} = \\frac{30}{5} = 6$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The mean of $5$ numbers is $8$. What is the total of the $5$ numbers?",
      "options": [
        { "id": "a", "text": "$5$" },
        { "id": "b", "text": "$8$" },
        { "id": "c", "text": "$13$" },
        { "id": "d", "text": "$40$" }
      ],
      "correctAnswer": "d",
      "explanation": "Total $= \\text{mean} \\times \\text{number of values} = 8 \\times 5 = 40$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A data set has a mean of $10$. A new value of $10$ is added. What happens to the mean?",
      "options": [
        { "id": "a", "text": "It increases" },
        { "id": "b", "text": "It decreases" },
        { "id": "c", "text": "It stays the same" },
        { "id": "d", "text": "It depends on the other values" }
      ],
      "correctAnswer": "c",
      "explanation": "Adding a value equal to the current mean does not change the mean. The new total and new count increase proportionally."
    }
  ]
}