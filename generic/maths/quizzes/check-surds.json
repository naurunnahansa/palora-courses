  "title": "Check: Surds",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\sqrt{50}$.",
      "options": [
        { "id": "a", "text": "$2\\sqrt{25}$" },
        { "id": "b", "text": "$5\\sqrt{2}$" },
        { "id": "c", "text": "$25\\sqrt{2}$" },
        { "id": "d", "text": "$10\\sqrt{5}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$\\sqrt{50} = \\sqrt{25 \\times 2} = \\sqrt{25} \\times \\sqrt{2} = 5\\sqrt{2}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\sqrt{3} \\times \\sqrt{12}$.",
      "options": [
        { "id": "a", "text": "$\\sqrt{15}$" },
        { "id": "b", "text": "$6$" },
        { "id": "c", "text": "$4\\sqrt{3}$" },
        { "id": "d", "text": "$\\sqrt{36}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$\\sqrt{3} \\times \\sqrt{12} = \\sqrt{3 \\times 12} = \\sqrt{36} = 6$. Note that options (b) and (d) are equivalent, but $6$ is the fully simplified form."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which of these is a surd?",
      "options": [
        { "id": "a", "text": "$\\sqrt{16}$" },
        { "id": "b", "text": "$\\sqrt[3]{8}$" },
        { "id": "c", "text": "$\\sqrt{7}$" },
        { "id": "d", "text": "$\\sqrt{0.25}$" }
      ],
      "correctAnswer": "c",
      "explanation": "A surd is an irrational root. $\\sqrt{16} = 4$, $\\sqrt[3]{8} = 2$, and $\\sqrt{0.25} = 0.5$ are all rational. $\\sqrt{7}$ is irrational and therefore a surd."
    }
  ]
