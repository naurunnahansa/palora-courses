  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "For y = x^2 - 4x + 3, what is the value of y when x = 5?",
      "options": [
        { "id": "a", "text": "8" },
        { "id": "b", "text": "3" },
        { "id": "c", "text": "48" },
        { "id": "d", "text": "-2" }
      ],
      "correctAnswer": "a",
      "explanation": "y = 25 - 20 + 3 = 8."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "The graph of y = x^2 - 6x + 8 crosses the x-axis at which points?",
      "options": [
        { "id": "a", "text": "(2, 0) and (4, 0)" },
        { "id": "b", "text": "(-2, 0) and (-4, 0)" },
        { "id": "c", "text": "(1, 0) and (8, 0)" },
        { "id": "d", "text": "(3, 0) only" }
      ],
      "correctAnswer": "a",
      "explanation": "Set y = 0: x^2 - 6x + 8 = 0. (x - 2)(x - 4) = 0. x = 2 or x = 4."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Which of these equations produces a U-shaped parabola?",
      "options": [
        { "id": "a", "text": "y = -x^2 + 3" },
        { "id": "b", "text": "y = -2x^2 + x" },
        { "id": "c", "text": "y = 3x^2 - 5x + 1" },
        { "id": "d", "text": "y = -(x - 1)^2" }
      ],
      "correctAnswer": "c",
      "explanation": "A U-shape (opening upward) occurs when the coefficient of x^2 is positive. Only y = 3x^2 - 5x + 1 has a positive x^2 coefficient (3). The others have negative coefficients, producing an inverted U."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "For y = x^2 - 2x - 3, what is the y-intercept?",
      "options": [
        { "id": "a", "text": "(0, -2)" },
        { "id": "b", "text": "(0, -3)" },
        { "id": "c", "text": "(0, 3)" },
        { "id": "d", "text": "(0, -1)" }
      ],
      "correctAnswer": "b",
      "explanation": "The y-intercept is found by setting x = 0: y = 0 - 0 - 3 = -3. The y-intercept is (0, -3)."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A ball is thrown and its height h metres after t seconds is h = -5t^2 + 20t. What is the maximum height?",
      "options": [
        { "id": "a", "text": "20 m" },
        { "id": "b", "text": "15 m" },
        { "id": "c", "text": "25 m" },
        { "id": "d", "text": "10 m" }
      ],
      "correctAnswer": "a",
      "explanation": "h = -5t^2 + 20t = -5(t^2 - 4t) = -5(t - 2)^2 + 20. Maximum height = 20 m at t = 2."
    }
  ]
