{
  "id": "check-algebraic-fractions-2",
  "title": "Check: Algebraic Fractions",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\frac{2}{x} + \\frac{3}{x+1}$.",
      "options": [
        { "id": "a", "text": "$\\frac{5}{2x+1}$" },
        { "id": "b", "text": "$\\frac{5x + 2}{x(x+1)}$" },
        { "id": "c", "text": "$\\frac{5x + 3}{x(x+1)}$" },
        { "id": "d", "text": "$\\frac{2x + 5}{x(x+1)}$" }
      ],
      "correctAnswer": "b",
      "explanation": "Common denominator is $x(x+1)$. So $\\frac{2(x+1)}{x(x+1)} + \\frac{3x}{x(x+1)} = \\frac{2x + 2 + 3x}{x(x+1)} = \\frac{5x + 2}{x(x+1)}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\frac{x^2 + 5x + 6}{x^2 + 2x}$.",
      "options": [
        { "id": "a", "text": "$\\frac{x + 3}{x}$" },
        { "id": "b", "text": "$\\frac{x + 2}{x}$" },
        { "id": "c", "text": "$\\frac{5x + 6}{2x}$" },
        { "id": "d", "text": "$\\frac{x + 3}{x + 2}$" }
      ],
      "correctAnswer": "a",
      "explanation": "Factorise: $\\frac{(x+2)(x+3)}{x(x+2)}$. Cancel the common factor $(x+2)$: $\\frac{x+3}{x}$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\frac{3x}{4} \\times \\frac{8}{x^2}$.",
      "options": [
        { "id": "a", "text": "$\\frac{24}{4x^2}$" },
        { "id": "b", "text": "$\\frac{6}{x}$" },
        { "id": "c", "text": "$\\frac{24x}{4x^2}$" },
        { "id": "d", "text": "$6x$" }
      ],
      "correctAnswer": "b",
      "explanation": "Multiply numerators and denominators: $\\frac{3x \\times 8}{4 \\times x^2} = \\frac{24x}{4x^2} = \\frac{6}{x}$."
    }
  ]
}
