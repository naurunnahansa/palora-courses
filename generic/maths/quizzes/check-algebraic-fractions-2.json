  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\frac{2}{x} + \\frac{3}{x+1}$.",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{5}{2x+1}$"
        },
        {
          "id": "b",
          "text": "$\\frac{5x + 2}{x(x+1)}$"
        },
        {
          "id": "c",
          "text": "$\\frac{5x + 3}{x(x+1)}$"
        },
        {
          "id": "d",
          "text": "$\\frac{2x + 5}{x(x+1)}$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Common denominator is $x(x+1)$. So $\\frac{2(x+1)}{x(x+1)} + \\frac{3x}{x(x+1)} = \\frac{2x + 2 + 3x}{x(x+1)} = \\frac{5x + 2}{x(x+1)}$."
    }
  ]
