  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Factorise $6x + 9$.",
      "options": [
        { "id": "a", "text": "$6(x + 9)$" },
        { "id": "b", "text": "$3(2x + 3)$" },
        { "id": "c", "text": "$3(2x + 9)$" },
        { "id": "d", "text": "$2(3x + 9)$" }
      ],
      "correctAnswer": "b",
      "explanation": "The highest common factor of $6$ and $9$ is $3$. Dividing each term by $3$: $6x \\div 3 = 2x$ and $9 \\div 3 = 3$, giving $3(2x + 3)$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Factorise $4x^2 - 10x$.",
      "options": [
        { "id": "a", "text": "$2(2x^2 - 5x)$" },
        { "id": "b", "text": "$x(4x - 10)$" },
        { "id": "c", "text": "$2x(2x - 5)$" },
        { "id": "d", "text": "$4x(x - 10)$" }
      ],
      "correctAnswer": "c",
      "explanation": "The HCF of $4x^2$ and $10x$ is $2x$. Dividing: $4x^2 \\div 2x = 2x$ and $-10x \\div 2x = -5$, giving $2x(2x - 5)$."
    }
  ]
