{
  "id": "check-finding-sides-trig-2",
  "title": "Check: Finding Sides Using Trigonometry",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, an angle is $50°$ and the opposite side is $8\\text{ cm}$. What is the hypotenuse? Round to 1 decimal place.",
      "options": [
        { "id": "a", "text": "$10.4\\text{ cm}$" },
        { "id": "b", "text": "$6.1\\text{ cm}$" },
        { "id": "c", "text": "$12.4\\text{ cm}$" },
        { "id": "d", "text": "$9.5\\text{ cm}$" }
      ],
      "correctAnswer": "a",
      "explanation": "$\\sin 50° = \\frac{8}{\\text{hyp}}$, so hyp $= \\frac{8}{\\sin 50°} = \\frac{8}{0.766} \\approx 10.4\\text{ cm}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the hypotenuse is $15\\text{ cm}$ and one angle is $65°$. What is the length of the side adjacent to the $65°$ angle? Round to 1 decimal place.",
      "options": [
        { "id": "a", "text": "$13.6\\text{ cm}$" },
        { "id": "b", "text": "$6.3\\text{ cm}$" },
        { "id": "c", "text": "$32.2\\text{ cm}$" },
        { "id": "d", "text": "$7.0\\text{ cm}$" }
      ],
      "correctAnswer": "b",
      "explanation": "Adjacent $= \\text{hyp} \\times \\cos 65° = 15 \\times 0.4226 \\approx 6.3\\text{ cm}$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "You know an angle and the opposite side of a right-angled triangle. To find the adjacent side, you should use:",
      "options": [
        { "id": "a", "text": "$\\sin$" },
        { "id": "b", "text": "$\\cos$" },
        { "id": "c", "text": "$\\tan$" },
        { "id": "d", "text": "Pythagoras' theorem only" }
      ],
      "correctAnswer": "c",
      "explanation": "$\\tan\\theta = \\frac{\\text{opposite}}{\\text{adjacent}}$, so adjacent $= \\frac{\\text{opposite}}{\\tan\\theta}$. You use $\\tan$ when you have opposite and adjacent."
    }
  ]
}