      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cuboid has a base of $6\\text{ cm} \\times 8\\text{ cm}$ and a height of $5\\text{ cm}$. What is the length of the diagonal across the base?",
      "options": [
        {
          "id": "a",
          "text": "$10\\text{ cm}$"
        },
        {
          "id": "b",
          "text": "$14\\text{ cm}$"
        },
        {
          "id": "c",
          "text": "$\\sqrt{125}\\text{ cm}$"
        },
        {
          "id": "d",
          "text": "$7\\text{ cm}$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Base diagonal $= \\sqrt{6^2 + 8^2} = \\sqrt{36 + 64} = \\sqrt{100} = 10\\text{ cm}$."
    }
