{
  "id": "check-negative-fractional-enlargements-c",
  "title": "Check: Negative and Fractional Enlargements (C)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A point $(6, 4)$ is enlarged by scale factor $-1$ from the centre $(2, 2)$. What is the image?",
      "options": [
        {
          "id": "a",
          "text": "$(0, 0)$"
        },
        {
          "id": "b",
          "text": "$(-2, 0)$"
        },
        {
          "id": "c",
          "text": "$(2, 2)$"
        },
        {
          "id": "d",
          "text": "$(-6, -4)$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Displacement from centre: $(6-2, 4-2) = (4, 2)$. Multiply by $-1$: $(-4, -2)$. Add centre: $(2-4, 2-2) = (-2, 0)$."
    }
  ]
}
