  "title": "Check: Angles of Elevation and Depression (C)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A drone hovers at a height of $80\\text{ m}$ above the ground. The angle of depression to a car is $40°$. How far is the car from the point directly below the drone? Round to the nearest metre.",
      "options": [
        {
          "id": "a",
          "text": "$67\\text{ m}$"
        },
        {
          "id": "b",
          "text": "$95\\text{ m}$"
        },
        {
          "id": "c",
          "text": "$105\\text{ m}$"
        },
        {
          "id": "d",
          "text": "$51\\text{ m}$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$\\tan 40° = \\frac{80}{d}$, so $d = \\frac{80}{\\tan 40°} = \\frac{80}{0.8391} \\approx 95\\text{ m}$."
    }
  ]
}