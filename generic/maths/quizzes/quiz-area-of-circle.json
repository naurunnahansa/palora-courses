{
  "id": "quiz-area-of-circle",
  "title": "Quiz: Area of a Circle",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A circle has a radius of $6$ cm. What is its area in terms of $\\pi$?",
      "options": [
        {"id": "a", "text": "$6\\pi$ cm$^2$"},
        {"id": "b", "text": "$12\\pi$ cm$^2$"},
        {"id": "c", "text": "$36\\pi$ cm$^2$"},
        {"id": "d", "text": "$144\\pi$ cm$^2$"}
      ],
      "correctAnswer": "c",
      "explanation": "Area $= \\pi r^2 = \\pi \\times 6^2 = 36\\pi$ cm$^2$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A circle has a diameter of $10$ cm. What is its area to $1$ decimal place? (Use $\\pi = 3.14$)",
      "options": [
        {"id": "a", "text": "$314.0$ cm$^2$"},
        {"id": "b", "text": "$78.5$ cm$^2$"},
        {"id": "c", "text": "$31.4$ cm$^2$"},
        {"id": "d", "text": "$157.0$ cm$^2$"}
      ],
      "correctAnswer": "b",
      "explanation": "Radius $= 5$ cm. Area $= \\pi r^2 = 3.14 \\times 25 = 78.5$ cm$^2$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A circle has an area of $49\\pi$ cm$^2$. What is its radius?",
      "options": [
        {"id": "a", "text": "$7$ cm"},
        {"id": "b", "text": "$14$ cm"},
        {"id": "c", "text": "$49$ cm"},
        {"id": "d", "text": "$24.5$ cm"}
      ],
      "correctAnswer": "a",
      "explanation": "$\\pi r^2 = 49\\pi$, so $r^2 = 49$ and $r = 7$ cm."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If the radius of a circle is tripled, the area is multiplied by:",
      "options": [
        {"id": "a", "text": "$3$"},
        {"id": "b", "text": "$6$"},
        {"id": "c", "text": "$9$"},
        {"id": "d", "text": "$27$"}
      ],
      "correctAnswer": "c",
      "explanation": "Area $= \\pi r^2$. If $r$ triples, area $= \\pi(3r)^2 = 9\\pi r^2$, which is $9$ times the original."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A circular pond has an area of $200.96$ m$^2$. What is its radius? (Use $\\pi = 3.14$)",
      "options": [
        {"id": "a", "text": "$4$ m"},
        {"id": "b", "text": "$8$ m"},
        {"id": "c", "text": "$16$ m"},
        {"id": "d", "text": "$64$ m"}
      ],
      "correctAnswer": "b",
      "explanation": "$r^2 = \\frac{200.96}{3.14} = 64$. So $r = \\sqrt{64} = 8$ m."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the area of a semicircle with diameter $12$ cm? (Give your answer in terms of $\\pi$.)",
      "options": [
        {"id": "a", "text": "$36\\pi$ cm$^2$"},
        {"id": "b", "text": "$18\\pi$ cm$^2$"},
        {"id": "c", "text": "$72\\pi$ cm$^2$"},
        {"id": "d", "text": "$6\\pi$ cm$^2$"}
      ],
      "correctAnswer": "b",
      "explanation": "Radius $= 6$ cm. Semicircle area $= \\frac{1}{2}\\pi r^2 = \\frac{1}{2} \\times \\pi \\times 36 = 18\\pi$ cm$^2$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A circular garden has a radius of $5$ m. Turf costs £$3$ per m$^2$. What is the cost to turf the garden? (Use $\\pi = 3.14$)",
      "options": [
        {"id": "a", "text": "£$47.10$"},
        {"id": "b", "text": "£$235.50$"},
        {"id": "c", "text": "£$78.50$"},
        {"id": "d", "text": "£$157.00$"}
      ],
      "correctAnswer": "b",
      "explanation": "Area $= 3.14 \\times 25 = 78.5$ m$^2$. Cost $= 78.5 \\times 3 = $ £$235.50$."
    }
  ]
}
