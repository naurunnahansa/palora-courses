{
  "id": "check-trigonometric-graphs",
  "title": "Check: Trigonometric Graphs",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the period of $y = \\sin(x)$?",
      "options": [
        { "id": "a", "text": "$180°$" },
        { "id": "b", "text": "$360°$" },
        { "id": "c", "text": "$90°$" },
        { "id": "d", "text": "$720°$" }
      ],
      "correctAnswer": "b",
      "explanation": "The sine function repeats every $360°$ (or $2\\pi$ radians). This means $\\sin(x) = \\sin(x + 360°)$ for all $x$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The maximum value of $y = \\cos(x)$ is:",
      "options": [
        { "id": "a", "text": "$0$" },
        { "id": "b", "text": "$1$" },
        { "id": "c", "text": "$2$" },
        { "id": "d", "text": "$\\infty$" }
      ],
      "correctAnswer": "b",
      "explanation": "The cosine function oscillates between $-1$ and $1$. Its maximum value is $1$, occurring at $x = 0°, 360°, 720°$, etc."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which trigonometric graph has a period of $180°$?",
      "options": [
        { "id": "a", "text": "$y = \\sin(x)$" },
        { "id": "b", "text": "$y = \\cos(x)$" },
        { "id": "c", "text": "$y = \\tan(x)$" },
        { "id": "d", "text": "None of the above" }
      ],
      "correctAnswer": "c",
      "explanation": "The tangent function has a period of $180°$ (or $\\pi$ radians), meaning $\\tan(x) = \\tan(x + 180°)$. Both sine and cosine have a period of $360°$."
    }
  ]
}
