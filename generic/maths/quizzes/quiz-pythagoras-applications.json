{
  "id": "quiz-pythagoras-applications",
  "title": "Quiz: Pythagoras Applications",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A ladder of length $5$ m leans against a wall. The foot of the ladder is $3$ m from the wall. How high up the wall does the ladder reach?",
      "options": [
        {"id": "a", "text": "$4$ m"},
        {"id": "b", "text": "$2$ m"},
        {"id": "c", "text": "$\\sqrt{34}$ m"},
        {"id": "d", "text": "$8$ m"}
      ],
      "correctAnswer": "a",
      "explanation": "Height $= \\sqrt{5^2 - 3^2} = \\sqrt{25 - 9} = \\sqrt{16} = 4$ m."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Find the distance between the points $(1, 2)$ and $(4, 6)$.",
      "options": [
        {"id": "a", "text": "$7$"},
        {"id": "b", "text": "$5$"},
        {"id": "c", "text": "$\\sqrt{7}$"},
        {"id": "d", "text": "$25$"}
      ],
      "correctAnswer": "b",
      "explanation": "$d = \\sqrt{(4-1)^2 + (6-2)^2} = \\sqrt{9 + 16} = \\sqrt{25} = 5$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "An isosceles triangle has two equal sides of $10$ cm and a base of $12$ cm. What is the perpendicular height?",
      "options": [
        {"id": "a", "text": "$6$ cm"},
        {"id": "b", "text": "$8$ cm"},
        {"id": "c", "text": "$\\sqrt{136}$ cm"},
        {"id": "d", "text": "$4$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "The perpendicular bisects the base: half-base $= 6$ cm. Height $= \\sqrt{10^2 - 6^2} = \\sqrt{64} = 8$ cm."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A rectangle has a diagonal of $15$ cm and a width of $9$ cm. What is its length?",
      "options": [
        {"id": "a", "text": "$6$ cm"},
        {"id": "b", "text": "$12$ cm"},
        {"id": "c", "text": "$\\sqrt{306}$ cm"},
        {"id": "d", "text": "$24$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "Length $= \\sqrt{15^2 - 9^2} = \\sqrt{225 - 81} = \\sqrt{144} = 12$ cm."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A ship sails $8$ km east and then $6$ km north. How far is it from its starting point?",
      "options": [
        {"id": "a", "text": "$14$ km"},
        {"id": "b", "text": "$10$ km"},
        {"id": "c", "text": "$\\sqrt{28}$ km"},
        {"id": "d", "text": "$2$ km"}
      ],
      "correctAnswer": "b",
      "explanation": "The path forms a right-angled triangle: $d = \\sqrt{8^2 + 6^2} = \\sqrt{64 + 36} = \\sqrt{100} = 10$ km."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A square has a diagonal of $10$ cm. What is the length of each side in simplified surd form?",
      "options": [
        {"id": "a", "text": "$5$ cm"},
        {"id": "b", "text": "$5\\sqrt{2}$ cm"},
        {"id": "c", "text": "$10\\sqrt{2}$ cm"},
        {"id": "d", "text": "$2\\sqrt{5}$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "If side $= s$, then $s^2 + s^2 = 10^2$, so $2s^2 = 100$, giving $s = \\sqrt{50} = 5\\sqrt{2}$ cm."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cone has a base radius of $5$ cm and a vertical height of $12$ cm. What is the slant height?",
      "options": [
        {"id": "a", "text": "$13$ cm"},
        {"id": "b", "text": "$17$ cm"},
        {"id": "c", "text": "$\\sqrt{119}$ cm"},
        {"id": "d", "text": "$7$ cm"}
      ],
      "correctAnswer": "a",
      "explanation": "Slant height $= \\sqrt{5^2 + 12^2} = \\sqrt{25 + 144} = \\sqrt{169} = 13$ cm."
    }
  ]
}
