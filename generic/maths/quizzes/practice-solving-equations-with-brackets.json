    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "I think of a number, subtract 3, then multiply by 4. The answer is 28. What was the number?",
      "options": [
        { "id": "a", "text": "10" },
        { "id": "b", "text": "7" },
        { "id": "c", "text": "4" },
        { "id": "d", "text": "31" }
      ],
      "correctAnswer": "a",
      "explanation": "Let the number be n. 4(n - 3) = 28. n - 3 = 7. n = 10. Check: (10 - 3) x 4 = 7 x 4 = 28."
    }
  ]
