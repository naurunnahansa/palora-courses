      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Solve: 5(2x + 1) - 3(x - 2) = 25",
      "options": [
        { "id": "a", "text": "x = 2" },
        { "id": "b", "text": "x = 14/7" },
        { "id": "c", "text": "x = 14/13" },
        { "id": "d", "text": "x = 18/7" }
      ],
      "correctAnswer": "b",
      "explanation": "10x + 5 - 3x + 6 = 25. 7x + 11 = 25. 7x = 14. x = 14/7 = 2. (Options a and b are the same value.)"
    },
