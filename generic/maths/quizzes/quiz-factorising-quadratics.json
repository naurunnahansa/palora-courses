{
  "id": "quiz-factorising-quadratics",
  "title": "Quiz: Factorising Quadratics (x\u00b2 + bx + c)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Factorise $x^2 + 7x + 12$.",
      "options": [
        {"id": "a", "text": "$(x + 2)(x + 6)$"},
        {"id": "b", "text": "$(x + 3)(x + 4)$"},
        {"id": "c", "text": "$(x + 1)(x + 12)$"},
        {"id": "d", "text": "$(x + 6)(x + 2)$"}
      ],
      "correctAnswer": "b",
      "explanation": "Find two numbers that multiply to 12 and add to 7. That is 3 and 4: $3 \\times 4 = 12$ and $3 + 4 = 7$. So $x^2 + 7x + 12 = (x + 3)(x + 4)$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Factorise $x^2 - 5x + 6$.",
      "options": [
        {"id": "a", "text": "$(x - 1)(x - 6)$"},
        {"id": "b", "text": "$(x + 2)(x + 3)$"},
        {"id": "c", "text": "$(x - 2)(x - 3)$"},
        {"id": "d", "text": "$(x - 2)(x + 3)$"}
      ],
      "correctAnswer": "c",
      "explanation": "Need two numbers that multiply to $+6$ and add to $-5$. That is $-2$ and $-3$. So $x^2 - 5x + 6 = (x - 2)(x - 3)$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Factorise $x^2 + 2x - 15$.",
      "options": [
        {"id": "a", "text": "$(x + 5)(x - 3)$"},
        {"id": "b", "text": "$(x - 5)(x + 3)$"},
        {"id": "c", "text": "$(x + 15)(x - 1)$"},
        {"id": "d", "text": "$(x + 5)(x + 3)$"}
      ],
      "correctAnswer": "a",
      "explanation": "Need two numbers that multiply to $-15$ and add to $+2$. That is $+5$ and $-3$: $5 \\times (-3) = -15$ and $5 + (-3) = 2$. So $(x + 5)(x - 3)$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Factorise $x^2 - x - 20$.",
      "options": [
        {"id": "a", "text": "$(x - 5)(x + 4)$"},
        {"id": "b", "text": "$(x + 5)(x - 4)$"},
        {"id": "c", "text": "$(x - 10)(x + 2)$"},
        {"id": "d", "text": "$(x - 4)(x - 5)$"}
      ],
      "correctAnswer": "a",
      "explanation": "Need two numbers that multiply to $-20$ and add to $-1$. That is $-5$ and $+4$. So $x^2 - x - 20 = (x - 5)(x + 4)$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Factorise $x^2 - 9$.",
      "options": [
        {"id": "a", "text": "$(x - 3)^2$"},
        {"id": "b", "text": "$(x + 3)^2$"},
        {"id": "c", "text": "$(x + 3)(x - 3)$"},
        {"id": "d", "text": "$(x + 9)(x - 1)$"}
      ],
      "correctAnswer": "c",
      "explanation": "This is the difference of two squares: $x^2 - 9 = x^2 - 3^2 = (x + 3)(x - 3)$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "When factorising $x^2 + bx + c$, you need two numbers that:",
      "options": [
        {"id": "a", "text": "Add to give $c$ and multiply to give $b$"},
        {"id": "b", "text": "Add to give $b$ and multiply to give $c$"},
        {"id": "c", "text": "Both equal $b + c$"},
        {"id": "d", "text": "Subtract to give $b$ and divide to give $c$"}
      ],
      "correctAnswer": "b",
      "explanation": "For $x^2 + bx + c = (x + p)(x + q)$, we need $p + q = b$ (the coefficient of $x$) and $p \\times q = c$ (the constant term)."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Factorise $x^2 - 8x + 16$.",
      "options": [
        {"id": "a", "text": "$(x + 4)^2$"},
        {"id": "b", "text": "$(x - 4)^2$"},
        {"id": "c", "text": "$(x - 2)(x - 8)$"},
        {"id": "d", "text": "$(x + 4)(x - 4)$"}
      ],
      "correctAnswer": "b",
      "explanation": "Two numbers that multiply to 16 and add to $-8$: that is $-4$ and $-4$. So $x^2 - 8x + 16 = (x - 4)(x - 4) = (x - 4)^2$. This is a perfect square."
    }
  ]
}
