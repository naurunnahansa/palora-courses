  "title": "Check: Iteration (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Using the iterative formula $x_{n+1} = \\frac{5}{x_n + 2}$ with $x_0 = 1$, find $x_2$ as a fraction.",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{15}{11}$"
        },
        {
          "id": "b",
          "text": "$\\frac{5}{3}$"
        },
        {
          "id": "c",
          "text": "$\\frac{11}{15}$"
        },
        {
          "id": "d",
          "text": "$\\frac{5}{7}$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "$x_1 = \\frac{5}{1 + 2} = \\frac{5}{3}$. Then $x_2 = \\frac{5}{\\frac{5}{3} + 2} = \\frac{5}{\\frac{5 + 6}{3}} = \\frac{5}{\\frac{11}{3}} = \\frac{15}{11}$."
    }
  ]
}
