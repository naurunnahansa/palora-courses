{
  "id": "check-vector-geometry-2-b",
  "title": "Check: Vector Geometry (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In triangle $OAB$, $\\overrightarrow{OA} = \\mathbf{a}$ and $\\overrightarrow{OB} = \\mathbf{b}$. Point $P$ lies on $AB$ such that $AP:PB = 1:2$. Express $\\overrightarrow{OP}$ in terms of $\\mathbf{a}$ and $\\mathbf{b}$.",
      "options": [
        {
          "id": "a",
          "text": "$\\mathbf{a} + \\frac{1}{3}\\mathbf{b}$"
        },
        {
          "id": "b",
          "text": "$\\frac{2}{3}\\mathbf{a} + \\frac{1}{3}\\mathbf{b}$"
        },
        {
          "id": "c",
          "text": "$\\frac{1}{3}\\mathbf{a} + \\frac{2}{3}\\mathbf{b}$"
        },
        {
          "id": "d",
          "text": "$\\frac{1}{3}(\\mathbf{b} - \\mathbf{a})$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$\\overrightarrow{OP} = \\overrightarrow{OA} + \\overrightarrow{AP} = \\mathbf{a} + \\frac{1}{3}\\overrightarrow{AB} = \\mathbf{a} + \\frac{1}{3}(\\mathbf{b} - \\mathbf{a}) = \\mathbf{a} + \\frac{1}{3}\\mathbf{b} - \\frac{1}{3}\\mathbf{a} = \\frac{2}{3}\\mathbf{a} + \\frac{1}{3}\\mathbf{b}$."
    }
  ]
}
