{
  "id": "check-histograms",
  "title": "Check: Histograms",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a histogram, the $y$-axis shows:",
      "options": [
        { "id": "a", "text": "Frequency" },
        { "id": "b", "text": "Frequency density" },
        { "id": "c", "text": "Cumulative frequency" },
        { "id": "d", "text": "Class width" }
      ],
      "correctAnswer": "b",
      "explanation": "In a histogram (with unequal class widths), the $y$-axis shows frequency density, where frequency density $= \\frac{\\text{frequency}}{\\text{class width}}$. It is the area of each bar that represents the frequency."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A class $10 \\leq x < 25$ has frequency $30$. What is the frequency density?",
      "options": [
        { "id": "a", "text": "$0.5$" },
        { "id": "b", "text": "$2$" },
        { "id": "c", "text": "$15$" },
        { "id": "d", "text": "$450$" }
      ],
      "correctAnswer": "b",
      "explanation": "Class width $= 25 - 10 = 15$. Frequency density $= \\frac{30}{15} = 2$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a histogram, the frequency is represented by:",
      "options": [
        { "id": "a", "text": "The height of the bar" },
        { "id": "b", "text": "The width of the bar" },
        { "id": "c", "text": "The area of the bar" },
        { "id": "d", "text": "The perimeter of the bar" }
      ],
      "correctAnswer": "c",
      "explanation": "In a histogram, frequency $=$ frequency density $\\times$ class width $=$ area of the bar. This is why histograms can handle unequal class widths."
    }
  ]
}