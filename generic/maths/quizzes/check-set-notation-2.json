{
  "id": "check-set-notation-2",
  "title": "Check: Set Notation",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $\\xi = \\{1,2,...,10\\}$, $A = \\{1,3,5,7,9\\}$, and $B = \\{3,6,9\\}$, what is $(A \\cap B)'$?",
      "options": [
        { "id": "a", "text": "$\\{3, 9\\}$" },
        { "id": "b", "text": "$\\{1,2,4,5,6,7,8,10\\}$" },
        { "id": "c", "text": "$\\{2,4,6,8,10\\}$" },
        { "id": "d", "text": "$\\{1,5,7\\}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$A \\cap B = \\{3, 9\\}$. The complement $(A \\cap B)' = \\xi \\setminus \\{3, 9\\} = \\{1,2,4,5,6,7,8,10\\}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The notation $n(A)$ means:",
      "options": [
        { "id": "a", "text": "The probability of $A$" },
        { "id": "b", "text": "The number of elements in set $A$" },
        { "id": "c", "text": "The complement of $A$" },
        { "id": "d", "text": "A multiplied by $n$" }
      ],
      "correctAnswer": "b",
      "explanation": "$n(A)$ denotes the number of elements (cardinality) of set $A$."
    }
  ]
}