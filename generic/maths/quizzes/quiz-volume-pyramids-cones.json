{
  "id": "quiz-volume-pyramids-cones",
  "title": "Quiz: Volume: Pyramids and Cones",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The volume of a cone is:",
      "options": [
        {"id": "a", "text": "$\\pi r^2 h$"},
        {"id": "b", "text": "$\\frac{1}{3}\\pi r^2 h$"},
        {"id": "c", "text": "$\\frac{1}{2}\\pi r^2 h$"},
        {"id": "d", "text": "$\\pi r l$"}
      ],
      "correctAnswer": "b",
      "explanation": "The volume of a cone is $\\frac{1}{3}\\pi r^2 h$, which is one-third of the volume of a cylinder with the same base and height."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cone has radius $6$ cm and height $10$ cm. What is its volume in terms of $\\pi$?",
      "options": [
        {"id": "a", "text": "$360\\pi$ cm$^3$"},
        {"id": "b", "text": "$120\\pi$ cm$^3$"},
        {"id": "c", "text": "$60\\pi$ cm$^3$"},
        {"id": "d", "text": "$180\\pi$ cm$^3$"}
      ],
      "correctAnswer": "b",
      "explanation": "Volume $= \\frac{1}{3}\\pi r^2 h = \\frac{1}{3}\\pi(36)(10) = 120\\pi$ cm$^3$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A square-based pyramid has a base side of $8$ cm and a height of $9$ cm. What is its volume?",
      "options": [
        {"id": "a", "text": "$576$ cm$^3$"},
        {"id": "b", "text": "$192$ cm$^3$"},
        {"id": "c", "text": "$288$ cm$^3$"},
        {"id": "d", "text": "$72$ cm$^3$"}
      ],
      "correctAnswer": "b",
      "explanation": "Base area $= 8^2 = 64$ cm$^2$. Volume $= \\frac{1}{3} \\times 64 \\times 9 = 192$ cm$^3$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The volume of a pyramid is what fraction of the volume of a prism with the same base and height?",
      "options": [
        {"id": "a", "text": "$\\frac{1}{2}$"},
        {"id": "b", "text": "$\\frac{1}{3}$"},
        {"id": "c", "text": "$\\frac{1}{4}$"},
        {"id": "d", "text": "$\\frac{2}{3}$"}
      ],
      "correctAnswer": "b",
      "explanation": "A pyramid's volume is exactly $\\frac{1}{3}$ of the prism with the same base area and height."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cone has a volume of $48\\pi$ cm$^3$ and a height of $4$ cm. What is the radius of the base?",
      "options": [
        {"id": "a", "text": "$4$ cm"},
        {"id": "b", "text": "$6$ cm"},
        {"id": "c", "text": "$12$ cm"},
        {"id": "d", "text": "$36$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "$48\\pi = \\frac{1}{3}\\pi r^2(4) = \\frac{4}{3}\\pi r^2$. So $r^2 = 36$ and $r = 6$ cm."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A triangular-based pyramid has a base area of $30$ cm$^2$ and a height of $12$ cm. What is its volume?",
      "options": [
        {"id": "a", "text": "$360$ cm$^3$"},
        {"id": "b", "text": "$120$ cm$^3$"},
        {"id": "c", "text": "$180$ cm$^3$"},
        {"id": "d", "text": "$60$ cm$^3$"}
      ],
      "correctAnswer": "b",
      "explanation": "Volume $= \\frac{1}{3} \\times 30 \\times 12 = 120$ cm$^3$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cone has the same base radius and height as a cylinder. The cylinder has a volume of $270\\pi$ cm$^3$. What is the volume of the cone?",
      "options": [
        {"id": "a", "text": "$810\\pi$ cm$^3$"},
        {"id": "b", "text": "$135\\pi$ cm$^3$"},
        {"id": "c", "text": "$90\\pi$ cm$^3$"},
        {"id": "d", "text": "$54\\pi$ cm$^3$"}
      ],
      "correctAnswer": "c",
      "explanation": "The cone's volume is $\\frac{1}{3}$ of the cylinder's: $\\frac{1}{3} \\times 270\\pi = 90\\pi$ cm$^3$."
    }
  ]
}
