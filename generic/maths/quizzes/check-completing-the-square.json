{
  "id": "check-completing-the-square",
  "title": "Check: Completing the Square",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Write $x^2 + 6x$ in the form $(x + a)^2 + b$.",
      "options": [
        { "id": "a", "text": "$(x + 6)^2 - 36$" },
        { "id": "b", "text": "$(x + 3)^2 - 9$" },
        { "id": "c", "text": "$(x + 3)^2 + 9$" },
        { "id": "d", "text": "$(x + 6)^2 + 36$" }
      ],
      "correctAnswer": "b",
      "explanation": "Half the coefficient of $x$ is $3$. So $x^2 + 6x = (x + 3)^2 - 9$, since $(x + 3)^2 = x^2 + 6x + 9$ and we need to subtract the extra $9$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Write $x^2 + 6x + 1$ in the form $(x + p)^2 + q$.",
      "options": [
        { "id": "a", "text": "$(x + 3)^2 - 8$" },
        { "id": "b", "text": "$(x + 3)^2 + 10$" },
        { "id": "c", "text": "$(x + 6)^2 - 35$" },
        { "id": "d", "text": "$(x + 3)^2 - 10$" }
      ],
      "correctAnswer": "a",
      "explanation": "From $x^2 + 6x = (x+3)^2 - 9$, add the constant: $x^2 + 6x + 1 = (x+3)^2 - 9 + 1 = (x+3)^2 - 8$."
    }
  ]
}
