{
  "id": "check-arc-length-sector-area",
  "title": "Check: Arc Length and Sector Area",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the arc length of a sector with radius $10\\text{ cm}$ and angle $72°$? Give your answer in terms of $\\pi$.",
      "options": [
        { "id": "a", "text": "$2\\pi\\text{ cm}$" },
        { "id": "b", "text": "$4\\pi\\text{ cm}$" },
        { "id": "c", "text": "$20\\pi\\text{ cm}$" },
        { "id": "d", "text": "$\\pi\\text{ cm}$" }
      ],
      "correctAnswer": "b",
      "explanation": "Arc length $= \\frac{\\theta}{360} \\times 2\\pi r = \\frac{72}{360} \\times 2\\pi \\times 10 = \\frac{1}{5} \\times 20\\pi = 4\\pi\\text{ cm}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the area of a sector with radius $6\\text{ cm}$ and angle $90°$? Give your answer in terms of $\\pi$.",
      "options": [
        { "id": "a", "text": "$36\\pi\\text{ cm}^2$" },
        { "id": "b", "text": "$3\\pi\\text{ cm}^2$" },
        { "id": "c", "text": "$9\\pi\\text{ cm}^2$" },
        { "id": "d", "text": "$12\\pi\\text{ cm}^2$" }
      ],
      "correctAnswer": "c",
      "explanation": "Sector area $= \\frac{\\theta}{360} \\times \\pi r^2 = \\frac{90}{360} \\times \\pi \\times 36 = \\frac{1}{4} \\times 36\\pi = 9\\pi\\text{ cm}^2$."
    }
  ]
}