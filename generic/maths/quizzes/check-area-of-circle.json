{
  "id": "check-area-of-circle",
  "title": "Check: Area of a Circle",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the area of a circle with radius $6\\text{ cm}$? Give your answer in terms of $\\pi$.",
      "options": [
        { "id": "a", "text": "$6\\pi\\text{ cm}^2$" },
        { "id": "b", "text": "$12\\pi\\text{ cm}^2$" },
        { "id": "c", "text": "$36\\pi\\text{ cm}^2$" },
        { "id": "d", "text": "$18\\pi\\text{ cm}^2$" }
      ],
      "correctAnswer": "c",
      "explanation": "Area $= \\pi r^2 = \\pi \\times 6^2 = 36\\pi\\text{ cm}^2$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A circle has a diameter of $10\\text{ cm}$. What is its area in terms of $\\pi$?",
      "options": [
        { "id": "a", "text": "$100\\pi\\text{ cm}^2$" },
        { "id": "b", "text": "$50\\pi\\text{ cm}^2$" },
        { "id": "c", "text": "$25\\pi\\text{ cm}^2$" },
        { "id": "d", "text": "$10\\pi\\text{ cm}^2$" }
      ],
      "correctAnswer": "c",
      "explanation": "The radius is $\\frac{10}{2} = 5\\text{ cm}$. Area $= \\pi r^2 = \\pi \\times 5^2 = 25\\pi\\text{ cm}^2$."
    }
  ]
}