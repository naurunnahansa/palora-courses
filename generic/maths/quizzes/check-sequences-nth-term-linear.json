{
  "id": "check-sequences-nth-term-linear",
  "title": "Check: Sequences: nth Term (Linear)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Find the $n$th term of the sequence $5, 8, 11, 14, ...$.",
      "options": [
        { "id": "a", "text": "$3n + 5$" },
        { "id": "b", "text": "$3n + 2$" },
        { "id": "c", "text": "$5n + 3$" },
        { "id": "d", "text": "$3n - 2$" }
      ],
      "correctAnswer": "b",
      "explanation": "The common difference is $3$, so the $n$th term starts with $3n$. When $n = 1$: $3(1) = 3$, but the first term is $5$, so we add $2$. The $n$th term is $3n + 2$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The $n$th term of a sequence is $4n - 1$. What is the $20$th term?",
      "options": [
        { "id": "a", "text": "$79$" },
        { "id": "b", "text": "$80$" },
        { "id": "c", "text": "$81$" },
        { "id": "d", "text": "$39$" }
      ],
      "correctAnswer": "a",
      "explanation": "Substitute $n = 20$: $4(20) - 1 = 80 - 1 = 79$."
    }
  ]
}
