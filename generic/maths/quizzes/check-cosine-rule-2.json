{
  "id": "check-cosine-rule-2",
  "title": "Check: Cosine Rule",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In triangle $ABC$, $a = 8\\text{ cm}$, $b = 6\\text{ cm}$, and $c = 10\\text{ cm}$. Which expression finds angle $C$?",
      "options": [
        {
          "id": "a",
          "text": "$\\cos C = \\frac{10^2 + 6^2 - 8^2}{2 \\times 10 \\times 6}$"
        },
        {
          "id": "b",
          "text": "$\\cos C = \\frac{8^2 + 10^2 - 6^2}{2 \\times 8 \\times 10}$"
        },
        {
          "id": "c",
          "text": "$\\cos C = \\frac{8^2 + 6^2 - 10^2}{2 \\times 8 \\times 6}$"
        },
        {
          "id": "d",
          "text": "$\\cos C = \\frac{8^2 - 6^2 + 10^2}{2 \\times 6 \\times 10}$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "To find angle $C$, rearrange the cosine rule: $\\cos C = \\frac{a^2 + b^2 - c^2}{2ab} = \\frac{8^2 + 6^2 - 10^2}{2 \\times 8 \\times 6}$."
    }
  ]
}
