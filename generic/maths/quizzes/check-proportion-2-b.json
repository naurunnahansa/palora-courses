  "title": "Check: Proportion (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "$y$ is directly proportional to $x^2$. When $x = 2$, $y = 12$. What is $y$ when $x = 5$?",
      "options": [
        {
          "id": "a",
          "text": "$30$"
        },
        {
          "id": "b",
          "text": "$60$"
        },
        {
          "id": "c",
          "text": "$75$"
        },
        {
          "id": "d",
          "text": "$300$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "$y = kx^2$. When $x = 2$: $12 = k \\times 4$, so $k = 3$. When $x = 5$: $y = 3 \\times 25 = 75$."
    }
  ]
}