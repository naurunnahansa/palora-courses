{
  "id": "check-expanding-double-brackets-2",
  "title": "Check: Expanding Double Brackets",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Expand $(2x + 1)(x - 3)$.",
      "options": [
        { "id": "a", "text": "$2x^2 - 5x - 3$" },
        { "id": "b", "text": "$2x^2 + 5x - 3$" },
        { "id": "c", "text": "$2x^2 - 6x - 3$" },
        { "id": "d", "text": "$2x^2 - 5x + 3$" }
      ],
      "correctAnswer": "a",
      "explanation": "$(2x + 1)(x - 3) = 2x^2 - 6x + x - 3 = 2x^2 - 5x - 3$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $(x - 5)^2$ expanded?",
      "options": [
        { "id": "a", "text": "$x^2 - 25$" },
        { "id": "b", "text": "$x^2 - 5x + 25$" },
        { "id": "c", "text": "$x^2 - 10x + 25$" },
        { "id": "d", "text": "$x^2 + 10x + 25$" }
      ],
      "correctAnswer": "c",
      "explanation": "$(x - 5)^2 = (x - 5)(x - 5) = x^2 - 5x - 5x + 25 = x^2 - 10x + 25$. A common mistake is to forget the middle term."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Expand $(x + 6)(x - 6)$.",
      "options": [
        { "id": "a", "text": "$x^2 + 36$" },
        { "id": "b", "text": "$x^2 - 12x + 36$" },
        { "id": "c", "text": "$x^2 - 36$" },
        { "id": "d", "text": "$x^2 + 12x - 36$" }
      ],
      "correctAnswer": "c",
      "explanation": "This is a difference of two squares: $(x + 6)(x - 6) = x^2 - 6x + 6x - 36 = x^2 - 36$. The middle terms cancel out."
    }
  ]
}
