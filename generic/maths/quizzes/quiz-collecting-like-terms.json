{
  "id": "quiz-collecting-like-terms",
  "title": "Quiz: Collecting Like Terms",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $5x + 3x - 2x$.",
      "options": [
        {
          "id": "a",
          "text": "$0$"
        },
        {
          "id": "b",
          "text": "$10x$"
        },
        {
          "id": "c",
          "text": "$6x^3$"
        },
        {
          "id": "d",
          "text": "$6x$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "These are all like terms ($x$ terms): $5x + 3x - 2x = (5 + 3 - 2)x = 6x$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $4a + 3b - 2a + 5b$.",
      "options": [
        {
          "id": "a",
          "text": "$6a + 2b$"
        },
        {
          "id": "b",
          "text": "$10ab$"
        },
        {
          "id": "c",
          "text": "$2a + 8b$"
        },
        {
          "id": "d",
          "text": "$9ab + a$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Collect the $a$ terms: $4a - 2a = 2a$. Collect the $b$ terms: $3b + 5b = 8b$. Result: $2a + 8b$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $3x^2 + 5x - 2x^2 + x$.",
      "options": [
        {
          "id": "a",
          "text": "$x^2 + 4x$"
        },
        {
          "id": "b",
          "text": "$7x^2$"
        },
        {
          "id": "c",
          "text": "$6x^3 + x$"
        },
        {
          "id": "d",
          "text": "$x^2 + 6x$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Collect the $x^2$ terms: $3x^2 - 2x^2 = x^2$. Collect the $x$ terms: $5x + x = 6x$. Result: $x^2 + 6x$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which of the following is correctly simplified?",
      "options": [
        {
          "id": "a",
          "text": "$4x^2 + 3x = 7x^3$"
        },
        {
          "id": "b",
          "text": "$3x + 2y = 5xy$"
        },
        {
          "id": "c",
          "text": "$5a + 3 = 8a$"
        },
        {
          "id": "d",
          "text": "$6y - 2y + 3 = 4y + 3$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "$6y - 2y + 3 = 4y + 3$ is correct. You cannot add $x$ and $y$ (different variables), cannot add $x^2$ and $x$ (different powers), and cannot add a variable term and a constant."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $7p - 3q - 4p + 3q$.",
      "options": [
        {
          "id": "a",
          "text": "$3p$"
        },
        {
          "id": "b",
          "text": "$3p + 6q$"
        },
        {
          "id": "c",
          "text": "$11p$"
        },
        {
          "id": "d",
          "text": "$3p - 6q$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "$p$ terms: $7p - 4p = 3p$. $q$ terms: $-3q + 3q = 0$. The $q$ terms cancel out, leaving $3p$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $2x + 5 - 3x + 8$.",
      "options": [
        {
          "id": "a",
          "text": "$12x$"
        },
        {
          "id": "b",
          "text": "$-x + 13$"
        },
        {
          "id": "c",
          "text": "$5x + 13$"
        },
        {
          "id": "d",
          "text": "$-x - 3$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$x$ terms: $2x - 3x = -x$. Constants: $5 + 8 = 13$. Result: $-x + 13$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $4xy + 2x^2 - xy + 3x^2$.",
      "options": [
        {
          "id": "a",
          "text": "$6x^2y + xy$"
        },
        {
          "id": "b",
          "text": "$5x^2 + 3xy$"
        },
        {
          "id": "c",
          "text": "$5x^2y + 3xy$"
        },
        {
          "id": "d",
          "text": "$9x^3y$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$x^2$ terms: $2x^2 + 3x^2 = 5x^2$. $xy$ terms: $4xy - xy = 3xy$. Result: $5x^2 + 3xy$. Note that $x^2$ and $xy$ are not like terms."
    }
  ]
}
