{
  "id": "check-sequences-nth-term-quadratic-2",
  "title": "Check: Sequences: nth Term (Quadratic)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Find the $n$th term of the sequence $2, 6, 12, 20, 30, ...$.",
      "options": [
        { "id": "a", "text": "$n^2 + n$" },
        { "id": "b", "text": "$n^2 + 2$" },
        { "id": "c", "text": "$2n^2$" },
        { "id": "d", "text": "$n^2 + 2n$" }
      ],
      "correctAnswer": "a",
      "explanation": "First differences: $4, 6, 8, 10$. Second differences: $2, 2, 2$. So $a = 1$ (since $2a = 2$). Subtract $n^2$: $2-1, 6-4, 12-9, 20-16, 30-25 = 1, 2, 3, 4, 5$. This is $n$. So the $n$th term is $n^2 + n$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The $n$th term of a sequence is $2n^2 - 3n + 1$. What is the $4$th term?",
      "options": [
        { "id": "a", "text": "$17$" },
        { "id": "b", "text": "$21$" },
        { "id": "c", "text": "$25$" },
        { "id": "d", "text": "$13$" }
      ],
      "correctAnswer": "b",
      "explanation": "Substitute $n = 4$: $2(16) - 3(4) + 1 = 32 - 12 + 1 = 21$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Find the $n$th term of $0, 3, 8, 15, 24, ...$.",
      "options": [
        { "id": "a", "text": "$n^2 + 1$" },
        { "id": "b", "text": "$n^2 - n$" },
        { "id": "c", "text": "$n^2 - 1$" },
        { "id": "d", "text": "$n^2 + n - 2$" }
      ],
      "correctAnswer": "c",
      "explanation": "Test $n = 1$: $1 - 1 = 0$. $n = 2$: $4 - 1 = 3$. $n = 3$: $9 - 1 = 8$. $n = 4$: $16 - 1 = 15$. $n = 5$: $25 - 1 = 24$. All match, so the $n$th term is $n^2 - 1$."
    }
  ]
}
