{
  "id": "quiz-units-conversions",
  "title": "Quiz: Units and Conversions",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "How many square centimetres are in $1$ square metre?",
      "options": [
        {
          "id": "a",
          "text": "$100$"
        },
        {
          "id": "b",
          "text": "$1000$"
        },
        {
          "id": "c",
          "text": "$1000000$"
        },
        {
          "id": "d",
          "text": "$10000$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "$1$ m $= 100$ cm, so $1$ m$^2 = 100^2 = 10000$ cm$^2$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Convert $5$ km to metres.",
      "options": [
        {
          "id": "a",
          "text": "$500$ m"
        },
        {
          "id": "b",
          "text": "$50000$ m"
        },
        {
          "id": "c",
          "text": "$5000$ m"
        },
        {
          "id": "d",
          "text": "$50$ m"
        }
      ],
      "correctAnswer": "c",
      "explanation": "$1$ km $= 1000$ m, so $5$ km $= 5 \\times 1000 = 5000$ m."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "How many cubic centimetres are in $1$ litre?",
      "options": [
        {
          "id": "a",
          "text": "$10000$"
        },
        {
          "id": "b",
          "text": "$10$"
        },
        {
          "id": "c",
          "text": "$1000$"
        },
        {
          "id": "d",
          "text": "$100$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "$1$ litre $= 1000$ cm$^3$ (or equivalently, $1000$ ml)."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Convert $3.5$ m$^2$ to cm$^2$.",
      "options": [
        {
          "id": "a",
          "text": "$3500$ cm$^2$"
        },
        {
          "id": "b",
          "text": "$35000$ cm$^2$"
        },
        {
          "id": "c",
          "text": "$350$ cm$^2$"
        },
        {
          "id": "d",
          "text": "$3.5$ cm$^2$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$1$ m$^2 = 10000$ cm$^2$, so $3.5$ m$^2 = 3.5 \\times 10000 = 35000$ cm$^2$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A container holds $2500$ cm$^3$ of water. How many litres is this?",
      "options": [
        {
          "id": "a",
          "text": "$25$ litres"
        },
        {
          "id": "b",
          "text": "$0.25$ litres"
        },
        {
          "id": "c",
          "text": "$2.5$ litres"
        },
        {
          "id": "d",
          "text": "$250$ litres"
        }
      ],
      "correctAnswer": "c",
      "explanation": "$1$ litre $= 1000$ cm$^3$, so $2500$ cm$^3 = \\frac{2500}{1000} = 2.5$ litres."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "How many mm$^3$ are in $1$ cm$^3$?",
      "options": [
        {
          "id": "a",
          "text": "$10$"
        },
        {
          "id": "b",
          "text": "$100$"
        },
        {
          "id": "c",
          "text": "$10000$"
        },
        {
          "id": "d",
          "text": "$1000$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "$1$ cm $= 10$ mm, so $1$ cm$^3 = 10^3 = 1000$ mm$^3$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A field has an area of $2$ hectares. What is this in m$^2$? ($1$ hectare $= 10000$ m$^2$)",
      "options": [
        {
          "id": "a",
          "text": "$2000$ m$^2$"
        },
        {
          "id": "b",
          "text": "$200$ m$^2$"
        },
        {
          "id": "c",
          "text": "$200000$ m$^2$"
        },
        {
          "id": "d",
          "text": "$20000$ m$^2$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "$2$ hectares $= 2 \\times 10000 = 20000$ m$^2$."
    }
  ]
}
