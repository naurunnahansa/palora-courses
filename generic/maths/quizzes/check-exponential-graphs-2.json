  "title": "Check: Exponential Graphs",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which of these represents exponential decay?",
      "options": [
        {
          "id": "a",
          "text": "$y = 2^x$"
        },
        {
          "id": "b",
          "text": "$y = x^2$"
        },
        {
          "id": "c",
          "text": "$y = \\left(\\frac{1}{2}\\right)^x$"
        },
        {
          "id": "d",
          "text": "$y = 2x$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Exponential decay occurs when the base is between $0$ and $1$. Here $\\frac{1}{2} < 1$, so $y = \\left(\\frac{1}{2}\\right)^x$ decreases as $x$ increases."
    }
  ]
}
