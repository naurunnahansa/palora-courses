{
  "id": "quiz-inequalities-linear",
  "title": "Quiz: Linear Inequalities",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $3x + 5 > 20$.",
      "options": [
        {
          "id": "a",
          "text": "$x > 15$"
        },
        {
          "id": "b",
          "text": "$x \\geq 5$"
        },
        {
          "id": "c",
          "text": "$x < 5$"
        },
        {
          "id": "d",
          "text": "$x > 5$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Subtract 5: $3x > 15$. Divide by 3: $x > 5$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $-2x \\geq 8$.",
      "options": [
        {
          "id": "a",
          "text": "$x \\leq -4$"
        },
        {
          "id": "b",
          "text": "$x \\geq 4$"
        },
        {
          "id": "c",
          "text": "$x \\geq -4$"
        },
        {
          "id": "d",
          "text": "$x \\leq 4$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Divide both sides by $-2$. When dividing by a negative number, the inequality sign reverses: $x \\leq -4$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "List the integers satisfying $-3 < x \\leq 2$.",
      "options": [
        {
          "id": "a",
          "text": "$-3, -2, -1, 0, 1, 2$"
        },
        {
          "id": "b",
          "text": "$-3, -2, -1, 0, 1$"
        },
        {
          "id": "c",
          "text": "$-2, -1, 0, 1$"
        },
        {
          "id": "d",
          "text": "$-2, -1, 0, 1, 2$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "The inequality is strict on the left ($x > -3$), so $-3$ is excluded. It is inclusive on the right ($x \\leq 2$), so $2$ is included. The integers are $-2, -1, 0, 1, 2$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $5 - 3x < 14$.",
      "options": [
        {
          "id": "a",
          "text": "$x > 3$"
        },
        {
          "id": "b",
          "text": "$x < 3$"
        },
        {
          "id": "c",
          "text": "$x > -3$"
        },
        {
          "id": "d",
          "text": "$x < -3$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Subtract 5: $-3x < 9$. Divide by $-3$ (reverse the sign): $x > -3$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $4x - 1 \\leq 2x + 7$.",
      "options": [
        {
          "id": "a",
          "text": "$x \\geq 3$"
        },
        {
          "id": "b",
          "text": "$x \\leq 4$"
        },
        {
          "id": "c",
          "text": "$x \\geq 4$"
        },
        {
          "id": "d",
          "text": "$x \\leq 3$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Subtract $2x$: $2x - 1 \\leq 7$. Add 1: $2x \\leq 8$. Divide by 2: $x \\leq 4$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "On a number line, how is $x > 3$ represented?",
      "options": [
        {
          "id": "a",
          "text": "A filled circle at 3 with an arrow pointing left"
        },
        {
          "id": "b",
          "text": "A filled circle at 3 with an arrow pointing right"
        },
        {
          "id": "c",
          "text": "An open circle at 3 with an arrow pointing left"
        },
        {
          "id": "d",
          "text": "An open circle at 3 with an arrow pointing right"
        }
      ],
      "correctAnswer": "d",
      "explanation": "A strict inequality ($>$, not $\\geq$) uses an open circle to show the endpoint is not included. The arrow points right to show all values greater than 3."
    },
    {
