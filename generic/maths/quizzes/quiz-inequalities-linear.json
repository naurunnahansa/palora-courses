      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $7 \\leq 2x + 3 < 15$.",
      "options": [
        {
          "id": "a",
          "text": "$5 \\leq x < 9$"
        },
        {
          "id": "b",
          "text": "$2 \\leq x \\leq 6$"
        },
        {
          "id": "c",
          "text": "$2 < x \\leq 6$"
        },
        {
          "id": "d",
          "text": "$2 \\leq x < 6$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Subtract 3 from all parts: $4 \\leq 2x < 12$. Divide all parts by 2: $2 \\leq x < 6$."
