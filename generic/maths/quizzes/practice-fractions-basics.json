{
  "id": "practice-fractions-basics",
  "title": "Practice: Fractions Basics",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Convert the mixed number 3 and 5/8 to an improper fraction.",
      "options": [
        { "id": "a", "text": "35/8" },
        { "id": "b", "text": "29/8" },
        { "id": "c", "text": "24/8" },
        { "id": "d", "text": "38/8" }
      ],
      "correctAnswer": "b",
      "explanation": "3 and 5/8 = (3 x 8 + 5)/8 = (24 + 5)/8 = 29/8."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A school has 720 students. 5/8 of them are boys. How many girls are there?",
      "options": [
        { "id": "a", "text": "450" },
        { "id": "b", "text": "270" },
        { "id": "c", "text": "360" },
        { "id": "d", "text": "90" }
      ],
      "correctAnswer": "b",
      "explanation": "If 5/8 are boys, then 3/8 are girls. Girls = 3/8 x 720 = 720/8 x 3 = 90 x 3 = 270."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Which fraction is the largest? 3/5, 5/8, 7/10",
      "options": [
        { "id": "a", "text": "3/5" },
        { "id": "b", "text": "5/8" },
        { "id": "c", "text": "7/10" },
        { "id": "d", "text": "They are all equal" }
      ],
      "correctAnswer": "c",
      "explanation": "Converting to the common denominator 40: 3/5 = 24/40, 5/8 = 25/40, 7/10 = 28/40. Since 28 > 25 > 24, the largest is 7/10."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Simplify 84/126 to its lowest terms.",
      "options": [
        { "id": "a", "text": "4/6" },
        { "id": "b", "text": "14/21" },
        { "id": "c", "text": "2/3" },
        { "id": "d", "text": "7/9" }
      ],
      "correctAnswer": "c",
      "explanation": "HCF(84, 126) = 42. So 84/126 = (84 / 42) / (126 / 42) = 2/3."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Convert 47/6 to a mixed number.",
      "options": [
        { "id": "a", "text": "7 and 4/6" },
        { "id": "b", "text": "7 and 5/6" },
        { "id": "c", "text": "8 and 1/6" },
        { "id": "d", "text": "6 and 5/6" }
      ],
      "correctAnswer": "b",
      "explanation": "47 / 6 = 7 remainder 5. So 47/6 = 7 and 5/6."
    }
  ]
}
