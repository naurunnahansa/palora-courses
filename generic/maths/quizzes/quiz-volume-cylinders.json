{
  "id": "quiz-volume-cylinders",
  "title": "Quiz: Volume of Cylinders",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cylinder has radius $4$ cm and height $10$ cm. What is its volume in terms of $\\pi$?",
      "options": [
        {"id": "a", "text": "$40\\pi$ cm$^3$"},
        {"id": "b", "text": "$80\\pi$ cm$^3$"},
        {"id": "c", "text": "$160\\pi$ cm$^3$"},
        {"id": "d", "text": "$320\\pi$ cm$^3$"}
      ],
      "correctAnswer": "c",
      "explanation": "Volume $= \\pi r^2 h = \\pi(16)(10) = 160\\pi$ cm$^3$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cylinder has a diameter of $6$ cm and height $8$ cm. What is its volume to $1$ decimal place? (Use $\\pi = 3.14$)",
      "options": [
        {"id": "a", "text": "$226.1$ cm$^3$"},
        {"id": "b", "text": "$150.7$ cm$^3$"},
        {"id": "c", "text": "$904.3$ cm$^3$"},
        {"id": "d", "text": "$113.0$ cm$^3$"}
      ],
      "correctAnswer": "a",
      "explanation": "Radius $= 3$ cm. Volume $= 3.14 \\times 9 \\times 8 = 226.08 \\approx 226.1$ cm$^3$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cylindrical container has volume $500\\pi$ cm$^3$ and radius $5$ cm. What is its height?",
      "options": [
        {"id": "a", "text": "$10$ cm"},
        {"id": "b", "text": "$20$ cm"},
        {"id": "c", "text": "$25$ cm"},
        {"id": "d", "text": "$100$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "$500\\pi = \\pi(25)h$, so $h = \\frac{500}{25} = 20$ cm."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cylinder has volume $200$ cm$^3$ and height $8$ cm. What is its radius to $1$ decimal place? (Use $\\pi = 3.14$)",
      "options": [
        {"id": "a", "text": "$2.5$ cm"},
        {"id": "b", "text": "$2.8$ cm"},
        {"id": "c", "text": "$4.0$ cm"},
        {"id": "d", "text": "$5.0$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "$200 = 3.14 \\times r^2 \\times 8 = 25.12r^2$. So $r^2 = 7.96$ and $r = 2.8$ cm (1 d.p.)."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If the radius of a cylinder is doubled but the height stays the same, the volume is multiplied by:",
      "options": [
        {"id": "a", "text": "$2$"},
        {"id": "b", "text": "$4$"},
        {"id": "c", "text": "$8$"},
        {"id": "d", "text": "$\\pi$"}
      ],
      "correctAnswer": "b",
      "explanation": "Volume $= \\pi r^2 h$. Doubling $r$ gives $\\pi(2r)^2 h = 4\\pi r^2 h$, which is $4$ times the original."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cylindrical glass has an internal radius of $3$ cm and a height of $12$ cm. How many millilitres of water can it hold? ($1$ cm$^3 = 1$ ml, use $\\pi = 3.14$)",
      "options": [
        {"id": "a", "text": "$113.0$ ml"},
        {"id": "b", "text": "$226.1$ ml"},
        {"id": "c", "text": "$339.1$ ml"},
        {"id": "d", "text": "$678.2$ ml"}
      ],
      "correctAnswer": "c",
      "explanation": "Volume $= 3.14 \\times 9 \\times 12 = 339.12 \\approx 339.1$ ml."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cylinder has radius $r$ and height $3r$. Its volume in terms of $r$ is:",
      "options": [
        {"id": "a", "text": "$3\\pi r^2$"},
        {"id": "b", "text": "$3\\pi r^3$"},
        {"id": "c", "text": "$9\\pi r^3$"},
        {"id": "d", "text": "$\\pi r^3$"}
      ],
      "correctAnswer": "b",
      "explanation": "Volume $= \\pi r^2 (3r) = 3\\pi r^3$."
    }
  ]
}
