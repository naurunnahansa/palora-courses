{
  "id": "practice-expanding-double-brackets",
  "title": "Practice: Expanding Double Brackets",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Expand and simplify: (x - 3)(x + 7)",
      "options": [
        { "id": "a", "text": "x^2 + 4x - 21" },
        { "id": "b", "text": "x^2 - 4x - 21" },
        { "id": "c", "text": "x^2 + 4x + 21" },
        { "id": "d", "text": "x^2 - 10x - 21" }
      ],
      "correctAnswer": "a",
      "explanation": "(x - 3)(x + 7) = x^2 + 7x - 3x - 21 = x^2 + 4x - 21."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Expand: (2x + 3)(3x - 4)",
      "options": [
        { "id": "a", "text": "6x^2 + x - 12" },
        { "id": "b", "text": "6x^2 - x - 12" },
        { "id": "c", "text": "6x^2 + 17x - 12" },
        { "id": "d", "text": "5x^2 + x - 12" }
      ],
      "correctAnswer": "a",
      "explanation": "(2x + 3)(3x - 4) = 6x^2 - 8x + 9x - 12 = 6x^2 + x - 12."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Expand: (x - 6)^2",
      "options": [
        { "id": "a", "text": "x^2 - 36" },
        { "id": "b", "text": "x^2 - 6x + 36" },
        { "id": "c", "text": "x^2 - 12x + 36" },
        { "id": "d", "text": "x^2 + 12x + 36" }
      ],
      "correctAnswer": "c",
      "explanation": "(x - 6)^2 = x^2 - 2(x)(6) + 36 = x^2 - 12x + 36. Common error: writing x^2 - 36 (which is the difference of squares, not a perfect square)."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "What is (x + 5)(x - 5)?",
      "options": [
        { "id": "a", "text": "x^2 - 10x - 25" },
        { "id": "b", "text": "x^2 + 25" },
        { "id": "c", "text": "x^2 - 25" },
        { "id": "d", "text": "x^2 - 10x + 25" }
      ],
      "correctAnswer": "c",
      "explanation": "This is the difference of squares pattern: (a + b)(a - b) = a^2 - b^2. So (x + 5)(x - 5) = x^2 - 25."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Show that (x + 2)^2 + (x - 2)^2 simplifies to:",
      "options": [
        { "id": "a", "text": "2x^2 + 8" },
        { "id": "b", "text": "2x^2" },
        { "id": "c", "text": "2x^2 + 4" },
        { "id": "d", "text": "8" }
      ],
      "correctAnswer": "a",
      "explanation": "(x + 2)^2 = x^2 + 4x + 4. (x - 2)^2 = x^2 - 4x + 4. Adding: x^2 + 4x + 4 + x^2 - 4x + 4 = 2x^2 + 8. The middle terms cancel out."
    }
  ]
}
