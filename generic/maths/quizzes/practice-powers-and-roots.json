{
  "id": "practice-powers-and-roots",
  "title": "Practice: Powers and Roots",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Calculate: 2^5 + 3^3",
      "options": [
        { "id": "a", "text": "35" },
        { "id": "b", "text": "59" },
        { "id": "c", "text": "53" },
        { "id": "d", "text": "41" }
      ],
      "correctAnswer": "b",
      "explanation": "2^5 = 32 and 3^3 = 27. So 32 + 27 = 59."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A cube has volume 512 cm^3. What is the side length?",
      "options": [
        { "id": "a", "text": "7 cm" },
        { "id": "b", "text": "8 cm" },
        { "id": "c", "text": "9 cm" },
        { "id": "d", "text": "64 cm" }
      ],
      "correctAnswer": "b",
      "explanation": "Volume of a cube = side^3. So side = cube root of 512. Since 8^3 = 512, the side length is 8 cm."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "What is the value of (6^2 - 4^2) / sqrt(25)?",
      "options": [
        { "id": "a", "text": "4" },
        { "id": "b", "text": "2" },
        { "id": "c", "text": "10" },
        { "id": "d", "text": "20" }
      ],
      "correctAnswer": "a",
      "explanation": "6^2 = 36, 4^2 = 16, so 36 - 16 = 20. sqrt(25) = 5. Therefore 20 / 5 = 4."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Between which two consecutive integers does sqrt(55) lie?",
      "options": [
        { "id": "a", "text": "6 and 7" },
        { "id": "b", "text": "7 and 8" },
        { "id": "c", "text": "8 and 9" },
        { "id": "d", "text": "27 and 28" }
      ],
      "correctAnswer": "b",
      "explanation": "7^2 = 49 and 8^2 = 64. Since 49 < 55 < 64, we know sqrt(55) lies between 7 and 8."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "What is the value of (-5)^2 + (-2)^3?",
      "options": [
        { "id": "a", "text": "33" },
        { "id": "b", "text": "-33" },
        { "id": "c", "text": "17" },
        { "id": "d", "text": "-17" }
      ],
      "correctAnswer": "c",
      "explanation": "(-5)^2 = 25 (even power gives positive). (-2)^3 = -8 (odd power gives negative). So 25 + (-8) = 25 - 8 = 17."
    }
  ]
}
