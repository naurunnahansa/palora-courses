  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Calculate: 3/4 + 2/5",
      "options": [
        { "id": "a", "text": "5/9" },
        { "id": "b", "text": "23/20" },
        { "id": "c", "text": "1 and 3/20" },
        { "id": "d", "text": "5/20" }
      ],
      "correctAnswer": "c",
      "explanation": "Find common denominator 20: 3/4 = 15/20 and 2/5 = 8/20. So 15/20 + 8/20 = 23/20 = 1 and 3/20."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Calculate: 2/3 x 9/14",
      "options": [
        { "id": "a", "text": "3/7" },
        { "id": "b", "text": "18/42" },
        { "id": "c", "text": "9/21" },
        { "id": "d", "text": "11/17" }
      ],
      "correctAnswer": "a",
      "explanation": "2/3 x 9/14 = (2 x 9)/(3 x 14) = 18/42. Simplify by dividing both by 6: 3/7."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Calculate: 3 and 1/2 divided by 1 and 3/4",
      "options": [
        { "id": "a", "text": "1" },
        { "id": "b", "text": "2" },
        { "id": "c", "text": "6 and 1/8" },
        { "id": "d", "text": "2 and 1/4" }
      ],
      "correctAnswer": "b",
      "explanation": "Convert to improper fractions: 7/2 divided by 7/4. Dividing means multiply by reciprocal: 7/2 x 4/7 = 28/14 = 2."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Calculate: 5/6 - 3/8",
      "options": [
        { "id": "a", "text": "2/2" },
        { "id": "b", "text": "11/24" },
        { "id": "c", "text": "1/4" },
        { "id": "d", "text": "2/24" }
      ],
      "correctAnswer": "b",
      "explanation": "Common denominator is 24. 5/6 = 20/24 and 3/8 = 9/24. So 20/24 - 9/24 = 11/24."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A recipe needs 2/3 of a cup of flour. If you want to make 2 and 1/2 times the recipe, how much flour do you need?",
      "options": [
        { "id": "a", "text": "1 and 1/3 cups" },
        { "id": "b", "text": "1 and 2/3 cups" },
        { "id": "c", "text": "1 and 1/2 cups" },
        { "id": "d", "text": "2 cups" }
      ],
      "correctAnswer": "b",
      "explanation": "2/3 x 2 and 1/2 = 2/3 x 5/2 = 10/6 = 5/3 = 1 and 2/3 cups."
    }
  ]
