  "title": "Practice: Substitution",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Find the value of 3x^2 - 2x + 5 when x = -2.",
      "options": [
        { "id": "a", "text": "21" },
        { "id": "b", "text": "5" },
        { "id": "c", "text": "13" },
        { "id": "d", "text": "-3" }
      ],
      "correctAnswer": "a",
      "explanation": "3(-2)^2 - 2(-2) + 5 = 3(4) - (-4) + 5 = 12 + 4 + 5 = 21. Remember: (-2)^2 = 4, and subtracting a negative gives a positive."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Using v = u + at, find v when u = 15, a = -3 and t = 4.",
      "options": [
        { "id": "a", "text": "27" },
        { "id": "b", "text": "3" },
        { "id": "c", "text": "-3" },
        { "id": "d", "text": "48" }
      ],
      "correctAnswer": "b",
      "explanation": "v = u + at = 15 + (-3)(4) = 15 + (-12) = 15 - 12 = 3."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "If a = 5 and b = -3, find the value of (a^2 - b^2) / (a + b).",
      "options": [
        { "id": "a", "text": "8" },
        { "id": "b", "text": "2" },
        { "id": "c", "text": "16" },
        { "id": "d", "text": "-2" }
      ],
      "correctAnswer": "a",
      "explanation": "a^2 = 25, b^2 = 9. Numerator: 25 - 9 = 16. Denominator: 5 + (-3) = 2. So 16/2 = 8."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "The formula F = (9C)/5 + 32 converts Celsius to Fahrenheit. What is 35 degrees C in Fahrenheit?",
      "options": [
        { "id": "a", "text": "63 degrees F" },
        { "id": "b", "text": "95 degrees F" },
        { "id": "c", "text": "67 degrees F" },
        { "id": "d", "text": "127 degrees F" }
      ],
      "correctAnswer": "b",
      "explanation": "F = (9 x 35)/5 + 32 = 315/5 + 32 = 63 + 32 = 95 degrees F."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Find the value of sqrt(a^2 + b^2) when a = 5 and b = 12.",
      "options": [
        { "id": "a", "text": "17" },
        { "id": "b", "text": "13" },
        { "id": "c", "text": "169" },
        { "id": "d", "text": "8.5" }
      ],
      "correctAnswer": "b",
      "explanation": "a^2 + b^2 = 25 + 144 = 169. sqrt(169) = 13."
    }
  ]
