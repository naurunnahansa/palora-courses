  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Solve: 3x - 7 > 8",
      "options": [
        { "id": "a", "text": "x > 5" },
        { "id": "b", "text": "x > 1/3" },
        { "id": "c", "text": "x < 5" },
        { "id": "d", "text": "x > 15" }
      ],
      "correctAnswer": "a",
      "explanation": "3x - 7 > 8. Add 7: 3x > 15. Divide by 3: x > 5."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Solve: -2x + 5 >= 11",
      "options": [
        { "id": "a", "text": "x >= 3" },
        { "id": "b", "text": "x <= -3" },
        { "id": "c", "text": "x >= -3" },
        { "id": "d", "text": "x <= 3" }
      ],
      "correctAnswer": "b",
      "explanation": "-2x + 5 >= 11. Subtract 5: -2x >= 6. Divide by -2 (flip the inequality): x <= -3. Remember: dividing by a negative reverses the sign!"
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Find the largest integer n such that 5n - 3 < 28.",
      "options": [
        { "id": "a", "text": "5" },
        { "id": "b", "text": "6" },
        { "id": "c", "text": "7" },
        { "id": "d", "text": "4" }
      ],
      "correctAnswer": "b",
      "explanation": "5n < 31. n < 6.2. The largest integer less than 6.2 is 6."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Solve the double inequality: -3 < 2x + 1 <= 9",
      "options": [
        { "id": "a", "text": "-2 < x <= 4" },
        { "id": "b", "text": "-1 < x <= 5" },
        { "id": "c", "text": "-2 <= x < 4" },
        { "id": "d", "text": "-1 < x <= 4" }
      ],
      "correctAnswer": "a",
      "explanation": "Subtract 1 throughout: -4 < 2x <= 8. Divide by 2: -2 < x <= 4."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "List the integer values of n that satisfy: -2 <= 3n - 1 < 11",
