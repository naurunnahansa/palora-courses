{
  "id": "check-pie-charts",
  "title": "Check: Pie Charts",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "$40$ students were asked about their favourite sport. Football was chosen by $15$ students. What angle should the football sector be on a pie chart?",
      "options": [
        { "id": "a", "text": "$15°$" },
        { "id": "b", "text": "$100°$" },
        { "id": "c", "text": "$135°$" },
        { "id": "d", "text": "$150°$" }
      ],
      "correctAnswer": "c",
      "explanation": "Angle $= \\frac{15}{40} \\times 360° = \\frac{5400°}{40} = 135°$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A pie chart sector has an angle of $90°$. What fraction of the total does it represent?",
      "options": [
        { "id": "a", "text": "$\\frac{1}{2}$" },
        { "id": "b", "text": "$\\frac{1}{3}$" },
        { "id": "c", "text": "$\\frac{1}{4}$" },
        { "id": "d", "text": "$\\frac{1}{6}$" }
      ],
      "correctAnswer": "c",
      "explanation": "$\\frac{90°}{360°} = \\frac{1}{4}$. A $90°$ sector represents one quarter of the total."
    }
  ]
}