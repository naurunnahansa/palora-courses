{
  "id": "check-trigonometric-ratios-2",
  "title": "Check: Trigonometric Ratios",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the adjacent side to angle $\\theta$ is $8$ and the opposite side is $6$. What is $\\tan\\theta$?",
      "options": [
        { "id": "a", "text": "$\\frac{8}{6}$" },
        { "id": "b", "text": "$\\frac{6}{10}$" },
        { "id": "c", "text": "$\\frac{6}{8}$" },
        { "id": "d", "text": "$\\frac{8}{10}$" }
      ],
      "correctAnswer": "c",
      "explanation": "$\\tan\\theta = \\frac{\\text{opposite}}{\\text{adjacent}} = \\frac{6}{8} = \\frac{3}{4}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which sides of a right-angled triangle do you need to use $\\sin\\theta$ if you know the hypotenuse and want to find the opposite side?",
      "options": [
        { "id": "a", "text": "Use $\\cos\\theta$ instead" },
        { "id": "b", "text": "Opposite $= \\text{hypotenuse} \\times \\sin\\theta$" },
        { "id": "c", "text": "Opposite $= \\frac{\\text{hypotenuse}}{\\sin\\theta}$" },
        { "id": "d", "text": "Opposite $= \\text{hypotenuse} \\times \\cos\\theta$" }
      ],
      "correctAnswer": "b",
      "explanation": "Since $\\sin\\theta = \\frac{\\text{opposite}}{\\text{hypotenuse}}$, rearranging gives opposite $= \\text{hypotenuse} \\times \\sin\\theta$."
    }
  ]
}