  "title": "Check: Functions and Notation",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $f(x) = 2x + 3$, what is $f(4)$?",
      "options": [
        { "id": "a", "text": "$8$" },
        { "id": "b", "text": "$11$" },
        { "id": "c", "text": "$14$" },
        { "id": "d", "text": "$7$" }
      ],
      "correctAnswer": "b",
      "explanation": "Substitute $x = 4$: $f(4) = 2(4) + 3 = 8 + 3 = 11$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $f(x) = x^2 - 1$, find the value of $x$ for which $f(x) = 0$.",
      "options": [
        { "id": "a", "text": "$x = 0$ only" },
        { "id": "b", "text": "$x = 1$ or $x = -1$" },
        { "id": "c", "text": "$x = 1$ only" },
        { "id": "d", "text": "$x = -1$ only" }
      ],
      "correctAnswer": "b",
      "explanation": "Set $f(x) = 0$: $x^2 - 1 = 0$. Factorise: $(x-1)(x+1) = 0$. So $x = 1$ or $x = -1$."
    }
  ]
}
