      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $\\mathbf{a} = \\begin{pmatrix} 2 \\\\ 5 \\end{pmatrix}$ and $\\mathbf{b} = \\begin{pmatrix} -3 \\\\ 1 \\end{pmatrix}$, what is $\\mathbf{a} + \\mathbf{b}$?",
      "options": [
        {
          "id": "a",
          "text": "$\\begin{pmatrix} -1 \\\\ 6 \\end{pmatrix}$"
        },
        {
          "id": "b",
          "text": "$\\begin{pmatrix} 5 \\\\ 4 \\end{pmatrix}$"
        },
        {
          "id": "c",
          "text": "$\\begin{pmatrix} 5 \\\\ 6 \\end{pmatrix}$"
        },
        {
          "id": "d",
          "text": "$\\begin{pmatrix} -1 \\\\ 4 \\end{pmatrix}$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Add the corresponding components: $\\begin{pmatrix} 2 + (-3) \\\\ 5 + 1 \\end{pmatrix} = \\begin{pmatrix} -1 \\\\ 6 \\end{pmatrix}$."
    }
  ]
