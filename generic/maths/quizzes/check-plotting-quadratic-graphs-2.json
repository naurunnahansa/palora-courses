  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The graph of $y = -x^2 + 3$ opens:",
      "options": [
        { "id": "a", "text": "Upwards" },
        { "id": "b", "text": "Downwards" },
        { "id": "c", "text": "To the right" },
        { "id": "d", "text": "To the left" }
      ],
      "correctAnswer": "b",
      "explanation": "When the coefficient of $x^2$ is negative (here $-1$), the parabola opens downwards (inverted U-shape)."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "For $y = x^2 + 2x - 3$, what is the $y$-intercept?",
      "options": [
        { "id": "a", "text": "$2$" },
        { "id": "b", "text": "$-3$" },
        { "id": "c", "text": "$1$" },
        { "id": "d", "text": "$0$" }
      ],
      "correctAnswer": "b",
      "explanation": "The $y$-intercept occurs when $x = 0$: $y = 0 + 0 - 3 = -3$. In $y = ax^2 + bx + c$, the $y$-intercept is always $c$."
    }
  ]
