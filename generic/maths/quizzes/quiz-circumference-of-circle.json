{
  "id": "quiz-circumference-of-circle",
  "title": "Quiz: Circumference of a Circle",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A circle has a radius of $5$ cm. What is its circumference? (Give your answer in terms of $\\pi$.)",
      "options": [
        {"id": "a", "text": "$5\\pi$ cm"},
        {"id": "b", "text": "$10\\pi$ cm"},
        {"id": "c", "text": "$25\\pi$ cm"},
        {"id": "d", "text": "$20\\pi$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "Circumference $= 2\\pi r = 2\\pi(5) = 10\\pi$ cm."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A circle has a diameter of $14$ cm. What is its circumference to $1$ decimal place? (Use $\\pi = 3.14$)",
      "options": [
        {"id": "a", "text": "$43.96$ cm"},
        {"id": "b", "text": "$44.0$ cm"},
        {"id": "c", "text": "$87.9$ cm"},
        {"id": "d", "text": "$21.98$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "Circumference $= \\pi d = 3.14 \\times 14 = 43.96 \\approx 44.0$ cm."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which formula gives the circumference of a circle?",
      "options": [
        {"id": "a", "text": "$C = \\pi r^2$"},
        {"id": "b", "text": "$C = 2\\pi r$"},
        {"id": "c", "text": "$C = \\pi d^2$"},
        {"id": "d", "text": "$C = 4\\pi r$"}
      ],
      "correctAnswer": "b",
      "explanation": "The circumference of a circle is $C = 2\\pi r$ or equivalently $C = \\pi d$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A circle has a circumference of $31.4$ cm. What is the radius? (Use $\\pi = 3.14$)",
      "options": [
        {"id": "a", "text": "$5$ cm"},
        {"id": "b", "text": "$10$ cm"},
        {"id": "c", "text": "$15.7$ cm"},
        {"id": "d", "text": "$100$ cm"}
      ],
      "correctAnswer": "a",
      "explanation": "$r = \\frac{C}{2\\pi} = \\frac{31.4}{2 \\times 3.14} = 5$ cm."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A wheel has a diameter of $0.5$ m. How far does it travel in one complete revolution? (Use $\\pi = 3.14$)",
      "options": [
        {"id": "a", "text": "$0.785$ m"},
        {"id": "b", "text": "$1.57$ m"},
        {"id": "c", "text": "$3.14$ m"},
        {"id": "d", "text": "$0.25$ m"}
      ],
      "correctAnswer": "b",
      "explanation": "One revolution covers the circumference: $\\pi d = 3.14 \\times 0.5 = 1.57$ m."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A semicircular shape has a diameter of $8$ cm. What is its total perimeter? (Use $\\pi = 3.14$)",
      "options": [
        {"id": "a", "text": "$12.56$ cm"},
        {"id": "b", "text": "$20.56$ cm"},
        {"id": "c", "text": "$25.12$ cm"},
        {"id": "d", "text": "$8$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "Perimeter $=$ half the circumference $+$ the diameter $= \\frac{\\pi \\times 8}{2} + 8 = 12.56 + 8 = 20.56$ cm."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If the radius of a circle is doubled, the circumference:",
      "options": [
        {"id": "a", "text": "Stays the same"},
        {"id": "b", "text": "Doubles"},
        {"id": "c", "text": "Quadruples"},
        {"id": "d", "text": "Halves"}
      ],
      "correctAnswer": "b",
      "explanation": "$C = 2\\pi r$. If $r$ doubles to $2r$, then $C = 2\\pi(2r) = 4\\pi r$, which is double the original circumference."
    }
  ]
}
