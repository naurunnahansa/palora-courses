{
  "id": "check-volume-cylinders",
  "title": "Check: Volume of Cylinders",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the volume of a cylinder with radius $4\\text{ cm}$ and height $10\\text{ cm}$? Give your answer in terms of $\\pi$.",
      "options": [
        { "id": "a", "text": "$40\\pi\\text{ cm}^3$" },
        { "id": "b", "text": "$80\\pi\\text{ cm}^3$" },
        { "id": "c", "text": "$160\\pi\\text{ cm}^3$" },
        { "id": "d", "text": "$400\\pi\\text{ cm}^3$" }
      ],
      "correctAnswer": "c",
      "explanation": "Volume $= \\pi r^2 h = \\pi \\times 16 \\times 10 = 160\\pi\\text{ cm}^3$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which formula gives the volume of a cylinder?",
      "options": [
        { "id": "a", "text": "$2\\pi rh$" },
        { "id": "b", "text": "$\\pi r^2 h$" },
        { "id": "c", "text": "$\\frac{1}{3}\\pi r^2 h$" },
        { "id": "d", "text": "$\\pi r h^2$" }
      ],
      "correctAnswer": "b",
      "explanation": "The volume of a cylinder is $\\pi r^2 h$, which is the area of the circular cross-section ($\\pi r^2$) multiplied by the height ($h$)."
    }
  ]
}