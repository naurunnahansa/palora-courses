  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Two vectors are equal if and only if they have:",
      "options": [
        { "id": "a", "text": "The same magnitude" },
        { "id": "b", "text": "The same direction" },
        { "id": "c", "text": "The same magnitude and direction" },
        { "id": "d", "text": "The same starting point" }
      ],
      "correctAnswer": "c",
      "explanation": "Two vectors are equal if they have both the same magnitude and the same direction. Their starting points can be different — vectors are free to be translated without changing their identity."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $\\mathbf{a} = \\begin{pmatrix} -5 \\\\ 12 \\end{pmatrix}$, what is $|\\mathbf{a}|$?",
      "options": [
        { "id": "a", "text": "$7$" },
        { "id": "b", "text": "$17$" },
        { "id": "c", "text": "$13$" },
        { "id": "d", "text": "$\\sqrt{17}$" }
      ],
      "correctAnswer": "c",
      "explanation": "$|\\mathbf{a}| = \\sqrt{(-5)^2 + 12^2} = \\sqrt{25 + 144} = \\sqrt{169} = 13$."
    }
  ]
