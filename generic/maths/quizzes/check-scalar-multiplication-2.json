{
  "id": "check-scalar-multiplication-2",
  "title": "Check: Scalar Multiplication",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Given $\\mathbf{a} = \\begin{pmatrix} 2 \\\\ -3 \\end{pmatrix}$ and $\\mathbf{b} = \\begin{pmatrix} -6 \\\\ 9 \\end{pmatrix}$, which statement is true?",
      "options": [
        { "id": "a", "text": "$\\mathbf{b} = 3\\mathbf{a}$" },
        { "id": "b", "text": "$\\mathbf{b} = -3\\mathbf{a}$" },
        { "id": "c", "text": "$\\mathbf{a}$ and $\\mathbf{b}$ are not parallel" },
        { "id": "d", "text": "$\\mathbf{b} = -2\\mathbf{a}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$-3\\mathbf{a} = -3\\begin{pmatrix} 2 \\\\ -3 \\end{pmatrix} = \\begin{pmatrix} -6 \\\\ 9 \\end{pmatrix} = \\mathbf{b}$. So $\\mathbf{b} = -3\\mathbf{a}$, and the vectors are parallel (pointing in opposite directions)."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $2\\mathbf{a} + 3\\mathbf{b} = \\begin{pmatrix} 13 \\\\ 1 \\end{pmatrix}$ and $\\mathbf{a} = \\begin{pmatrix} 2 \\\\ -1 \\end{pmatrix}$, find $\\mathbf{b}$.",
      "options": [
        { "id": "a", "text": "$\\begin{pmatrix} 3 \\\\ 1 \\end{pmatrix}$" },
        { "id": "b", "text": "$\\begin{pmatrix} 9 \\\\ 3 \\end{pmatrix}$" },
        { "id": "c", "text": "$\\begin{pmatrix} 3 \\\\ -1 \\end{pmatrix}$" },
        { "id": "d", "text": "$\\begin{pmatrix} 1 \\\\ 3 \\end{pmatrix}$" }
      ],
      "correctAnswer": "a",
      "explanation": "$2\\mathbf{a} = \\begin{pmatrix} 4 \\\\ -2 \\end{pmatrix}$. So $3\\mathbf{b} = \\begin{pmatrix} 13 \\\\ 1 \\end{pmatrix} - \\begin{pmatrix} 4 \\\\ -2 \\end{pmatrix} = \\begin{pmatrix} 9 \\\\ 3 \\end{pmatrix}$. Therefore $\\mathbf{b} = \\begin{pmatrix} 3 \\\\ 1 \\end{pmatrix}$."
    }
  ]
}