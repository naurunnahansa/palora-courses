  "title": "Quiz: Sequences: The nth Term (Linear)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Find the nth term of the sequence 5, 8, 11, 14, ...",
      "options": [
        {
          "id": "a",
          "text": "$3n + 5$"
        },
        {
          "id": "b",
          "text": "$3n - 2$"
        },
        {
          "id": "c",
          "text": "$5n + 3$"
        },
        {
          "id": "d",
          "text": "$3n + 2$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Common difference is 3, so start with $3n$. When $n = 1$: $3(1) = 3$, but the first term is 5, so add 2. The nth term is $3n + 2$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Find the nth term of the sequence 20, 17, 14, 11, ...",
      "options": [
        {
          "id": "a",
          "text": "$20 - 3n$"
        },
        {
          "id": "b",
          "text": "$3n - 20$"
        },
        {
          "id": "c",
          "text": "$17 - 3n$"
        },
        {
          "id": "d",
          "text": "$23 - 3n$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Common difference is $-3$, so start with $-3n$. When $n = 1$: $-3(1) = -3$, but the first term is 20, so add 23. The nth term is $23 - 3n$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The nth term of a sequence is $4n - 1$. What is the 25th term?",
      "options": [
        {
          "id": "a",
          "text": "100"
        },
        {
          "id": "b",
          "text": "96"
        },
        {
          "id": "c",
          "text": "101"
        },
        {
          "id": "d",
          "text": "99"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Substitute $n = 25$: $4(25) - 1 = 100 - 1 = 99$."
    },
