      "stem": "What are the first 4 terms of the sequence with nth term $10 - 2n$?",
      "options": [
        {
          "id": "a",
          "text": "8, 16, 24, 32"
        },
        {
          "id": "b",
          "text": "10, 8, 6, 4"
        },
        {
          "id": "c",
          "text": "8, 6, 4, 2"
        },
        {
          "id": "d",
          "text": "12, 14, 16, 18"
        }
      ],
      "correctAnswer": "c",
      "explanation": "$n = 1$: $10 - 2 = 8$. $n = 2$: $10 - 4 = 6$. $n = 3$: $10 - 6 = 4$. $n = 4$: $10 - 8 = 2$."
    },
    {
