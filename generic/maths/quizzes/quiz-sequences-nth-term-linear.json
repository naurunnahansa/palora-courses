    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "An arithmetic sequence has 3rd term 11 and 7th term 27. What is the common difference?",
      "options": [
        {
          "id": "a",
          "text": "3"
        },
        {
          "id": "b",
          "text": "8"
        },
        {
          "id": "c",
          "text": "2"
        },
        {
          "id": "d",
          "text": "4"
        }
      ],
      "correctAnswer": "d",
      "explanation": "The difference between the 3rd and 7th terms is $27 - 11 = 16$. There are $7 - 3 = 4$ gaps between them. Common difference $= 16 \\div 4 = 4$."
    },
    {
      "id": "q6",
