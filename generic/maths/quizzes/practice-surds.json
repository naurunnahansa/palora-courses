{
  "id": "practice-surds",
  "title": "Practice: Surds",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Simplify sqrt(72) + sqrt(18).",
      "options": [
        { "id": "a", "text": "sqrt(90)" },
        { "id": "b", "text": "9*sqrt(2)" },
        { "id": "c", "text": "6*sqrt(2) + 3*sqrt(2)" },
        { "id": "d", "text": "3*sqrt(10)" }
      ],
      "correctAnswer": "b",
      "explanation": "sqrt(72) = sqrt(36 x 2) = 6*sqrt(2). sqrt(18) = sqrt(9 x 2) = 3*sqrt(2). So 6*sqrt(2) + 3*sqrt(2) = 9*sqrt(2). Note: sqrt(a) + sqrt(b) does NOT equal sqrt(a+b)."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Expand and simplify (3 + sqrt(5))(3 - sqrt(5)).",
      "options": [
        { "id": "a", "text": "4" },
        { "id": "b", "text": "9 - 5" },
        { "id": "c", "text": "14" },
        { "id": "d", "text": "9 + 5" }
      ],
      "correctAnswer": "a",
      "explanation": "This is the difference of squares pattern: (a + b)(a - b) = a^2 - b^2. So (3 + sqrt(5))(3 - sqrt(5)) = 9 - 5 = 4."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Rationalise the denominator of 6 / sqrt(3).",
      "options": [
        { "id": "a", "text": "6*sqrt(3) / 3" },
        { "id": "b", "text": "2*sqrt(3)" },
        { "id": "c", "text": "6*sqrt(3)" },
        { "id": "d", "text": "2 / sqrt(3)" }
      ],
      "correctAnswer": "b",
      "explanation": "Multiply top and bottom by sqrt(3): (6 x sqrt(3)) / (sqrt(3) x sqrt(3)) = 6*sqrt(3) / 3 = 2*sqrt(3)."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Expand and simplify (2 + sqrt(3))^2.",
      "options": [
        { "id": "a", "text": "7 + 4*sqrt(3)" },
        { "id": "b", "text": "4 + 3" },
        { "id": "c", "text": "7 + 2*sqrt(3)" },
        { "id": "d", "text": "4 + 4*sqrt(3) + 3" }
      ],
      "correctAnswer": "a",
      "explanation": "(2 + sqrt(3))^2 = 4 + 2(2)(sqrt(3)) + 3 = 4 + 4*sqrt(3) + 3 = 7 + 4*sqrt(3). Option d shows the unsimplified form; the simplified answer is 7 + 4*sqrt(3)."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Rationalise the denominator of 1 / (3 + sqrt(2)).",
      "options": [
        { "id": "a", "text": "(3 - sqrt(2)) / 11" },
        { "id": "b", "text": "(3 - sqrt(2)) / 7" },
        { "id": "c", "text": "(3 + sqrt(2)) / 7" },
        { "id": "d", "text": "(3 - sqrt(2)) / 9" }
      ],
      "correctAnswer": "b",
      "explanation": "Multiply top and bottom by the conjugate (3 - sqrt(2)): 1(3 - sqrt(2)) / ((3 + sqrt(2))(3 - sqrt(2))) = (3 - sqrt(2)) / (9 - 2) = (3 - sqrt(2)) / 7."
    }
  ]
}
