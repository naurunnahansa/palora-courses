    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Express $\\frac{7}{20}$ as a percentage.",
      "options": [
        { "id": "a", "text": "$7\\%$" },
        { "id": "b", "text": "$14\\%$" },
        { "id": "c", "text": "$35\\%$" },
        { "id": "d", "text": "$70\\%$" }
      ],
      "correctAnswer": "c",
      "explanation": "$\\frac{7}{20} = \\frac{7 \\times 5}{20 \\times 5} = \\frac{35}{100} = 35\\%$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A shirt costs $£40$ and is reduced by $20\\%$. What is the sale price?",
      "options": [
        { "id": "a", "text": "$£8$" },
        { "id": "b", "text": "$£20$" },
        { "id": "c", "text": "$£32$" },
        { "id": "d", "text": "$£36$" }
      ],
      "correctAnswer": "c",
      "explanation": "$20\\%$ of $£40 = £8$. Sale price $= £40 - £8 = £32$. Alternatively, $80\\%$ of $£40 = 0.80 \\times 40 = £32$."
    }
  ]
