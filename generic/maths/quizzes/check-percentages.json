      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $15\\%$ of $£240$?",
      "options": [
        { "id": "a", "text": "$£24$" },
        { "id": "b", "text": "$£36$" },
        { "id": "c", "text": "$£48$" },
