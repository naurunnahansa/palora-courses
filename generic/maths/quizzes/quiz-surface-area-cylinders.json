{
  "id": "quiz-surface-area-cylinders",
  "title": "Quiz: Surface Area of Cylinders",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cylinder has radius $3$ cm and height $10$ cm. What is its curved surface area in terms of $\\pi$?",
      "options": [
        {"id": "a", "text": "$30\\pi$ cm$^2$"},
        {"id": "b", "text": "$60\\pi$ cm$^2$"},
        {"id": "c", "text": "$90\\pi$ cm$^2$"},
        {"id": "d", "text": "$9\\pi$ cm$^2$"}
      ],
      "correctAnswer": "b",
      "explanation": "Curved surface area $= 2\\pi rh = 2\\pi(3)(10) = 60\\pi$ cm$^2$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cylinder has radius $5$ cm and height $8$ cm. What is its total surface area in terms of $\\pi$?",
      "options": [
        {"id": "a", "text": "$80\\pi$ cm$^2$"},
        {"id": "b", "text": "$130\\pi$ cm$^2$"},
        {"id": "c", "text": "$105\\pi$ cm$^2$"},
        {"id": "d", "text": "$65\\pi$ cm$^2$"}
      ],
      "correctAnswer": "b",
      "explanation": "Total surface area $= 2\\pi rh + 2\\pi r^2 = 2\\pi(5)(8) + 2\\pi(25) = 80\\pi + 50\\pi = 130\\pi$ cm$^2$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The curved surface of a cylinder, when unrolled, forms a:",
      "options": [
        {"id": "a", "text": "Circle"},
        {"id": "b", "text": "Triangle"},
        {"id": "c", "text": "Rectangle"},
        {"id": "d", "text": "Trapezium"}
      ],
      "correctAnswer": "c",
      "explanation": "When unrolled, the curved surface forms a rectangle with width equal to the circumference ($2\\pi r$) and height equal to the cylinder's height."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cylindrical tin has radius $4$ cm and height $12$ cm. It has no lid. What is its total outer surface area? (Use $\\pi = 3.14$)",
      "options": [
        {"id": "a", "text": "$351.7$ cm$^2$"},
        {"id": "b", "text": "$301.4$ cm$^2$"},
        {"id": "c", "text": "$401.9$ cm$^2$"},
        {"id": "d", "text": "$251.2$ cm$^2$"}
      ],
      "correctAnswer": "a",
      "explanation": "Curved surface $= 2\\pi rh = 2(3.14)(4)(12) = 301.44$ cm$^2$. One circular base $= \\pi r^2 = 3.14 \\times 16 = 50.24$ cm$^2$. Total $= 301.44 + 50.24 = 351.68 \\approx 351.7$ cm$^2$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cylinder has a total surface area of $96\\pi$ cm$^2$ and a radius of $4$ cm. What is its height?",
      "options": [
        {"id": "a", "text": "$6$ cm"},
        {"id": "b", "text": "$8$ cm"},
        {"id": "c", "text": "$10$ cm"},
        {"id": "d", "text": "$12$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "$96\\pi = 2\\pi(4)h + 2\\pi(16) = 8\\pi h + 32\\pi$. So $8\\pi h = 64\\pi$, giving $h = 8$ cm."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which part of the cylinder surface area formula $2\\pi r^2 + 2\\pi rh$ represents the two circular ends?",
      "options": [
        {"id": "a", "text": "$2\\pi rh$"},
        {"id": "b", "text": "$2\\pi r^2$"},
        {"id": "c", "text": "$\\pi r^2$"},
        {"id": "d", "text": "$\\pi rh$"}
      ],
      "correctAnswer": "b",
      "explanation": "$2\\pi r^2$ is the area of the two circular ends (each has area $\\pi r^2$). The term $2\\pi rh$ is the curved surface area."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cylinder has radius $r$ and height $2r$. Its total surface area in terms of $r$ is:",
      "options": [
        {"id": "a", "text": "$4\\pi r^2$"},
        {"id": "b", "text": "$6\\pi r^2$"},
        {"id": "c", "text": "$8\\pi r^2$"},
        {"id": "d", "text": "$5\\pi r^2$"}
      ],
      "correctAnswer": "b",
      "explanation": "Total $= 2\\pi r(2r) + 2\\pi r^2 = 4\\pi r^2 + 2\\pi r^2 = 6\\pi r^2$."
    }
  ]
}
