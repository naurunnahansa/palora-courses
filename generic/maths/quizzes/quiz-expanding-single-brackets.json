{
  "id": "quiz-expanding-single-brackets",
  "title": "Quiz: Expanding Single Brackets",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Expand $3(x + 4)$.",
      "options": [
        {"id": "a", "text": "$3x + 4$"},
        {"id": "b", "text": "$3x + 12$"},
        {"id": "c", "text": "$3x + 7$"},
        {"id": "d", "text": "$x + 12$"}
      ],
      "correctAnswer": "b",
      "explanation": "Multiply everything inside the bracket by 3: $3 \\times x + 3 \\times 4 = 3x + 12$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Expand $-2(3x - 5)$.",
      "options": [
        {"id": "a", "text": "$-6x - 10$"},
        {"id": "b", "text": "$-6x - 5$"},
        {"id": "c", "text": "$-6x + 10$"},
        {"id": "d", "text": "$6x - 10$"}
      ],
      "correctAnswer": "c",
      "explanation": "$-2 \\times 3x = -6x$ and $-2 \\times (-5) = +10$. So $-2(3x - 5) = -6x + 10$. Remember: negative times negative equals positive."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Expand $x(x + 5)$.",
      "options": [
        {"id": "a", "text": "$x^2 + 5$"},
        {"id": "b", "text": "$x^2 + 5x$"},
        {"id": "c", "text": "$2x + 5$"},
        {"id": "d", "text": "$x + 5x$"}
      ],
      "correctAnswer": "b",
      "explanation": "$x \\times x = x^2$ and $x \\times 5 = 5x$. So $x(x + 5) = x^2 + 5x$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Expand and simplify $2(x + 3) + 3(x - 1)$.",
      "options": [
        {"id": "a", "text": "$5x + 3$"},
        {"id": "b", "text": "$5x + 9$"},
        {"id": "c", "text": "$5x + 2$"},
        {"id": "d", "text": "$6x + 3$"}
      ],
      "correctAnswer": "a",
      "explanation": "Expand each bracket: $2x + 6 + 3x - 3$. Collect like terms: $5x + 3$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Expand $4a(2a - 3b)$.",
      "options": [
        {"id": "a", "text": "$8a - 12b$"},
        {"id": "b", "text": "$8a^2 - 3b$"},
        {"id": "c", "text": "$8a^2 - 12ab$"},
        {"id": "d", "text": "$6a^2 - 7ab$"}
      ],
      "correctAnswer": "c",
      "explanation": "$4a \\times 2a = 8a^2$ and $4a \\times (-3b) = -12ab$. So $4a(2a - 3b) = 8a^2 - 12ab$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Expand and simplify $5(2y + 1) - 3(y - 4)$.",
      "options": [
        {"id": "a", "text": "$7y - 3$"},
        {"id": "b", "text": "$7y + 17$"},
        {"id": "c", "text": "$7y - 7$"},
        {"id": "d", "text": "$13y + 17$"}
      ],
      "correctAnswer": "b",
      "explanation": "Expand: $10y + 5 - 3y + 12$. Collect like terms: $(10y - 3y) + (5 + 12) = 7y + 17$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Expand $-x(2x - 7)$.",
      "options": [
        {"id": "a", "text": "$-2x^2 - 7x$"},
        {"id": "b", "text": "$-2x^2 + 7x$"},
        {"id": "c", "text": "$2x^2 - 7x$"},
        {"id": "d", "text": "$2x^2 + 7x$"}
      ],
      "correctAnswer": "b",
      "explanation": "$-x \\times 2x = -2x^2$ and $-x \\times (-7) = +7x$. So $-x(2x - 7) = -2x^2 + 7x$."
    }
  ]
}
