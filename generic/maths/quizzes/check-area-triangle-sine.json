      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A triangle has sides $a = 8\\text{ cm}$ and $b = 12\\text{ cm}$ with an included angle of $30°$. What is its area?",
      "options": [
        { "id": "a", "text": "$48\\text{ cm}^2$" },
        { "id": "b", "text": "$24\\text{ cm}^2$" },
        { "id": "c", "text": "$24\\sqrt{3}\\text{ cm}^2$" },
        { "id": "d", "text": "$96\\text{ cm}^2$" }
      ],
      "correctAnswer": "b",
      "explanation": "Area $= \\frac{1}{2} \\times 8 \\times 12 \\times \\sin 30° = \\frac{1}{2} \\times 8 \\times 12 \\times 0.5 = 24\\text{ cm}^2$."
