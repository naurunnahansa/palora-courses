  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "From a Venn diagram: $n(A \\cap B) = 6$, $n(B) = 15$, $n(\\xi) = 40$. What is $P(A\\,|\\,B)$?",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{6}{15}$"
        },
        {
          "id": "b",
          "text": "$\\frac{15}{6}$"
        },
        {
          "id": "c",
          "text": "$\\frac{15}{40}$"
        },
        {
          "id": "d",
          "text": "$\\frac{6}{40}$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "$P(A\\,|\\,B) = \\frac{P(A \\cap B)}{P(B)} = \\frac{n(A \\cap B)}{n(B)} = \\frac{6}{15} = \\frac{2}{5}$."
    }
  ]
