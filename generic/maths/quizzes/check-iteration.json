      "difficulty": "knowledge-check",
      "stem": "The iterative formula $x_{n+1} = \\frac{x_n^2 + 3}{4}$ with $x_0 = 1$. What is $x_1$?",
      "options": [
        {
          "id": "a",
          "text": "$0.5$"
        },
        {
          "id": "b",
          "text": "$1$"
        },
