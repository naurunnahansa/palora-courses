{
  "id": "quiz-histograms",
  "title": "Quiz: Histograms",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a histogram, the $y$-axis shows:",
      "options": [
        {
          "id": "a",
          "text": "Frequency density"
        },
        {
          "id": "b",
          "text": "Cumulative frequency"
        },
        {
          "id": "c",
          "text": "Relative frequency"
        },
        {
          "id": "d",
          "text": "Frequency"
        }
      ],
      "correctAnswer": "a",
      "explanation": "The $y$-axis of a histogram shows frequency density, not frequency. This ensures fair representation when class widths are unequal."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Frequency density is calculated as:",
      "options": [
        {
          "id": "a",
          "text": "Frequency $\\div$ class width"
        },
        {
          "id": "b",
          "text": "Frequency $\\times$ class width"
        },
        {
          "id": "c",
          "text": "Frequency $\\div$ total frequency"
        },
        {
          "id": "d",
          "text": "Class width $\\div$ frequency"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Frequency density $= \\frac{\\text{frequency}}{\\text{class width}}$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a histogram, the frequency of a class is represented by:",
      "options": [
        {
          "id": "a",
          "text": "The colour of the bar"
        },
        {
          "id": "b",
          "text": "The height of the bar"
        },
        {
          "id": "c",
          "text": "The area of the bar"
        },
        {
          "id": "d",
          "text": "The width of the bar"
        }
      ],
      "correctAnswer": "c",
      "explanation": "In a histogram, frequency $=$ area $=$ frequency density $\\times$ class width. The area of each bar gives the frequency."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A histogram bar has class width 10 and frequency density 3. What is the frequency?",
      "options": [
        {
          "id": "a",
          "text": "30"
        },
        {
          "id": "b",
          "text": "0.3"
        },
        {
          "id": "c",
          "text": "10"
        },
        {
          "id": "d",
          "text": "3"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Frequency $=$ frequency density $\\times$ class width $= 3 \\times 10 = 30$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Why must histograms have no gaps between bars?",
      "options": [
        {
          "id": "a",
          "text": "Because histograms display continuous data where values can take any value in the range"
        },
        {
          "id": "b",
          "text": "Because gaps would make the chart too wide"
        },
        {
          "id": "c",
          "text": "To make them look different from bar charts"
        },
        {
          "id": "d",
          "text": "Because the bars represent percentages"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Histograms display continuous data. Since the data has no gaps between values, the bars are adjacent to reflect this continuity."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A class has width 5 and frequency 20. Another class has width 20 and frequency 20. Which has the taller bar on a histogram?",
      "options": [
        {
          "id": "a",
          "text": "They have the same height"
        },
        {
          "id": "b",
          "text": "It depends on the total frequency"
        },
        {
          "id": "c",
          "text": "The second class (width 20)"
        },
        {
          "id": "d",
          "text": "The first class (width 5)"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Frequency density: first $= \\frac{20}{5} = 4$, second $= \\frac{20}{20} = 1$. The narrower class has a much taller bar because its data is more densely packed."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The total area under a histogram equals:",
      "options": [
        {
          "id": "a",
          "text": "1"
        },
        {
          "id": "b",
          "text": "The number of class intervals"
        },
        {
          "id": "c",
          "text": "The total frequency"
        },
        {
          "id": "d",
          "text": "The range of the data"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Since each bar's area equals its frequency, the total area under the histogram equals the total frequency (total number of data items)."
    }
  ]
}
