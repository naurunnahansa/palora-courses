{
  "id": "practice-simultaneous-equations-substitution",
  "title": "Practice: Simultaneous Equations (Substitution)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Solve: y = 3x - 1 and 2x + y = 9",
      "options": [
        { "id": "a", "text": "x = 2, y = 5" },
        { "id": "b", "text": "x = 3, y = 8" },
        { "id": "c", "text": "x = 1, y = 2" },
        { "id": "d", "text": "x = 4, y = 1" }
      ],
      "correctAnswer": "a",
      "explanation": "Substitute y = 3x - 1 into 2x + y = 9: 2x + 3x - 1 = 9. 5x = 10. x = 2. y = 3(2) - 1 = 5. Check: 2(2) + 5 = 9."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Solve: x + 2y = 10 and 3x - y = 2",
      "options": [
        { "id": "a", "text": "x = 4, y = 3" },
        { "id": "b", "text": "x = 2, y = 4" },
        { "id": "c", "text": "x = 6, y = 2" },
        { "id": "d", "text": "x = 0, y = 5" }
      ],
      "correctAnswer": "b",
      "explanation": "From first: x = 10 - 2y. Substitute: 3(10 - 2y) - y = 2. 30 - 6y - y = 2. -7y = -28. y = 4. x = 10 - 8 = 2. Check: 3(2) - 4 = 2."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A rectangle has perimeter 28 cm and its length is 4 cm more than its width. Find the length.",
      "options": [
        { "id": "a", "text": "7 cm" },
        { "id": "b", "text": "9 cm" },
        { "id": "c", "text": "12 cm" },
        { "id": "d", "text": "5 cm" }
      ],
      "correctAnswer": "b",
      "explanation": "Let width = w, length = w + 4. Perimeter: 2(w + w + 4) = 28. 2(2w + 4) = 28. 4w + 8 = 28. 4w = 20. w = 5. Length = 5 + 4 = 9 cm."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Solve: y = x + 5 and y = 2x + 1",
      "options": [
        { "id": "a", "text": "x = 4, y = 9" },
        { "id": "b", "text": "x = -4, y = 1" },
        { "id": "c", "text": "x = 6, y = 11" },
        { "id": "d", "text": "x = 2, y = 7" }
      ],
      "correctAnswer": "a",
      "explanation": "Set equal: x + 5 = 2x + 1. 5 - 1 = 2x - x. x = 4. y = 4 + 5 = 9. Check: y = 2(4) + 1 = 9."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Two numbers sum to 20. Three times the larger minus twice the smaller equals 25. Find the larger number.",
      "options": [
        { "id": "a", "text": "12" },
        { "id": "b", "text": "13" },
        { "id": "c", "text": "15" },
        { "id": "d", "text": "11" }
      ],
      "correctAnswer": "b",
      "explanation": "Let larger = x, smaller = y. x + y = 20 and 3x - 2y = 25. From first: y = 20 - x. Substitute: 3x - 2(20 - x) = 25. 3x - 40 + 2x = 25. 5x = 65. x = 13."
    }
  ]
}
