  "title": "Check: Algebraic Notation (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A rectangle has length $l$ and width $w$. Which expression gives its perimeter?",
      "options": [
        {
          "id": "a",
          "text": "$lw$"
        },
        {
          "id": "b",
          "text": "$l + w$"
        },
        {
          "id": "c",
          "text": "$2(l + w)$"
        },
        {
          "id": "d",
          "text": "$4lw$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "The perimeter of a rectangle is the total distance around it: $l + w + l + w = 2l + 2w = 2(l + w)$."
    }
  ]
