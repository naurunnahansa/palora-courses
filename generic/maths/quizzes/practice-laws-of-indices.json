{
  "id": "practice-laws-of-indices",
  "title": "Practice: Laws of Indices",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Simplify: x^5 x x^3 / x^2",
      "options": [
        { "id": "a", "text": "x^6" },
        { "id": "b", "text": "x^10" },
        { "id": "c", "text": "x^4" },
        { "id": "d", "text": "x^8" }
      ],
      "correctAnswer": "a",
      "explanation": "Using the laws of indices: x^5 x x^3 = x^(5+3) = x^8. Then x^8 / x^2 = x^(8-2) = x^6."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Simplify: (2y^3)^4",
      "options": [
        { "id": "a", "text": "2y^12" },
        { "id": "b", "text": "8y^12" },
        { "id": "c", "text": "16y^12" },
        { "id": "d", "text": "16y^7" }
      ],
      "correctAnswer": "c",
      "explanation": "(2y^3)^4 = 2^4 x (y^3)^4 = 16 x y^(3x4) = 16y^12. A common error is forgetting to raise the 2 to the power 4."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Simplify: 6a^4b^2 / 3a^2b^5",
      "options": [
        { "id": "a", "text": "2a^2b^3" },
        { "id": "b", "text": "2a^2 / b^3" },
        { "id": "c", "text": "3a^2 / b^3" },
        { "id": "d", "text": "2a^6b^7" }
      ],
      "correctAnswer": "b",
      "explanation": "6/3 = 2, a^4 / a^2 = a^(4-2) = a^2, b^2 / b^5 = b^(2-5) = b^(-3) = 1/b^3. So the answer is 2a^2/b^3."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "What is the value of 5^0 + 3^1 + 2^(-1)?",
      "options": [
        { "id": "a", "text": "3.5" },
        { "id": "b", "text": "4.5" },
        { "id": "c", "text": "4" },
        { "id": "d", "text": "9" }
      ],
      "correctAnswer": "b",
      "explanation": "5^0 = 1 (any non-zero number to the power 0 is 1). 3^1 = 3. 2^(-1) = 1/2 = 0.5. So 1 + 3 + 0.5 = 4.5."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Simplify: (3x^2)^2 x 2x^3",
      "options": [
        { "id": "a", "text": "18x^7" },
        { "id": "b", "text": "6x^7" },
        { "id": "c", "text": "18x^6" },
        { "id": "d", "text": "12x^7" }
      ],
      "correctAnswer": "a",
      "explanation": "(3x^2)^2 = 9x^4. Then 9x^4 x 2x^3 = 18x^(4+3) = 18x^7."
    }
  ]
}
