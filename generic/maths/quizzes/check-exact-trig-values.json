      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the exact value of $\\sin 60°$?",
      "options": [
        { "id": "a", "text": "$\\frac{1}{2}$" },
        { "id": "b", "text": "$\\frac{\\sqrt{3}}{2}$" },
        { "id": "c", "text": "$\\frac{\\sqrt{2}}{2}$" },
        { "id": "d", "text": "$\\sqrt{3}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$\\sin 60° = \\frac{\\sqrt{3}}{2}$. This can be derived from an equilateral triangle of side 2 split in half."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the exact value of $\\tan 45°$?",
      "options": [
        { "id": "a", "text": "$0$" },
        { "id": "b", "text": "$\\frac{1}{\\sqrt{2}}$" },
        { "id": "c", "text": "$1$" },
        { "id": "d", "text": "$\\sqrt{2}$" }
      ],
      "correctAnswer": "c",
      "explanation": "$\\tan 45° = 1$. In a $45°$-$45°$-$90°$ triangle, the opposite and adjacent sides are equal, so $\\tan 45° = \\frac{1}{1} = 1$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the exact value of $\\cos 30°$?",
