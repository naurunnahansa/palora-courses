{
  "id": "check-calculating-probability",
  "title": "Check: Calculating Probability",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A bag contains $3$ red, $5$ blue, and $2$ green marbles. A marble is picked at random. What is the probability of picking a blue marble?",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{5}{10}$"
        },
        {
          "id": "b",
          "text": "$\\frac{5}{8}$"
        },
        {
          "id": "c",
          "text": "$\\frac{3}{10}$"
        },
        {
          "id": "d",
          "text": "$\\frac{1}{5}$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Total marbles $= 3 + 5 + 2 = 10$. $P(\\text{blue}) = \\frac{\\text{number of blue}}{\\text{total}} = \\frac{5}{10} = \\frac{1}{2}$."
    }
  ]
}