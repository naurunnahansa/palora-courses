  "title": "Check: Cubic Graphs",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The graph of $y = -x^3$ compared to $y = x^3$ is:",
      "options": [
        { "id": "a", "text": "Reflected in the $x$-axis" },
        { "id": "b", "text": "Reflected in the $y$-axis" },
        { "id": "c", "text": "Translated upward" },
        { "id": "d", "text": "Stretched horizontally" }
      ],
      "correctAnswer": "a",
      "explanation": "Multiplying the function by $-1$ reflects the graph in the $x$-axis. Every $y$-value becomes its negative."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "How many times can a cubic graph cross the $x$-axis at most?",
      "options": [
        { "id": "a", "text": "1" },
        { "id": "b", "text": "2" },
        { "id": "c", "text": "3" },
        { "id": "d", "text": "4" }
      ],
      "correctAnswer": "c",
      "explanation": "A cubic polynomial has degree $3$, so it can have at most $3$ real roots, meaning the graph can cross the $x$-axis at most $3$ times."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The cubic $y = (x-1)(x+2)(x-3)$ crosses the $x$-axis at:",
      "options": [
        { "id": "a", "text": "$x = -1,\\, x = 2,\\, x = -3$" },
        { "id": "b", "text": "$x = 1,\\, x = -2,\\, x = 3$" },
        { "id": "c", "text": "$x = 1,\\, x = 2,\\, x = 3$" },
        { "id": "d", "text": "$x = -1,\\, x = -2,\\, x = -3$" }
      ],
      "correctAnswer": "b",
      "explanation": "Setting $y = 0$: $(x-1)(x+2)(x-3) = 0$ gives $x = 1$, $x = -2$, or $x = 3$."
    }
  ]
