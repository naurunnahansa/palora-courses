      "difficulty": "knowledge-check",
      "stem": "The graph of $y = 2^x$ passes through which point?",
      "options": [
        {
          "id": "a",
          "text": "$(0, 0)$"
        },
        {
          "id": "b",
          "text": "$(1, 1)$"
        },
        {
          "id": "c",
          "text": "$(0, 1)$"
        },
        {
          "id": "d",
          "text": "$(0, 2)$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "When $x = 0$: $y = 2^0 = 1$. All exponential graphs of the form $y = a^x$ (where $a > 0$) pass through $(0, 1)$."
    }
