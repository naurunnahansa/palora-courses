{
  "id": "quiz-fractions-basics",
  "title": "Quiz: Fractions: Basics",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\frac{24}{36}$ to its lowest terms.",
      "options": [
        {"id": "a", "text": "$\\frac{4}{6}$"},
        {"id": "b", "text": "$\\frac{2}{3}$"},
        {"id": "c", "text": "$\\frac{12}{18}$"},
        {"id": "d", "text": "$\\frac{6}{9}$"}
      ],
      "correctAnswer": "b",
      "explanation": "The HCF of 24 and 36 is 12. Dividing both by 12: $\\frac{24 \\div 12}{36 \\div 12} = \\frac{2}{3}$. The other options are equivalent but not in simplest form."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Convert $3\\frac{2}{5}$ to an improper fraction.",
      "options": [
        {"id": "a", "text": "$\\frac{6}{5}$"},
        {"id": "b", "text": "$\\frac{15}{5}$"},
        {"id": "c", "text": "$\\frac{17}{5}$"},
        {"id": "d", "text": "$\\frac{32}{5}$"}
      ],
      "correctAnswer": "c",
      "explanation": "$3\\frac{2}{5} = \\frac{3 \\times 5 + 2}{5} = \\frac{15 + 2}{5} = \\frac{17}{5}$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Convert $\\frac{23}{4}$ to a mixed number.",
      "options": [
        {"id": "a", "text": "$5\\frac{1}{4}$"},
        {"id": "b", "text": "$5\\frac{3}{4}$"},
        {"id": "c", "text": "$4\\frac{3}{4}$"},
        {"id": "d", "text": "$6\\frac{1}{4}$"}
      ],
      "correctAnswer": "b",
      "explanation": "$23 \\div 4 = 5$ remainder $3$, so $\\frac{23}{4} = 5\\frac{3}{4}$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which is greater: $\\frac{7}{12}$ or $\\frac{5}{8}$?",
      "options": [
        {"id": "a", "text": "$\\frac{7}{12}$"},
        {"id": "b", "text": "$\\frac{5}{8}$"},
        {"id": "c", "text": "They are equal"},
        {"id": "d", "text": "Cannot be determined without a calculator"}
      ],
      "correctAnswer": "b",
      "explanation": "Convert to the same denominator (LCM of 12 and 8 is 24): $\\frac{7}{12} = \\frac{14}{24}$ and $\\frac{5}{8} = \\frac{15}{24}$. Since $15 > 14$, $\\frac{5}{8}$ is greater."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $\\frac{3}{4}$ of £60?",
      "options": [
        {"id": "a", "text": "£15"},
        {"id": "b", "text": "£40"},
        {"id": "c", "text": "£45"},
        {"id": "d", "text": "£48"}
      ],
      "correctAnswer": "c",
      "explanation": "Divide by the denominator: $60 \\div 4 = 15$. Multiply by the numerator: $15 \\times 3 = 45$. So $\\frac{3}{4}$ of £60 = £45."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which type of fraction has a numerator that is greater than its denominator?",
      "options": [
        {"id": "a", "text": "Proper fraction"},
        {"id": "b", "text": "Unit fraction"},
        {"id": "c", "text": "Improper fraction"},
        {"id": "d", "text": "Mixed number"}
      ],
      "correctAnswer": "c",
      "explanation": "An improper fraction has a numerator greater than or equal to the denominator, such as $\\frac{5}{3}$ or $\\frac{9}{4}$. A proper fraction has a numerator less than its denominator."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A school has 840 students. $\\frac{3}{7}$ are girls. How many boys are there?",
      "options": [
        {"id": "a", "text": "120"},
        {"id": "b", "text": "360"},
        {"id": "c", "text": "480"},
        {"id": "d", "text": "600"}
      ],
      "correctAnswer": "c",
      "explanation": "Girls: $\\frac{3}{7} \\times 840 = 360$. Boys: $840 - 360 = 480$."
    }
  ]
}
