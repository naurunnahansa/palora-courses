      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "$£120$ is shared between Alice and Bob in the ratio $3 : 5$. How much does Bob receive?",
      "options": [
        { "id": "a", "text": "$£45$" },
        { "id": "b", "text": "$£60$" },
        { "id": "c", "text": "$£72$" },
        { "id": "d", "text": "$£75$" }
      ],
      "correctAnswer": "d",
      "explanation": "Total parts $= 3 + 5 = 8$. One part $= £120 \\div 8 = £15$. Bob gets $5 \\times £15 = £75$."
    }
