  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "For y = 2^x, what is y when x = 5?",
      "options": [
        { "id": "a", "text": "10" },
        { "id": "b", "text": "32" },
        { "id": "c", "text": "25" },
        { "id": "d", "text": "64" }
      ],
      "correctAnswer": "b",
      "explanation": "y = 2^5 = 32."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A population doubles every year, starting at 100. Which equation models the population P after t years?",
      "options": [
        { "id": "a", "text": "P = 100 + 2t" },
        { "id": "b", "text": "P = 100 x 2^t" },
        { "id": "c", "text": "P = 200t" },
        { "id": "d", "text": "P = 100^t" }
      ],
      "correctAnswer": "b",
      "explanation": "Doubling each year is exponential growth. Starting value 100, multiplied by 2 each year: P = 100 x 2^t."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "The graph y = 3^x passes through (0, k). What is k?",
      "options": [
        { "id": "a", "text": "0" },
        { "id": "b", "text": "1" },
        { "id": "c", "text": "3" },
        { "id": "d", "text": "-1" }
      ],
      "correctAnswer": "b",
      "explanation": "When x = 0: y = 3^0 = 1. All exponential graphs y = a^x pass through (0, 1) since any non-zero number to the power 0 equals 1."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Which graph represents exponential decay?",
      "options": [
        { "id": "a", "text": "y = 3^x" },
        { "id": "b", "text": "y = (1/2)^x" },
        { "id": "c", "text": "y = x^2" },
        { "id": "d", "text": "y = 2x" }
      ],
      "correctAnswer": "b",
      "explanation": "Exponential decay occurs when the base is between 0 and 1. y = (1/2)^x decreases as x increases, representing decay. y = 3^x represents growth."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A radioactive substance has mass m = 800 x (0.5)^t grams after t hours. What is the mass after 3 hours?",
      "options": [
        { "id": "a", "text": "100 grams" },
        { "id": "b", "text": "200 grams" },
        { "id": "c", "text": "400 grams" },
        { "id": "d", "text": "50 grams" }
      ],
      "correctAnswer": "a",
      "explanation": "m = 800 x (0.5)^3 = 800 x 0.125 = 100 grams."
    }
  ]
