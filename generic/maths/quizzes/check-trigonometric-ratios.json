{
  "id": "check-trigonometric-ratios",
  "title": "Check: Trigonometric Ratios",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, $\\sin\\theta$ is defined as:",
      "options": [
        { "id": "a", "text": "$\\frac{\\text{adjacent}}{\\text{hypotenuse}}$" },
        { "id": "b", "text": "$\\frac{\\text{opposite}}{\\text{hypotenuse}}$" },
        { "id": "c", "text": "$\\frac{\\text{opposite}}{\\text{adjacent}}$" },
        { "id": "d", "text": "$\\frac{\\text{hypotenuse}}{\\text{opposite}}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$\\sin\\theta = \\frac{\\text{opposite}}{\\text{hypotenuse}}$. This can be remembered using the mnemonic SOH-CAH-TOA."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, if the side opposite to angle $\\theta$ is $5$ and the hypotenuse is $13$, what is $\\cos\\theta$?",
      "options": [
        { "id": "a", "text": "$\\frac{5}{13}$" },
        { "id": "b", "text": "$\\frac{12}{13}$" },
        { "id": "c", "text": "$\\frac{5}{12}$" },
        { "id": "d", "text": "$\\frac{13}{12}$" }
      ],
      "correctAnswer": "b",
      "explanation": "First find the adjacent side: $\\sqrt{13^2 - 5^2} = \\sqrt{144} = 12$. Then $\\cos\\theta = \\frac{\\text{adjacent}}{\\text{hypotenuse}} = \\frac{12}{13}$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which trigonometric ratio is $\\frac{\\text{opposite}}{\\text{adjacent}}$?",
      "options": [
        { "id": "a", "text": "$\\sin\\theta$" },
        { "id": "b", "text": "$\\cos\\theta$" },
        { "id": "c", "text": "$\\tan\\theta$" },
        { "id": "d", "text": "$\\sec\\theta$" }
      ],
      "correctAnswer": "c",
      "explanation": "$\\tan\\theta = \\frac{\\text{opposite}}{\\text{adjacent}}$ (the TOA part of SOH-CAH-TOA)."
    }
  ]
}