{
  "id": "check-finding-angles-trig",
  "title": "Check: Finding Angles Using Trigonometry",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the opposite side is $5\\text{ cm}$ and the hypotenuse is $10\\text{ cm}$. What is angle $\\theta$?",
      "options": [
        { "id": "a", "text": "$60°$" },
        { "id": "b", "text": "$30°$" },
        { "id": "c", "text": "$45°$" },
        { "id": "d", "text": "$90°$" }
      ],
      "correctAnswer": "b",
      "explanation": "$\\sin\\theta = \\frac{5}{10} = 0.5$, so $\\theta = \\sin^{-1}(0.5) = 30°$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "To find an angle when you know the opposite and adjacent sides, you use:",
      "options": [
        { "id": "a", "text": "$\\theta = \\sin^{-1}\\left(\\frac{\\text{opp}}{\\text{adj}}\\right)$" },
        { "id": "b", "text": "$\\theta = \\cos^{-1}\\left(\\frac{\\text{opp}}{\\text{adj}}\\right)$" },
        { "id": "c", "text": "$\\theta = \\tan^{-1}\\left(\\frac{\\text{opp}}{\\text{adj}}\\right)$" },
        { "id": "d", "text": "$\\theta = \\tan^{-1}\\left(\\frac{\\text{adj}}{\\text{opp}}\\right)$" }
      ],
      "correctAnswer": "c",
      "explanation": "When you have the opposite and adjacent sides, use $\\tan\\theta = \\frac{\\text{opp}}{\\text{adj}}$, so $\\theta = \\tan^{-1}\\left(\\frac{\\text{opp}}{\\text{adj}}\\right)$."
    }
  ]
}