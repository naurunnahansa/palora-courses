{
  "id": "check-functions-notation-2",
  "title": "Check: Functions and Notation",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $f(x) = 3x - 1$ and $g(x) = x^2$, what is $fg(2)$?",
      "options": [
        { "id": "a", "text": "$25$" },
        { "id": "b", "text": "$11$" },
        { "id": "c", "text": "$10$" },
        { "id": "d", "text": "$35$" }
      ],
      "correctAnswer": "b",
      "explanation": "$fg(2)$ means $f(g(2))$. First find $g(2) = 2^2 = 4$. Then $f(4) = 3(4) - 1 = 11$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $f(x) = 2x + 5$, what is $f^{-1}(x)$?",
      "options": [
        { "id": "a", "text": "$\\frac{x + 5}{2}$" },
        { "id": "b", "text": "$\\frac{x - 5}{2}$" },
        { "id": "c", "text": "$2x - 5$" },
        { "id": "d", "text": "$\\frac{1}{2x + 5}$" }
      ],
      "correctAnswer": "b",
      "explanation": "To find the inverse, set $y = 2x + 5$. Swap $x$ and $y$: $x = 2y + 5$. Solve for $y$: $y = \\frac{x - 5}{2}$. So $f^{-1}(x) = \\frac{x - 5}{2}$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $f(x) = 3x - 1$ and $g(x) = x^2$, what is $gf(x)$ expanded?",
      "options": [
        { "id": "a", "text": "$9x^2 - 1$" },
        { "id": "b", "text": "$9x^2 - 6x + 1$" },
        { "id": "c", "text": "$3x^2 - 1$" },
        { "id": "d", "text": "$9x^2 + 6x + 1$" }
      ],
      "correctAnswer": "b",
      "explanation": "$gf(x) = g(f(x)) = g(3x - 1) = (3x - 1)^2 = 9x^2 - 6x + 1$."
    }
  ]
}
