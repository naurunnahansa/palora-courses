{
  "id": "practice-gradient",
  "title": "Practice: Gradient",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Find the gradient of the line passing through (2, 5) and (6, 17).",
      "options": [
        { "id": "a", "text": "3" },
        { "id": "b", "text": "1/3" },
        { "id": "c", "text": "4" },
        { "id": "d", "text": "12" }
      ],
      "correctAnswer": "a",
      "explanation": "Gradient = (17 - 5) / (6 - 2) = 12 / 4 = 3."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A road rises 3 metres for every 20 metres of horizontal distance. What is the gradient?",
      "options": [
        { "id": "a", "text": "3/20" },
        { "id": "b", "text": "20/3" },
        { "id": "c", "text": "6.67" },
        { "id": "d", "text": "3" }
      ],
      "correctAnswer": "a",
      "explanation": "Gradient = rise / run = 3/20 = 0.15."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Find the gradient of the line passing through (-3, 4) and (1, -8).",
      "options": [
        { "id": "a", "text": "3" },
        { "id": "b", "text": "-3" },
        { "id": "c", "text": "-1/3" },
        { "id": "d", "text": "1/3" }
      ],
      "correctAnswer": "b",
      "explanation": "Gradient = (-8 - 4) / (1 - (-3)) = -12 / 4 = -3."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Line A has gradient 2 and Line B has gradient -2. Which statement is correct?",
      "options": [
        { "id": "a", "text": "They are parallel" },
        { "id": "b", "text": "They are perpendicular" },
        { "id": "c", "text": "Line A slopes up and Line B slopes down, but they are not perpendicular" },
        { "id": "d", "text": "They have the same steepness but opposite directions" }
      ],
      "correctAnswer": "c",
      "explanation": "Lines are perpendicular when their gradients multiply to -1. Here 2 x (-2) = -4, not -1. They have the same steepness (both 'go 2 for 1') but slope in opposite directions. They are not parallel (different gradients) and not perpendicular."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A line passes through (0, 4) and (k, 10) with gradient 3/2. Find k.",
      "options": [
        { "id": "a", "text": "4" },
        { "id": "b", "text": "9" },
        { "id": "c", "text": "3" },
        { "id": "d", "text": "6" }
      ],
      "correctAnswer": "a",
      "explanation": "Gradient = (10 - 4) / (k - 0) = 6/k = 3/2. Cross multiply: 12 = 3k. k = 4."
    }
  ]
}
