{
  "id": "quiz-pythagoras-theorem",
  "title": "Quiz: Pythagoras' Theorem",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A right-angled triangle has legs of $3$ cm and $4$ cm. What is the hypotenuse?",
      "options": [
        {"id": "a", "text": "$5$ cm"},
        {"id": "b", "text": "$7$ cm"},
        {"id": "c", "text": "$6$ cm"},
        {"id": "d", "text": "$\\sqrt{7}$ cm"}
      ],
      "correctAnswer": "a",
      "explanation": "$c = \\sqrt{3^2 + 4^2} = \\sqrt{9 + 16} = \\sqrt{25} = 5$ cm."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A right-angled triangle has a hypotenuse of $13$ cm and one leg of $5$ cm. What is the other leg?",
      "options": [
        {"id": "a", "text": "$8$ cm"},
        {"id": "b", "text": "$12$ cm"},
        {"id": "c", "text": "$\\sqrt{194}$ cm"},
        {"id": "d", "text": "$18$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "$a = \\sqrt{13^2 - 5^2} = \\sqrt{169 - 25} = \\sqrt{144} = 12$ cm."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Pythagoras' Theorem states that in a right-angled triangle:",
      "options": [
        {"id": "a", "text": "$a + b = c$"},
        {"id": "b", "text": "$a^2 + b^2 = c^2$ where $c$ is the hypotenuse"},
        {"id": "c", "text": "$a^2 \\times b^2 = c^2$"},
        {"id": "d", "text": "$a^2 + b^2 + c^2 = 180$"}
      ],
      "correctAnswer": "b",
      "explanation": "Pythagoras' Theorem states that the square of the hypotenuse equals the sum of the squares of the other two sides."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A right-angled triangle has legs of $6$ cm and $8$ cm. What is the hypotenuse?",
      "options": [
        {"id": "a", "text": "$14$ cm"},
        {"id": "b", "text": "$10$ cm"},
        {"id": "c", "text": "$\\sqrt{48}$ cm"},
        {"id": "d", "text": "$100$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "$c = \\sqrt{6^2 + 8^2} = \\sqrt{36 + 64} = \\sqrt{100} = 10$ cm."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A triangle has sides $7$ cm, $24$ cm, and $25$ cm. Is it right-angled?",
      "options": [
        {"id": "a", "text": "Yes, because $7 + 24 > 25$"},
        {"id": "b", "text": "Yes, because $7^2 + 24^2 = 25^2$"},
        {"id": "c", "text": "No, because $7^2 + 24^2 \\neq 25^2$"},
        {"id": "d", "text": "No, because 25 is too large"}
      ],
      "correctAnswer": "b",
      "explanation": "$7^2 + 24^2 = 49 + 576 = 625 = 25^2$. Since the sum of the squares of the two shorter sides equals the square of the longest side, the triangle is right-angled."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A right-angled triangle has legs of $1$ cm and $1$ cm. What is the exact length of the hypotenuse?",
      "options": [
        {"id": "a", "text": "$2$ cm"},
        {"id": "b", "text": "$\\sqrt{2}$ cm"},
        {"id": "c", "text": "$1.5$ cm"},
        {"id": "d", "text": "$\\sqrt{3}$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "$c = \\sqrt{1^2 + 1^2} = \\sqrt{2}$ cm."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The hypotenuse of a right-angled triangle is always:",
      "options": [
        {"id": "a", "text": "The shortest side"},
        {"id": "b", "text": "Opposite the smallest angle"},
        {"id": "c", "text": "The longest side, opposite the right angle"},
        {"id": "d", "text": "Equal to the sum of the other two sides"}
      ],
      "correctAnswer": "c",
      "explanation": "The hypotenuse is always the longest side and is opposite the right angle ($90°$), which is the largest angle."
    }
  ]
}
