{
  "id": "check-laws-of-indices-2",
  "title": "Check: Laws of Indices",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the value of $5^0$?",
      "options": [
        { "id": "a", "text": "$0$" },
        { "id": "b", "text": "$1$" },
        { "id": "c", "text": "$5$" },
        { "id": "d", "text": "Undefined" }
      ],
      "correctAnswer": "b",
      "explanation": "Any non-zero number raised to the power $0$ equals $1$. This follows from the division rule: $\\frac{5^n}{5^n} = 5^{n-n} = 5^0 = 1$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\frac{2x^5 \\times 3x^2}{x^3}$.",
      "options": [
        { "id": "a", "text": "$6x^4$" },
        { "id": "b", "text": "$5x^4$" },
        { "id": "c", "text": "$6x^{10}$" },
        { "id": "d", "text": "$6x^{\\frac{10}{3}}$" }
      ],
      "correctAnswer": "a",
      "explanation": "First multiply the numerator: $2x^5 \\times 3x^2 = 6x^7$. Then divide: $\\frac{6x^7}{x^3} = 6x^{7-3} = 6x^4$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $(2m^3)^4$.",
      "options": [
        { "id": "a", "text": "$2m^{12}$" },
        { "id": "b", "text": "$8m^{12}$" },
        { "id": "c", "text": "$16m^{12}$" },
        { "id": "d", "text": "$16m^{7}$" }
      ],
      "correctAnswer": "c",
      "explanation": "$(2m^3)^4 = 2^4 \\times (m^3)^4 = 16 \\times m^{12} = 16m^{12}$. Remember to raise both the coefficient and the variable part to the power."
    }
  ]
}
