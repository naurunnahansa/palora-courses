  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A field has an area of $3.5\\text{ m}^2$. What is this in $\\text{cm}^2$?",
      "options": [
        { "id": "a", "text": "$350\\text{ cm}^2$" },
        { "id": "b", "text": "$3{,}500\\text{ cm}^2$" },
        { "id": "c", "text": "$35{,}000\\text{ cm}^2$" },
        { "id": "d", "text": "$0.035\\text{ cm}^2$" }
      ],
      "correctAnswer": "c",
      "explanation": "$1\\text{ m}^2 = 10{,}000\\text{ cm}^2$, so $3.5\\text{ m}^2 = 3.5 \\times 10{,}000 = 35{,}000\\text{ cm}^2$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cube has sides of $0.3\\text{ m}$. What is its volume in $\\text{cm}^3$?",
      "options": [
        { "id": "a", "text": "$27\\text{ cm}^3$" },
        { "id": "b", "text": "$270\\text{ cm}^3$" },
        { "id": "c", "text": "$2{,}700\\text{ cm}^3$" },
        { "id": "d", "text": "$27{,}000\\text{ cm}^3$" }
      ],
      "correctAnswer": "d",
      "explanation": "$0.3\\text{ m} = 30\\text{ cm}$. Volume $= 30^3 = 27{,}000\\text{ cm}^3$."
    }
