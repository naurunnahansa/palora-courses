  "title": "Check: Substitution",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $p = -3$, what is the value of $p^2 - 2p$?",
      "options": [
        { "id": "a", "text": "$3$" },
        { "id": "b", "text": "$15$" },
        { "id": "c", "text": "$-15$" },
        { "id": "d", "text": "$-3$" }
      ],
      "correctAnswer": "b",
      "explanation": "Substitute $p = -3$: $(-3)^2 - 2(-3) = 9 + 6 = 15$. Remember that $(-3)^2 = 9$ and subtracting a negative gives a positive."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Given $v = u + at$, find $v$ when $u = 5$, $a = -2$ and $t = 3$.",
      "options": [
        { "id": "a", "text": "$-1$" },
        { "id": "b", "text": "$11$" },
        { "id": "c", "text": "$1$" },
        { "id": "d", "text": "$-11$" }
      ],
      "correctAnswer": "a",
      "explanation": "Substitute into $v = u + at$: $v = 5 + (-2)(3) = 5 - 6 = -1$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $a = 2$ and $b = 5$, what is the value of $\\frac{a^2 + b}{3}$?",
      "options": [
        { "id": "a", "text": "$1$" },
        { "id": "b", "text": "$3$" },
        { "id": "c", "text": "$9$" },
        { "id": "d", "text": "$7$" }
      ],
      "correctAnswer": "b",
      "explanation": "Substitute $a = 2$ and $b = 5$: $\\frac{2^2 + 5}{3} = \\frac{4 + 5}{3} = \\frac{9}{3} = 3$."
    }
  ]
