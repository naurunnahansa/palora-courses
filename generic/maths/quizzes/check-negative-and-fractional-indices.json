{
  "id": "check-negative-and-fractional-indices",
  "title": "Check: Negative and Fractional Indices",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $3^{-2}$?",
      "options": [
        { "id": "a", "text": "$-9$" },
        { "id": "b", "text": "$-6$" },
        { "id": "c", "text": "$\\frac{1}{6}$" },
        { "id": "d", "text": "$\\frac{1}{9}$" }
      ],
      "correctAnswer": "d",
      "explanation": "A negative index means the reciprocal: $3^{-2} = \\frac{1}{3^2} = \\frac{1}{9}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $25^{\\frac{1}{2}}$?",
      "options": [
        { "id": "a", "text": "$5$" },
        { "id": "b", "text": "$12.5$" },
        { "id": "c", "text": "$50$" },
        { "id": "d", "text": "$\\frac{25}{2}$" }
      ],
      "correctAnswer": "a",
      "explanation": "A fractional index of $\\frac{1}{2}$ means the square root: $25^{\\frac{1}{2}} = \\sqrt{25} = 5$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $8^{\\frac{2}{3}}$?",
      "options": [
        { "id": "a", "text": "$2$" },
        { "id": "b", "text": "$4$" },
        { "id": "c", "text": "$16$" },
        { "id": "d", "text": "$\\frac{16}{3}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$8^{\\frac{2}{3}} = (\\sqrt[3]{8})^2 = 2^2 = 4$. The denominator of the fraction gives the root and the numerator gives the power."
    }
  ]
}
