{
  "id": "check-scalar-multiplication",
  "title": "Check: Scalar Multiplication",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $\\mathbf{v} = \\begin{pmatrix} 3 \\\\ -2 \\end{pmatrix}$, what is $4\\mathbf{v}$?",
      "options": [
        {
          "id": "a",
          "text": "$\\begin{pmatrix} 7 \\\\ 2 \\end{pmatrix}$"
        },
        {
          "id": "b",
          "text": "$\\begin{pmatrix} 12 \\\\ 8 \\end{pmatrix}$"
        },
        {
          "id": "c",
          "text": "$\\begin{pmatrix} 12 \\\\ -8 \\end{pmatrix}$"
        },
        {
          "id": "d",
          "text": "$\\begin{pmatrix} 3 \\\\ -8 \\end{pmatrix}$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Multiply each component by the scalar: $4\\begin{pmatrix} 3 \\\\ -2 \\end{pmatrix} = \\begin{pmatrix} 12 \\\\ -8 \\end{pmatrix}$."
    }
  ]
}
