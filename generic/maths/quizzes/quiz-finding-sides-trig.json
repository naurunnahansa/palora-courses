{
  "id": "quiz-finding-sides-trig",
  "title": "Quiz: Finding Sides using Trigonometry",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the angle is $30°$ and the hypotenuse is $10$ cm. What is the length of the side opposite the $30°$ angle?",
      "options": [
        {"id": "a", "text": "$5$ cm"},
        {"id": "b", "text": "$8.66$ cm"},
        {"id": "c", "text": "$5.77$ cm"},
        {"id": "d", "text": "$20$ cm"}
      ],
      "correctAnswer": "a",
      "explanation": "Opposite $= \\text{hyp} \\times \\sin 30° = 10 \\times 0.5 = 5$ cm."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the angle is $40°$ and the adjacent side is $8$ cm. What is the opposite side to $1$ decimal place?",
      "options": [
        {"id": "a", "text": "$5.1$ cm"},
        {"id": "b", "text": "$6.7$ cm"},
        {"id": "c", "text": "$10.4$ cm"},
        {"id": "d", "text": "$9.5$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "Opposite $= \\text{adjacent} \\times \\tan 40° = 8 \\times 0.8391 = 6.7$ cm (1 d.p.)."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the angle is $55°$ and the opposite side is $7$ cm. What is the hypotenuse to $1$ decimal place?",
      "options": [
        {"id": "a", "text": "$5.7$ cm"},
        {"id": "b", "text": "$12.2$ cm"},
        {"id": "c", "text": "$8.5$ cm"},
        {"id": "d", "text": "$10.0$ cm"}
      ],
      "correctAnswer": "c",
      "explanation": "Hypotenuse $= \\frac{\\text{opposite}}{\\sin 55°} = \\frac{7}{0.8192} = 8.5$ cm (1 d.p.)."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "To find the adjacent side when you know the hypotenuse and an angle, you use:",
      "options": [
        {"id": "a", "text": "$\\text{adj} = \\text{hyp} \\times \\sin \\theta$"},
        {"id": "b", "text": "$\\text{adj} = \\text{hyp} \\times \\cos \\theta$"},
        {"id": "c", "text": "$\\text{adj} = \\text{hyp} \\times \\tan \\theta$"},
        {"id": "d", "text": "$\\text{adj} = \\frac{\\text{hyp}}{\\cos \\theta}$"}
      ],
      "correctAnswer": "b",
      "explanation": "$\\cos \\theta = \\frac{\\text{adj}}{\\text{hyp}}$, so $\\text{adj} = \\text{hyp} \\times \\cos \\theta$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the angle is $60°$ and the hypotenuse is $12$ cm. What is the adjacent side?",
      "options": [
        {"id": "a", "text": "$6$ cm"},
        {"id": "b", "text": "$6\\sqrt{3}$ cm"},
        {"id": "c", "text": "$10.39$ cm"},
        {"id": "d", "text": "$24$ cm"}
      ],
      "correctAnswer": "a",
      "explanation": "Adjacent $= 12 \\times \\cos 60° = 12 \\times 0.5 = 6$ cm."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the angle is $35°$ and the adjacent side is $15$ cm. What is the hypotenuse to $1$ decimal place?",
      "options": [
        {"id": "a", "text": "$12.3$ cm"},
        {"id": "b", "text": "$18.3$ cm"},
        {"id": "c", "text": "$26.2$ cm"},
        {"id": "d", "text": "$21.4$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "Hypotenuse $= \\frac{\\text{adj}}{\\cos 35°} = \\frac{15}{0.8192} = 18.3$ cm (1 d.p.)."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, you know the angle is $50°$ and the opposite side is $9$ cm. Which calculation gives the adjacent side?",
      "options": [
        {"id": "a", "text": "$9 \\times \\tan 50°$"},
        {"id": "b", "text": "$\\frac{9}{\\sin 50°}$"},
        {"id": "c", "text": "$\\frac{9}{\\tan 50°}$"},
        {"id": "d", "text": "$9 \\times \\cos 50°$"}
      ],
      "correctAnswer": "c",
      "explanation": "$\\tan 50° = \\frac{\\text{opp}}{\\text{adj}} = \\frac{9}{\\text{adj}}$, so adj $= \\frac{9}{\\tan 50°}$."
    }
  ]
}
