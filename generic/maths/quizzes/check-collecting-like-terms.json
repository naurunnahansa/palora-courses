      "stem": "Simplify $4a + 3b - a + 5b$.",
      "options": [
        { "id": "a", "text": "$3a + 8b$" },
        { "id": "b", "text": "$5a + 8b$" },
        { "id": "c", "text": "$11ab$" },
        { "id": "d", "text": "$4a + 8b$" }
      ],
      "correctAnswer": "a",
      "explanation": "Collect the $a$ terms: $4a - a = 3a$. Collect the $b$ terms: $3b + 5b = 8b$. So the answer is $3a + 8b$."
