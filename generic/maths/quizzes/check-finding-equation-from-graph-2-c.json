{
  "id": "check-finding-equation-from-graph-2-c",
  "title": "Check: Finding Equation from a Graph (C)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A straight line has a $y$-intercept of $1$ and passes through $(6, 4)$. What is its equation?",
      "options": [
        {
          "id": "a",
          "text": "$y = 4x + 1$"
        },
        {
          "id": "b",
          "text": "$y = 2x + 1$"
        },
        {
          "id": "c",
          "text": "$y = \\frac{1}{2}x + 1$"
        },
        {
          "id": "d",
          "text": "$y = \\frac{1}{2}x - 1$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Gradient $= \\frac{4 - 1}{6 - 0} = \\frac{3}{6} = \\frac{1}{2}$. With $c = 1$, the equation is $y = \\frac{1}{2}x + 1$."
    }
  ]
}
