{
  "id": "quiz-angles-elevation-depression",
  "title": "Quiz: Angles of Elevation and Depression",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The angle of elevation is measured from:",
      "options": [
        {
          "id": "a",
          "text": "The horizontal looking up"
        },
        {
          "id": "b",
          "text": "The horizontal looking down"
        },
        {
          "id": "c",
          "text": "The top of the object"
        },
        {
          "id": "d",
          "text": "The vertical looking up"
        }
      ],
      "correctAnswer": "a",
      "explanation": "The angle of elevation is measured upwards from the horizontal to the line of sight."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The angle of depression from the top of a cliff to a boat is $25°$. The cliff is $40$ m high. How far is the boat from the base of the cliff? (1 d.p.)",
      "options": [
        {
          "id": "a",
          "text": "$85.8$ m"
        },
        {
          "id": "b",
          "text": "$44.1$ m"
        },
        {
          "id": "c",
          "text": "$94.6$ m"
        },
        {
          "id": "d",
          "text": "$18.7$ m"
        }
      ],
      "correctAnswer": "a",
      "explanation": "$\\tan 25° = \\frac{40}{d}$, so $d = \\frac{40}{\\tan 25°} = \\frac{40}{0.4663} = 85.8$ m."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The angle of elevation from a point on the ground to the top of a building is $35°$. The point is $50$ m from the base. What is the height of the building? (1 d.p.)",
      "options": [
        {
          "id": "a",
          "text": "$71.4$ m"
        },
        {
          "id": "b",
          "text": "$35.0$ m"
        },
        {
          "id": "c",
          "text": "$41.0$ m"
        },
        {
          "id": "d",
          "text": "$28.7$ m"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$h = 50 \\times \\tan 35° = 50 \\times 0.7002 = 35.0$ m."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The angle of depression from a point to an object below is equal to:",
      "options": [
        {
          "id": "a",
          "text": "The angle of elevation from the object to the point"
        },
        {
          "id": "b",
          "text": "Twice the angle of elevation"
        },
        {
          "id": "c",
          "text": "The complement of the angle of elevation"
        },
        {
          "id": "d",
          "text": "$90°$ minus the angle of elevation"
        }
      ],
      "correctAnswer": "a",
      "explanation": "The angle of depression and the angle of elevation are alternate angles between parallel horizontal lines, so they are equal."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A tree is $12$ m tall. The angle of elevation from a point to the top of the tree is $40°$. How far is the point from the base? (1 d.p.)",
      "options": [
        {
          "id": "a",
          "text": "$14.3$ m"
        },
        {
          "id": "b",
          "text": "$15.7$ m"
        },
        {
          "id": "c",
          "text": "$18.6$ m"
        },
        {
          "id": "d",
          "text": "$10.1$ m"
        }
      ],
      "correctAnswer": "a",
      "explanation": "$\\tan 40° = \\frac{12}{d}$, so $d = \\frac{12}{\\tan 40°} = \\frac{12}{0.8391} = 14.3$ m."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "From the top of a $20$ m tower, the angle of depression to a car is $50°$. What is the distance from the car to the base of the tower? (1 d.p.)",
      "options": [
        {
          "id": "a",
          "text": "$25.6$ m"
        },
        {
          "id": "b",
          "text": "$23.8$ m"
        },
        {
          "id": "c",
          "text": "$15.3$ m"
        },
        {
          "id": "d",
          "text": "$16.8$ m"
        }
      ],
      "correctAnswer": "d",
      "explanation": "$\\tan 50° = \\frac{20}{d}$, so $d = \\frac{20}{\\tan 50°} = \\frac{20}{1.1918} = 16.8$ m."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A person stands $30$ m from a building and measures the angle of elevation to the top as $58°$. Their eye level is $1.5$ m above the ground. What is the total height of the building? (1 d.p.)",
      "options": [
        {
          "id": "a",
          "text": "$48.0$ m"
        },
        {
          "id": "b",
          "text": "$18.7$ m"
        },
        {
          "id": "c",
          "text": "$46.5$ m"
        },
        {
          "id": "d",
          "text": "$49.5$ m"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Height above eye level $= 30 \\times \\tan 58° = 30 \\times 1.6003 = 48.0$ m. Total height $= 48.0 + 1.5 = 49.5$ m."
    }
  ]
}
