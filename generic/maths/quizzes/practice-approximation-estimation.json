      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Estimate the value of (49.3 x 21.2) / 4.87 by rounding each number to 1 significant figure.",
      "options": [
        { "id": "a", "text": "100" },
        { "id": "b", "text": "200" },
        { "id": "c", "text": "250" },
        { "id": "d", "text": "50" }
      ],
      "correctAnswer": "b",
      "explanation": "Round to 1 s.f.: 49.3 -> 50, 21.2 -> 20, 4.87 -> 5. Estimate = (50 x 20) / 5 = 1000 / 5 = 200."
