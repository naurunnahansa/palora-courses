  "title": "Check: Venn Diagrams",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a group of $40$ people, $18$ like chocolate, $22$ like vanilla, and $8$ like both. A person is chosen at random. What is $P(\\text{chocolate or vanilla})$?",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{40}{40}$"
        },
        {
          "id": "b",
          "text": "$\\frac{30}{40}$"
        },
        {
          "id": "c",
          "text": "$\\frac{48}{40}$"
        },
        {
          "id": "d",
          "text": "$\\frac{32}{40}$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "$P(C \\cup V) = P(C) + P(V) - P(C \\cap V) = \\frac{18}{40} + \\frac{22}{40} - \\frac{8}{40} = \\frac{32}{40} = \\frac{4}{5}$."
    }
  ]
}
