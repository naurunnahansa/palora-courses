  "title": "Check: Finding Angles Using Trigonometry (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the opposite side is $9\\text{ cm}$ and the adjacent side is $9\\text{ cm}$. What is angle $\\theta$?",
      "options": [
        {
          "id": "a",
          "text": "$30°$"
        },
        {
          "id": "b",
          "text": "$45°$"
        },
        {
          "id": "c",
          "text": "$60°$"
        },
        {
          "id": "d",
          "text": "$90°$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$\\tan\\theta = \\frac{9}{9} = 1$, so $\\theta = \\tan^{-1}(1) = 45°$."
    }
  ]
}