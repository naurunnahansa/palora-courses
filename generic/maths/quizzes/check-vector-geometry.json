{
  "id": "check-vector-geometry",
  "title": "Check: Vector Geometry",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In triangle $OAB$, $\\overrightarrow{OA} = \\mathbf{a}$ and $\\overrightarrow{OB} = \\mathbf{b}$. $M$ is the midpoint of $AB$. Express $\\overrightarrow{OM}$ in terms of $\\mathbf{a}$ and $\\mathbf{b}$.",
      "options": [
        {
          "id": "a",
          "text": "$\\mathbf{a} + \\mathbf{b}$"
        },
        {
          "id": "b",
          "text": "$\\frac{1}{2}\\mathbf{a} + \\frac{1}{2}\\mathbf{b}$"
        },
        {
          "id": "c",
          "text": "$\\mathbf{b} - \\mathbf{a}$"
        },
        {
          "id": "d",
          "text": "$\\frac{1}{2}(\\mathbf{b} - \\mathbf{a})$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$\\overrightarrow{OM} = \\overrightarrow{OA} + \\overrightarrow{AM} = \\mathbf{a} + \\frac{1}{2}\\overrightarrow{AB} = \\mathbf{a} + \\frac{1}{2}(\\mathbf{b} - \\mathbf{a}) = \\frac{1}{2}\\mathbf{a} + \\frac{1}{2}\\mathbf{b}$."
    }
  ]
}