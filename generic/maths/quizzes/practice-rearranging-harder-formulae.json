      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Make x the subject of: ax + 3 = bx - 5",
      "options": [
        { "id": "a", "text": "x = -8 / (a - b)" },
        { "id": "b", "text": "x = 8 / (a - b)" },
        { "id": "c", "text": "x = -8 / (a + b)" },
        { "id": "d", "text": "x = 2 / (a - b)" }
      ],
      "correctAnswer": "a",
      "explanation": "ax - bx = -5 - 3. x(a - b) = -8. x = -8/(a - b)."
    },
