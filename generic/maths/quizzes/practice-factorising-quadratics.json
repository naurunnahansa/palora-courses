{
  "id": "practice-factorising-quadratics",
  "title": "Practice: Factorising Quadratics",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Factorise: x^2 - 3x - 28",
      "options": [
        { "id": "a", "text": "(x - 7)(x + 4)" },
        { "id": "b", "text": "(x + 7)(x - 4)" },
        { "id": "c", "text": "(x - 14)(x + 2)" },
        { "id": "d", "text": "(x - 7)(x - 4)" }
      ],
      "correctAnswer": "a",
      "explanation": "Need two numbers that multiply to -28 and add to -3. That's -7 and +4: (-7)(4) = -28, -7 + 4 = -3. So (x - 7)(x + 4)."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Factorise: x^2 - 144",
      "options": [
        { "id": "a", "text": "(x - 12)(x - 12)" },
        { "id": "b", "text": "(x + 12)(x - 12)" },
        { "id": "c", "text": "(x + 72)(x - 2)" },
        { "id": "d", "text": "Cannot be factorised" }
      ],
      "correctAnswer": "b",
      "explanation": "This is a difference of two squares: x^2 - 12^2 = (x + 12)(x - 12)."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Factorise: x^2 + 10x + 25",
      "options": [
        { "id": "a", "text": "(x + 5)(x + 5)" },
        { "id": "b", "text": "(x + 25)(x + 1)" },
        { "id": "c", "text": "(x - 5)(x - 5)" },
        { "id": "d", "text": "(x + 10)(x + 2.5)" }
      ],
      "correctAnswer": "a",
      "explanation": "This is a perfect square trinomial: x^2 + 2(5)x + 5^2 = (x + 5)^2 = (x + 5)(x + 5)."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Factorise: y^2 + 2y - 35",
      "options": [
        { "id": "a", "text": "(y + 5)(y - 7)" },
        { "id": "b", "text": "(y - 5)(y + 7)" },
        { "id": "c", "text": "(y + 35)(y - 1)" },
        { "id": "d", "text": "(y - 5)(y - 7)" }
      ],
      "correctAnswer": "b",
      "explanation": "Need two numbers that multiply to -35 and add to +2. That's -5 and +7: (-5)(7) = -35, -5 + 7 = 2. So (y - 5)(y + 7)."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Factorise: x^2 - 11x + 30",
      "options": [
        { "id": "a", "text": "(x - 3)(x - 10)" },
        { "id": "b", "text": "(x - 6)(x - 5)" },
        { "id": "c", "text": "(x + 6)(x + 5)" },
        { "id": "d", "text": "(x - 15)(x + 2)" }
      ],
      "correctAnswer": "b",
      "explanation": "Need two numbers that multiply to +30 and add to -11. Both must be negative: -6 and -5: (-6)(-5) = 30, -6 + (-5) = -11. So (x - 6)(x - 5)."
    }
  ]
