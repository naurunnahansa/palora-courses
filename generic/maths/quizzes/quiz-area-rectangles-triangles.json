{
  "id": "quiz-area-rectangles-triangles",
  "title": "Quiz: Area: Rectangles and Triangles",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A rectangle has a length of $8$ cm and a width of $5$ cm. What is its area?",
      "options": [
        {
          "id": "a",
          "text": "$80$ cm$^2$"
        },
        {
          "id": "b",
          "text": "$40$ cm$^2$"
        },
        {
          "id": "c",
          "text": "$13$ cm$^2$"
        },
        {
          "id": "d",
          "text": "$26$ cm$^2$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Area of a rectangle $= l \\times w = 8 \\times 5 = 40$ cm$^2$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A triangle has a base of $10$ cm and a perpendicular height of $6$ cm. What is its area?",
      "options": [
        {
          "id": "a",
          "text": "$16$ cm$^2$"
        },
        {
          "id": "b",
          "text": "$60$ cm$^2$"
        },
        {
          "id": "c",
          "text": "$30$ cm$^2$"
        },
        {
          "id": "d",
          "text": "$20$ cm$^2$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Area of a triangle $= \\frac{1}{2} \\times b \\times h = \\frac{1}{2} \\times 10 \\times 6 = 30$ cm$^2$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A square has an area of $49$ cm$^2$. What is the length of each side?",
      "options": [
        {
          "id": "a",
          "text": "$24.5$ cm"
        },
        {
          "id": "b",
          "text": "$7$ cm"
        },
        {
          "id": "c",
          "text": "$12.25$ cm"
        },
        {
          "id": "d",
          "text": "$6$ cm"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Side $= \\sqrt{49} = 7$ cm."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A rectangle has an area of $72$ cm$^2$ and a width of $8$ cm. What is its length?",
      "options": [
        {
          "id": "a",
          "text": "$64$ cm"
        },
        {
          "id": "b",
          "text": "$8$ cm"
        },
        {
          "id": "c",
          "text": "$10$ cm"
        },
        {
          "id": "d",
          "text": "$9$ cm"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Length $= \\frac{\\text{Area}}{\\text{width}} = \\frac{72}{8} = 9$ cm."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A right-angled triangle has legs of $9$ cm and $12$ cm. What is its area?",
      "options": [
        {
          "id": "a",
          "text": "$54$ cm$^2$"
        },
        {
          "id": "b",
          "text": "$36$ cm$^2$"
        },
        {
          "id": "c",
          "text": "$21$ cm$^2$"
        },
        {
          "id": "d",
          "text": "$108$ cm$^2$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "For a right-angled triangle, the two legs are the base and height: $\\frac{1}{2} \\times 9 \\times 12 = 54$ cm$^2$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A triangle has an area of $24$ cm$^2$ and a base of $8$ cm. What is the perpendicular height?",
      "options": [
        {
          "id": "a",
          "text": "$16$ cm"
        },
        {
          "id": "b",
          "text": "$6$ cm"
        },
        {
          "id": "c",
          "text": "$4$ cm"
        },
        {
          "id": "d",
          "text": "$3$ cm"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$24 = \\frac{1}{2} \\times 8 \\times h$, so $h = \\frac{24 \\times 2}{8} = 6$ cm."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Two rectangles each measure $3$ cm by $5$ cm. They are placed side by side along their $5$ cm edges. What is the area of the combined shape?",
      "options": [
        {
          "id": "a",
          "text": "$15$ cm$^2$"
        },
        {
          "id": "b",
          "text": "$16$ cm$^2$"
        },
        {
          "id": "c",
          "text": "$40$ cm$^2$"
        },
        {
          "id": "d",
          "text": "$30$ cm$^2$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Each rectangle has area $3 \\times 5 = 15$ cm$^2$. Combined: $15 + 15 = 30$ cm$^2$."
    }
  ]
}
