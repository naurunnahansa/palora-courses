{
  "id": "practice-area-parallelograms-trapeziums",
  "title": "Practice: Area - Parallelograms and Trapeziums",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A parallelogram has a base of 12 cm and a slant side of 8 cm. The perpendicular height is 6 cm. What is its area?",
      "options": [
        { "id": "a", "text": "96 cm squared" },
        { "id": "b", "text": "72 cm squared" },
        { "id": "c", "text": "48 cm squared" },
        { "id": "d", "text": "120 cm squared" }
      ],
      "correctAnswer": "b",
      "explanation": "Area = base x perpendicular height = 12 x 6 = 72 cm squared. The slant side (8 cm) is not used -- a common mistake is to multiply base by slant side."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A trapezium has parallel sides of 10 cm and 6 cm, and a perpendicular height of 4 cm. What is its area?",
      "options": [
        { "id": "a", "text": "64 cm squared" },
        { "id": "b", "text": "40 cm squared" },
        { "id": "c", "text": "32 cm squared" },
        { "id": "d", "text": "24 cm squared" }
      ],
      "correctAnswer": "c",
      "explanation": "Area = (1/2)(a + b) x h = (1/2)(10 + 6) x 4 = (1/2)(16)(4) = 32 cm squared."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A trapezium has an area of 45 cm squared, a height of 5 cm, and one parallel side of 8 cm. Find the other parallel side.",
      "options": [
        { "id": "a", "text": "10 cm" },
        { "id": "b", "text": "9 cm" },
        { "id": "c", "text": "12 cm" },
        { "id": "d", "text": "7 cm" }
      ],
      "correctAnswer": "a",
      "explanation": "45 = (1/2)(a + 8)(5). So 45 = (5/2)(a + 8), giving 90 = 5(a + 8), so 18 = a + 8, and a = 10 cm."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A parallelogram has an area of 108 cm squared and a perpendicular height of 9 cm. What is the base length?",
      "options": [
        { "id": "a", "text": "12 cm" },
        { "id": "b", "text": "972 cm" },
        { "id": "c", "text": "54 cm" },
        { "id": "d", "text": "18 cm" }
      ],
      "correctAnswer": "a",
      "explanation": "Area = base x height. So base = 108 / 9 = 12 cm."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A trapezium has parallel sides of 15 cm and 9 cm, and a perpendicular height of 8 cm. What is its area?",
      "options": [
        { "id": "a", "text": "120 cm squared" },
        { "id": "b", "text": "192 cm squared" },
        { "id": "c", "text": "96 cm squared" },
        { "id": "d", "text": "60 cm squared" }
      ],
      "correctAnswer": "c",
      "explanation": "Area = (1/2)(15 + 9)(8) = (1/2)(24)(8) = 96 cm squared."
    }
  ]
}
