{
  "id": "practice-algebraic-fractions",
  "title": "Practice: Algebraic Fractions",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Simplify: (x^2 - 9) / (x^2 + 5x + 6)",
      "options": [
        { "id": "a", "text": "(x - 3) / (x + 2)" },
        { "id": "b", "text": "(x + 3) / (x + 2)" },
        { "id": "c", "text": "(x - 3) / (x + 3)" },
        { "id": "d", "text": "Cannot be simplified" }
      ],
      "correctAnswer": "a",
      "explanation": "Factorise: numerator = (x+3)(x-3), denominator = (x+2)(x+3). Cancel (x+3): (x-3)/(x+2)."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Write as a single fraction: 2/x + 3/(x+1)",
      "options": [
        { "id": "a", "text": "5/(2x+1)" },
        { "id": "b", "text": "(5x + 2) / (x(x+1))" },
        { "id": "c", "text": "(5x + 2) / (x^2 + x)" },
        { "id": "d", "text": "Both b and c" }
      ],
      "correctAnswer": "d",
      "explanation": "Common denominator = x(x+1). So 2(x+1)/(x(x+1)) + 3x/(x(x+1)) = (2x+2+3x)/(x(x+1)) = (5x+2)/(x(x+1)). Since x(x+1) = x^2+x, options b and c are both correct."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Simplify: (3x/4) divided by (9x/8)",
      "options": [
        { "id": "a", "text": "2/3" },
        { "id": "b", "text": "3/2" },
        { "id": "c", "text": "27x^2/32" },
        { "id": "d", "text": "6" }
      ],
      "correctAnswer": "a",
      "explanation": "(3x/4) / (9x/8) = (3x/4) x (8/9x) = 24x/36x = 2/3."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Solve: 5/(x-1) = 3/(x+1)",
      "options": [
        { "id": "a", "text": "x = 4" },
        { "id": "b", "text": "x = -4" },
        { "id": "c", "text": "x = 2" },
        { "id": "d", "text": "x = -2" }
      ],
      "correctAnswer": "b",
      "explanation": "Cross multiply: 5(x+1) = 3(x-1). 5x + 5 = 3x - 3. 2x = -8. x = -4. Check: 5/(-5) = -1 and 3/(-3) = -1. Both equal -1."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Simplify: (x^2 - 4) / (x + 2) x (x + 3) / (x - 2)",
      "options": [
        { "id": "a", "text": "x + 3" },
        { "id": "b", "text": "(x+3)(x-2)" },
        { "id": "c", "text": "x - 2" },
        { "id": "d", "text": "1" }
      ],
      "correctAnswer": "a",
      "explanation": "(x^2-4)/(x+2) = (x+2)(x-2)/(x+2) = x-2. Then (x-2) x (x+3)/(x-2) = x+3."
    }
  ]
}
