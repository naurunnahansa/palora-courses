{
  "id": "quiz-calculating-probability",
  "title": "Quiz: Calculating Probability",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A bag contains 3 red, 5 blue, and 2 green balls. What is the probability of picking a blue ball at random?",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{3}{10}$"
        },
        {
          "id": "b",
          "text": "$\\frac{1}{2}$"
        },
        {
          "id": "c",
          "text": "$\\frac{5}{10}$"
        },
        {
          "id": "d",
          "text": "$\\frac{5}{8}$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Total balls $= 3 + 5 + 2 = 10$. $P(\\text{blue}) = \\frac{5}{10} = \\frac{1}{2}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A fair six-sided dice is rolled. What is the probability of getting a number greater than 4?",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{4}{6}$"
        },
        {
          "id": "b",
          "text": "$\\frac{2}{6}$"
        },
        {
          "id": "c",
          "text": "$\\frac{1}{6}$"
        },
        {
          "id": "d",
          "text": "$\\frac{3}{6}$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Numbers greater than 4 are 5 and 6. That is 2 outcomes out of 6: $P = \\frac{2}{6} = \\frac{1}{3}$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The theoretical probability formula for equally likely outcomes is:",
      "options": [
        {
          "id": "a",
          "text": "$P = \\frac{\\text{favourable outcomes}}{\\text{total outcomes}}$"
        },
        {
          "id": "b",
          "text": "$P = \\frac{\\text{total outcomes}}{\\text{favourable outcomes}}$"
        },
        {
          "id": "c",
          "text": "$P = \\text{favourable outcomes} \\times \\text{total outcomes}$"
        },
        {
          "id": "d",
          "text": "$P = \\text{favourable outcomes} - \\text{total outcomes}$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Theoretical probability is the number of favourable outcomes divided by the total number of equally likely outcomes."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A letter is chosen at random from the word MATHEMATICS. What is the probability of choosing the letter A?",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{1}{11}$"
        },
        {
          "id": "b",
          "text": "$\\frac{1}{6}$"
        },
        {
          "id": "c",
          "text": "$\\frac{3}{11}$"
        },
        {
          "id": "d",
          "text": "$\\frac{2}{11}$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "MATHEMATICS has 11 letters, and A appears twice (positions 2 and 7). So $P(A) = \\frac{2}{11}$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $P(A) = 0.35$, what is $P(\\text{not } A)$?",
      "options": [
        {
          "id": "a",
          "text": "$0.35$"
        },
        {
          "id": "b",
          "text": "$0.65$"
        },
        {
          "id": "c",
          "text": "$0.75$"
        },
        {
          "id": "d",
          "text": "$1.35$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "The probability of an event not occurring is $1 - P(A) = 1 - 0.35 = 0.65$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A spinner has sections coloured red, blue, green, and yellow. The probabilities of red, blue, and green are $0.2$, $0.35$, and $0.15$ respectively. What is the probability of yellow?",
      "options": [
        {
          "id": "a",
          "text": "$0.2$"
        },
        {
          "id": "b",
          "text": "$0.25$"
        },
        {
          "id": "c",
          "text": "$0.3$"
        },
        {
          "id": "d",
          "text": "$0.7$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "All probabilities must sum to 1: $P(\\text{yellow}) = 1 - 0.2 - 0.35 - 0.15 = 0.3$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A card is drawn at random from a standard pack of 52 cards. What is the probability of drawing a heart?",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{1}{4}$"
        },
        {
          "id": "b",
          "text": "$\\frac{1}{13}$"
        },
        {
          "id": "c",
          "text": "$\\frac{1}{52}$"
        },
        {
          "id": "d",
          "text": "$\\frac{1}{2}$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "There are 13 hearts in a pack of 52 cards: $P(\\text{heart}) = \\frac{13}{52} = \\frac{1}{4}$."
    }
  ]
}
