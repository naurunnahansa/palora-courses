{
  "id": "quiz-negative-and-fractional-indices",
  "title": "Quiz: Negative and Fractional Indices",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the value of $3^{-2}$?",
      "options": [
        {"id": "a", "text": "$-9$"},
        {"id": "b", "text": "$-6$"},
        {"id": "c", "text": "$\\frac{1}{9}$"},
        {"id": "d", "text": "$\\frac{1}{6}$"}
      ],
      "correctAnswer": "c",
      "explanation": "A negative index means take the reciprocal: $3^{-2} = \\frac{1}{3^2} = \\frac{1}{9}$. A negative index does not make the answer negative."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $8^{\\frac{2}{3}}$?",
      "options": [
        {"id": "a", "text": "$2$"},
        {"id": "b", "text": "$4$"},
        {"id": "c", "text": "$16$"},
        {"id": "d", "text": "$\\frac{16}{3}$"}
      ],
      "correctAnswer": "b",
      "explanation": "$8^{\\frac{2}{3}} = (\\sqrt[3]{8})^2 = 2^2 = 4$. Find the cube root first ($\\sqrt[3]{8} = 2$), then square the result."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What does $a^{\\frac{1}{2}}$ represent?",
      "options": [
        {"id": "a", "text": "Half of $a$"},
        {"id": "b", "text": "$\\sqrt{a}$"},
        {"id": "c", "text": "$\\frac{a}{2}$"},
        {"id": "d", "text": "$2a$"}
      ],
      "correctAnswer": "b",
      "explanation": "A fractional index of $\\frac{1}{n}$ represents the $n$th root. So $a^{\\frac{1}{2}} = \\sqrt{a}$ (the square root of $a$)."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Evaluate $\\left(\\frac{4}{9}\\right)^{-\\frac{1}{2}}$.",
      "options": [
        {"id": "a", "text": "$\\frac{2}{3}$"},
        {"id": "b", "text": "$\\frac{3}{2}$"},
        {"id": "c", "text": "$-\\frac{2}{3}$"},
        {"id": "d", "text": "$\\frac{9}{4}$"}
      ],
      "correctAnswer": "b",
      "explanation": "The negative index flips the fraction: $\\left(\\frac{4}{9}\\right)^{-\\frac{1}{2}} = \\left(\\frac{9}{4}\\right)^{\\frac{1}{2}} = \\sqrt{\\frac{9}{4}} = \\frac{3}{2}$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $x^{\\frac{1}{2}} \\times x^{\\frac{3}{2}}$.",
      "options": [
        {"id": "a", "text": "$x^{\\frac{3}{4}}$"},
        {"id": "b", "text": "$x^{\\frac{4}{2}}$"},
        {"id": "c", "text": "$x^2$"},
        {"id": "d", "text": "$x^{\\frac{1}{3}}$"}
      ],
      "correctAnswer": "c",
      "explanation": "Add the indices: $x^{\\frac{1}{2}} \\times x^{\\frac{3}{2}} = x^{\\frac{1}{2} + \\frac{3}{2}} = x^{\\frac{4}{2}} = x^2$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "How would $\\frac{1}{\\sqrt{x}}$ be written using index notation?",
      "options": [
        {"id": "a", "text": "$x^{\\frac{1}{2}}$"},
        {"id": "b", "text": "$x^{-\\frac{1}{2}}$"},
        {"id": "c", "text": "$x^{-2}$"},
        {"id": "d", "text": "$-x^{\\frac{1}{2}}$"}
      ],
      "correctAnswer": "b",
      "explanation": "$\\frac{1}{\\sqrt{x}} = \\frac{1}{x^{\\frac{1}{2}}} = x^{-\\frac{1}{2}}$. The square root gives the $\\frac{1}{2}$ and the reciprocal gives the negative sign."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $(16x^8)^{\\frac{3}{4}}$.",
      "options": [
        {"id": "a", "text": "$4x^2$"},
        {"id": "b", "text": "$8x^6$"},
        {"id": "c", "text": "$12x^6$"},
        {"id": "d", "text": "$8x^{32}$"}
      ],
      "correctAnswer": "b",
      "explanation": "$(16x^8)^{\\frac{3}{4}} = 16^{\\frac{3}{4}} \\times (x^8)^{\\frac{3}{4}} = (\\sqrt[4]{16})^3 \\times x^{8 \\times \\frac{3}{4}} = 2^3 \\times x^6 = 8x^6$."
    }
  ]
}
