{
  "id": "check-pythagoras-applications",
  "title": "Check: Pythagoras' Theorem Applications",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A ladder $5\\text{ m}$ long leans against a wall. The foot of the ladder is $3\\text{ m}$ from the wall. How high up the wall does the ladder reach?",
      "options": [
        { "id": "a", "text": "$2\\text{ m}$" },
        { "id": "b", "text": "$4\\text{ m}$" },
        { "id": "c", "text": "$\\sqrt{34}\\text{ m}$" },
        { "id": "d", "text": "$8\\text{ m}$" }
      ],
      "correctAnswer": "b",
      "explanation": "Height $= \\sqrt{5^2 - 3^2} = \\sqrt{25 - 9} = \\sqrt{16} = 4\\text{ m}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Find the distance between the points $(1, 2)$ and $(4, 6)$.",
      "options": [
        { "id": "a", "text": "$7$" },
        { "id": "b", "text": "$25$" },
        { "id": "c", "text": "$5$" },
        { "id": "d", "text": "$\\sqrt{7}$" }
      ],
      "correctAnswer": "c",
      "explanation": "Distance $= \\sqrt{(4-1)^2 + (6-2)^2} = \\sqrt{9 + 16} = \\sqrt{25} = 5$."
    }
  ]
}