{
  "id": "quiz-substitution",
  "title": "Quiz: Substitution",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $x = 4$, find the value of $3x + 7$.",
      "options": [
        {"id": "a", "text": "$14$"},
        {"id": "b", "text": "$19$"},
        {"id": "c", "text": "$34$"},
        {"id": "d", "text": "$47$"}
      ],
      "correctAnswer": "b",
      "explanation": "Substitute $x = 4$: $3(4) + 7 = 12 + 7 = 19$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $a = 3$ and $b = -2$, find the value of $a^2 - 2b$.",
      "options": [
        {"id": "a", "text": "$5$"},
        {"id": "b", "text": "$7$"},
        {"id": "c", "text": "$13$"},
        {"id": "d", "text": "$1$"}
      ],
      "correctAnswer": "c",
      "explanation": "$a^2 - 2b = (3)^2 - 2(-2) = 9 - (-4) = 9 + 4 = 13$. Remember that subtracting a negative becomes adding."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $x = -3$, what is $x^2 + 2x$?",
      "options": [
        {"id": "a", "text": "$15$"},
        {"id": "b", "text": "$3$"},
        {"id": "c", "text": "$-3$"},
        {"id": "d", "text": "$-15$"}
      ],
      "correctAnswer": "b",
      "explanation": "$x^2 + 2x = (-3)^2 + 2(-3) = 9 + (-6) = 3$. Note that $(-3)^2 = 9$, not $-9$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Using the formula $v = u + at$, find $v$ when $u = 5$, $a = -2$, and $t = 3$.",
      "options": [
        {"id": "a", "text": "$-1$"},
        {"id": "b", "text": "$1$"},
        {"id": "c", "text": "$11$"},
        {"id": "d", "text": "$-11$"}
      ],
      "correctAnswer": "a",
      "explanation": "$v = 5 + (-2)(3) = 5 + (-6) = 5 - 6 = -1$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $p = 5$ and $q = 2$, find $\\frac{p^2 - q}{p + q}$.",
      "options": [
        {"id": "a", "text": "$\\frac{23}{7}$"},
        {"id": "b", "text": "$3$"},
        {"id": "c", "text": "$\\frac{27}{7}$"},
        {"id": "d", "text": "$\\frac{23}{3}$"}
      ],
      "correctAnswer": "a",
      "explanation": "$\\frac{p^2 - q}{p + q} = \\frac{25 - 2}{5 + 2} = \\frac{23}{7}$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $y = -4$, what is $-y^2$?",
      "options": [
        {"id": "a", "text": "$16$"},
        {"id": "b", "text": "$-16$"},
        {"id": "c", "text": "$8$"},
        {"id": "d", "text": "$-8$"}
      ],
      "correctAnswer": "b",
      "explanation": "$-y^2 = -(y^2) = -((-4)^2) = -(16) = -16$. The negative sign is not part of the squaring."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $x = 2$ and $y = -1$, evaluate $3xy^2 - 4x$.",
      "options": [
        {"id": "a", "text": "$-2$"},
        {"id": "b", "text": "$2$"},
        {"id": "c", "text": "$-14$"},
        {"id": "d", "text": "$14$"}
      ],
      "correctAnswer": "a",
      "explanation": "$3xy^2 - 4x = 3(2)(-1)^2 - 4(2) = 3(2)(1) - 8 = 6 - 8 = -2$."
    }
  ]
}
