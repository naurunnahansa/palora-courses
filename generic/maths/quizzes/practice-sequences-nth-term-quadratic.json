  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Find the nth term of: 2, 6, 12, 20, 30, ...",
      "options": [
        { "id": "a", "text": "n^2 + n" },
        { "id": "b", "text": "n^2 + 2n" },
        { "id": "c", "text": "2n^2" },
        { "id": "d", "text": "n^2 - n + 2" }
      ],
      "correctAnswer": "a",
      "explanation": "1st differences: 4, 6, 8, 10. 2nd differences: 2, 2, 2. So a = 1. Subtract n^2: 2-1=1, 6-4=2, 12-9=3, 20-16=4. Linear part: n. nth term = n^2 + n. Check: n=3 gives 9+3=12."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A quadratic sequence has 2nd difference of 6. What is the coefficient of n^2 in its nth term?",
      "options": [
        { "id": "a", "text": "6" },
        { "id": "b", "text": "3" },
        { "id": "c", "text": "12" },
        { "id": "d", "text": "2" }
      ],
      "correctAnswer": "b",
      "explanation": "If the second difference is 2a, then a = second difference / 2 = 6/2 = 3. The coefficient of n^2 is 3."
    },
