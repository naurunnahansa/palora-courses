{
  "id": "check-rearranging-formulae",
  "title": "Check: Rearranging Formulae",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $x$ the subject of $y = 3x + 5$.",
      "options": [
        { "id": "a", "text": "$x = \\frac{y + 5}{3}$" },
        { "id": "b", "text": "$x = \\frac{y - 5}{3}$" },
        { "id": "c", "text": "$x = 3y - 5$" },
        { "id": "d", "text": "$x = \\frac{3}{y - 5}$" }
      ],
      "correctAnswer": "b",
      "explanation": "Subtract $5$ from both sides: $y - 5 = 3x$. Divide by $3$: $x = \\frac{y - 5}{3}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $r$ the subject of $A = \\pi r^2$.",
      "options": [
        { "id": "a", "text": "$r = \\frac{A}{\\pi}$" },
        { "id": "b", "text": "$r = \\sqrt{\\frac{A}{\\pi}}$" },
        { "id": "c", "text": "$r = \\frac{\\sqrt{A}}{\\pi}$" },
        { "id": "d", "text": "$r = \\sqrt{A\\pi}$" }
      ],
      "correctAnswer": "b",
      "explanation": "Divide by $\\pi$: $\\frac{A}{\\pi} = r^2$. Square root both sides: $r = \\sqrt{\\frac{A}{\\pi}}$."
    }
  ]
}
