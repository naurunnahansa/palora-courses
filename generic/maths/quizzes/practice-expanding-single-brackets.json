{
  "id": "practice-expanding-single-brackets",
  "title": "Practice: Expanding Single Brackets",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Expand and simplify: 3(2x + 5) - 4(x - 2)",
      "options": [
        { "id": "a", "text": "2x + 23" },
        { "id": "b", "text": "2x + 7" },
        { "id": "c", "text": "2x + 11" },
        { "id": "d", "text": "10x + 7" }
      ],
      "correctAnswer": "a",
      "explanation": "3(2x + 5) = 6x + 15. -4(x - 2) = -4x + 8. Combine: 6x + 15 - 4x + 8 = 2x + 23. A common error is writing -4(x - 2) = -4x - 8 (forgetting that negative times negative is positive)."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Expand: -2x(3x - 4)",
      "options": [
        { "id": "a", "text": "-6x^2 + 8x" },
        { "id": "b", "text": "-6x^2 - 8x" },
        { "id": "c", "text": "6x^2 + 8x" },
        { "id": "d", "text": "-6x + 8" }
      ],
      "correctAnswer": "a",
      "explanation": "-2x(3x) = -6x^2 and -2x(-4) = +8x. So -2x(3x - 4) = -6x^2 + 8x."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Expand and simplify: 5(x + 3) + 2(3x - 1)",
      "options": [
        { "id": "a", "text": "11x + 17" },
        { "id": "b", "text": "11x + 13" },
        { "id": "c", "text": "8x + 13" },
        { "id": "d", "text": "11x + 7" }
      ],
      "correctAnswer": "b",
      "explanation": "5(x + 3) = 5x + 15. 2(3x - 1) = 6x - 2. Combine: 5x + 15 + 6x - 2 = 11x + 13."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Expand: x^2(2x - 3)",
      "options": [
        { "id": "a", "text": "2x^2 - 3" },
        { "id": "b", "text": "2x^3 - 3x" },
        { "id": "c", "text": "2x^3 - 3x^2" },
        { "id": "d", "text": "2x^2 - 3x^2" }
      ],
      "correctAnswer": "c",
      "explanation": "x^2(2x) = 2x^3 (add the indices: 2 + 1 = 3). x^2(-3) = -3x^2. So x^2(2x - 3) = 2x^3 - 3x^2."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "The area of a rectangle is 4x(x + 5). When expanded, what is this equal to?",
      "options": [
        { "id": "a", "text": "4x^2 + 5" },
        { "id": "b", "text": "4x^2 + 20" },
        { "id": "c", "text": "4x^2 + 20x" },
        { "id": "d", "text": "4x + 20" }
      ],
      "correctAnswer": "c",
      "explanation": "4x(x + 5) = 4x(x) + 4x(5) = 4x^2 + 20x."
    }
  ]
}
