{
  "id": "check-collecting-like-terms-2",
  "title": "Check: Collecting Like Terms",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $2x^2 + 3x - x^2 + 5x$.",
      "options": [
        { "id": "a", "text": "$x^2 + 8x$" },
        { "id": "b", "text": "$3x^2 + 8x$" },
        { "id": "c", "text": "$9x^3$" },
        { "id": "d", "text": "$x^2 + 2x$" }
      ],
      "correctAnswer": "a",
      "explanation": "Collect the $x^2$ terms: $2x^2 - x^2 = x^2$. Collect the $x$ terms: $3x + 5x = 8x$. Note that $x^2$ and $x$ are not like terms and cannot be combined."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which of these is a correct simplification of $5xy - 2x + 3xy + x$?",
      "options": [
        { "id": "a", "text": "$8xy - x$" },
        { "id": "b", "text": "$8xy - 2x + x$" },
        { "id": "c", "text": "$8x^2y^2 - x$" },
        { "id": "d", "text": "$7xy$" }
      ],
      "correctAnswer": "a",
      "explanation": "Collect the $xy$ terms: $5xy + 3xy = 8xy$. Collect the $x$ terms: $-2x + x = -x$. So the answer is $8xy - x$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $7m - 3n + 2m + 3n$.",
      "options": [
        { "id": "a", "text": "$9m + 6n$" },
        { "id": "b", "text": "$9m$" },
        { "id": "c", "text": "$5m - 6n$" },
        { "id": "d", "text": "$9mn$" }
      ],
      "correctAnswer": "b",
      "explanation": "Collect the $m$ terms: $7m + 2m = 9m$. Collect the $n$ terms: $-3n + 3n = 0$. So the answer is simply $9m$."
    }
  ]
}
