{
  "id": "quiz-powers-and-roots",
  "title": "Quiz: Powers and Roots",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the value of $2^5$?",
      "options": [
        {
          "id": "a",
          "text": "10"
        },
        {
          "id": "b",
          "text": "25"
        },
        {
          "id": "c",
          "text": "32"
        },
        {
          "id": "d",
          "text": "64"
        }
      ],
      "correctAnswer": "c",
      "explanation": "$2^5 = 2 \\times 2 \\times 2 \\times 2 \\times 2 = 32$. A common error is to multiply the base by the index ($2 \\times 5 = 10$), but powers mean repeated multiplication."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $\\sqrt{144}$?",
      "options": [
        {
          "id": "a",
          "text": "14"
        },
        {
          "id": "b",
          "text": "13"
        },
        {
          "id": "c",
          "text": "11"
        },
        {
          "id": "d",
          "text": "12"
        }
      ],
      "correctAnswer": "d",
      "explanation": "$12^2 = 144$, so $\\sqrt{144} = 12$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $\\sqrt[3]{-27}$?",
      "options": [
        {
          "id": "a",
          "text": "$-9$"
        },
        {
          "id": "b",
          "text": "$3$"
        },
        {
          "id": "c",
          "text": "$-3$"
        },
        {
          "id": "d",
          "text": "Undefined"
        }
      ],
      "correctAnswer": "c",
      "explanation": "$(-3)^3 = (-3) \\times (-3) \\times (-3) = -27$, so $\\sqrt[3]{-27} = -3$. Unlike square roots, cube roots of negative numbers are defined."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the value of $7^0$?",
      "options": [
        {
          "id": "a",
          "text": "Undefined"
        },
        {
          "id": "b",
          "text": "7"
        },
        {
          "id": "c",
          "text": "1"
        },
        {
          "id": "d",
          "text": "0"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Any non-zero number raised to the power of 0 equals 1. So $7^0 = 1$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Between which two consecutive integers does $\\sqrt{70}$ lie?",
      "options": [
        {
          "id": "a",
          "text": "34 and 36"
        },
        {
          "id": "b",
          "text": "9 and 10"
        },
        {
          "id": "c",
          "text": "7 and 8"
        },
        {
          "id": "d",
          "text": "8 and 9"
        }
      ],
      "correctAnswer": "d",
      "explanation": "$8^2 = 64$ and $9^2 = 81$. Since $64 < 70 < 81$, we know $\\sqrt{70}$ lies between 8 and 9."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A square has area $196 \\text{ cm}^2$. What is its side length?",
      "options": [
        {
          "id": "a",
          "text": "$49$ cm"
        },
        {
          "id": "b",
          "text": "$14$ cm"
        },
        {
          "id": "c",
          "text": "$13$ cm"
        },
        {
          "id": "d",
          "text": "$98$ cm"
        }
      ],
      "correctAnswer": "b",
      "explanation": "For a square, area $= \\text{side}^2$. So side $= \\sqrt{196} = 14$ cm."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which statement about powers of negative numbers is correct?",
      "options": [
        {
          "id": "a",
          "text": "A negative number raised to any power is always negative"
        },
        {
          "id": "b",
          "text": "A negative number raised to an even power is positive; raised to an odd power is negative"
        },
        {
          "id": "c",
          "text": "A negative number can never be raised to a power"
        },
        {
          "id": "d",
          "text": "A negative number raised to an even power is negative; raised to an odd power is positive"
        }
      ],
      "correctAnswer": "b",
      "explanation": "An even power of a negative number is positive (e.g., $(-3)^2 = 9$) because the pairs of negatives cancel. An odd power is negative (e.g., $(-3)^3 = -27$) because there is one unpaired negative."
    }
  ]
}
