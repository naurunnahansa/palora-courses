{
  "id": "check-finding-angles-trig-2",
  "title": "Check: Finding Angles Using Trigonometry",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the adjacent side is $7\\text{ cm}$ and the hypotenuse is $14\\text{ cm}$. What is angle $\\theta$?",
      "options": [
        { "id": "a", "text": "$30°$" },
        { "id": "b", "text": "$45°$" },
        { "id": "c", "text": "$60°$" },
        { "id": "d", "text": "$90°$" }
      ],
      "correctAnswer": "c",
      "explanation": "$\\cos\\theta = \\frac{7}{14} = 0.5$, so $\\theta = \\cos^{-1}(0.5) = 60°$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the opposite side is $9\\text{ cm}$ and the adjacent side is $9\\text{ cm}$. What is angle $\\theta$?",
      "options": [
        { "id": "a", "text": "$30°$" },
        { "id": "b", "text": "$45°$" },
        { "id": "c", "text": "$60°$" },
        { "id": "d", "text": "$90°$" }
      ],
      "correctAnswer": "b",
      "explanation": "$\\tan\\theta = \\frac{9}{9} = 1$, so $\\theta = \\tan^{-1}(1) = 45°$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A ramp rises $2\\text{ m}$ over a horizontal distance of $5\\text{ m}$. What angle does the ramp make with the horizontal? Round to 1 decimal place.",
      "options": [
        { "id": "a", "text": "$21.8°$" },
        { "id": "b", "text": "$23.6°$" },
        { "id": "c", "text": "$68.2°$" },
        { "id": "d", "text": "$66.4°$" }
      ],
      "correctAnswer": "a",
      "explanation": "$\\tan\\theta = \\frac{2}{5} = 0.4$, so $\\theta = \\tan^{-1}(0.4) \\approx 21.8°$."
    }
  ]
}