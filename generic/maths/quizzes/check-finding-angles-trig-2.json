{
  "id": "check-finding-angles-trig-2",
  "title": "Check: Finding Angles Using Trigonometry",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the adjacent side is $7\\text{ cm}$ and the hypotenuse is $14\\text{ cm}$. What is angle $\\theta$?",
      "options": [
        {
          "id": "a",
          "text": "$30°$"
        },
        {
          "id": "b",
          "text": "$45°$"
        },
        {
          "id": "c",
          "text": "$60°$"
        },
        {
          "id": "d",
          "text": "$90°$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "$\\cos\\theta = \\frac{7}{14} = 0.5$, so $\\theta = \\cos^{-1}(0.5) = 60°$."
    }
  ]
}