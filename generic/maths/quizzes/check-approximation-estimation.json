    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Estimate the value of $\\frac{19.8 \\times 3.1}{0.52}$ by rounding each number to $1$ significant figure.",
      "options": [
        { "id": "a", "text": "$60$" },
        { "id": "b", "text": "$100$" },
        { "id": "c", "text": "$120$" },
        { "id": "d", "text": "$12$" }
      ],
      "correctAnswer": "c",
      "explanation": "Round: $19.8 \\approx 20$, $3.1 \\approx 3$, $0.52 \\approx 0.5$. Estimate $= \\frac{20 \\times 3}{0.5} = \\frac{60}{0.5} = 120$."
    }
  ]
