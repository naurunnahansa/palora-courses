    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Round $0.004372$ to $2$ significant figures.",
      "options": [
        { "id": "a", "text": "$0.004$" },
        { "id": "b", "text": "$0.0044$" },
        { "id": "c", "text": "$0.0043$" },
        { "id": "d", "text": "$0.00437$" }
      ],
      "correctAnswer": "b",
      "explanation": "Leading zeros are not significant. The first significant figure is $4$, the second is $3$. The next digit is $7 \\geq 5$, so round up: $0.0044$."
