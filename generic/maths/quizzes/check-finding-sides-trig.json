{
  "id": "check-finding-sides-trig",
  "title": "Check: Finding Sides Using Trigonometry",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the hypotenuse is $10\\text{ cm}$ and one angle is $30°$. What is the length of the side opposite to the $30°$ angle?",
      "options": [
        {
          "id": "a",
          "text": "$10\\sqrt{3}\\text{ cm}$"
        },
        {
          "id": "b",
          "text": "$\\frac{10}{\\sqrt{3}}\\text{ cm}$"
        },
        {
          "id": "c",
          "text": "$5\\sqrt{3}\\text{ cm}$"
        },
        {
          "id": "d",
          "text": "$5\\text{ cm}$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Opposite $= \\text{hypotenuse} \\times \\sin 30° = 10 \\times 0.5 = 5\\text{ cm}$."
    }
  ]
}
