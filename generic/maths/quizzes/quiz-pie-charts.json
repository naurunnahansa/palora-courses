{
  "id": "quiz-pie-charts",
  "title": "Quiz: Pie Charts",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "60 people were surveyed. The 'car' sector has a frequency of 20. What angle should this sector be?",
      "options": [
        {
          "id": "a",
          "text": "$60°$"
        },
        {
          "id": "b",
          "text": "$90°$"
        },
        {
          "id": "c",
          "text": "$120°$"
        },
        {
          "id": "d",
          "text": "$180°$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Angle $= \\frac{20}{60} \\times 360° = 120°$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a pie chart for 90 people, a sector has an angle of $80°$. How many people does it represent?",
      "options": [
        {
          "id": "a",
          "text": "20"
        },
        {
          "id": "b",
          "text": "10"
        },
        {
          "id": "c",
          "text": "30"
        },
        {
          "id": "d",
          "text": "40"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Frequency $= \\frac{80}{360} \\times 90 = 20$ people."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The angles in a pie chart must always sum to:",
      "options": [
        {
          "id": "a",
          "text": "$180°$"
        },
        {
          "id": "b",
          "text": "$360°$"
        },
        {
          "id": "c",
          "text": "$270°$"
        },
        {
          "id": "d",
          "text": "$100°$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "A pie chart is a full circle, so the angles of all sectors must sum to $360°$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Two pie charts have the same sized 'football' sector ($90°$). School A has 200 students and School B has 80. Which school has more football fans?",
      "options": [
        {
          "id": "a",
          "text": "School B"
        },
        {
          "id": "b",
          "text": "They have the same number"
        },
        {
          "id": "c",
          "text": "It cannot be determined"
        },
        {
          "id": "d",
          "text": "School A"
        }
      ],
      "correctAnswer": "d",
      "explanation": "School A: $\\frac{90}{360} \\times 200 = 50$. School B: $\\frac{90}{360} \\times 80 = 20$. School A has more football fans despite the sectors being the same angle."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A pie chart sector has an angle of $40°$ and represents 8 people. What is the total number of people surveyed?",
      "options": [
        {
          "id": "a",
          "text": "72"
        },
        {
          "id": "b",
          "text": "48"
        },
        {
          "id": "c",
          "text": "36"
        },
        {
          "id": "d",
          "text": "80"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Total $= \\frac{8 \\times 360}{40} = \\frac{2880}{40} = 72$ people."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Pie charts are best for showing:",
      "options": [
        {
          "id": "a",
          "text": "Exact values of each category"
        },
        {
          "id": "b",
          "text": "Trends over time"
        },
        {
          "id": "c",
          "text": "Proportions of a whole"
        },
        {
          "id": "d",
          "text": "Continuous data distributions"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Pie charts are designed to show how a total is divided into proportions. They are less suitable for showing exact values or trends."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A common mistake when calculating pie chart angles is dividing $360°$ by the number of categories instead of the total frequency. If there are 5 categories and 100 people, what would this incorrect method give?",
      "options": [
        {
          "id": "a",
          "text": "$3.6°$ per person"
        },
        {
          "id": "b",
          "text": "$72°$ per category"
        },
        {
          "id": "c",
          "text": "$36°$ per category"
        },
        {
          "id": "d",
          "text": "$60°$ per category"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Incorrectly dividing $360° \\div 5 = 72°$ gives equal sectors regardless of the actual frequencies. The correct method is $\\frac{360°}{100} = 3.6°$ per person."
    }
  ]
}
