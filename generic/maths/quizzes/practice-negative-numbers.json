  "id": "practice-negative-numbers",
  "title": "Practice: Negative Numbers",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Calculate: (-8) + 5 - (-3)",
      "options": [
        { "id": "a", "text": "-6" },
        { "id": "b", "text": "0" },
        { "id": "c", "text": "-10" },
        { "id": "d", "text": "6" }
      ],
      "correctAnswer": "b",
      "explanation": "(-8) + 5 - (-3) = (-8) + 5 + 3. First: -8 + 5 = -3. Then: -3 + 3 = 0."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "The temperature at midnight was -7 degrees C. By noon it had risen by 12 degrees C, then fell by 4 degrees C by 6 pm. What was the temperature at 6 pm?",
      "options": [
        { "id": "a", "text": "3 degrees C" },
        { "id": "b", "text": "-3 degrees C" },
        { "id": "c", "text": "1 degree C" },
        { "id": "d", "text": "5 degrees C" }
      ],
      "correctAnswer": "c",
      "explanation": "Starting at -7, rising by 12 gives: -7 + 12 = 5. Then falling by 4 gives: 5 - 4 = 1 degree C."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Calculate: (-4) x (-3) x (-2)",
      "options": [
        { "id": "a", "text": "24" },
        { "id": "b", "text": "-24" },
        { "id": "c", "text": "-12" },
        { "id": "d", "text": "12" }
      ],
      "correctAnswer": "b",
      "explanation": "(-4) x (-3) = 12 (same signs give positive). Then 12 x (-2) = -24 (different signs give negative). An odd number of negative factors gives a negative product."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "What is the value of (-3)^2 - (-2)^3?",
      "options": [
        { "id": "a", "text": "1" },
        { "id": "b", "text": "17" },
        { "id": "c", "text": "-17" },
        { "id": "d", "text": "-1" }
      ],
      "correctAnswer": "b",
      "explanation": "(-3)^2 = 9 (even power gives positive). (-2)^3 = -8 (odd power gives negative). So 9 - (-8) = 9 + 8 = 17."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Calculate: (-18) / (-3) + (-10) / 5",
      "options": [
        { "id": "a", "text": "8" },
        { "id": "b", "text": "-8" },
        { "id": "c", "text": "4" },
        { "id": "d", "text": "-4" }
      ],
      "correctAnswer": "c",
      "explanation": "(-18) / (-3) = 6 (same signs give positive). (-10) / 5 = -2 (different signs give negative). So 6 + (-2) = 6 - 2 = 4."
    }
  ]
}
