{
  "id": "quiz-angles-in-polygons",
  "title": "Quiz: Angles in Polygons",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the sum of the interior angles of a hexagon?",
      "options": [
        {"id": "a", "text": "$540°$"},
        {"id": "b", "text": "$720°$"},
        {"id": "c", "text": "$900°$"},
        {"id": "d", "text": "$360°$"}
      ],
      "correctAnswer": "b",
      "explanation": "The sum of interior angles of an $n$-sided polygon is $(n-2) \\times 180°$. For a hexagon: $(6-2) \\times 180° = 720°$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the size of each interior angle of a regular pentagon?",
      "options": [
        {"id": "a", "text": "$120°$"},
        {"id": "b", "text": "$100°$"},
        {"id": "c", "text": "$108°$"},
        {"id": "d", "text": "$135°$"}
      ],
      "correctAnswer": "c",
      "explanation": "Interior angle sum $= (5-2) \\times 180° = 540°$. Each angle $= 540° \\div 5 = 108°$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The sum of the exterior angles of any convex polygon is:",
      "options": [
        {"id": "a", "text": "$180°$"},
        {"id": "b", "text": "$360°$"},
        {"id": "c", "text": "It depends on the number of sides"},
        {"id": "d", "text": "$720°$"}
      ],
      "correctAnswer": "b",
      "explanation": "The sum of exterior angles of any convex polygon is always $360°$, regardless of the number of sides."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Each exterior angle of a regular polygon is $40°$. How many sides does the polygon have?",
      "options": [
        {"id": "a", "text": "$8$"},
        {"id": "b", "text": "$9$"},
        {"id": "c", "text": "$10$"},
        {"id": "d", "text": "$12$"}
      ],
      "correctAnswer": "b",
      "explanation": "Number of sides $= 360° \\div 40° = 9$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the size of each exterior angle of a regular octagon?",
      "options": [
        {"id": "a", "text": "$30°$"},
        {"id": "b", "text": "$40°$"},
        {"id": "c", "text": "$45°$"},
        {"id": "d", "text": "$60°$"}
      ],
      "correctAnswer": "c",
      "explanation": "Each exterior angle $= 360° \\div 8 = 45°$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A regular polygon has an interior angle of $150°$. How many sides does it have?",
      "options": [
        {"id": "a", "text": "$10$"},
        {"id": "b", "text": "$12$"},
        {"id": "c", "text": "$15$"},
        {"id": "d", "text": "$18$"}
      ],
      "correctAnswer": "b",
      "explanation": "Exterior angle $= 180° - 150° = 30°$. Number of sides $= 360° \\div 30° = 12$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Five angles of a hexagon are $100°$, $130°$, $140°$, $110°$, and $120°$. What is the sixth angle?",
      "options": [
        {"id": "a", "text": "$110°$"},
        {"id": "b", "text": "$120°$"},
        {"id": "c", "text": "$130°$"},
        {"id": "d", "text": "$140°$"}
      ],
      "correctAnswer": "b",
      "explanation": "Sum of interior angles $= 720°$. Sixth angle $= 720° - 100° - 130° - 140° - 110° - 120° = 120°$."
    }
  ]
}
