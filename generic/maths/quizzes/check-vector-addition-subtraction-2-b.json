{
  "id": "check-vector-addition-subtraction-2-b",
  "title": "Check: Vector Addition and Subtraction (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $\\mathbf{a} + \\mathbf{b} = \\begin{pmatrix} 7 \\\\ 2 \\end{pmatrix}$ and $\\mathbf{a} = \\begin{pmatrix} 3 \\\\ -1 \\end{pmatrix}$, what is $\\mathbf{b}$?",
      "options": [
        {
          "id": "a",
          "text": "$\\begin{pmatrix} 10 \\\\ 1 \\end{pmatrix}$"
        },
        {
          "id": "b",
          "text": "$\\begin{pmatrix} 4 \\\\ 3 \\end{pmatrix}$"
        },
        {
          "id": "c",
          "text": "$\\begin{pmatrix} 4 \\\\ -3 \\end{pmatrix}$"
        },
        {
          "id": "d",
          "text": "$\\begin{pmatrix} -4 \\\\ 3 \\end{pmatrix}$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$\\mathbf{b} = \\begin{pmatrix} 7 \\\\ 2 \\end{pmatrix} - \\begin{pmatrix} 3 \\\\ -1 \\end{pmatrix} = \\begin{pmatrix} 4 \\\\ 3 \\end{pmatrix}$."
    }
  ]
