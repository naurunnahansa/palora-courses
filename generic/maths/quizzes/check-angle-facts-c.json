  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Three angles meet at a point. Two of them are $110°$ and $85°$. What is the third angle?",
      "options": [
        {
          "id": "a",
          "text": "$155°$"
        },
        {
          "id": "b",
          "text": "$145°$"
        },
        {
          "id": "c",
          "text": "$175°$"
        },
        {
          "id": "d",
          "text": "$165°$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Angles around a point sum to $360°$. The third angle is $360° - 110° - 85° = 165°$."
    }
  ]
