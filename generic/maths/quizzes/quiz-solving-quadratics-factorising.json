{
  "id": "quiz-solving-quadratics-factorising",
  "title": "Quiz: Solving Quadratics by Factorising",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $x^2 + 5x + 6 = 0$.",
      "options": [
        {"id": "a", "text": "$x = 2$ and $x = 3$"},
        {"id": "b", "text": "$x = -2$ and $x = -3$"},
        {"id": "c", "text": "$x = 1$ and $x = 6$"},
        {"id": "d", "text": "$x = -1$ and $x = -6$"}
      ],
      "correctAnswer": "b",
      "explanation": "Factorise: $(x + 2)(x + 3) = 0$. Set each factor to zero: $x + 2 = 0$ gives $x = -2$, and $x + 3 = 0$ gives $x = -3$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $x^2 - 7x + 10 = 0$.",
      "options": [
        {"id": "a", "text": "$x = 2$ and $x = 5$"},
        {"id": "b", "text": "$x = -2$ and $x = -5$"},
        {"id": "c", "text": "$x = 1$ and $x = 10$"},
        {"id": "d", "text": "$x = -2$ and $x = 5$"}
      ],
      "correctAnswer": "a",
      "explanation": "Factorise: $(x - 2)(x - 5) = 0$. So $x = 2$ or $x = 5$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $x^2 - 16 = 0$.",
      "options": [
        {"id": "a", "text": "$x = 4$ only"},
        {"id": "b", "text": "$x = -4$ only"},
        {"id": "c", "text": "$x = 4$ or $x = -4$"},
        {"id": "d", "text": "$x = 8$ or $x = -8$"}
      ],
      "correctAnswer": "c",
      "explanation": "Factorise using difference of squares: $(x + 4)(x - 4) = 0$. So $x = 4$ or $x = -4$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $x^2 + 3x = 0$.",
      "options": [
        {"id": "a", "text": "$x = 3$ only"},
        {"id": "b", "text": "$x = 0$ only"},
        {"id": "c", "text": "$x = 0$ or $x = -3$"},
        {"id": "d", "text": "$x = 0$ or $x = 3$"}
      ],
      "correctAnswer": "c",
      "explanation": "Factorise: $x(x + 3) = 0$. So $x = 0$ or $x + 3 = 0$, giving $x = -3$. Do not divide by $x$ as this loses the $x = 0$ solution."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $2x^2 + 5x - 3 = 0$.",
      "options": [
        {"id": "a", "text": "$x = \\frac{1}{2}$ or $x = -3$"},
        {"id": "b", "text": "$x = -\\frac{1}{2}$ or $x = 3$"},
        {"id": "c", "text": "$x = 1$ or $x = -3$"},
        {"id": "d", "text": "$x = 3$ or $x = -\\frac{1}{2}$"}
      ],
      "correctAnswer": "a",
      "explanation": "Factorise: $(2x - 1)(x + 3) = 0$. So $2x - 1 = 0$ gives $x = \\frac{1}{2}$, and $x + 3 = 0$ gives $x = -3$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Why must you set the quadratic equal to zero before factorising to solve?",
      "options": [
        {"id": "a", "text": "Because it makes the numbers smaller"},
        {"id": "b", "text": "Because if $ab = 0$, then $a = 0$ or $b = 0$ (the zero product property)"},
        {"id": "c", "text": "Because quadratics cannot be factorised otherwise"},
        {"id": "d", "text": "Because the teacher says so"}
      ],
      "correctAnswer": "b",
      "explanation": "The zero product property states that if two factors multiply to give zero, at least one of them must be zero. This only works when the product equals zero."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $x^2 = 5x + 14$.",
      "options": [
        {"id": "a", "text": "$x = 5$ or $x = 14$"},
        {"id": "b", "text": "$x = 7$ or $x = -2$"},
        {"id": "c", "text": "$x = -7$ or $x = 2$"},
        {"id": "d", "text": "$x = 7$ or $x = 2$"}
      ],
      "correctAnswer": "b",
      "explanation": "Rearrange to zero: $x^2 - 5x - 14 = 0$. Factorise: $(x - 7)(x + 2) = 0$. So $x = 7$ or $x = -2$."
    }
  ]
}
