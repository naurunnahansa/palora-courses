{
  "id": "check-plotting-quadratic-graphs",
  "title": "Check: Plotting Quadratic Graphs",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the shape of a quadratic graph?",
      "options": [
        { "id": "a", "text": "A straight line" },
        { "id": "b", "text": "A parabola (U-shape or inverted U-shape)" },
        { "id": "c", "text": "A circle" },
        { "id": "d", "text": "A hyperbola" }
      ],
      "correctAnswer": "b",
      "explanation": "A quadratic function $y = ax^2 + bx + c$ produces a parabola. It is U-shaped when $a > 0$ and an inverted U-shape when $a < 0$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "For the quadratic $y = x^2 - 4$, what is the value of $y$ when $x = 3$?",
      "options": [
        { "id": "a", "text": "$-1$" },
        { "id": "b", "text": "$5$" },
        { "id": "c", "text": "$13$" },
        { "id": "d", "text": "$-4$" }
      ],
      "correctAnswer": "b",
      "explanation": "Substituting $x = 3$: $y = (3)^2 - 4 = 9 - 4 = 5$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "When plotting $y = x^2$, the point $(-2, y)$ has $y$ equal to:",
      "options": [
        { "id": "a", "text": "$-4$" },
        { "id": "b", "text": "$4$" },
        { "id": "c", "text": "$-2$" },
        { "id": "d", "text": "$2$" }
      ],
      "correctAnswer": "b",
      "explanation": "$y = (-2)^2 = 4$. Note that squaring a negative number gives a positive result."
    }
  ]
}
