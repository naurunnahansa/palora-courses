{
  "id": "practice-proportion",
  "title": "Practice: Proportion",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "If 5 books cost 35 pounds, how much would 8 books cost?",
      "options": [
        { "id": "a", "text": "40 pounds" },
        { "id": "b", "text": "48 pounds" },
        { "id": "c", "text": "56 pounds" },
        { "id": "d", "text": "63 pounds" }
      ],
      "correctAnswer": "c",
      "explanation": "Cost per book = 35 / 5 = 7 pounds. Cost of 8 books = 8 x 7 = 56 pounds."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "y is directly proportional to x. When x = 4, y = 20. Find y when x = 7.",
      "options": [
        { "id": "a", "text": "28" },
        { "id": "b", "text": "35" },
        { "id": "c", "text": "140" },
        { "id": "d", "text": "23" }
      ],
      "correctAnswer": "b",
      "explanation": "y = kx. When x = 4, y = 20: 20 = 4k, so k = 5. When x = 7: y = 5 x 7 = 35."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "y is inversely proportional to x. When x = 3, y = 12. Find y when x = 9.",
      "options": [
        { "id": "a", "text": "36" },
        { "id": "b", "text": "4" },
        { "id": "c", "text": "6" },
        { "id": "d", "text": "108" }
      ],
      "correctAnswer": "b",
      "explanation": "y = k/x. When x = 3, y = 12: 12 = k/3, so k = 36. When x = 9: y = 36/9 = 4."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "y is directly proportional to x^2. When x = 3, y = 36. Find y when x = 5.",
      "options": [
        { "id": "a", "text": "60" },
        { "id": "b", "text": "100" },
        { "id": "c", "text": "20" },
        { "id": "d", "text": "180" }
      ],
      "correctAnswer": "b",
      "explanation": "y = kx^2. When x = 3, y = 36: 36 = k(9), so k = 4. When x = 5: y = 4 x 25 = 100."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "It takes 6 workers 10 days to complete a job. How many days would it take 15 workers to complete the same job?",
      "options": [
        { "id": "a", "text": "25 days" },
        { "id": "b", "text": "6 days" },
        { "id": "c", "text": "4 days" },
        { "id": "d", "text": "9 days" }
      ],
      "correctAnswer": "c",
      "explanation": "Workers and days are inversely proportional. Total work = 6 x 10 = 60 worker-days. With 15 workers: 60 / 15 = 4 days."
    }
  ]
}
