      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "The graph of y = -3/x has branches in which quadrants?",
      "options": [
        { "id": "a", "text": "1st and 3rd" },
        { "id": "b", "text": "2nd and 4th" },
        { "id": "c", "text": "1st and 2nd" },
        { "id": "d", "text": "All four" }
      ],
      "correctAnswer": "b",
      "explanation": "For y = a/x where a < 0, the branches are in the 2nd quadrant (x < 0, y > 0) and 4th quadrant (x > 0, y < 0)."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A car travels 120 km. The time t hours at speed v km/h is t = 120/v. How fast must the car travel to complete the journey in 1.5 hours?",
      "options": [
        { "id": "a", "text": "60 km/h" },
        { "id": "b", "text": "80 km/h" },
        { "id": "c", "text": "90 km/h" },
        { "id": "d", "text": "180 km/h" }
      ],
      "correctAnswer": "b",
      "explanation": "1.5 = 120/v. v = 120/1.5 = 80 km/h."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Which statement about y = 1/x is FALSE?",
      "options": [
        { "id": "a", "text": "The x-axis and y-axis are asymptotes" },
        { "id": "b", "text": "The graph passes through (1, 1)" },
        { "id": "c", "text": "The graph passes through the origin" },
        { "id": "d", "text": "The graph has rotational symmetry about the origin" }
      ],
      "correctAnswer": "c",
      "explanation": "The graph of y = 1/x never passes through the origin because 1/0 is undefined. The function is not defined at x = 0."
    },
