      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A ship sails $8\\text{ km}$ east and then $15\\text{ km}$ north. How far is the ship from its starting point?",
      "options": [
        {
          "id": "a",
          "text": "$\\sqrt{161}\\text{ km}$"
        },
        {
          "id": "b",
          "text": "$23\\text{ km}$"
        },
        {
          "id": "c",
          "text": "$12\\text{ km}$"
        },
        {
          "id": "d",
          "text": "$17\\text{ km}$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "The path forms a right angle. Distance $= \\sqrt{8^2 + 15^2} = \\sqrt{64 + 225} = \\sqrt{289} = 17\\text{ km}$."
    }
  ]
