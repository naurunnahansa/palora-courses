{
  "id": "quiz-similar-shapes",
  "title": "Quiz: Similar Shapes",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Two shapes are similar. This means they have:",
      "options": [
        {
          "id": "a",
          "text": "Equal side lengths"
        },
        {
          "id": "b",
          "text": "The same size but different shape"
        },
        {
          "id": "c",
          "text": "The same shape but possibly different sizes"
        },
        {
          "id": "d",
          "text": "The same area"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Similar shapes have the same shape (equal angles) but may be different sizes. Corresponding sides are in the same ratio."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Two similar triangles have a scale factor of $3$. If a side in the smaller triangle is $4$ cm, what is the corresponding side in the larger triangle?",
      "options": [
        {
          "id": "a",
          "text": "$16$ cm"
        },
        {
          "id": "b",
          "text": "$12$ cm"
        },
        {
          "id": "c",
          "text": "$1.33$ cm"
        },
        {
          "id": "d",
          "text": "$7$ cm"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Multiply the side by the scale factor: $4 \\times 3 = 12$ cm."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Triangle $ABC$ is similar to triangle $DEF$. $AB = 6$ cm, $DE = 9$ cm, and $BC = 8$ cm. What is $EF$?",
      "options": [
        {
          "id": "a",
          "text": "$5.33$ cm"
        },
        {
          "id": "b",
          "text": "$10$ cm"
        },
        {
          "id": "c",
          "text": "$14$ cm"
        },
        {
          "id": "d",
          "text": "$12$ cm"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Scale factor $= \\frac{DE}{AB} = \\frac{9}{6} = 1.5$. So $EF = 8 \\times 1.5 = 12$ cm."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Two rectangles are similar. The first is $4$ cm by $6$ cm and the second is $6$ cm by $x$ cm. What is $x$?",
      "options": [
        {
          "id": "a",
          "text": "$10$"
        },
        {
          "id": "b",
          "text": "$12$"
        },
        {
          "id": "c",
          "text": "$8$"
        },
        {
          "id": "d",
          "text": "$9$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Scale factor $= \\frac{6}{4} = 1.5$. So $x = 6 \\times 1.5 = 9$ cm."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Two similar triangles have corresponding sides of $10$ cm and $15$ cm. What is the scale factor from the smaller to the larger?",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{2}{3}$"
        },
        {
          "id": "b",
          "text": "$\\frac{3}{2}$"
        },
        {
          "id": "c",
          "text": "$1.25$"
        },
        {
          "id": "d",
          "text": "$5$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Scale factor $= \\frac{15}{10} = \\frac{3}{2}$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which condition is sufficient to prove two triangles are similar?",
      "options": [
        {
          "id": "a",
          "text": "One pair of equal angles"
        },
        {
          "id": "b",
          "text": "Equal perimeters"
        },
        {
          "id": "c",
          "text": "One pair of equal sides"
        },
        {
          "id": "d",
          "text": "Two pairs of equal angles"
        }
      ],
      "correctAnswer": "d",
      "explanation": "If two pairs of angles are equal, the third pair must also be equal (angles in a triangle sum to $180°$), proving similarity (AA condition)."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A map has a scale of $1:25000$. Two towns are $8$ cm apart on the map. What is the actual distance in kilometres?",
      "options": [
        {
          "id": "a",
          "text": "$0.2$ km"
        },
        {
          "id": "b",
          "text": "$20$ km"
        },
        {
          "id": "c",
          "text": "$200$ km"
        },
        {
          "id": "d",
          "text": "$2$ km"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Actual distance $= 8 \\times 25000 = 200000$ cm $= 2000$ m $= 2$ km."
    }
  ]
}
