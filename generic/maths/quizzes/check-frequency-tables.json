  "title": "Check: Frequency Tables",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A frequency table shows: Score $1$ (freq $4$), Score $2$ (freq $7$), Score $3$ (freq $9$). What is the total frequency?",
      "options": [
        { "id": "a", "text": "$3$" },
        { "id": "b", "text": "$6$" },
        { "id": "c", "text": "$20$" },
        { "id": "d", "text": "$21$" }
      ],
      "correctAnswer": "c",
      "explanation": "Total frequency $= 4 + 7 + 9 = 20$. This is the total number of data values."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "From the same table (Score $1$: freq $4$, Score $2$: freq $7$, Score $3$: freq $9$), what is the mean score?",
      "options": [
        { "id": "a", "text": "$2$" },
        { "id": "b", "text": "$2.25$" },
        { "id": "c", "text": "$2.5$" },
        { "id": "d", "text": "$6.\\overline{6}$" }
      ],
      "correctAnswer": "b",
      "explanation": "Mean $= \\frac{\\sum fx}{\\sum f} = \\frac{(1 \\times 4) + (2 \\times 7) + (3 \\times 9)}{4 + 7 + 9} = \\frac{4 + 14 + 27}{20} = \\frac{45}{20} = 2.25$."
    }
  ]
}