{
  "id": "check-volume-prisms-2",
  "title": "Check: Volume of Prisms",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A prism has a cross-sectional area of $18\\text{ cm}^2$ and a volume of $180\\text{ cm}^3$. What is its length?",
      "options": [
        {
          "id": "a",
          "text": "$162\\text{ cm}$"
        },
        {
          "id": "b",
          "text": "$10\\text{ cm}$"
        },
        {
          "id": "c",
          "text": "$8\\text{ cm}$"
        },
        {
          "id": "d",
          "text": "$9\\text{ cm}$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Volume $= \\text{area} \\times \\text{length}$, so $180 = 18 \\times l$, giving $l = 10\\text{ cm}$."
    }
  ]
}
