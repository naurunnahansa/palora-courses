  "title": "Check: Laws of Indices",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $x^3 \\times x^4$.",
      "options": [
        { "id": "a", "text": "$x^{12}$" },
        { "id": "b", "text": "$x^7$" },
        { "id": "c", "text": "$x^1$" },
        { "id": "d", "text": "$2x^7$" }
      ],
      "correctAnswer": "b",
      "explanation": "When multiplying with the same base, add the indices: $x^3 \\times x^4 = x^{3+4} = x^7$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\frac{y^{10}}{y^6}$.",
      "options": [
        { "id": "a", "text": "$y^{60}$" },
        { "id": "b", "text": "$y^{16}$" },
        { "id": "c", "text": "$y^4$" },
        { "id": "d", "text": "$y^{\\frac{5}{3}}$" }
      ],
      "correctAnswer": "c",
      "explanation": "When dividing with the same base, subtract the indices: $\\frac{y^{10}}{y^6} = y^{10-6} = y^4$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $(a^3)^2$?",
      "options": [
        { "id": "a", "text": "$a^5$" },
        { "id": "b", "text": "$a^6$" },
        { "id": "c", "text": "$a^9$" },
        { "id": "d", "text": "$a^{32}$" }
      ],
      "correctAnswer": "b",
      "explanation": "When raising a power to a power, multiply the indices: $(a^3)^2 = a^{3 \\times 2} = a^6$."
    }
  ]
