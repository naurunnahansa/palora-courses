{
  "id": "quiz-inequalities-quadratic",
  "title": "Quiz: Quadratic Inequalities",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $x^2 - 5x + 6 > 0$.",
      "options": [
        {
          "id": "a",
          "text": "$x < 2$ or $x > 3$"
        },
        {
          "id": "b",
          "text": "$-3 < x < -2$"
        },
        {
          "id": "c",
          "text": "$2 < x < 3$"
        },
        {
          "id": "d",
          "text": "$x < -2$ or $x > -3$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Factorise: $(x - 2)(x - 3) > 0$. The parabola opens upward and is above the x-axis when $x < 2$ or $x > 3$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $x^2 \\leq 16$.",
      "options": [
        {
          "id": "a",
          "text": "$x \\leq 4$"
        },
        {
          "id": "b",
          "text": "$x \\leq -4$ or $x \\geq 4$"
        },
        {
          "id": "c",
          "text": "$0 \\leq x \\leq 4$"
        },
        {
          "id": "d",
          "text": "$-4 \\leq x \\leq 4$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "$x^2 - 16 \\leq 0$, so $(x + 4)(x - 4) \\leq 0$. The parabola is below or on the x-axis between the roots: $-4 \\leq x \\leq 4$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The solution to a quadratic inequality is $-3 < x < 5$. Which inequality could it be?",
      "options": [
        {
          "id": "a",
          "text": "$(x - 3)(x + 5) < 0$"
        },
        {
          "id": "b",
          "text": "$(x + 3)(x - 5) < 0$"
        },
        {
          "id": "c",
          "text": "$(x + 3)(x - 5) > 0$"
        },
        {
          "id": "d",
          "text": "$(x - 3)(x - 5) < 0$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$(x + 3)(x - 5) = 0$ has roots at $x = -3$ and $x = 5$. Since the parabola opens upward, it is below the x-axis (negative) between the roots: $-3 < x < 5$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $x^2 + 2x - 8 \\leq 0$.",
      "options": [
        {
          "id": "a",
          "text": "$2 \\leq x \\leq 4$"
        },
        {
          "id": "b",
          "text": "$-2 \\leq x \\leq 4$"
        },
        {
          "id": "c",
          "text": "$-4 \\leq x \\leq 2$"
        },
        {
          "id": "d",
          "text": "$x \\leq -4$ or $x \\geq 2$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Factorise: $(x + 4)(x - 2) \\leq 0$. Roots at $-4$ and $2$. The parabola is below or on the x-axis between the roots: $-4 \\leq x \\leq 2$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the solution to $x^2 + 4x + 5 < 0$?",
      "options": [
        {
          "id": "a",
          "text": "No real solutions"
        },
        {
          "id": "b",
          "text": "$x < -5$ or $x > 1$"
        },
        {
          "id": "c",
          "text": "$-5 < x < -1$"
        },
        {
          "id": "d",
          "text": "All real values of $x$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "The discriminant is $16 - 20 = -4 < 0$, so the parabola has no real roots. Since $a > 0$, it is always above the x-axis, meaning $x^2 + 4x + 5$ is always positive. There are no values where it is negative."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Solve $-x^2 + 4x - 3 > 0$.",
      "options": [
        {
          "id": "a",
          "text": "$x < -3$ or $x > -1$"
        },
        {
          "id": "b",
          "text": "$1 < x < 3$"
        },
        {
          "id": "c",
          "text": "$-1 < x < 3$"
        },
        {
          "id": "d",
          "text": "$x < 1$ or $x > 3$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Multiply by $-1$ (reverse inequality): $x^2 - 4x + 3 < 0$, so $(x - 1)(x - 3) < 0$. The parabola is below the x-axis between roots: $1 < x < 3$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Find the range of values of $k$ for which $x^2 + kx + 9 = 0$ has no real roots.",
      "options": [
        {
          "id": "a",
          "text": "$-6 < k < 6$"
        },
        {
          "id": "b",
          "text": "$k < -6$ or $k > 6$"
        },
        {
          "id": "c",
          "text": "$k > -6$"
        },
        {
          "id": "d",
          "text": "$k < 6$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "No real roots when $\\Delta < 0$: $k^2 - 36 < 0$, so $k^2 < 36$. This gives $-6 < k < 6$."
    }
  ]
