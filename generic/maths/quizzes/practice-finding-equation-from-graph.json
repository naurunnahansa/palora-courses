{
  "id": "practice-finding-equation-from-graph",
  "title": "Practice: Finding Equation from Graph",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A line passes through (2, 5) and (6, 13). Find its equation.",
      "options": [
        { "id": "a", "text": "y = 2x + 1" },
        { "id": "b", "text": "y = 4x - 3" },
        { "id": "c", "text": "y = 2x + 3" },
        { "id": "d", "text": "y = 8x - 11" }
      ],
      "correctAnswer": "a",
      "explanation": "Gradient = (13 - 5)/(6 - 2) = 8/4 = 2. Using (2, 5): 5 = 2(2) + c, c = 1. Equation: y = 2x + 1. Check: 2(6) + 1 = 13."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A straight line crosses the y-axis at (0, -2) and passes through (3, 7). Find its equation.",
      "options": [
        { "id": "a", "text": "y = 3x - 2" },
        { "id": "b", "text": "y = 3x + 2" },
        { "id": "c", "text": "y = -2x + 3" },
        { "id": "d", "text": "y = 5x - 2" }
      ],
      "correctAnswer": "a",
      "explanation": "y-intercept = -2. Gradient = (7 - (-2))/(3 - 0) = 9/3 = 3. Equation: y = 3x - 2."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A line passes through (-1, 7) and (3, -1). Find its equation.",
      "options": [
        { "id": "a", "text": "y = 2x + 5" },
        { "id": "b", "text": "y = -2x + 5" },
        { "id": "c", "text": "y = -2x - 5" },
        { "id": "d", "text": "y = 2x - 5" }
      ],
      "correctAnswer": "b",
      "explanation": "Gradient = (-1 - 7)/(3 - (-1)) = -8/4 = -2. Using (-1, 7): 7 = -2(-1) + c = 2 + c. c = 5. Equation: y = -2x + 5."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A spring stretches according to the equation L = km + c, where L is length in cm and m is mass in grams. With no mass, L = 15 cm. With 40 g, L = 23 cm. Find k.",
      "options": [
        { "id": "a", "text": "0.2" },
        { "id": "b", "text": "5" },
        { "id": "c", "text": "0.5" },
        { "id": "d", "text": "8" }
      ],
      "correctAnswer": "a",
      "explanation": "c = 15 (length when m = 0). When m = 40: 23 = 40k + 15. 40k = 8. k = 0.2."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "A line passes through (4, 2) with gradient 3/4. What is its y-intercept?",
      "options": [
        { "id": "a", "text": "-1" },
        { "id": "b", "text": "2" },
        { "id": "c", "text": "5" },
        { "id": "d", "text": "-2" }
      ],
      "correctAnswer": "a",
      "explanation": "y = (3/4)x + c. Substitute (4, 2): 2 = (3/4)(4) + c = 3 + c. c = -1."
    }
  ]
}
