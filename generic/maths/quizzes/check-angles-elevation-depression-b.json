  "id": "check-angles-elevation-depression-b",
  "title": "Check: Angles of Elevation and Depression (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A person stands $20\\text{ m}$ from the base of a building. The angle of elevation to the top is $60°$. What is the height of the building? Give an exact answer.",
      "options": [
        {
          "id": "a",
          "text": "$20\\sqrt{3}\\text{ m}$"
        },
        {
          "id": "b",
          "text": "$10\\sqrt{3}\\text{ m}$"
        },
        {
          "id": "c",
          "text": "$20\\text{ m}$"
        },
        {
          "id": "d",
          "text": "$40\\text{ m}$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "$\\tan 60° = \\frac{h}{20}$, so $h = 20 \\tan 60° = 20\\sqrt{3}\\text{ m}$."
    }
  ]
