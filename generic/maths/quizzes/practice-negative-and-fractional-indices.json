{
  "id": "practice-negative-and-fractional-indices",
  "title": "Practice: Negative and Fractional Indices",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Evaluate: 27^(2/3)",
      "options": [
        { "id": "a", "text": "3" },
        { "id": "b", "text": "9" },
        { "id": "c", "text": "18" },
        { "id": "d", "text": "729" }
      ],
      "correctAnswer": "b",
      "explanation": "27^(2/3) = (cube root of 27)^2 = 3^2 = 9. Take the root first (cube root of 27 = 3), then square it."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Evaluate: 16^(-3/4)",
      "options": [
        { "id": "a", "text": "1/8" },
        { "id": "b", "text": "-8" },
        { "id": "c", "text": "8" },
        { "id": "d", "text": "-1/8" }
      ],
      "correctAnswer": "a",
      "explanation": "16^(-3/4) = 1 / 16^(3/4) = 1 / (4th root of 16)^3 = 1 / 2^3 = 1/8. The negative index means reciprocal, and the 4th root of 16 is 2."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Evaluate: (4/9)^(-1/2)",
      "options": [
        { "id": "a", "text": "2/3" },
        { "id": "b", "text": "3/2" },
        { "id": "c", "text": "-2/3" },
        { "id": "d", "text": "9/4" }
      ],
      "correctAnswer": "b",
      "explanation": "(4/9)^(-1/2) = (9/4)^(1/2) (negative index flips the fraction) = sqrt(9/4) = 3/2."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Simplify: (8x^6)^(2/3)",
      "options": [
        { "id": "a", "text": "2x^4" },
        { "id": "b", "text": "4x^4" },
        { "id": "c", "text": "4x^9" },
        { "id": "d", "text": "8x^4" }
      ],
      "correctAnswer": "b",
      "explanation": "(8x^6)^(2/3) = 8^(2/3) x (x^6)^(2/3). 8^(2/3) = (cube root of 8)^2 = 2^2 = 4. (x^6)^(2/3) = x^(6 x 2/3) = x^4. So the answer is 4x^4."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Which expression is equivalent to 1/(x * sqrt(x))?",
      "options": [
        { "id": "a", "text": "x^(-1/2)" },
        { "id": "b", "text": "x^(-3/2)" },
        { "id": "c", "text": "x^(-2)" },
        { "id": "d", "text": "x^(-3)" }
      ],
      "correctAnswer": "b",
      "explanation": "x * sqrt(x) = x^1 * x^(1/2) = x^(3/2). Therefore 1/(x * sqrt(x)) = x^(-3/2)."
    }
  ]
}
