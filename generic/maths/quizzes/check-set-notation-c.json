  "title": "Check: Set Notation (C)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $\\xi = \\{1,2,3,4,5,6,7,8\\}$, $A = \\{2,4,6,8\\}$, and $B = \\{1,2,3,4\\}$, what is $A \\cup B$?",
      "options": [
        {
          "id": "a",
          "text": "$\\{2, 4\\}$"
        },
        {
          "id": "b",
          "text": "$\\{1,2,3,4,6,8\\}$"
        },
        {
          "id": "c",
          "text": "$\\{1,3,5,7\\}$"
        },
        {
          "id": "d",
          "text": "$\\{6, 8\\}$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$A \\cup B$ is the union — all elements in $A$ or $B$ (or both): $\\{1,2,3,4,6,8\\}$."
    }
  ]
