  "id": "check-negative-and-fractional-indices-2",
  "title": "Check: Negative and Fractional Indices",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $16^{-\\frac{1}{4}}$?",
      "options": [
        { "id": "a", "text": "$-2$" },
        { "id": "b", "text": "$\\frac{1}{2}$" },
        { "id": "c", "text": "$-4$" },
        { "id": "d", "text": "$\\frac{1}{4}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$16^{-\\frac{1}{4}} = \\frac{1}{16^{\\frac{1}{4}}} = \\frac{1}{\\sqrt[4]{16}} = \\frac{1}{2}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Evaluate $\\left(\\frac{27}{8}\\right)^{\\frac{2}{3}}$.",
      "options": [
        { "id": "a", "text": "$\\frac{3}{2}$" },
        { "id": "b", "text": "$\\frac{9}{4}$" },
        { "id": "c", "text": "$\\frac{27}{4}$" },
        { "id": "d", "text": "$\\frac{9}{8}$" }
      ],
      "correctAnswer": "b",
      "explanation": "$\\left(\\frac{27}{8}\\right)^{\\frac{2}{3}} = \\frac{27^{\\frac{2}{3}}}{8^{\\frac{2}{3}}} = \\frac{(\\sqrt[3]{27})^2}{(\\sqrt[3]{8})^2} = \\frac{3^2}{2^2} = \\frac{9}{4}$."
    }
  ]
}
