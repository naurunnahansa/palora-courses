  "title": "Check: Algebraic Proof",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Prove that $(n+1)^2 - n^2$ is always odd. What does $(n+1)^2 - n^2$ simplify to?",
      "options": [
        {
          "id": "a",
          "text": "$2n + 1$"
        },
        {
          "id": "b",
          "text": "$n^2 + 1$"
        },
        {
          "id": "c",
          "text": "$2n$"
        },
        {
          "id": "d",
          "text": "$1$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "$(n+1)^2 - n^2 = n^2 + 2n + 1 - n^2 = 2n + 1$. Since $2n$ is even, $2n + 1$ is always odd."
    }
  ]
}
