    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Simplify: 5x^2 + 3x - 2x^2 + 7 - 4x + 1",
      "options": [
        { "id": "a", "text": "3x^2 + 7x + 8" },
        { "id": "b", "text": "3x^2 - x + 8" },
        { "id": "c", "text": "7x^2 - x + 8" },
        { "id": "d", "text": "3x^2 - 7x + 8" }
      ],
      "correctAnswer": "b",
      "explanation": "x^2 terms: 5x^2 - 2x^2 = 3x^2. x terms: 3x - 4x = -x. Constants: 7 + 1 = 8. Result: 3x^2 - x + 8."
    },
    {
      "id": "q2",
