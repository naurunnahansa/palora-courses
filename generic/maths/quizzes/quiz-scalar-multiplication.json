{
  "id": "quiz-scalar-multiplication",
  "title": "Quiz: Scalar Multiplication",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $\\mathbf{a} = \\binom{3}{-2}$, what is $4\\mathbf{a}$?",
      "options": [
        {
          "id": "a",
          "text": "$\\binom{7}{2}$"
        },
        {
          "id": "b",
          "text": "$\\binom{12}{-8}$"
        },
        {
          "id": "c",
          "text": "$\\binom{12}{-2}$"
        },
        {
          "id": "d",
          "text": "$\\binom{3}{-8}$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Multiply each component by the scalar: $4 \\times 3 = 12$ and $4 \\times (-2) = -8$, giving $\\binom{12}{-8}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $\\mathbf{v} = \\binom{6}{-4}$, what is $-\\frac{1}{2}\\mathbf{v}$?",
      "options": [
        {
          "id": "a",
          "text": "$\\binom{-3}{2}$"
        },
        {
          "id": "b",
          "text": "$\\binom{3}{-2}$"
        },
        {
          "id": "c",
          "text": "$\\binom{-3}{-2}$"
        },
        {
          "id": "d",
          "text": "$\\binom{-12}{8}$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Multiply each component by $-\\frac{1}{2}$: $-\\frac{1}{2} \\times 6 = -3$ and $-\\frac{1}{2} \\times (-4) = 2$, giving $\\binom{-3}{2}$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "When a vector is multiplied by a scalar $k > 1$, the result is:",
      "options": [
        {
          "id": "a",
          "text": "A vector in the opposite direction with the same magnitude"
        },
        {
          "id": "b",
          "text": "A vector in the same direction with a smaller magnitude"
        },
        {
          "id": "c",
          "text": "A vector perpendicular to the original"
        },
        {
          "id": "d",
          "text": "A vector in the same direction with a larger magnitude"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Multiplying by $k > 1$ scales the magnitude by $k$ (making it larger) while keeping the same direction."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $\\mathbf{b} = 3\\mathbf{a}$, which statement is true?",
      "options": [
        {
          "id": "a",
          "text": "$\\mathbf{b}$ is perpendicular to $\\mathbf{a}$"
        },
        {
          "id": "b",
          "text": "$\\mathbf{b}$ is parallel to $\\mathbf{a}$ and three times as long"
        },
        {
          "id": "c",
          "text": "$\\mathbf{b}$ is in the opposite direction to $\\mathbf{a}$"
        },
        {
          "id": "d",
          "text": "$\\mathbf{b}$ has the same magnitude as $\\mathbf{a}$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Scalar multiplication by a positive number produces a parallel vector. The magnitude of $\\mathbf{b}$ is 3 times the magnitude of $\\mathbf{a}$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $\\mathbf{a} = \\binom{2}{5}$, what is $2\\mathbf{a} + \\binom{-1}{3}$?",
      "options": [
        {
          "id": "a",
          "text": "$\\binom{3}{13}$"
        },
        {
          "id": "b",
          "text": "$\\binom{5}{8}$"
        },
        {
          "id": "c",
          "text": "$\\binom{3}{8}$"
        },
        {
          "id": "d",
          "text": "$\\binom{1}{13}$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "First compute $2\\mathbf{a} = \\binom{4}{10}$, then add: $\\binom{4}{10} + \\binom{-1}{3} = \\binom{3}{13}$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Multiplying a vector by $-1$ has the same effect as:",
      "options": [
        {
          "id": "a",
          "text": "Doubling the vector"
        },
        {
          "id": "b",
          "text": "Keeping the vector unchanged"
        },
        {
          "id": "c",
          "text": "Reversing the direction of the vector"
        },
        {
          "id": "d",
          "text": "Rotating the vector by $90°$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Multiplying by $-1$ reverses the direction while keeping the same magnitude. The vector points the opposite way."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Two vectors $\\mathbf{p}$ and $\\mathbf{q}$ are parallel. Which of the following must be true?",
      "options": [
        {
          "id": "a",
          "text": "$\\mathbf{p} = \\mathbf{q}$"
        },
        {
          "id": "b",
          "text": "$\\mathbf{p} + \\mathbf{q} = \\mathbf{0}$"
        },
        {
          "id": "c",
          "text": "$\\mathbf{p} = k\\mathbf{q}$ for some scalar $k$"
        },
        {
          "id": "d",
          "text": "$|\\mathbf{p}| = |\\mathbf{q}|$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Two vectors are parallel if and only if one is a scalar multiple of the other, i.e. $\\mathbf{p} = k\\mathbf{q}$ for some scalar $k$."
    }
  ]
}
