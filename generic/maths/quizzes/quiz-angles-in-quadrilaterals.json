{
  "id": "quiz-angles-in-quadrilaterals",
  "title": "Quiz: Angles in Quadrilaterals",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Three angles in a quadrilateral are $90°$, $80°$, and $110°$. What is the fourth angle?",
      "options": [
        {
          "id": "a",
          "text": "$70°$"
        },
        {
          "id": "b",
          "text": "$100°$"
        },
        {
          "id": "c",
          "text": "$80°$"
        },
        {
          "id": "d",
          "text": "$90°$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Angles in a quadrilateral sum to $360°$: $360° - 90° - 80° - 110° = 80°$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The angles of a quadrilateral are $x$, $2x$, $3x$, and $4x$. What is the value of $x$?",
      "options": [
        {
          "id": "a",
          "text": "$36°$"
        },
        {
          "id": "b",
          "text": "$30°$"
        },
        {
          "id": "c",
          "text": "$40°$"
        },
        {
          "id": "d",
          "text": "$45°$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "$x + 2x + 3x + 4x = 10x = 360°$, so $x = 36°$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A trapezium has two co-interior angles between parallel sides. One is $115°$. What is the other?",
      "options": [
        {
          "id": "a",
          "text": "$65°$"
        },
        {
          "id": "b",
          "text": "$55°$"
        },
        {
          "id": "c",
          "text": "$115°$"
        },
        {
          "id": "d",
          "text": "$75°$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Co-interior angles between parallel sides sum to $180°$: $180° - 115° = 65°$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A parallelogram has one angle of $72°$. What is the angle adjacent to it?",
      "options": [
        {
          "id": "a",
          "text": "$108°$"
        },
        {
          "id": "b",
          "text": "$72°$"
        },
        {
          "id": "c",
          "text": "$88°$"
        },
        {
          "id": "d",
          "text": "$118°$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Adjacent angles in a parallelogram are supplementary: $180° - 72° = 108°$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A kite has angles of $100°$, $100°$, and $70°$. What is the fourth angle?",
      "options": [
        {
          "id": "a",
          "text": "$70°$"
        },
        {
          "id": "b",
          "text": "$90°$"
        },
        {
          "id": "c",
          "text": "$80°$"
        },
        {
          "id": "d",
          "text": "$100°$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Angles in a quadrilateral sum to $360°$: $360° - 100° - 100° - 70° = 90°$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Opposite angles in a parallelogram are:",
      "options": [
        {
          "id": "a",
          "text": "Always $90°$"
        },
        {
          "id": "b",
          "text": "Complementary (sum to $90°$)"
        },
        {
          "id": "c",
          "text": "Supplementary (sum to $180°$)"
        },
        {
          "id": "d",
          "text": "Equal"
        }
      ],
      "correctAnswer": "d",
      "explanation": "In a parallelogram, opposite angles are always equal. It is the adjacent angles that are supplementary."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A quadrilateral has angles $(x + 30)°$, $(2x)°$, $(x + 50)°$, and $(2x - 20)°$. What is the value of $x$?",
      "options": [
        {
          "id": "a",
          "text": "$55$"
        },
        {
          "id": "b",
          "text": "$50$"
        },
        {
          "id": "c",
          "text": "$60$"
        },
        {
          "id": "d",
          "text": "$45$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "$(x+30) + 2x + (x+50) + (2x-20) = 6x + 60 = 360$, so $6x = 300$ and $x = 50$."
    }
  ]
}
