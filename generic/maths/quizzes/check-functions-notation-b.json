{
  "id": "check-functions-notation-b",
  "title": "Check: Functions and Notation (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $f(x) = x^2 - 1$, find the value of $x$ for which $f(x) = 0$.",
      "options": [
        {
          "id": "a",
          "text": "$x = 0$ only"
        },
        {
          "id": "b",
          "text": "$x = 1$ only"
        },
        {
          "id": "c",
          "text": "$x = -1$ only"
        },
        {
          "id": "d",
          "text": "$x = 1$ or $x = -1$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Set $f(x) = 0$: $x^2 - 1 = 0$. Factorise: $(x-1)(x+1) = 0$. So $x = 1$ or $x = -1$."
    }
  ]
}
