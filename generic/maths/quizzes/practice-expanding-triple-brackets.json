{
  "id": "practice-expanding-triple-brackets",
  "title": "Practice: Expanding Triple Brackets",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Expand (x + 1)(x + 3)(x + 5). What is the coefficient of x^2?",
      "options": [
        { "id": "a", "text": "8" },
        { "id": "b", "text": "9" },
        { "id": "c", "text": "15" },
        { "id": "d", "text": "3" }
      ],
      "correctAnswer": "b",
      "explanation": "For (x + a)(x + b)(x + c), the coefficient of x^2 is a + b + c = 1 + 3 + 5 = 9."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "What is the constant term when (x - 2)(x + 3)(x - 4) is expanded?",
      "options": [
        { "id": "a", "text": "24" },
        { "id": "b", "text": "-24" },
        { "id": "c", "text": "-9" },
        { "id": "d", "text": "9" }
      ],
      "correctAnswer": "a",
      "explanation": "The constant term = (-2)(3)(-4) = 24."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Expand and simplify (x + 2)(x - 1)(x + 3).",
      "options": [
        { "id": "a", "text": "x^3 + 4x^2 + x - 6" },
        { "id": "b", "text": "x^3 + 4x^2 + 5x - 6" },
        { "id": "c", "text": "x^3 + 2x^2 - 5x - 6" },
        { "id": "d", "text": "x^3 + 4x^2 + x + 6" }
      ],
      "correctAnswer": "a",
      "explanation": "Step 1: (x + 2)(x - 1) = x^2 + x - 2. Step 2: (x^2 + x - 2)(x + 3) = x^3 + 3x^2 + x^2 + 3x - 2x - 6 = x^3 + 4x^2 + x - 6."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Expand (x + 1)^3.",
      "options": [
        { "id": "a", "text": "x^3 + 1" },
        { "id": "b", "text": "x^3 + 3x^2 + 3x + 1" },
        { "id": "c", "text": "x^3 + 3x + 1" },
        { "id": "d", "text": "x^3 + x^2 + x + 1" }
      ],
      "correctAnswer": "b",
      "explanation": "(x + 1)^3 = x^3 + 3x^2(1) + 3x(1)^2 + 1^3 = x^3 + 3x^2 + 3x + 1. A common error is writing x^3 + 1 (forgetting all middle terms)."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "application",
      "stem": "Expand (x + 2)(x - 2)(x + 5). [Hint: use the difference of squares first.]",
      "options": [
        { "id": "a", "text": "x^3 + 5x^2 - 4x - 20" },
        { "id": "b", "text": "x^3 - 5x^2 - 4x + 20" },
        { "id": "c", "text": "x^3 + 5x^2 + 4x - 20" },
        { "id": "d", "text": "x^3 + 5x^2 - 4x + 20" }
      ],
      "correctAnswer": "a",
      "explanation": "(x + 2)(x - 2) = x^2 - 4. Then (x^2 - 4)(x + 5) = x^3 + 5x^2 - 4x - 20."
    }
  ]
}
