{
  "id": "check-algebraic-fractions",
  "title": "Check: Algebraic Fractions",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\frac{6x^2}{3x}$.",
      "options": [
        { "id": "a", "text": "$2x^2$" },
        { "id": "b", "text": "$2x$" },
        { "id": "c", "text": "$3x$" },
        { "id": "d", "text": "$2$" }
      ],
      "correctAnswer": "b",
      "explanation": "Divide numerator and denominator: $\\frac{6x^2}{3x} = \\frac{6}{3} \\times \\frac{x^2}{x} = 2x$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Simplify $\\frac{x^2 - 9}{x + 3}$.",
      "options": [
        { "id": "a", "text": "$x - 9$" },
        { "id": "b", "text": "$x + 3$" },
        { "id": "c", "text": "$x - 3$" },
        { "id": "d", "text": "$x^2 - 3$" }
      ],
      "correctAnswer": "c",
      "explanation": "Factorise the numerator: $x^2 - 9 = (x+3)(x-3)$. Then $\\frac{(x+3)(x-3)}{x+3} = x - 3$."
    }
  ]
}
