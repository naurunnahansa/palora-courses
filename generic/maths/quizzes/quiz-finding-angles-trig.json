{
  "id": "quiz-finding-angles-trig",
  "title": "Quiz: Finding Angles using Trigonometry",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the opposite side is $5$ cm and the hypotenuse is $10$ cm. What is the angle $\\theta$?",
      "options": [
        {"id": "a", "text": "$60°$"},
        {"id": "b", "text": "$30°$"},
        {"id": "c", "text": "$45°$"},
        {"id": "d", "text": "$90°$"}
      ],
      "correctAnswer": "b",
      "explanation": "$\\sin \\theta = \\frac{5}{10} = 0.5$, so $\\theta = \\sin^{-1}(0.5) = 30°$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the adjacent side is $8$ cm and the hypotenuse is $16$ cm. What is the angle $\\theta$?",
      "options": [
        {"id": "a", "text": "$30°$"},
        {"id": "b", "text": "$45°$"},
        {"id": "c", "text": "$60°$"},
        {"id": "d", "text": "$90°$"}
      ],
      "correctAnswer": "c",
      "explanation": "$\\cos \\theta = \\frac{8}{16} = 0.5$, so $\\theta = \\cos^{-1}(0.5) = 60°$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the opposite side is $7$ cm and the adjacent side is $7$ cm. What is the angle $\\theta$?",
      "options": [
        {"id": "a", "text": "$30°$"},
        {"id": "b", "text": "$45°$"},
        {"id": "c", "text": "$60°$"},
        {"id": "d", "text": "$90°$"}
      ],
      "correctAnswer": "b",
      "explanation": "$\\tan \\theta = \\frac{7}{7} = 1$, so $\\theta = \\tan^{-1}(1) = 45°$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "To find an angle from a trigonometric ratio, you use:",
      "options": [
        {"id": "a", "text": "The square root"},
        {"id": "b", "text": "The inverse (arc) function, e.g. $\\sin^{-1}$"},
        {"id": "c", "text": "Division by the ratio"},
        {"id": "d", "text": "Pythagoras' Theorem"}
      ],
      "correctAnswer": "b",
      "explanation": "To find the angle, use the inverse trig function: $\\sin^{-1}$, $\\cos^{-1}$, or $\\tan^{-1}$ on your calculator."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, the opposite side is $6$ cm and the adjacent side is $10$ cm. What is $\\theta$ to $1$ decimal place?",
      "options": [
        {"id": "a", "text": "$31.0°$"},
        {"id": "b", "text": "$59.0°$"},
        {"id": "c", "text": "$36.9°$"},
        {"id": "d", "text": "$53.1°$"}
      ],
      "correctAnswer": "a",
      "explanation": "$\\tan \\theta = \\frac{6}{10} = 0.6$, so $\\theta = \\tan^{-1}(0.6) = 31.0°$ (1 d.p.)."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A right-angled triangle has an opposite side of $9$ cm and a hypotenuse of $15$ cm. What is the angle to $1$ decimal place?",
      "options": [
        {"id": "a", "text": "$53.1°$"},
        {"id": "b", "text": "$36.9°$"},
        {"id": "c", "text": "$30.0°$"},
        {"id": "d", "text": "$60.0°$"}
      ],
      "correctAnswer": "b",
      "explanation": "$\\sin \\theta = \\frac{9}{15} = 0.6$, so $\\theta = \\sin^{-1}(0.6) = 36.9°$ (1 d.p.)."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a right-angled triangle, which sides would you use to find $\\theta$ using $\\cos^{-1}$?",
      "options": [
        {"id": "a", "text": "Opposite and adjacent"},
        {"id": "b", "text": "Opposite and hypotenuse"},
        {"id": "c", "text": "Adjacent and hypotenuse"},
        {"id": "d", "text": "Any two sides"}
      ],
      "correctAnswer": "c",
      "explanation": "$\\cos \\theta = \\frac{\\text{adjacent}}{\\text{hypotenuse}}$, so $\\cos^{-1}$ requires the adjacent side and the hypotenuse."
    }
  ]
}
