{
  "id": "check-sine-rule-b",
  "title": "Check: Sine Rule (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In triangle $ABC$, $A = 40°$, $B = 60°$, and $a = 10\\text{ cm}$. Which expression gives the length of side $b$?",
      "options": [
        {
          "id": "a",
          "text": "$b = \\frac{10 \\sin 60°}{\\sin 40°}$"
        },
        {
          "id": "b",
          "text": "$b = \\frac{10 \\sin 40°}{\\sin 60°}$"
        },
        {
          "id": "c",
          "text": "$b = \\frac{\\sin 60°}{10 \\sin 40°}$"
        },
        {
          "id": "d",
          "text": "$b = 10 \\sin 60° \\times \\sin 40°$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "By the sine rule: $\\frac{a}{\\sin A} = \\frac{b}{\\sin B}$, so $b = \\frac{a \\sin B}{\\sin A} = \\frac{10 \\sin 60°}{\\sin 40°}$."
    }
  ]
}