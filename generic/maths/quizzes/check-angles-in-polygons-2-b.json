{
  "id": "check-angles-in-polygons-2-b",
  "title": "Check: Angles in Polygons (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A regular polygon has interior angles of $156°$. How many sides does it have?",
      "options": [
        {
          "id": "a",
          "text": "$18$"
        },
        {
          "id": "b",
          "text": "$12$"
        },
        {
          "id": "c",
          "text": "$15$"
        },
        {
          "id": "d",
          "text": "$20$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Each exterior angle is $180° - 156° = 24°$. The number of sides is $\\frac{360°}{24°} = 15$."
    }
  ]
}
