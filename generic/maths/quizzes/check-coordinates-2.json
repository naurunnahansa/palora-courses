{
  "id": "check-coordinates-2",
  "title": "Check: Coordinates",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The distance between $(1, 2)$ and $(4, 6)$ is:",
      "options": [
        { "id": "a", "text": "$7$" },
        { "id": "b", "text": "$5$" },
        { "id": "c", "text": "$25$" },
        { "id": "d", "text": "$\\sqrt{7}$" }
      ],
      "correctAnswer": "b",
      "explanation": "Using the distance formula: $d = \\sqrt{(4-1)^2 + (6-2)^2} = \\sqrt{9 + 16} = \\sqrt{25} = 5$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Point $A$ is at $(3, -1)$ and point $B$ is at $(-5, -1)$. What is the length of $AB$?",
      "options": [
        { "id": "a", "text": "$2$" },
        { "id": "b", "text": "$6$" },
        { "id": "c", "text": "$8$" },
        { "id": "d", "text": "$4$" }
      ],
      "correctAnswer": "c",
      "explanation": "Since both points share the same $y$-coordinate, the distance is simply $|3 - (-5)| = |3 + 5| = 8$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If the midpoint of $(a, 3)$ and $(7, 11)$ is $(5, 7)$, what is the value of $a$?",
      "options": [
        { "id": "a", "text": "$2$" },
        { "id": "b", "text": "$3$" },
        { "id": "c", "text": "$-2$" },
        { "id": "d", "text": "$12$" }
      ],
      "correctAnswer": "b",
      "explanation": "The midpoint formula gives $\\frac{a + 7}{2} = 5$, so $a + 7 = 10$ and $a = 3$. We can verify: $\\frac{3 + 11}{2} = 7$ also checks out."
    }
  ]
}
