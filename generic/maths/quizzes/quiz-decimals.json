  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Convert $\\frac{3}{8}$ to a decimal.",
      "options": [
        {
          "id": "a",
          "text": "$0.3$"
        },
        {
          "id": "b",
          "text": "$0.38$"
        },
        {
          "id": "c",
          "text": "$0.375$"
        },
        {
          "id": "d",
          "text": "$0.35$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "$\\frac{3}{8} = 3 \\div 8 = 0.375$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Calculate $3.6 \\div 0.4$.",
      "options": [
        {
          "id": "a",
          "text": "$0.9$"
        },
        {
          "id": "b",
          "text": "$90$"
        },
        {
          "id": "c",
          "text": "$0.09$"
        },
        {
          "id": "d",
          "text": "$9$"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Multiply both numbers by 10 to make the divisor a whole number: $3.6 \\div 0.4 = 36 \\div 4 = 9$."
    },
    {
