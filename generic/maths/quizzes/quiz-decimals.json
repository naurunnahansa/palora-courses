    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Convert 0.45 to a fraction in simplest form.",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{9}{20}$"
        },
        {
          "id": "b",
          "text": "$\\frac{45}{100}$"
        },
        {
          "id": "c",
          "text": "$\\frac{45}{10}$"
        },
        {
          "id": "d",
          "text": "$\\frac{4}{5}$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "$0.45 = \\frac{45}{100}$. Simplify by dividing both by 5: $\\frac{45 \\div 5}{100 \\div 5} = \\frac{9}{20}$."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $0.3 \\times 0.4$?",
      "options": [
        {
          "id": "a",
          "text": "$0.12$"
        },
        {
          "id": "b",
          "text": "$0.7$"
        },
        {
          "id": "c",
          "text": "$1.2$"
        },
        {
          "id": "d",
          "text": "$0.012$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "When multiplying decimals, count the total decimal places in both numbers (1 + 1 = 2). $3 \\times 4 = 12$, then place 2 decimal places: $0.12$."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "How many significant figures does the number $0.00340$ have?",
      "options": [
        {
          "id": "a",
          "text": "6"
        },
        {
          "id": "b",
          "text": "2"
        },
        {
          "id": "c",
          "text": "3"
        },
        {
          "id": "d",
          "text": "5"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Leading zeros are not significant. Count from the first non-zero digit: 3, 4, 0. The trailing zero after the 4 is significant because it comes after the decimal point, giving 3 significant figures."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Convert the recurring decimal $0.\\dot{2}\\dot{7}$ to a fraction.",
      "options": [
        {
          "id": "a",
          "text": "$\\frac{27}{100}$"
        },
        {
          "id": "b",
          "text": "$\\frac{3}{11}$"
        },
        {
          "id": "c",
          "text": "$\\frac{27}{99}$"
        },
        {
          "id": "d",
          "text": "$\\frac{9}{33}$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Let $x = 0.272727\\ldots$ Then $100x = 27.2727\\ldots$ Subtracting: $99x = 27$, so $x = \\frac{27}{99} = \\frac{3}{11}$."
    }
  ]
