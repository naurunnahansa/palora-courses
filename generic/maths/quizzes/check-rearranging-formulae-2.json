  "title": "Check: Rearranging Formulae",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $t$ the subject of $v = u + at$.",
      "options": [
        { "id": "a", "text": "$t = \\frac{v + u}{a}$" },
        { "id": "b", "text": "$t = \\frac{v - u}{a}$" },
        { "id": "c", "text": "$t = a(v - u)$" },
        { "id": "d", "text": "$t = \\frac{a}{v - u}$" }
      ],
      "correctAnswer": "b",
      "explanation": "Subtract $u$ from both sides: $v - u = at$. Divide by $a$: $t = \\frac{v - u}{a}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $b$ the subject of $P = 2a + 2b$.",
      "options": [
        { "id": "a", "text": "$b = P - 2a$" },
        { "id": "b", "text": "$b = \\frac{P - a}{2}$" },
        { "id": "c", "text": "$b = \\frac{P - 2a}{2}$" },
        { "id": "d", "text": "$b = \\frac{P}{2} - 2a$" }
      ],
      "correctAnswer": "c",
      "explanation": "Subtract $2a$ from both sides: $P - 2a = 2b$. Divide by $2$: $b = \\frac{P - 2a}{2}$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $h$ the subject of $V = \\frac{1}{3}\\pi r^2 h$.",
      "options": [
        { "id": "a", "text": "$h = \\frac{3V}{\\pi r^2}$" },
        { "id": "b", "text": "$h = \\frac{V}{3\\pi r^2}$" },
        { "id": "c", "text": "$h = \\frac{\\pi r^2}{3V}$" },
        { "id": "d", "text": "$h = 3V\\pi r^2$" }
      ],
      "correctAnswer": "a",
      "explanation": "Multiply both sides by $3$: $3V = \\pi r^2 h$. Divide by $\\pi r^2$: $h = \\frac{3V}{\\pi r^2}$."
    }
  ]
