  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $t$ the subject of $v = u + at$.",
      "options": [
        {
          "id": "a",
          "text": "$t = \\frac{v + u}{a}$"
        },
        {
          "id": "b",
          "text": "$t = \\frac{v - u}{a}$"
        },
        {
          "id": "c",
          "text": "$t = a(v - u)$"
        },
        {
          "id": "d",
          "text": "$t = \\frac{a}{v - u}$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Subtract $u$ from both sides: $v - u = at$. Divide by $a$: $t = \\frac{v - u}{a}$."
    }
  ]
