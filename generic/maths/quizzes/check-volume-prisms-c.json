{
  "id": "check-volume-prisms-c",
  "title": "Check: Volume of Prisms (C)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A triangular prism has a cross-section with base $6\\text{ cm}$ and height $4\\text{ cm}$. The prism is $10\\text{ cm}$ long. What is its volume?",
      "options": [
        {
          "id": "a",
          "text": "$240\\text{ cm}^3$"
        },
        {
          "id": "b",
          "text": "$120\\text{ cm}^3$"
        },
        {
          "id": "c",
          "text": "$60\\text{ cm}^3$"
        },
        {
          "id": "d",
          "text": "$20\\text{ cm}^3$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Cross-sectional area $= \\frac{1}{2} \\times 6 \\times 4 = 12\\text{ cm}^2$. Volume $= 12 \\times 10 = 120\\text{ cm}^3$."
    }
  ]
}