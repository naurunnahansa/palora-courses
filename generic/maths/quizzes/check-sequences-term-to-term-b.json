  "id": "check-sequences-term-to-term-b",
  "title": "Check: Sequences: Term-to-Term (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The first four terms of a sequence are $2, 6, 18, 54$. What is the term-to-term rule?",
      "options": [
        {
          "id": "a",
          "text": "Multiply by $3$"
        },
        {
          "id": "b",
          "text": "Add $12$"
        },
        {
          "id": "c",
          "text": "Add $4$"
        },
        {
          "id": "d",
          "text": "Multiply by $2$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "$6 \\div 2 = 3$, $18 \\div 6 = 3$, $54 \\div 18 = 3$. Each term is multiplied by $3$ to get the next term."
    }
  ]
}
