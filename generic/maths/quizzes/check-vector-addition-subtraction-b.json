  "id": "check-vector-addition-subtraction-b",
  "title": "Check: Vector Addition and Subtraction (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If $\\mathbf{p} = \\begin{pmatrix} 4 \\\\ -2 \\end{pmatrix}$ and $\\mathbf{q} = \\begin{pmatrix} 1 \\\\ 3 \\end{pmatrix}$, what is $\\mathbf{p} - \\mathbf{q}$?",
      "options": [
        {
          "id": "a",
          "text": "$\\begin{pmatrix} 5 \\\\ 1 \\end{pmatrix}$"
        },
        {
          "id": "b",
          "text": "$\\begin{pmatrix} 3 \\\\ -5 \\end{pmatrix}$"
        },
        {
          "id": "c",
          "text": "$\\begin{pmatrix} -3 \\\\ 5 \\end{pmatrix}$"
        },
        {
          "id": "d",
          "text": "$\\begin{pmatrix} 3 \\\\ 1 \\end{pmatrix}$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Subtract the corresponding components: $\\begin{pmatrix} 4 - 1 \\\\ -2 - 3 \\end{pmatrix} = \\begin{pmatrix} 3 \\\\ -5 \\end{pmatrix}$."
    }
  ]
}