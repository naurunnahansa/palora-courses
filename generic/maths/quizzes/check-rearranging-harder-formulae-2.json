{
  "id": "check-rearranging-harder-formulae-2",
  "title": "Check: Rearranging Harder Formulae",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $x$ the subject of $y = \\sqrt{\\frac{x + 1}{3}}$.",
      "options": [
        { "id": "a", "text": "$x = 3y^2 + 1$" },
        { "id": "b", "text": "$x = 3y^2 - 1$" },
        { "id": "c", "text": "$x = \\frac{y^2 - 1}{3}$" },
        { "id": "d", "text": "$x = 9y^2 - 1$" }
      ],
      "correctAnswer": "b",
      "explanation": "Square both sides: $y^2 = \\frac{x+1}{3}$. Multiply by $3$: $3y^2 = x + 1$. Subtract $1$: $x = 3y^2 - 1$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $t$ the subject of $T = 2\\pi\\sqrt{\\frac{l}{g}}$, where $g$ is a constant. (Note: $t$ here refers to $l$.)",
      "options": [
        { "id": "a", "text": "$l = \\frac{T^2 g}{4\\pi^2}$" },
        { "id": "b", "text": "$l = \\frac{T^2}{4\\pi^2 g}$" },
        { "id": "c", "text": "$l = \\frac{Tg}{2\\pi}$" },
        { "id": "d", "text": "$l = \\frac{T^2 g}{2\\pi}$" }
      ],
      "correctAnswer": "a",
      "explanation": "Divide by $2\\pi$: $\\frac{T}{2\\pi} = \\sqrt{\\frac{l}{g}}$. Square: $\\frac{T^2}{4\\pi^2} = \\frac{l}{g}$. Multiply by $g$: $l = \\frac{T^2 g}{4\\pi^2}$."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $x$ the subject of $\\frac{1}{a} = \\frac{1}{x} + \\frac{1}{b}$.",
      "options": [
        { "id": "a", "text": "$x = a - b$" },
        { "id": "b", "text": "$x = \\frac{1}{a - b}$" },
        { "id": "c", "text": "$x = \\frac{ab}{b - a}$" },
        { "id": "d", "text": "$x = \\frac{a + b}{ab}$" }
      ],
      "correctAnswer": "c",
      "explanation": "Rearrange: $\\frac{1}{x} = \\frac{1}{a} - \\frac{1}{b} = \\frac{b - a}{ab}$. Take the reciprocal: $x = \\frac{ab}{b - a}$."
    }
  ]
}
