      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $x$ the subject of $y = \\sqrt{\\frac{x + 1}{3}}$.",
      "options": [
        {
          "id": "a",
          "text": "$x = 3y^2 + 1$"
        },
        {
          "id": "b",
          "text": "$x = 3y^2 - 1$"
        },
        {
          "id": "c",
          "text": "$x = \\frac{y^2 - 1}{3}$"
        },
        {
          "id": "d",
          "text": "$x = 9y^2 - 1$"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Square both sides: $y^2 = \\frac{x+1}{3}$. Multiply by $3$: $3y^2 = x + 1$. Subtract $1$: $x = 3y^2 - 1$."
    }
  ]
