  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a class, $P(\\text{glasses}) = 0.4$ and $P(\\text{glasses and left-handed}) = 0.1$. What is $P(\\text{left-handed}\\,|\\,\\text{glasses})$?",
      "options": [
        {
          "id": "a",
          "text": "$4$"
        },
        {
          "id": "b",
          "text": "$0.5$"
        },
        {
          "id": "c",
          "text": "$0.25$"
        },
        {
          "id": "d",
          "text": "$0.04$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "$P(L\\,|\\,G) = \\frac{P(L \\cap G)}{P(G)} = \\frac{0.1}{0.4} = 0.25$."
    }
  ]
