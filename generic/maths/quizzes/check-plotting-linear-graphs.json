      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which of these points lies on the line $y = 2x + 1$?",
      "options": [
        { "id": "a", "text": "$(2, 4)$" },
        { "id": "b", "text": "$(3, 7)$" },
        { "id": "c", "text": "$(1, 4)$" },
        { "id": "d", "text": "$(0, 2)$" }
      ],
      "correctAnswer": "b",
      "explanation": "Substituting $x = 3$ into $y = 2x + 1$ gives $y = 2(3) + 1 = 7$, so $(3, 7)$ lies on the line."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "To plot the line $y = -x + 4$, which table of values is correct?",
      "options": [
        { "id": "a", "text": "$x = 0, y = 4$; $x = 2, y = 2$; $x = 4, y = 0$" },
        { "id": "b", "text": "$x = 0, y = -4$; $x = 2, y = -2$; $x = 4, y = 0$" },
        { "id": "c", "text": "$x = 0, y = 4$; $x = 2, y = 6$; $x = 4, y = 8$" },
        { "id": "d", "text": "$x = 0, y = 0$; $x = 2, y = 2$; $x = 4, y = 4$" }
      ],
      "correctAnswer": "a",
      "explanation": "For $y = -x + 4$: when $x = 0$, $y = 4$; when $x = 2$, $y = -2 + 4 = 2$; when $x = 4$, $y = -4 + 4 = 0$."
    }
  ]
