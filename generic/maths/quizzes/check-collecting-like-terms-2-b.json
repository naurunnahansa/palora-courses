{
  "id": "check-collecting-like-terms-2-b",
  "title": "Check: Collecting Like Terms (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which of these is a correct simplification of $5xy - 2x + 3xy + x$?",
      "options": [
        {
          "id": "a",
          "text": "$8xy - x$"
        },
        {
          "id": "b",
          "text": "$8xy - 2x + x$"
        },
        {
          "id": "c",
          "text": "$8x^2y^2 - x$"
        },
        {
          "id": "d",
          "text": "$7xy$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Collect the $xy$ terms: $5xy + 3xy = 8xy$. Collect the $x$ terms: $-2x + x = -x$. So the answer is $8xy - x$."
    }
  ]
}