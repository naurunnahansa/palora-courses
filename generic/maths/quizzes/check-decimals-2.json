{
  "id": "check-decimals-2",
  "title": "Check: Decimals",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Convert $0.\\overline{45}$ (i.e. $0.454545...$) to a fraction in its simplest form.",
      "options": [
        { "id": "a", "text": "$\\frac{45}{100}$" },
        { "id": "b", "text": "$\\frac{5}{11}$" },
        { "id": "c", "text": "$\\frac{9}{20}$" },
        { "id": "d", "text": "$\\frac{45}{99}$" }
      ],
      "correctAnswer": "b",
      "explanation": "Let $x = 0.\\overline{45}$. Then $100x = 45.\\overline{45}$. Subtracting: $99x = 45$, so $x = \\frac{45}{99} = \\frac{5}{11}$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Place these in order from smallest to largest: $0.305$, $0.35$, $0.3$.",
      "options": [
        { "id": "a", "text": "$0.3,\\ 0.305,\\ 0.35$" },
        { "id": "b", "text": "$0.305,\\ 0.3,\\ 0.35$" },
        { "id": "c", "text": "$0.3,\\ 0.35,\\ 0.305$" },
        { "id": "d", "text": "$0.305,\\ 0.35,\\ 0.3$" }
      ],
      "correctAnswer": "a",
      "explanation": "Writing them all to three decimal places: $0.300 < 0.305 < 0.350$. So the order is $0.3,\\ 0.305,\\ 0.35$."
    }
  ]
}
