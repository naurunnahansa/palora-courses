      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is $\\sqrt{144} + \\sqrt[3]{27}$?",
      "options": [
        { "id": "a", "text": "$9$" },
        { "id": "b", "text": "$12$" },
        { "id": "c", "text": "$15$" },
        { "id": "d", "text": "$18$" }
      ],
      "correctAnswer": "c",
      "explanation": "$\\sqrt{144} = 12$ and $\\sqrt[3]{27} = 3$, so $12 + 3 = 15$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which number is both a square number and a cube number?",
      "options": [
        { "id": "a", "text": "$16$" },
        { "id": "b", "text": "$27$" },
        { "id": "c", "text": "$36$" },
        { "id": "d", "text": "$64$" }
      ],
      "correctAnswer": "d",
      "explanation": "$64 = 8^2$ (square) and $64 = 4^3$ (cube). $16$ is $4^2$ but not a perfect cube. $27 = 3^3$ but not a perfect square. $36 = 6^2$ but not a perfect cube."
    }
  ]
