{
  "id": "quiz-volume-prisms",
  "title": "Quiz: Volume of Prisms",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cuboid has dimensions $6$ cm, $4$ cm, and $3$ cm. What is its volume?",
      "options": [
        {"id": "a", "text": "$72$ cm$^3$"},
        {"id": "b", "text": "$48$ cm$^3$"},
        {"id": "c", "text": "$13$ cm$^3$"},
        {"id": "d", "text": "$96$ cm$^3$"}
      ],
      "correctAnswer": "a",
      "explanation": "Volume $= l \\times w \\times h = 6 \\times 4 \\times 3 = 72$ cm$^3$."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The volume of any prism is calculated by:",
      "options": [
        {"id": "a", "text": "Length $\\times$ width $\\times$ height"},
        {"id": "b", "text": "Cross-sectional area $\\times$ length"},
        {"id": "c", "text": "$\\frac{1}{3} \\times$ base area $\\times$ height"},
        {"id": "d", "text": "Surface area $\\times$ length"}
      ],
      "correctAnswer": "b",
      "explanation": "Volume of a prism $=$ area of cross-section $\\times$ length (the distance between the two parallel ends)."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A triangular prism has a cross-section with base $8$ cm and height $5$ cm. The prism is $12$ cm long. What is its volume?",
      "options": [
        {"id": "a", "text": "$480$ cm$^3$"},
        {"id": "b", "text": "$240$ cm$^3$"},
        {"id": "c", "text": "$120$ cm$^3$"},
        {"id": "d", "text": "$160$ cm$^3$"}
      ],
      "correctAnswer": "b",
      "explanation": "Cross-section area $= \\frac{1}{2} \\times 8 \\times 5 = 20$ cm$^2$. Volume $= 20 \\times 12 = 240$ cm$^3$."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A cube has a volume of $125$ cm$^3$. What is the length of one side?",
      "options": [
        {"id": "a", "text": "$5$ cm"},
        {"id": "b", "text": "$25$ cm"},
        {"id": "c", "text": "$\\sqrt{125}$ cm"},
        {"id": "d", "text": "$62.5$ cm"}
      ],
      "correctAnswer": "a",
      "explanation": "Side $= \\sqrt[3]{125} = 5$ cm."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A prism has a cross-sectional area of $15$ cm$^2$ and a volume of $180$ cm$^3$. What is its length?",
      "options": [
        {"id": "a", "text": "$10$ cm"},
        {"id": "b", "text": "$12$ cm"},
        {"id": "c", "text": "$15$ cm"},
        {"id": "d", "text": "$165$ cm"}
      ],
      "correctAnswer": "b",
      "explanation": "Length $= \\frac{\\text{Volume}}{\\text{Area}} = \\frac{180}{15} = 12$ cm."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A trapezoidal prism has parallel sides $5$ cm and $9$ cm, a height of $4$ cm, and a length of $10$ cm. What is its volume?",
      "options": [
        {"id": "a", "text": "$280$ cm$^3$"},
        {"id": "b", "text": "$140$ cm$^3$"},
        {"id": "c", "text": "$360$ cm$^3$"},
        {"id": "d", "text": "$180$ cm$^3$"}
      ],
      "correctAnswer": "a",
      "explanation": "Trapezium area $= \\frac{1}{2}(5+9) \\times 4 = 28$ cm$^2$. Volume $= 28 \\times 10 = 280$ cm$^3$."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A water tank is a cuboid $2$ m long, $1.5$ m wide, and $1$ m deep. How many litres of water can it hold? ($1$ m$^3 = 1000$ litres)",
      "options": [
        {"id": "a", "text": "$3$ litres"},
        {"id": "b", "text": "$300$ litres"},
        {"id": "c", "text": "$3000$ litres"},
        {"id": "d", "text": "$30000$ litres"}
      ],
      "correctAnswer": "c",
      "explanation": "Volume $= 2 \\times 1.5 \\times 1 = 3$ m$^3$. In litres: $3 \\times 1000 = 3000$ litres."
    }
  ]
}
