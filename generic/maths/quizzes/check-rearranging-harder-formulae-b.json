  "title": "Check: Rearranging Harder Formulae (B)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Make $a$ the subject of $s = ut + \\frac{1}{2}at^2$.",
      "options": [
        {
          "id": "a",
          "text": "$a = \\frac{2(s - ut)}{t^2}$"
        },
        {
          "id": "b",
          "text": "$a = \\frac{s - ut}{t^2}$"
        },
        {
          "id": "c",
          "text": "$a = \\frac{2s - ut}{t^2}$"
        },
        {
          "id": "d",
          "text": "$a = \\frac{s - ut}{2t^2}$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Subtract $ut$: $s - ut = \\frac{1}{2}at^2$. Multiply by $2$: $2(s - ut) = at^2$. Divide by $t^2$: $a = \\frac{2(s - ut)}{t^2}$."
    }
  ]
