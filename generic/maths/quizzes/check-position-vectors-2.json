{
  "id": "check-position-vectors-2",
  "title": "Check: Position Vectors",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "$A$ has position vector $\\begin{pmatrix} 2 \\\\ 3 \\end{pmatrix}$ and $B$ has position vector $\\begin{pmatrix} 8 \\\\ 7 \\end{pmatrix}$. What is the position vector of the midpoint $M$ of $AB$?",
      "options": [
        {
          "id": "a",
          "text": "$\\begin{pmatrix} 6 \\\\ 4 \\end{pmatrix}$"
        },
        {
          "id": "b",
          "text": "$\\begin{pmatrix} 10 \\\\ 10 \\end{pmatrix}$"
        },
        {
          "id": "c",
          "text": "$\\begin{pmatrix} 5 \\\\ 5 \\end{pmatrix}$"
        },
        {
          "id": "d",
          "text": "$\\begin{pmatrix} 3 \\\\ 2 \\end{pmatrix}$"
        }
      ],
      "correctAnswer": "c",
      "explanation": "The midpoint has position vector $\\frac{1}{2}(\\overrightarrow{OA} + \\overrightarrow{OB}) = \\frac{1}{2}\\begin{pmatrix} 2+8 \\\\ 3+7 \\end{pmatrix} = \\frac{1}{2}\\begin{pmatrix} 10 \\\\ 10 \\end{pmatrix} = \\begin{pmatrix} 5 \\\\ 5 \\end{pmatrix}$."
    }
  ]
}