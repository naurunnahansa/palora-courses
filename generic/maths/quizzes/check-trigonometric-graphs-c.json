  "title": "Check: Trigonometric Graphs (C)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which trigonometric graph has a period of $180°$?",
      "options": [
        {
          "id": "a",
          "text": "$y = \\sin(x)$"
        },
        {
          "id": "b",
          "text": "$y = \\cos(x)$"
        },
        {
          "id": "c",
          "text": "$y = \\tan(x)$"
        },
        {
          "id": "d",
          "text": "None of the above"
        }
      ],
      "correctAnswer": "c",
      "explanation": "The tangent function has a period of $180°$ (or $\\pi$ radians), meaning $\\tan(x) = \\tan(x + 180°)$. Both sine and cosine have a period of $360°$."
    }
  ]
}