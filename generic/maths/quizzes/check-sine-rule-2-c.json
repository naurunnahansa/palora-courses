  "title": "Check: Sine Rule (C)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In triangle $ABC$, $A = 30°$, $C = 80°$, and $c = 15\\text{ cm}$. What is the value of $B$, and which expression gives side $a$?",
      "options": [
        {
          "id": "a",
          "text": "$B = 70°$; $a = \\frac{15 \\sin 30°}{\\sin 80°}$"
        },
        {
          "id": "b",
          "text": "$B = 70°$; $a = \\frac{15 \\sin 80°}{\\sin 30°}$"
        },
        {
          "id": "c",
          "text": "$B = 110°$; $a = \\frac{15 \\sin 30°}{\\sin 80°}$"
        },
        {
          "id": "d",
          "text": "$B = 60°$; $a = \\frac{15 \\sin 30°}{\\sin 80°}$"
        }
      ],
      "correctAnswer": "a",
      "explanation": "$B = 180° - 30° - 80° = 70°$. By the sine rule: $a = \\frac{c \\sin A}{\\sin C} = \\frac{15 \\sin 30°}{\\sin 80°}$."
    }
  ]
