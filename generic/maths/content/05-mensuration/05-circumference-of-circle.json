          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A running track consists of two straight sections, each 100 m long, and two semicircular ends. The total length of the track is 400 m. Find the radius of each semicircular end to 1 decimal place."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 11
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The circumference of a circle is $18\\pi$ cm. Find the radius."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 12
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A shape is formed by joining a semicircle of diameter 12 cm to one end of a rectangle 12 cm by 8 cm. Find the perimeter of the shape to 1 decimal place."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Answers"
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 1
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$C = 20\\pi$ cm"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 2
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$C = 2\\pi(6) = 12\\pi = 37.699... \\approx 37.7$ cm"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 3
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$C = \\pi \\times 50 = 50\\pi = 157.079... \\approx 157$ cm"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 4
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$C = 2\\pi(4.5) = 9\\pi = 28.274... \\approx 28.27$ m"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 5
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$d = \\frac{31.4}{\\pi} = 9.99... \\approx 10.0$ m"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 6
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$C = 2\\pi(15) = 30\\pi \\approx 94.2$ cm"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 7
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Perimeter $= \\frac{1}{2}\\pi(8) + 8 = 4\\pi + 8$ cm"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 8
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Curved part $= \\frac{1}{4} \\times 2\\pi(6) = 3\\pi$. Perimeter $= 3\\pi + 6 + 6 = 3\\pi + 12 = 9.424... + 12 = 21.4$ cm"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 9
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Circumference $= 2\\pi(0.35) = 0.7\\pi \\approx 2.199$ m. Revolutions $= \\frac{1000}{2.199} \\approx 454.7$, so "
                  },
                  {
                    "type": "text",
                    "text": "454 complete revolutions",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": "."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 10
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The two semicircles form one full circle. Straight parts total $200$ m. So circumference of circle $= 400 - 200 = 200$ m. $200 = 2\\pi r$, so $r = \\frac{200}{2\\pi} = \\frac{100}{\\pi} = 31.8$ m."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 11
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$2\\pi r = 18\\pi$, so $r = 9$ cm."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 12
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Perimeter = two lengths of 8 cm + one width of 12 cm + semicircle. Semicircle curved part $= \\frac{1}{2}\\pi(12) = 6\\pi \\approx 18.8$ cm. Total $= 8 + 8 + 12 + 18.8 = 46.8$ cm. (Note: the side where the semicircle attaches replaces that edge of the rectangle.)"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Corrected: Perimeter = two sides of 8 cm + one width of 12 cm (opposite end from semicircle) + semicircle arc. $= 8 + 8 + 12 + 6\\pi \\approx 8 + 8 + 12 + 18.85 = 46.8$ cm."
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Exam Tips"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Check whether the question gives the "
                  },
                  {
                    "type": "text",
                    "text": "radius",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " or the "
                  },
                  {
                    "type": "text",
                    "text": "diameter",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " -- this is the most common source of error."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "If asked for an "
                  },
                  {
                    "type": "text",
                    "text": "exact answer",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ", leave it in terms of $\\pi$ (e.g., $14\\pi$ cm)."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "If asked for a rounded answer, use the full value of $\\pi$ from your calculator and only round at the "
                  },
                  {
                    "type": "text",
                    "text": "final step",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": "."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "For semicircles and quarter circles, always consider whether you need to add "
                  },
                  {
                    "type": "text",
                    "text": "straight edges",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " as well as curved parts."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A wheel's distance per revolution equals its "
                  },
                  {
                    "type": "text",
                    "text": "circumference",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": "."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "quizEmbed",
        "attrs": {
          "quizId": "quiz-circumference-of-circle"
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Summary"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Circumference",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " is the distance around a circle."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$C = \\pi d$ or $C = 2\\pi r$"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$\\pi \\approx 3.14159...$"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "To find $d$ from $C$: $d = \\frac{C}{\\pi}$"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "To find $r$ from $C$: $r = \\frac{C}{2\\pi}$"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "For "
                  },
                  {
                    "type": "text",
                    "text": "semicircles",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ", the perimeter = half circumference + diameter."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "For "
                  },
                  {
                    "type": "text",
                    "text": "quarter circles",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ", the perimeter = quarter circumference + two radii."
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
