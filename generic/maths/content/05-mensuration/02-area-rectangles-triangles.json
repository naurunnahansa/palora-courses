        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A triangle has an area of 36 cm$^2$ and a base of 9 cm. Find the perpendicular height."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 9
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A rectangle has a length that is three times its width. If its area is 108 cm$^2$, find its dimensions."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 10
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Two shapes have the same area: a square of side $s$ and a triangle with base 10 cm and height 8 cm. Find $s$."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 11
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A rectangular room measures 6.5 m by 4.2 m. Carpet costs \\$22.50 per m$^2$. Find the total cost of carpeting the room."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 12
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The area of a right-angled triangle is 60 cm$^2$. The two shorter sides are in the ratio $3:5$. Find the lengths of the two shorter sides."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Answers"
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 1
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$A = 7 \\times 4 = 28$ cm$^2$"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 2
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$A = 9^2 = 81$ m$^2$"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 3
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$A = \\frac{1}{2} \\times 12 \\times 5 = 30$ cm$^2$"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 4
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$A = 120 \\times 85 = 10{,}200$ m$^2$"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 5
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$A = \\frac{1}{2} \\times 14 \\times 8 = 56$ cm$^2$"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 6
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$l = 72 \\div 6 = 12$ cm"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 7
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$A = 4 \\times 2.5 = 10$ m$^2$. Tins needed $= 10 \\div 5 = 2$ tins."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 8
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$36 = \\frac{1}{2} \\times 9 \\times h$, so $36 = 4.5h$, giving $h = 8$ cm."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 9
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Let width $= w$, length $= 3w$. Then $3w \\times w = 108$, $3w^2 = 108$, $w^2 = 36$, $w = 6$ cm, $l = 18$ cm."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 10
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Triangle area $= \\frac{1}{2} \\times 10 \\times 8 = 40$ cm$^2$. So $s^2 = 40$, $s = \\sqrt{40} = 2\\sqrt{10} \\approx 6.32$ cm."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 11
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$A = 6.5 \\times 4.2 = 27.3$ m$^2$. Cost $= 27.3 \\times 22.50 = \\$614.25$."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 12
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Let the sides be $3k$ and $5k$. Then $\\frac{1}{2} \\times 3k \\times 5k = 60$, so $\\frac{15k^2}{2} = 60$, $15k^2 = 120$, $k^2 = 8$, $k = 2\\sqrt{2}$. Sides: $3k = 6\\sqrt{2} \\approx 8.49$ cm and $5k = 10\\sqrt{2} \\approx 14.14$ cm."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Exam Tips"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Always check whether the height given is the "
                  },
                  {
                    "type": "text",
                    "text": "perpendicular height",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " -- this is crucial for triangles."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "If a question gives you a triangle inside a rectangle, the triangle's area is half the rectangle's area."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "For cost or quantity questions, calculate the area first, then apply the rate."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Show your formula, substitution, and answer clearly for full marks."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Double-check that your units are "
                  },
                  {
                    "type": "text",
                    "text": "squared",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " for area."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "quizEmbed",
        "attrs": {
          "quizId": "quiz-area-rectangles-triangles"
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Summary"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Area of a rectangle:",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " $A = lw$"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Area of a square:",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " $A = s^2$"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Area of a triangle:",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " $A = \\frac{1}{2}bh$ (where $h$ is the perpendicular height)"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Area is measured in "
                  },
                  {
                    "type": "text",
                    "text": "square units",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " (cm$^2$, m$^2$, etc.)"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "To find a missing dimension, rearrange the formula."
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
