        "attrs": {
          "start": 12
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Two prisms have the same volume. Prism A is a cuboid $10 \\times 8 \\times 6$ cm. Prism B is a triangular prism with a right-angled triangular cross-section with legs 12 cm and $h$ cm, and length 10 cm. Find $h$."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Answers"
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 1
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$V = 8 \\times 5 \\times 3 = 120$ cm$^3$"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 2
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$V = 6^3 = 216$ cm$^3$"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 3
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$V = \\frac{1}{2}(10)(6) \\times 14 = 30 \\times 14 = 420$ cm$^3$"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 4
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$V = 25 \\times 10 \\times 1.8 = 450$ m$^3$"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 5
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$h = \\frac{480}{12 \\times 8} = \\frac{480}{96} = 5$ cm"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 6
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$V = \\frac{1}{2}(4)(3) \\times 15 = 6 \\times 15 = 90$ cm$^3$"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 7
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$V = 5 \\times 4 \\times 3 = 60$ m$^3$"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 8
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "L-shape area $= (6 \\times 5) - (3 \\times 2) = 30 - 6 = 24$ cm$^2$. Volume $= 24 \\times 10 = 240$ cm$^3$."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 9
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Trapezium area $= \\frac{1}{2}(9 + 5)(4) = 28$ cm$^2$. $560 = 28 \\times l$, so $l = 20$ cm."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 10
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$V = 93.5 \\times 20 = 1870$ cm$^3$"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 11
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "T-shape area $= (40 \\times 10) + (10 \\times 30) = 400 + 300 = 700$ cm$^2$. Length $= 300$ cm. Volume $= 700 \\times 300 = 210{,}000$ cm$^3$ $= 0.21$ m$^3$."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 12
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Prism A: $V = 10 \\times 8 \\times 6 = 480$ cm$^3$. Prism B: $480 = \\frac{1}{2}(12)(h) \\times 10 = 60h$. So $h = 8$ cm."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Exam Tips"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The key formula is: "
                  },
                  {
                    "type": "text",
                    "text": "Volume = cross-section area $\\times$ length",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ". This works for ALL prisms."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "First find the area of the cross-section using the appropriate 2D formula, then multiply by the length."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make sure you identify the "
                  },
                  {
                    "type": "text",
                    "text": "uniform",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " cross-section -- it is the face that stays the same along the length."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "For compound cross-sections (L-shapes, T-shapes), use addition or subtraction of simpler shapes."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Units must be "
                  },
                  {
                    "type": "text",
                    "text": "cubic",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " (cm$^3$, m$^3$). Check all dimensions are in the same unit before calculating."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "quizEmbed",
        "attrs": {
          "quizId": "quiz-volume-prisms"
        }
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Summary"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Volume of a prism",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " $= \\text{cross-section area} \\times \\text{length}$"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cuboid:",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " $V = lwh$"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Cube:",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " $V = s^3$"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Triangular prism:",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " $V = \\frac{1}{2}bh \\times l$"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "The cross-section can be any shape: triangle, trapezium, L-shape, hexagon, etc."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Volume is measured in "
                  },
                  {
                    "type": "text",
                    "text": "cubic units",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " (cm$^3$, m$^3$, etc.)."
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
