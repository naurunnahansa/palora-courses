                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Triangular prism:",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
