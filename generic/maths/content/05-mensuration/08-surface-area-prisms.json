              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Identify the faces of cuboids and triangular prisms"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Calculate the surface area of a cuboid"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Calculate the surface area of a triangular prism"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Apply surface area calculations to real-world problems"
                  }
                ]
              }
            ]
