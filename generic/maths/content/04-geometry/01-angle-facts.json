                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Exam mark schemes require a reason for each step"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "tableCell",
                "attrs": {
                  "colspan": 1,
                  "rowspan": 1,
                  "colwidth": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Always write the angle fact used, e.g. \"angles on a straight line\""
                      }
                    ]
                  }
                ]
              }
            ]
          },
