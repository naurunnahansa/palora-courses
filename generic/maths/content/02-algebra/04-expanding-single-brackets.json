        "content": [
          {
            "type": "text",
            "text": "Question:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " Show that $5(x + 3) - 2(x - 4) = 3(x + \\frac{23}{3})$."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Solution:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " LHS: $5(x + 3) - 2(x - 4) = 5x + 15 - 2x + 8 = 3x + 23$"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "RHS: $3(x + \\frac{23}{3}) = 3x + 23$ ✓"
          }
        ]
