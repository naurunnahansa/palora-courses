                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " means multiplying each term inside the bracket by the term outside"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Distributive law:",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": " $a(b + c) = ab + ac$"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Be careful with "
                  },
                  {
                    "type": "text",
                    "text": "negative signs",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ": $-a(b - c) = -ab + ac$"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "When the multiplier contains a variable: $x(x + 3) = x^2 + 3x$"
                  }
