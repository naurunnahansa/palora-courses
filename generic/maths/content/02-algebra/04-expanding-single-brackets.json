                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " Expand $3x(2x - 5y + 4)$."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Solution:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "$$3x(2x - 5y + 4) = 6x^2 - 15xy + 12x$$"
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
