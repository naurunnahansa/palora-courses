              }
            ]
          },
          {
            "type": "text",
            "text": " Expand and simplify $3(x + 2) + 4(x - 3) - 2(x + 1)$."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Solution:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "$$= 3x + 6 + 4x - 12 - 2x - 2$$"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "$$= (3x + 4x - 2x) + (6 - 12 - 2)$$"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "$$= 5x - 8$$"
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
