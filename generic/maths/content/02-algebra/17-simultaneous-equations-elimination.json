                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$3x - 2y = 13$"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$2x + y = 9$"
                  }
