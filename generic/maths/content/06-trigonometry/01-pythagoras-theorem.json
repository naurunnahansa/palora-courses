        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Learning Objectives"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "By the end of this lesson, you should be able to:"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "State Pythagoras' Theorem and identify when it can be used"
