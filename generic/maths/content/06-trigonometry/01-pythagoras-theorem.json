      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 10
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Prove that a triangle with sides 8, 15, and 17 is right-angled."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 11
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Find the value of $x$ in a right-angled triangle where the sides are $x$, $x + 1$, and $x + 2$."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 12
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A rectangle has a diagonal of 26 cm and a width of 10 cm. Find the area of the rectangle."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Answers"
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 1
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$c = \\sqrt{6^2 + 8^2} = \\sqrt{100} = 10$ cm"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 2
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$c = \\sqrt{5^2 + 12^2} = \\sqrt{169} = 13$ cm"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 3
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$a = \\sqrt{10^2 - 6^2} = \\sqrt{64} = 8$ cm"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 4
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$c = \\sqrt{7^2 + 9^2} = \\sqrt{130} = 11.4$ cm (1 d.p.)"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 5
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$a = \\sqrt{15^2 - 9^2} = \\sqrt{144} = 12$ cm"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 6
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Diagonal $= \\sqrt{4^2 + 3^2} = \\sqrt{25} = 5$ m"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 7
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$c = \\sqrt{5 + 7} = \\sqrt{12} = 2\\sqrt{3}$ cm"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 8
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$a = \\sqrt{50 - 9} = \\sqrt{41}$ cm"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 9
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Distance $= \\sqrt{15^2 + 20^2} = \\sqrt{625} = 25$ km"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 10
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Check: $8^2 + 15^2 = 64 + 225 = 289 = 17^2$. Since $a^2 + b^2 = c^2$, the triangle is right-angled."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 11
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "$(x+2)^2 = x^2 + (x+1)^2$, so $x^2 + 4x + 4 = x^2 + x^2 + 2x + 1$, giving $x^2 - 2x - 3 = 0$, so $(x-3)(x+1) = 0$. Since lengths are positive, $x = 3$. Sides are 3, 4, 5."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "orderedList",
        "attrs": {
          "start": 12
        },
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Length $= \\sqrt{26^2 - 10^2} = \\sqrt{576} = 24$ cm. Area $= 24 \\times 10 = 240$ cm$^2$."
                  }
                ]
              }
            ]
          }
        ]
      },
