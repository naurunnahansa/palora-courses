            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A right-angled triangle has a hypotenuse of $\\sqrt{50}$ cm and one shorter side of 3 cm. Find the other shorter side in surd form."
                  }
