          {
            "type": "text",
            "text": "Worked Examples"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Example 1: Reading a Distance-Time Graph"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Question:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " A cyclist leaves home at 9:00 am. The distance-time graph shows their journey."
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "From 9:00 to 10:00 they travel 15 km."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "From 10:00 to 10:30 they stop for a rest."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "From 10:30 to 11:30 they travel a further 20 km."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Calculate the speed for each section."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Solution:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Section 1 (9:00 to 10:00):",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "$$\\begin{aligned}\n\\text{Speed} &= \\frac{\\text{Distance}}{\\text{Time}} \\\\\n&= \\frac{15 \\text{ km}}{1 \\text{ hour}} \\\\\n&= 15 \\text{ km/h}\n\\end{aligned}$$"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Section 2 (10:00 to 10:30):",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " The cyclist is stationary, so the speed is $0$ km/h."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Section 3 (10:30 to 11:30):",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "$$\\begin{aligned}\n\\text{Speed} &= \\frac{20 \\text{ km}}{1 \\text{ hour}} \\\\\n&= 20 \\text{ km/h}\n\\end{aligned}$$"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The third section is steeper, confirming the cyclist was travelling faster."
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Example 2: Conversion Graph"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Question:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " A conversion graph shows that 5 miles = 8 km. Use this to convert: (a) 20 miles to km (b) 40 km to miles"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Solution:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The conversion rate is:"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "$$\\frac{8 \\text{ km}}{5 \\text{ miles}} = 1.6 \\text{ km per mile}$$"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "(a)",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " $20 \\text{ miles} = 20 \\times 1.6 = 32$ km"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "(b)",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " $40 \\text{ km} = 40 \\div 1.6 = 25$ miles"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "On a conversion graph, you would read across from 20 on the miles axis to the line, then down to the km axis to get 32."
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Example 3: Interpreting Gradient in Context"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Question:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " A graph shows the cost of printing leaflets. At 100 leaflets the cost is £30, and at 300 leaflets the cost is £50. Find and interpret the gradient."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Solution:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "$$\\begin{aligned}\n\\text{Gradient} &= \\frac{\\text{Change in cost}}{\\text{Change in quantity}} \\\\\n&= \\frac{50 - 30}{300 - 100} \\\\\n&= \\frac{20}{200} \\\\\n&= 0.10\n\\end{aligned}$$"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Interpretation:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " Each additional leaflet costs "
          },
          {
            "type": "text",
            "text": "£0.10",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " (10p) to print."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Note: The graph does not pass through the origin, suggesting there is a "
          },
          {
            "type": "text",
            "text": "fixed cost",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " (setup charge) in addition to the per-leaflet cost."
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Example 4: Return Journey on a Distance-Time Graph"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Question:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " A walker leaves home at 2:00 pm, walks 6 km in 1.5 hours, rests for 30 minutes, then walks back home in 1 hour. Calculate the speed of the return journey and the average speed for the whole trip."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Solution:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Return journey speed:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "$$\\begin{aligned}\n\\text{Speed} &= \\frac{6 \\text{ km}}{1 \\text{ hour}} \\\\\n&= 6 \\text{ km/h}\n\\end{aligned}$$"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Average speed for the whole trip:",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "$$\\begin{aligned}\n\\text{Total distance} &= 6 + 6 = 12 \\text{ km} \\\\\n\\text{Total time} &= 1.5 + 0.5 + 1 = 3 \\text{ hours} \\\\\n\\text{Average speed} &= \\frac{12}{3} = 4 \\text{ km/h}\n\\end{aligned}$$"
          }
        ]
      },
      {
        "type": "blockquote",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Key Insight:",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": " Average speed uses "
              },
              {
                "type": "text",
                "text": "total distance",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": " divided by "
              },
              {
                "type": "text",
                "text": "total time",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": ", including rest stops."
              }
            ]
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
