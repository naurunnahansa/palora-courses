      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "To use a conversion graph, start at a value on one axis, draw across (or up) to the line, then read the corresponding value on the other axis."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
