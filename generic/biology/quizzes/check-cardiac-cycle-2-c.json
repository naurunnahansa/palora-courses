  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What produces the second heart sound ('dub')?",
      "options": [
        {
          "id": "a",
          "text": "Blood rushing into the aorta"
        },
        {
          "id": "b",
          "text": "The atrioventricular valves closing"
        },
        {
          "id": "c",
          "text": "The semilunar valves closing"
        },
        {
          "id": "d",
          "text": "The ventricles contracting"
        }
      ],
      "correctAnswer": "c",
      "explanation": "The 'dub' (second heart sound, S2) is caused by the semilunar valves (aortic and pulmonary) closing at the start of diastole, when ventricular pressure drops below arterial pressure."
    }
  ]
