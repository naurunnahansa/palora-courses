  "title": "Power - Check 1",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the equation for power?",
      "options": [
        { "id": "a", "text": "P = E x t" },
        { "id": "b", "text": "P = E / t" },
        { "id": "c", "text": "P = F x d" },
        { "id": "d", "text": "P = m x v" }
      ],
      "correctAnswer": "b",
      "explanation": "Power is the rate of energy transfer (or rate of doing work). P = E/t, where E is energy transferred in joules and t is time in seconds. The unit of power is the watt (W)."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is 1 watt equivalent to?",
      "options": [
        { "id": "a", "text": "1 joule per minute" },
        { "id": "b", "text": "1 newton per second" },
        { "id": "c", "text": "1 joule per second" },
        { "id": "d", "text": "1 kilogram per second" }
      ],
      "correctAnswer": "c",
      "explanation": "One watt is equal to one joule per second (1 W = 1 J/s). It measures the rate at which energy is transferred."
    }
  ]
}
