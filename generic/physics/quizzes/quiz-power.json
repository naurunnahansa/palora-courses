{
  "id": "quiz-power",
  "title": "Quiz: Power",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Power is defined as:",
      "options": [
        {
          "id": "a",
          "text": "The force multiplied by distance"
        },
        {
          "id": "b",
          "text": "The rate of energy transfer"
        },
        {
          "id": "c",
          "text": "The amount of work an object can do"
        },
        {
          "id": "d",
          "text": "The total energy used"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Power is the rate of energy transfer, or equivalently, the rate of doing work. It tells us how quickly energy is being transferred."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the SI unit of power?",
      "options": [
        {
          "id": "a",
          "text": "Watt (W)"
        },
        {
          "id": "b",
          "text": "Joule (J)"
        },
        {
          "id": "c",
          "text": "Newton (N)"
        },
        {
          "id": "d",
          "text": "Kilowatt-hour (kWh)"
        }
      ],
      "correctAnswer": "a",
      "explanation": "The SI unit of power is the watt (W). One watt equals one joule per second (1 W = 1 J/s)."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A machine does 600 J of work in 30 seconds. What is its power?",
      "options": [
        {
          "id": "a",
          "text": "570 W"
        },
        {
          "id": "b",
          "text": "18,000 W"
        },
        {
          "id": "c",
          "text": "20 W"
        },
        {
          "id": "d",
          "text": "0.05 W"
        }
      ],
      "correctAnswer": "c",
      "explanation": "P = W/t = 600 J / 30 s = 20 W."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A 2 kW heater is used for 5 minutes. How much energy does it transfer?",
      "options": [
        {
          "id": "a",
          "text": "600 J"
        },
        {
          "id": "b",
          "text": "600,000 J"
        },
        {
          "id": "c",
          "text": "10,000 J"
        },
        {
          "id": "d",
          "text": "10 J"
        }
      ],
      "correctAnswer": "b",
      "explanation": "E = Pt = 2000 W x (5 x 60 s) = 2000 x 300 = 600,000 J (600 kJ). Remember to convert minutes to seconds."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If two machines do the same amount of work, the more powerful machine will:",
      "options": [
        {
          "id": "a",
          "text": "Use more energy in total"
        },
        {
          "id": "b",
          "text": "Apply a greater force"
        },
        {
          "id": "c",
          "text": "Move the object further"
        },
        {
          "id": "d",
          "text": "Do the work in less time"
        }
      ],
      "correctAnswer": "d",
      "explanation": "More power means a faster rate of energy transfer, so the more powerful machine completes the same work in less time."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "How many watts are in 1 kilowatt?",
      "options": [
        {
          "id": "a",
          "text": "10 W"
        },
        {
          "id": "b",
          "text": "10,000 W"
        },
        {
          "id": "c",
          "text": "100 W"
        },
        {
          "id": "d",
          "text": "1000 W"
        }
      ],
      "correctAnswer": "d",
      "explanation": "1 kilowatt (kW) = 1000 watts (W). The prefix 'kilo' means 1000."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which equation relates power to force and velocity?",
      "options": [
        {
          "id": "a",
          "text": "P = Fa"
        },
        {
          "id": "b",
          "text": "P = F/v"
        },
        {
          "id": "c",
          "text": "P = mv"
        },
        {
          "id": "d",
          "text": "P = Fv"
        }
      ],
      "correctAnswer": "d",
      "explanation": "P = Fv. Since P = W/t and W = Fd, then P = Fd/t = Fv, where v = d/t is the velocity."
    }
  ]
}
