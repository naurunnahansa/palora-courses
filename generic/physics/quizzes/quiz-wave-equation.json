{
  "id": "quiz-wave-equation",
  "title": "Quiz: Wave Equation",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the wave equation?",
      "options": [
        {
          "id": "a",
          "text": "v = f x lambda"
        },
        {
          "id": "b",
          "text": "v = lambda / f"
        },
        {
          "id": "c",
          "text": "v = f / lambda"
        },
        {
          "id": "d",
          "text": "v = f + lambda"
        }
      ],
      "correctAnswer": "a",
      "explanation": "The wave equation is v = f x lambda, where v is wave speed (m/s), f is frequency (Hz), and lambda is wavelength (m)."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A sound wave has a frequency of 440 Hz and a wavelength of 0.78 m. What is its speed?",
      "options": [
        {
          "id": "a",
          "text": "171.6 m/s"
        },
        {
          "id": "b",
          "text": "343.2 m/s"
        },
        {
          "id": "c",
          "text": "564 m/s"
        },
        {
          "id": "d",
          "text": "439.2 m/s"
        }
      ],
      "correctAnswer": "b",
      "explanation": "v = f x lambda = 440 x 0.78 = 343.2 m/s."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The wave equation applies to:",
      "options": [
        {
          "id": "a",
          "text": "Light waves only"
        },
        {
          "id": "b",
          "text": "Sound waves only"
        },
        {
          "id": "c",
          "text": "All types of waves"
        },
        {
          "id": "d",
          "text": "Water waves only"
        }
      ],
      "correctAnswer": "c",
      "explanation": "The wave equation v = f x lambda applies to all types of waves, including sound, light, water, seismic, and electromagnetic waves."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Radio waves travel at 3 x 10^8 m/s. A station broadcasts at 100 MHz. What is the wavelength?",
      "options": [
        {
          "id": "a",
          "text": "3 m"
        },
        {
          "id": "b",
          "text": "30 m"
        },
        {
          "id": "c",
          "text": "300 m"
        },
        {
          "id": "d",
          "text": "0.3 m"
        }
      ],
      "correctAnswer": "a",
      "explanation": "lambda = v/f = (3 x 10^8) / (100 x 10^6) = 3 m. Remember to convert MHz to Hz."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "If the frequency of a wave increases while the speed stays constant, what happens to the wavelength?",
      "options": [
        {
          "id": "a",
          "text": "It stays the same"
        },
        {
          "id": "b",
          "text": "It decreases"
        },
        {
          "id": "c",
          "text": "It doubles"
        },
        {
          "id": "d",
          "text": "It increases"
        }
      ],
      "correctAnswer": "b",
      "explanation": "From v = f x lambda, if v is constant and f increases, then lambda must decrease. Frequency and wavelength are inversely proportional at constant speed."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What determines the speed of a wave?",
      "options": [
        {
          "id": "a",
          "text": "The medium through which it travels"
        },
        {
          "id": "b",
          "text": "The amplitude of the wave"
        },
        {
          "id": "c",
          "text": "The colour of the wave"
        },
        {
          "id": "d",
          "text": "The frequency of the source"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Wave speed depends on the medium, not the source. For example, sound travels faster in steel (5100 m/s) than in air (343 m/s)."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "All electromagnetic waves travel at the same speed in a vacuum. That speed is:",
      "options": [
        {
          "id": "a",
          "text": "3 x 10^6 m/s"
        },
        {
          "id": "b",
          "text": "343 m/s"
        },
        {
          "id": "c",
          "text": "3 x 10^8 m/s"
        },
        {
          "id": "d",
          "text": "1500 m/s"
        }
      ],
      "correctAnswer": "c",
      "explanation": "All electromagnetic waves travel at the speed of light in a vacuum: c = 3 x 10^8 m/s (300,000,000 m/s)."
    }
  ]
}
