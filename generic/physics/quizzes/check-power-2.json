{
  "id": "check-power-2",
  "title": "Power - Check 2",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A motor does 5000 J of work in 10 seconds. What is its power output?",
      "options": [
        { "id": "a", "text": "50 W" },
        { "id": "b", "text": "500 W" },
        { "id": "c", "text": "5000 W" },
        { "id": "d", "text": "50000 W" }
      ],
      "correctAnswer": "b",
      "explanation": "P = W/t = 5000/10 = 500 W."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which equation relates power to force and velocity?",
      "options": [
        { "id": "a", "text": "P = F/v" },
        { "id": "b", "text": "P = Fv" },
        { "id": "c", "text": "P = F + v" },
        { "id": "d", "text": "P = v/F" }
      ],
      "correctAnswer": "b",
      "explanation": "P = Fv, where F is the driving force in newtons and v is the velocity in m/s. This is derived from P = W/t = Fd/t = F x (d/t) = Fv."
    }
  ]
}
