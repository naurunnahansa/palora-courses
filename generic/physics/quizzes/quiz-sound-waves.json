{
  "id": "quiz-sound-waves",
  "title": "Quiz: Sound Waves",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Sound waves are:",
      "options": [
        {
          "id": "a",
          "text": "Electromagnetic waves"
        },
        {
          "id": "b",
          "text": "Transverse waves"
        },
        {
          "id": "c",
          "text": "Neither transverse nor longitudinal"
        },
        {
          "id": "d",
          "text": "Longitudinal waves"
        }
      ],
      "correctAnswer": "d",
      "explanation": "Sound waves are longitudinal waves. Air particles vibrate back and forth parallel to the direction the sound travels, creating compressions and rarefactions."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Sound cannot travel through:",
      "options": [
        {
          "id": "a",
          "text": "A vacuum"
        },
        {
          "id": "b",
          "text": "Steel"
        },
        {
          "id": "c",
          "text": "Air"
        },
        {
          "id": "d",
          "text": "Water"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Sound requires a medium (solid, liquid, or gas) to travel through. It cannot travel through a vacuum because there are no particles to vibrate."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The pitch of a sound is determined by its:",
      "options": [
        {
          "id": "a",
          "text": "Amplitude"
        },
        {
          "id": "b",
          "text": "Speed"
        },
        {
          "id": "c",
          "text": "Frequency"
        },
        {
          "id": "d",
          "text": "Wavelength only"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Pitch is determined by frequency. Higher frequency means higher pitch. The human hearing range is approximately 20 Hz to 20,000 Hz."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The loudness of a sound is determined by its:",
      "options": [
        {
          "id": "a",
          "text": "Wavelength"
        },
        {
          "id": "b",
          "text": "Frequency"
        },
        {
          "id": "c",
          "text": "Amplitude"
        },
        {
          "id": "d",
          "text": "Speed"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Loudness depends on amplitude. A greater amplitude means louder sound because more energy is being transferred by the wave."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The approximate speed of sound in air at room temperature is:",
      "options": [
        {
          "id": "a",
          "text": "1500 m/s"
        },
        {
          "id": "b",
          "text": "343 m/s"
        },
        {
          "id": "c",
          "text": "3 x 10^8 m/s"
        },
        {
          "id": "d",
          "text": "30 m/s"
        }
      ],
      "correctAnswer": "b",
      "explanation": "The speed of sound in air at room temperature (about 20 degrees C) is approximately 343 m/s."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Sound travels fastest through:",
      "options": [
        {
          "id": "a",
          "text": "Solids such as steel"
        },
        {
          "id": "b",
          "text": "Water"
        },
        {
          "id": "c",
          "text": "Air"
        },
        {
          "id": "d",
          "text": "A vacuum"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Sound travels fastest through solids (e.g. steel at about 5100 m/s), slower through liquids (e.g. water at about 1500 m/s), and slowest through gases (e.g. air at about 343 m/s)."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "The human hearing range is approximately:",
      "options": [
        {
          "id": "a",
          "text": "1 Hz to 100 Hz"
        },
        {
          "id": "b",
          "text": "0 Hz to 50,000 Hz"
        },
        {
          "id": "c",
          "text": "20 Hz to 20,000 Hz"
        },
        {
          "id": "d",
          "text": "100 Hz to 100,000 Hz"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Humans can typically hear sounds with frequencies between about 20 Hz and 20,000 Hz (20 kHz). Below 20 Hz is infrasound; above 20 kHz is ultrasound."
    }
  ]
}
