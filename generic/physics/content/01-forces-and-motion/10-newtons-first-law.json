                  {
                    "type": "text",
                    "text": "$2000 = 1500 + F_{air}$"
                  },
                  {
                    "type": "text",
                    "text": "; "
                  },
                  {
                    "type": "text",
                    "text": "$F_{air} = 500$"
                  },
                  {
                    "type": "text",
                    "text": " N (calculation)"
                  }
                ]
              }
            ]
          }
