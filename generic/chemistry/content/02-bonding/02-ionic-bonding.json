        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Sodium (Na): 2, 8, 1 \u2192 has 1 electron to lose" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Chlorine (Cl): 2, 8, 7 \u2192 needs 1 electron to fill shell" }] }] }
