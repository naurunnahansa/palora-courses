          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "These become the subscripts" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Simplify if necessary" }] }] }
