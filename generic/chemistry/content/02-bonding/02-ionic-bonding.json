        "type": "paragraph",
        "content": [{ "type": "text", "text": "Solution:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Potassium forms K\u207a ions" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Sulfur forms S\u00b2\u207b ions" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Need 2 K\u207a to balance S\u00b2\u207b: 2(+1) + (-2) = 0" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Formula: K\u2082S" }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Common Mistakes" }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mistake:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Forgetting to show the charge on dot-and-cross diagrams" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Correct:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Always include the charge outside the square brackets" }] }] }
        ]
      },
      {
