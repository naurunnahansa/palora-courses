        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Sodium loses 1 electron \u2192 Na\u207a (2, 8)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Chlorine gains 1 electron \u2192 Cl\u207b (2, 8, 8)" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Step 3:", "marks": [{ "type": "bold" }] },
