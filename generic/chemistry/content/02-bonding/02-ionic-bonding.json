      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Introduction" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Ionic bonding", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " occurs between metals and non-metals. It involves the transfer of electrons from metal atoms to non-metal atoms, forming charged particles called " },
          { "type": "text", "text": "ions", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": ". The electrostatic attraction between oppositely charged ions is the ionic bond." }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Key Concepts" }]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Why Do Ionic Bonds Form?" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Atoms are most stable when they have a full outer shell of electrons:" }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Metal atoms", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " have few outer electrons (1-3), so it's easier to " }, { "type": "text", "text": "lose", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " them" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Non-metal atoms", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " have many outer electrons (5-7), so it's easier to " }, { "type": "text", "text": "gain", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " electrons" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "When a metal meets a non-metal:" }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Metal atom loses electrons \u2192 becomes " }, { "type": "text", "text": "positive ion (cation)", "marks": [{ "type": "bold" }] }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Non-metal atom gains electrons \u2192 becomes " }, { "type": "text", "text": "negative ion (anion)", "marks": [{ "type": "bold" }] }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Opposite charges attract \u2192 " }, { "type": "text", "text": "ionic bond forms", "marks": [{ "type": "bold" }] }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Formation of Sodium Chloride" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Step 1:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " Electron configuration" }
        ]
