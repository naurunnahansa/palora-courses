      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Rules:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "orderedList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Use dots for one element's electrons, crosses for the other" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Show only the outer shell electrons" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Draw square brackets around ions" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Write the charge outside the brackets" }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Working Out Ionic Formulae" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "The formula of an ionic compound depends on balancing the charges." }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Total positive charges = Total negative charges", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Example 1:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " Sodium chloride" }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Na\u207a (charge +1) and Cl\u207b (charge -1)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "1 \u00d7 (+1) + 1 \u00d7 (-1) = 0 \u2713" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Formula: NaCl" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Example 2:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " Magnesium chloride" }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mg\u00b2\u207a (charge +2) and Cl\u207b (charge -1)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Need 2 chloride ions to balance: +2 + 2\u00d7(-1) = 0 \u2713" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Formula: MgCl\u2082" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Example 3:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " Aluminium oxide" }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Al\u00b3\u207a (charge +3) and O\u00b2\u207b (charge -2)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Need to find lowest common multiple: 2 \u00d7 Al\u00b3\u207a and 3 \u00d7 O\u00b2\u207b" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "2 \u00d7 (+3) + 3 \u00d7 (-2) = +6 - 6 = 0 \u2713" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Formula: Al\u2082O\u2083" }] }] }
        ]
      },
      {
