            { "type": "tableCell", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mg + H\u2082O(g) \u2192 MgO + H\u2082" }] }] }
          ]},
          { "type": "tableRow", "content": [
            { "type": "tableCell", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Zn" }] }] },
            { "type": "tableCell", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Zn + H\u2082O(g) \u2192 ZnO + H\u2082" }] }] }
          ]},
          { "type": "tableRow", "content": [
            { "type": "tableCell", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fe" }] }] },
