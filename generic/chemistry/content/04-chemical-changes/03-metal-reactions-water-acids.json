          ]}
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Reactions of Metals with Dilute Acids" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "General equation:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Metal + Acid \u2192 Salt + Hydrogen" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "With hydrochloric acid (HCl) \u2192 chloride salts:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Mg + 2HCl \u2192 MgCl\u2082 + H\u2082" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Zn + 2HCl \u2192 ZnCl\u2082 + H\u2082" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Fe + 2HCl \u2192 FeCl\u2082 + H\u2082" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "With sulfuric acid (H\u2082SO\u2084) \u2192 sulfate salts:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Mg + H\u2082SO\u2084 \u2192 MgSO\u2084 + H\u2082" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Zn + H\u2082SO\u2084 \u2192 ZnSO\u2084 + H\u2082" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Fe + H\u2082SO\u2084 \u2192 FeSO\u2084 + H\u2082" }]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Observations with Dilute Acids" }]
      },
      {
        "type": "table",
        "content": [
          {
            "type": "tableRow",
            "content": [
              { "type": "tableHeader", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Metal" }] }] },
              { "type": "tableHeader", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Observations with dilute HCl" }] }] }
            ]
          },
          { "type": "tableRow", "content": [
            { "type": "tableCell", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mg" }] }] },
            { "type": "tableCell", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Vigorous fizzing, gets hot, metal disappears quickly" }] }] }
          ]},
          { "type": "tableRow", "content": [
            { "type": "tableCell", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Al" }] }] },
            { "type": "tableCell", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Slow at first, then moderate fizzing (oxide layer)" }] }] }
          ]},
          { "type": "tableRow", "content": [
            { "type": "tableCell", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Zn" }] }] },
            { "type": "tableCell", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Moderate fizzing, metal dissolves" }] }] }
          ]},
          { "type": "tableRow", "content": [
            { "type": "tableCell", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fe" }] }] },
            { "type": "tableCell", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Slow fizzing, solution turns pale green" }] }] }
          ]},
          { "type": "tableRow", "content": [
            { "type": "tableCell", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Cu" }] }] },
            { "type": "tableCell", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "No reaction" }] }] }
          ]}
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Testing for Hydrogen Gas" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Test:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Apply a burning splint to the gas" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Positive result:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " A squeaky pop" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "[DIAGRAM: Test tube with metal in acid, collecting gas, burning splint test]" }]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Why Don't Unreactive Metals React?" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Copper, silver, and gold are below hydrogen in the reactivity series:" }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "They cannot displace hydrogen from acids" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "They hold onto their electrons too tightly" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "No reaction occurs with dilute HCl or H\u2082SO\u2084" }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Worked Examples" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Example 1:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Write a balanced equation for the reaction of calcium with water." }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Solution:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Calcium reacts with water to form calcium hydroxide and hydrogen" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Calcium has a 2+ charge, so formula is Ca(OH)\u2082" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Ca + 2H\u2082O \u2192 Ca(OH)\u2082 + H\u2082" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "---" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Example 2:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Describe what you would see when magnesium ribbon is added to dilute sulfuric acid." }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Solution:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bubbles/fizzing/effervescence" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "The magnesium ribbon gets smaller/dissolves/disappears" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "The solution gets warm/hot" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "The solution remains colourless" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "---" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Example 3:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Write a balanced equation for zinc reacting with dilute hydrochloric acid, including state symbols." }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Solution:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Zn(s) + 2HCl(aq) \u2192 ZnCl\u2082(aq) + H\u2082(g)" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "---" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Example 4:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Explain why copper does not react with dilute sulfuric acid." }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Solution:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Copper is below hydrogen in the reactivity series" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Copper is less reactive than hydrogen" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Copper cannot displace hydrogen from the acid" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Therefore no reaction occurs" }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Common Mistakes" }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mistake:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Saying metals react with cold water when they only react with steam" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Correct:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Only K, Na, Li, Ca react with cold water; others need steam or don't react" }] }] }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mistake:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Forgetting to balance equations properly" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Correct:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Remember: 2K + 2H\u2082O (not K + H\u2082O)" }] }] }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mistake:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Confusing the products - hydroxides from water, salts from acids" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Correct:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Water \u2192 hydroxide + H\u2082; Acid \u2192 salt + H\u2082" }] }] }
        ]
      },
