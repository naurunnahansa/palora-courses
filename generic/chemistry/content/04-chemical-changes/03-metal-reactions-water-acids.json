      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Introduction" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "The reactions of metals with water and acids help us understand and confirm the reactivity series. More reactive metals react more vigorously, producing characteristic observations." }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Key Concepts" }]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Reactions of Metals with Water" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "General equation:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Metal + Water \u2192 Metal hydroxide + Hydrogen" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Specific examples:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Potassium + Water:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "2K + 2H\u2082O \u2192 2KOH + H\u2082" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Observations:", "marks": [{ "type": "italic" }] }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melts into a ball and floats" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Moves rapidly across water surface" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Burns with a " }, { "type": "text", "text": "lilac flame", "marks": [{ "type": "bold" }] }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "May explode" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Solution turns alkaline (pH > 7)" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Sodium + Water:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "2Na + 2H\u2082O \u2192 2NaOH + H\u2082" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Observations:", "marks": [{ "type": "italic" }] }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Melts into a ball and floats" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fizzes vigorously" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Moves rapidly on water surface" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "May catch fire (yellow flame) if held in place" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Solution turns alkaline" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Lithium + Water:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "2Li + 2H\u2082O \u2192 2LiOH + H\u2082" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Observations:", "marks": [{ "type": "italic" }] }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Floats" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fizzes steadily (slower than Na)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Gets smaller and disappears" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Solution turns alkaline" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Calcium + Water:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Ca + 2H\u2082O \u2192 Ca(OH)\u2082 + H\u2082" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Observations:", "marks": [{ "type": "italic" }] }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Sinks (calcium is denser than water)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Bubbles of hydrogen form" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Goes cloudy (calcium hydroxide is sparingly soluble)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Solution is alkaline" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Magnesium + Water:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Mg + 2H\u2082O \u2192 Mg(OH)\u2082 + H\u2082" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Observations:", "marks": [{ "type": "italic" }] }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Very slow reaction with cold water" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Few bubbles form over several days" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reacts much faster with steam:" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Mg + H\u2082O(g) \u2192 MgO + H\u2082" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "[DIAGRAM: Apparatus for magnesium reacting with steam - showing test tube with magnesium ribbon heated, steam passing over it]" }]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Reactions with Steam" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Metals below calcium in the reactivity series react with steam (not cold water):" }]
      },
