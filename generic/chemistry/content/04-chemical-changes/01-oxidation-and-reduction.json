      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mistake:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Confusing oxidation and reduction" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Correct:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Use OIL RIG - Oxidation Is Loss, Reduction Is Gain (of electrons)" }] }] }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mistake:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Thinking oxidation always involves oxygen" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Correct:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Oxidation can also mean loss of electrons (even without oxygen)" }] }] }
        ]
      },
