        "content": [{ "type": "text", "text": "Oxidation and Reduction" }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Learning Objectives" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "By the end of this lesson, you should be able to:" }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Define oxidation and reduction in terms of oxygen" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Define oxidation and reduction in terms of electrons" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Identify oxidation and reduction in chemical reactions" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Explain why oxidation and reduction always occur together (redox)" }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Introduction" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Oxidation", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " and " },
          { "type": "text", "text": "reduction", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " are fundamental chemical processes that always occur together. Understanding these reactions helps explain many important processes, from rusting to respiration to metal extraction." }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Key Concepts" }]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Definitions in Terms of Oxygen" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Oxidation:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " Gain of oxygen" }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Reduction:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " Loss of oxygen" }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Example:", "marks": [{ "type": "bold" }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "2Mg + O\u2082 \u2192 2MgO" }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Magnesium is " }, { "type": "text", "text": "oxidised", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " (gains oxygen)" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "CuO + H\u2082 \u2192 Cu + H\u2082O" }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Copper oxide is " }, { "type": "text", "text": "reduced", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " (loses oxygen)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Hydrogen is " }, { "type": "text", "text": "oxidised", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " (gains oxygen)" }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Definitions in Terms of Electrons" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Oxidation:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " Loss of electrons" }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Reduction:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " Gain of electrons" }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Memory aid: OIL RIG", "marks": [{ "type": "bold" }] }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "O", "marks": [{ "type": "bold" }] }, { "type": "text", "text": "xidation " }, { "type": "text", "text": "I", "marks": [{ "type": "bold" }] }, { "type": "text", "text": "s " }, { "type": "text", "text": "L", "marks": [{ "type": "bold" }] }, { "type": "text", "text": "oss (of electrons)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "R", "marks": [{ "type": "bold" }] }, { "type": "text", "text": "eduction " }, { "type": "text", "text": "I", "marks": [{ "type": "bold" }] }, { "type": "text", "text": "s " }, { "type": "text", "text": "G", "marks": [{ "type": "bold" }] }, { "type": "text", "text": "ain (of electrons)" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Alternative: LEO GER", "marks": [{ "type": "bold" }] }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "L", "marks": [{ "type": "bold" }] }, { "type": "text", "text": "ose " }, { "type": "text", "text": "E", "marks": [{ "type": "bold" }] }, { "type": "text", "text": "lectrons = " }, { "type": "text", "text": "O", "marks": [{ "type": "bold" }] }, { "type": "text", "text": "xidation" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "G", "marks": [{ "type": "bold" }] }, { "type": "text", "text": "ain " }, { "type": "text", "text": "E", "marks": [{ "type": "bold" }] }, { "type": "text", "text": "lectrons = " }, { "type": "text", "text": "R", "marks": [{ "type": "bold" }] }, { "type": "text", "text": "eduction" }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Why Both Definitions Work" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "When magnesium reacts with oxygen:" }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mg atoms " }, { "type": "text", "text": "lose electrons", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " \u2192 Mg\u00b2\u207a ions (oxidation)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "O atoms " }, { "type": "text", "text": "gain electrons", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " \u2192 O\u00b2\u207b ions (reduction)" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Losing electrons to oxygen is equivalent to gaining oxygen!" }]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Redox Reactions" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Oxidation and reduction " },
          { "type": "text", "text": "always occur together", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": ". When one substance is oxidised, another must be reduced." }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "These reactions are called " },
          { "type": "text", "text": "redox reactions", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " (reduction-oxidation)." }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Example:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Zn + CuSO\u2084 \u2192 ZnSO\u2084 + Cu" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "In terms of electrons:" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Zn \u2192 Zn\u00b2\u207a + 2e\u207b (oxidation)" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Cu\u00b2\u207a + 2e\u207b \u2192 Cu (reduction)" }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Zinc is " }, { "type": "text", "text": "oxidised", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " (loses electrons)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Copper ions are " }, { "type": "text", "text": "reduced", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " (gain electrons)" }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Oxidising and Reducing Agents" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Oxidising agent:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " A substance that oxidises another substance" }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "It causes oxidation" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "It is itself reduced (gains electrons)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Example: Oxygen, chlorine, acids" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Reducing agent:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " A substance that reduces another substance" }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "It causes reduction" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "It is itself oxidised (loses electrons)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Example: Carbon, hydrogen, reactive metals" }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Worked Examples" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Example 1:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " In the reaction below, identify what is oxidised and what is reduced." }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Fe\u2082O\u2083 + 3CO \u2192 2Fe + 3CO\u2082" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Solution:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Iron(III) oxide loses oxygen \u2192 " }, { "type": "text", "text": "iron is reduced", "marks": [{ "type": "bold" }] }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Carbon monoxide gains oxygen \u2192 " }, { "type": "text", "text": "carbon is oxidised", "marks": [{ "type": "bold" }] }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "CO is the reducing agent" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fe\u2082O\u2083 is the oxidising agent" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "---" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Example 2:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " Identify the redox changes in:" }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Mg + 2HCl \u2192 MgCl\u2082 + H\u2082" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Solution:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mg \u2192 Mg\u00b2\u207a + 2e\u207b (magnesium loses electrons, so is " }, { "type": "text", "text": "oxidised", "marks": [{ "type": "bold" }] }, { "type": "text", "text": ")" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "2H\u207a + 2e\u207b \u2192 H\u2082 (hydrogen ions gain electrons, so are " }, { "type": "text", "text": "reduced", "marks": [{ "type": "bold" }] }, { "type": "text", "text": ")" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "This is a redox reaction" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "---" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Example 3:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " In the thermite reaction, identify the oxidising and reducing agents." }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "2Al + Fe\u2082O\u2083 \u2192 2Fe + Al\u2082O\u2083" }]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Solution:", "marks": [{ "type": "bold" }] }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Al is oxidised (loses electrons/gains oxygen) \u2192 " }, { "type": "text", "text": "Al is the reducing agent", "marks": [{ "type": "bold" }] }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fe\u2082O\u2083 is reduced (gains electrons/loses oxygen) \u2192 " }, { "type": "text", "text": "Fe\u2082O\u2083 is the oxidising agent", "marks": [{ "type": "bold" }] }] }] }
        ]
      },
      {
