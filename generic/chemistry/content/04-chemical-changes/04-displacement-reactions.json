        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Key Concepts"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Explore displacement reactions — predict which metal will displace another using the reactivity series using the interactive visualisation below."
          }
        ]
      },
      {
        "type": "visualizationEmbed",
        "attrs": {
          "visualizationId": "chem-displacement-reactions",
          "displayMode": "expanded",
          "customHeight": 500
