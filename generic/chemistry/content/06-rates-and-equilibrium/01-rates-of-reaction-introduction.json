      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Introduction" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Chemical reactions happen at different speeds. Some are almost instantaneous (explosions), while others take millions of years (rock formation). Understanding and controlling " },
          { "type": "text", "text": "rate of reaction", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " is crucial in chemistry, industry, and everyday life." }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Key Concepts" }]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "What is Rate of Reaction?" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Rate of reaction:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " How fast reactants are converted into products." }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Definition:", "marks": [{ "type": "bold" }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "$$\\text{Rate of reaction} = \\frac{\\text{Amount of reactant used (or product formed)}}{\\text{Time taken}}$$" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Units:", "marks": [{ "type": "bold" }] }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "g/s (grams per second)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "mol/s (moles per second)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "cm\u00b3/s (volume of gas per second)" }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Fast and Slow Reactions" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Fast reactions (seconds or less):", "marks": [{ "type": "bold" }] }
        ]
      },
      {
