      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "How to Measure Rate" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "1. Measuring mass lost (for gas-producing reactions):", "marks": [{ "type": "bold" }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "[DIAGRAM: Conical flask on balance, cotton wool in top, showing gas escaping]" }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Reaction produces gas that escapes" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mass of flask decreases" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Measure mass at regular time intervals" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rate = mass lost / time" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "2. Measuring volume of gas produced:", "marks": [{ "type": "bold" }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "[DIAGRAM: Conical flask connected to gas syringe, measuring gas volume]" }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Collect gas in a gas syringe or over water" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Record volume at regular intervals" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rate = volume / time" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "3. Measuring colour change:", "marks": [{ "type": "bold" }] }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Disappearing cross experiment (sodium thiosulfate + acid)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Measure time for cross to disappear" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Colorimetry for precise measurements" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "4. Measuring change in concentration:", "marks": [{ "type": "bold" }] }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Take samples at regular intervals" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Titre (for acid-base reactions)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Rate = change in concentration / time" }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Rate During a Reaction" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Reaction rate is " },
          { "type": "text", "text": "not constant", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " throughout a reaction:" }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Fastest at the start", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " (most reactant particles)" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Slows down", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " as reactants are used up" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Stops", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " when reaction is complete (or equilibrium reached)" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "[DIAGRAM: Graph showing volume of gas vs time - steep at first then levels off]" }]
      },
      {
        "type": "heading",
        "attrs": { "level": 3 },
        "content": [{ "type": "text", "text": "Reading Rate from Graphs" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Gradient = rate", "marks": [{ "type": "bold" }] }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Steeper gradient = faster rate" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Gradient decreases as reaction proceeds" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Gradient = 0 when reaction stops" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "$$\\text{Rate} = \\frac{\\text{Change in y-axis}}{\\text{Change in x-axis}}$$" }]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Worked Examples" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Example 1:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " In a reaction, 50 cm\u00b3 of gas is produced in 20 seconds. Calculate the average rate of reaction." }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Solution:", "marks": [{ "type": "bold" }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "$$\\text{Rate} = \\frac{50}{20} = 2.5 \\text{ cm}^3\\text{/s}$$" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Example 2:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " A reaction loses 4.8 g of mass in 2 minutes. Calculate the average rate in g/s." }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Solution:", "marks": [{ "type": "bold" }] }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Time = 2 minutes = 120 seconds" }] }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "$$\\text{Rate} = \\frac{4.8}{120} = 0.04 \\text{ g/s}$$" }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Example 3:", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " Look at the graph below. At which point (A, B, or C) is the reaction fastest?" }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Volume of gas (cm\u00b3) vs Time (s) graph: The curve starts steep at point A, becomes less steep at point B, and levels off at point C." }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "Solution:", "marks": [{ "type": "bold" }] }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "The reaction is fastest at point " },
          { "type": "text", "text": "A", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": " because:" }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "The gradient (slope) is steepest at the start" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "This means more gas is being produced per second" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "At C, the line is flat (gradient = 0), so the reaction has stopped" }] }] }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 2 },
        "content": [{ "type": "text", "text": "Common Mistakes" }]
      },
      {
        "type": "bulletList",
        "content": [
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mistake:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Thinking rate stays constant throughout a reaction" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Correct:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Rate is usually fastest at the start and decreases" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mistake:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Confusing rate with total amount of product" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Correct:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " A reaction might produce the same total amount but at different rates" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Mistake:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Forgetting to convert time units" }] }] },
          { "type": "listItem", "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Correct:", "marks": [{ "type": "bold" }] }, { "type": "text", "text": " Ensure consistent units (e.g., seconds, not minutes)" }] }] }
        ]
