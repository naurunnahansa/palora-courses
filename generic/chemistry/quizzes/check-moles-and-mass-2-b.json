  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the mass of 0.1 mol of glucose (C₆H₁₂O₆)? (Ar: C = 12, H = 1, O = 16)",
      "options": [
        {
          "id": "a",
          "text": "18 g"
        },
        {
          "id": "b",
          "text": "36 g"
        },
        {
          "id": "c",
          "text": "180 g"
        },
        {
          "id": "d",
          "text": "1.8 g"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Mr of C₆H₁₂O₆ = (6 × 12) + (12 × 1) + (6 × 16) = 72 + 12 + 96 = 180. Using m = n × M = 0.1 × 180 = 18 g."
    }
  ]
