{
  "id": "check-moles-and-mass",
  "title": "Check: Moles and Mass Calculations",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "How many moles are in 49 g of sulfuric acid (H₂SO₄)? (Ar: H = 1, S = 32, O = 16)",
      "options": [
        { "id": "a", "text": "0.25 mol" },
        { "id": "b", "text": "0.5 mol" },
        { "id": "c", "text": "1 mol" },
        { "id": "d", "text": "2 mol" }
      ],
      "correctAnswer": "b",
      "explanation": "Mr of H₂SO₄ = (2 × 1) + 32 + (4 × 16) = 2 + 32 + 64 = 98. Using n = m/M = 49/98 = 0.5 mol."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the mass of 0.25 mol of copper sulfate (CuSO₄)? (Ar: Cu = 64, S = 32, O = 16)",
      "options": [
        { "id": "a", "text": "40 g" },
        { "id": "b", "text": "80 g" },
        { "id": "c", "text": "160 g" },
        { "id": "d", "text": "20 g" }
      ],
      "correctAnswer": "a",
      "explanation": "Mr of CuSO₄ = 64 + 32 + (4 × 16) = 64 + 32 + 64 = 160. Using m = n × M = 0.25 × 160 = 40 g."
    }
  ]
}
