  "title": "Quiz: Moles and Mass Calculations",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which formula correctly relates moles, mass, and relative formula mass?",
      "options": [
        {
          "id": "a",
          "text": "Moles = Mass x Mr"
        },
        {
          "id": "b",
          "text": "Moles = Mass / Mr"
        },
        {
          "id": "c",
          "text": "Moles = Mr / Mass"
        },
        {
          "id": "d",
          "text": "Moles = Mass + Mr"
        }
      ],
      "correctAnswer": "b",
      "explanation": "The formula is: Moles = Mass (g) / Mr. This can be rearranged to Mass = Moles x Mr, or Mr = Mass / Moles."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "How many moles are in 36 g of water (H₂O)? [Mr of H₂O = 18]",
      "options": [
        {
          "id": "a",
          "text": "0.5 moles"
        },
        {
          "id": "b",
          "text": "2 moles"
        },
        {
          "id": "c",
          "text": "1 mole"
        },
        {
          "id": "d",
          "text": "18 moles"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Moles = Mass / Mr = 36 / 18 = 2 moles."
    },
