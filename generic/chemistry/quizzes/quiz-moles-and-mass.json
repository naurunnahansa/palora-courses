  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "Which formula correctly relates moles, mass, and relative formula mass?",
      "options": [
        {"id": "a", "text": "Moles = Mass x Mr"},
        {"id": "b", "text": "Moles = Mr / Mass"},
        {"id": "c", "text": "Moles = Mass / Mr"},
        {"id": "d", "text": "Moles = Mass + Mr"}
      ],
      "correctAnswer": "c",
      "explanation": "The formula is: Moles = Mass (g) / Mr. This can be rearranged to Mass = Moles x Mr, or Mr = Mass / Moles."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "How many moles are in 36 g of water (H\u2082O)? [Mr of H\u2082O = 18]",
      "options": [
        {"id": "a", "text": "0.5 moles"},
        {"id": "b", "text": "1 mole"},
        {"id": "c", "text": "2 moles"},
        {"id": "d", "text": "18 moles"}
      ],
      "correctAnswer": "c",
      "explanation": "Moles = Mass / Mr = 36 / 18 = 2 moles."
    },
