{
  "id": "quiz-moles-in-solutions",
  "title": "Quiz: Moles in Solutions",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the formula for concentration in mol/dm³?",
      "options": [
        {
          "id": "a",
          "text": "Concentration = Mass / Moles"
        },
        {
          "id": "b",
          "text": "Concentration = Moles / Volume (dm³)"
        },
        {
          "id": "c",
          "text": "Concentration = Moles x Volume"
        },
        {
          "id": "d",
          "text": "Concentration = Volume / Moles"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Concentration (mol/dm³) = Number of moles / Volume (dm³). This gives the number of moles of solute per dm³ of solution."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "How many moles of NaOH are in 500 cm³ of a 2 mol/dm³ solution?",
      "options": [
        {
          "id": "a",
          "text": "0.5 moles"
        },
        {
          "id": "b",
          "text": "4 moles"
        },
        {
          "id": "c",
          "text": "1 mole"
        },
        {
          "id": "d",
          "text": "2 moles"
        }
      ],
      "correctAnswer": "c",
      "explanation": "Moles = Concentration x Volume. Convert 500 cm³ to 0.5 dm³. Moles = 2 x 0.5 = 1 mole."
    },
    {
      "id": "q3",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "0.1 moles of HCl is dissolved in 250 cm³ of solution. What is the concentration?",
      "options": [
        {
          "id": "a",
          "text": "2.5 mol/dm³"
        },
        {
          "id": "b",
          "text": "0.1 mol/dm³"
        },
        {
          "id": "c",
          "text": "0.4 mol/dm³"
        },
        {
          "id": "d",
          "text": "0.25 mol/dm³"
        }
      ],
      "correctAnswer": "c",
      "explanation": "250 cm³ = 0.25 dm³. Concentration = Moles / Volume = 0.1 / 0.25 = 0.4 mol/dm³."
    },
    {
      "id": "q4",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "How do you convert concentration from g/dm³ to mol/dm³?",
      "options": [
        {
          "id": "a",
          "text": "Multiply by the Mr"
        },
        {
          "id": "b",
          "text": "Add the Mr to the concentration"
        },
        {
          "id": "c",
          "text": "Divide the concentration in g/dm³ by the Mr"
        },
        {
          "id": "d",
          "text": "It cannot be converted"
        }
      ],
      "correctAnswer": "c",
      "explanation": "To convert from g/dm³ to mol/dm³, divide by the Mr. This is because moles = mass / Mr, so the same relationship applies to concentrations."
    },
    {
      "id": "q5",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What volume of a 0.5 mol/dm³ solution contains 0.2 moles of solute?",
      "options": [
        {
          "id": "a",
          "text": "2.5 dm³"
        },
        {
          "id": "b",
          "text": "0.4 dm³"
        },
        {
          "id": "c",
          "text": "0.1 dm³"
        },
        {
          "id": "d",
          "text": "0.25 dm³"
        }
      ],
      "correctAnswer": "b",
      "explanation": "Volume = Moles / Concentration = 0.2 / 0.5 = 0.4 dm³ (or 400 cm³)."
    },
    {
      "id": "q6",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "A solution of NaOH has a concentration of 40 g/dm³. What is this in mol/dm³? [Mr of NaOH = 40]",
      "options": [
        {
          "id": "a",
          "text": "1 mol/dm³"
        },
        {
          "id": "b",
          "text": "40 mol/dm³"
        },
        {
          "id": "c",
          "text": "1600 mol/dm³"
        },
        {
          "id": "d",
          "text": "0.5 mol/dm³"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Concentration in mol/dm³ = Concentration in g/dm³ / Mr = 40 / 40 = 1 mol/dm³."
    },
    {
      "id": "q7",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "In a titration, 25 cm³ of a 0.1 mol/dm³ NaOH solution is used. How many moles of NaOH is this?",
      "options": [
        {
          "id": "a",
          "text": "0.0025 moles"
        },
        {
          "id": "b",
          "text": "0.025 moles"
        },
        {
          "id": "c",
          "text": "2.5 moles"
        },
        {
          "id": "d",
          "text": "0.25 moles"
        }
      ],
      "correctAnswer": "a",
      "explanation": "25 cm³ = 0.025 dm³. Moles = Concentration x Volume = 0.1 x 0.025 = 0.0025 moles."
    }
  ]
