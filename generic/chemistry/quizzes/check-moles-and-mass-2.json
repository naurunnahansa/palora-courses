{
  "id": "check-moles-and-mass-2",
  "title": "Check: Moles and Mass Calculations (2)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "4.4 g of a gas contains 0.1 mol. What is the relative formula mass (Mr) of the gas?",
      "options": [
        { "id": "a", "text": "22" },
        { "id": "b", "text": "44" },
        { "id": "c", "text": "88" },
        { "id": "d", "text": "4.4" }
      ],
      "correctAnswer": "b",
      "explanation": "Using M = m/n = 4.4/0.1 = 44 g/mol. The Mr is therefore 44, which corresponds to carbon dioxide (CO₂)."
    },
    {
      "id": "q2",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "What is the mass of 0.1 mol of glucose (C₆H₁₂O₆)? (Ar: C = 12, H = 1, O = 16)",
      "options": [
        { "id": "a", "text": "18 g" },
        { "id": "b", "text": "36 g" },
        { "id": "c", "text": "180 g" },
        { "id": "d", "text": "1.8 g" }
      ],
      "correctAnswer": "a",
      "explanation": "Mr of C₆H₁₂O₆ = (6 × 12) + (12 × 1) + (6 × 16) = 72 + 12 + 96 = 180. Using m = n × M = 0.1 × 180 = 18 g."
    }
  ]
}
