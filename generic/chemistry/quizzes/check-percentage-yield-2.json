{
  "id": "check-percentage-yield-2",
  "title": "Check: Percentage Yield (2)",
  "questions": [
    {
      "id": "q1",
      "type": "multiple-choice",
      "difficulty": "knowledge-check",
      "stem": "4.8 g of magnesium is burned: 2Mg + O₂ → 2MgO. The theoretical yield of MgO is 8 g, but only 7.2 g is obtained. What is the percentage yield? (Ar: Mg = 24, O = 16)",
      "options": [
        {
          "id": "a",
          "text": "90%"
        },
        {
          "id": "b",
          "text": "60%"
        },
        {
          "id": "c",
          "text": "75%"
        },
        {
          "id": "d",
          "text": "96%"
        }
      ],
      "correctAnswer": "a",
      "explanation": "Percentage yield = (actual yield / theoretical yield) × 100 = (7.2/8) × 100 = 90%."
    }
  ]
}
